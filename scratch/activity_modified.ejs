    <script>
        // ─── Concept Gamification & Sound Logic ───
        const exploredConcepts = new Set();
        const TOTAL_CONCEPTS = 13;

        // Custom Sound Player using browser's Web Audio API
        window.playCustomSound = function(type) {
            try {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (!AudioContextClass) return;
                const ctx = new AudioContextClass();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                
                osc.connect(gain);
                gain.connect(ctx.destination);
                
                const now = ctx.currentTime;
                
                if (type === 'pop') {
                    // Short cute bubble pop
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(450, now);
                    osc.frequency.exponentialRampToValueAtTime(1300, now + 0.08);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                } else if (type === 'coin') {
                    // Double coin collector ping
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(987.77, now); // B5
                    osc.frequency.setValueAtTime(1318.51, now + 0.07); // E6
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.setValueAtTime(0.08, now + 0.07);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'chime') {
                    // Shiny magic chime/sparkle
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.exponentialRampToValueAtTime(1567.98, now + 0.22); // G6
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.22);
                    osc.start(now);
                    osc.stop(now + 0.22);
                } else if (type === 'fanfare') {
                    // Triumphant 8-bit victory fanfare (C5, E5, G5, C6)
                    osc.type = 'square';
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    const duration = 0.08;
                    gain.gain.setValueAtTime(0.04, now);
                    notes.forEach((freq, idx) => {
                        const noteTime = now + (idx * duration);
                        osc.frequency.setValueAtTime(freq, noteTime);
                        if (idx === notes.length - 1) {
                            gain.gain.setValueAtTime(0.04, noteTime);
                            gain.gain.exponentialRampToValueAtTime(0.01, noteTime + 0.35);
                        }
                    });
                    osc.start(now);
                    osc.stop(now + (notes.length * duration) + 0.35);
                } else if (type === 'tick') {
                    // Simple interface tick/tap
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(600, now);
                    osc.frequency.exponentialRampToValueAtTime(150, now + 0.05);
                    gain.gain.setValueAtTime(0.05, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                }
            } catch (e) {
                console.warn('Sound play failed:', e);
            }
        };

        // Explore Concept Handler
        window.exploreConcept = function(element, conceptId, soundType, event) {
            // Determine clicked position for float text
            let x = 40;
            let y = 10;
            if (event && event.clientX && event.clientY) {
                const rect = element.getBoundingClientRect();
                x = event.clientX - rect.left;
                y = event.clientY - rect.top;
            }

            // Only add XP and float if not already explored
            if (!exploredConcepts.has(conceptId)) {
                exploredConcepts.add(conceptId);
                
                // Spawn XP Float text
                const xpFloat = document.createElement('span');
                xpFloat.className = 'xp-float';
                xpFloat.textContent = '+10 XP';
                xpFloat.style.left = `${x}px`;
                xpFloat.style.top = `${y}px`;
                element.appendChild(xpFloat);
                setTimeout(() => xpFloat.remove(), 800);

                // Play sound
                playCustomSound(soundType);
                
                // Set discovered class
                element.classList.add('discovered');

                // Update progress bar
                updateQuestTracker();
            } else {
                // If already discovered, just play tick sound and toggle expansion visual (standard check)
                playCustomSound('tick');
                element.classList.add('discovered'); // ensure it stays open
            }
        };

        function updateQuestTracker() {
            const countEl = document.getElementById('quest-tracker-count');
            const fillEl = document.getElementById('quest-tracker-fill');
            const trackerContainer = document.getElementById('questTracker');
            if (!countEl || !fillEl) return;

            const size = exploredConcepts.size;
            const pct = (size / TOTAL_CONCEPTS) * 100;
            
            // i18n label
            const lang = window.langUtils ? window.langUtils.getLang() : 'es';
            let label = `${size * 10} XP`;
            if (lang === 'de') {
                label = `${size * 10} XP`;
            } else if (lang === 'en') {
                label = `${size * 10} XP`;
            }
            
            countEl.textContent = `⭐ ${label}`;
            fillEl.style.width = `${pct}%`;

            if (size === TOTAL_CONCEPTS) {
                trackerContainer.classList.add('completed');
                // Play final epic fanfare and confetti
                setTimeout(() => {
                    playCustomSound('fanfare');
                    spawnConfetti();
                }, 300);
            }
        }

        function spawnConfetti() {
            const colors = ['#f59e0b', '#10b981', '#3b82f6', '#ef4444', '#8b5cf6', '#ec4899'];
            const container = document.body;
            for (let i = 0; i < 40; i++) {
                const p = document.createElement('div');
                p.style.position = 'fixed';
                p.style.width = Math.random() * 8 + 6 + 'px';
                p.style.height = Math.random() * 8 + 6 + 'px';
                p.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                p.style.left = Math.random() * 100 + 'vw';
                p.style.top = '-10px';
                p.style.borderRadius = '50%';
                p.style.zIndex = '9999';
                p.style.pointerEvents = 'none';
                
                container.appendChild(p);
                
                const duration = Math.random() * 2 + 1.5;
                const drift = (Math.random() - 0.5) * 200;
                
                p.animate([
                    { transform: 'translateY(0) rotate(0deg)', opacity: 1 },
                    { transform: `translateY(105vh) translateX(${drift}px) rotate(${Math.random() * 360}deg)`, opacity: 0 }
                ], {
                    duration: duration * 1000,
                    easing: 'cubic-bezier(0.1, 0.8, 0.3, 1)'
                });
                
                setTimeout(() => p.remove(), duration * 1000);
            }
        }

        // ─── Slide Deck Logic ───
        let slideIndex = 1;
        function showSlides(n) {
            let i;
            let slides = document.getElementsByClassName("mySlides");
            let dots = document.getElementsByClassName("dot");
            if (!slides || slides.length === 0) return;
            if (n > slides.length) {slideIndex = 1}
            if (n < 1) {slideIndex = slides.length}
            for (i = 0; i < slides.length; i++) {
                slides[i].style.display = "none";
            }
            for (i = 0; i < dots.length; i++) {
                dots[i].className = dots[i].className.replace(" active", "");
            }
            slides[slideIndex-1].style.display = "block";
            dots[slideIndex-1].className += " active";
        }
        function moveSlide(n) {
            showSlides(slideIndex += n);
        }
        function currentSlide(n) {
            showSlides(slideIndex = n);
        }
        // Initialize slideshow on load if elements exist
        document.addEventListener('DOMContentLoaded', () => {
            if (document.getElementsByClassName("mySlides").length > 0) {
                showSlides(slideIndex);
            }
        });
    </script>

    <script>
        // ─── Star Rating ───
        let currentStarRating = 0;
        function setStarRating(rating) {
            currentStarRating = rating;
            document.getElementById('star_rating_value').value = rating;
            const stars = document.querySelectorAll('.star-clickable');
            stars.forEach(star => {
                const val = parseInt(star.getAttribute('data-star'));
                star.textContent = val <= rating ? '★' : '☆';
                star.classList.toggle('star-filled', val <= rating);
            });
        }

        // ─── Mini Star Rating per Field (Automatic Scoring Rules) ───
        function checkCoherence(text) {
            const trimmed = text.trim();
            if (trimmed.length < 40) return false;
            const words = trimmed.split(/\s+/).filter(w => w.length > 0);
            if (words.length < 8) return false;
            
            // Character variety check
            const uniqueChars = new Set(trimmed.toLowerCase().replace(/\s/g, ''));
            if (uniqueChars.size < 5) return false;
            
            // Word variety check
            const uniqueWords = new Set(words.map(w => w.toLowerCase()));
            if (uniqueWords.size < words.length / 2) return false;
            
            return true;
        }

        function recalculateInteractiveStars() {
            // Find all radio group questions (like r1_aleman_k5_q1)
            document.querySelectorAll('.radio-group').forEach(group => {
                const fieldId = group.id.replace('group_', '');
                
                // Get corresponding explain field (textarea)
                const explainInput = document.getElementById(fieldId + '_explain');
                const selectedRadio = group.querySelector('input[type="radio"]:checked');
                const starInput = document.getElementById('star_' + fieldId);
                const sadFace = document.getElementById('sad_' + fieldId);
                const starContainer = document.querySelector(`.field-star-rating[data-field-id="${fieldId}"]`);
                
                if (!starInput) return; // Skip if no rating container exists
                
                let stars = 0;
                let showSad = false;
                
                if (selectedRadio) {
                    const isCorrect = selectedRadio.getAttribute('data-correct') === 'true';
                    const explanationText = explainInput ? explainInput.value : '';
                    const hasCoherentExplain = checkCoherence(explanationText);
                    
                    if (isCorrect) {
                        stars = 3;
                        if (hasCoherentExplain) {
                            stars += 2; // total 5
                        }
                    } else {
                        // Incorrect answer
                        if (hasCoherentExplain) {
                            stars = 3; // 1 + 2 = 3
                        } else {
                            stars = 0;
                            showSad = true; // Incorrect AND no coherent argument -> 0 stars + sad face
                        }
                    }
                } else {
                    // Not answered yet
                    stars = 0;
                    showSad = false;
                }
                
                // Update hidden input
                starInput.value = stars;
                
                // Update sad face visual
                if (sadFace) {
                    sadFace.style.display = showSad ? 'inline' : 'none';
                }
                
                // Update stars visual
                if (starContainer) {
                    starContainer.querySelectorAll('.mini-star').forEach(star => {
                        const val = parseInt(star.getAttribute('data-val'));
                        star.textContent = val <= stars ? '★' : '☆';
                        star.classList.toggle('mini-star-filled', val <= stars);
                    });
                }
            });
            
            // Trigger the general star summary calculation
            if (typeof updateStarSummary === 'function') {
                updateStarSummary();
            }
        }

        function setFieldStar(fieldId, rating) {
            const container = document.querySelector(`.field-star-rating[data-field-id="${fieldId}"]`);
            if (!container) return;

            const hiddenInput = document.getElementById('star_' + fieldId);
            hiddenInput.value = rating;

            container.querySelectorAll('.mini-star').forEach(star => {
                const val = parseInt(star.getAttribute('data-val'));
                star.textContent = val <= rating ? '★' : '☆';
                star.classList.toggle('mini-star-filled', val <= rating);
            });

            updateStarSummary();
        }

        // ─── Competency Group Stars ───
        function setCgStar(groupIdx, starVal) {
            const hidden = document.getElementById('cg_stars_' + groupIdx);
            if (!hidden) return;
            const currentVal = parseInt(hidden.value) || 0;
            const newVal = (currentVal === starVal) ? 0 : starVal;
            hidden.value = newVal;

            // Update star display for this group
            document.querySelectorAll(`.cg-star[data-group="${groupIdx}"]`).forEach(star => {
                const val = parseInt(star.getAttribute('data-star'));
                star.textContent = val <= newVal ? '★' : '☆';
                star.classList.toggle('cg-star-filled', val <= newVal);
            });
            updateCgTotal();
            updateStarSummary();
        }

        function updateCgTotal() {
            const totalEl = document.getElementById('cgTotalValue');
            if (!totalEl) return;
            let total = 0;
            document.querySelectorAll('[id^="cg_stars_"]').forEach(input => {
                total += parseInt(input.value) || 0;
            });
            totalEl.textContent = total;
        }

        function updateStarSummary() {
            const summaryValue = document.getElementById('starSummaryValue');
            const summaryFill = document.getElementById('starSummaryFill');
            const summaryMessage = document.getElementById('starSummaryMessage');
            if (!summaryValue) return;

            const isProfile = '<%= activity.id %>' === 'profile';

            let totalPoints = 0;
            let maxPoints = 0;

            if (isProfile) {
                // Quiz calculation for profile (Reto 0)
                document.querySelectorAll('.radio-group').forEach(group => {
                    maxPoints++;
                    const selected = group.querySelector('input[type="radio"]:checked');
                    if (selected && selected.getAttribute('data-correct') === 'true') {
                        totalPoints++;
                    }
                });
                
                summaryValue.textContent = `${totalPoints} / ${maxPoints} ✅`;
            } else {
                // Normal star calculation
                document.querySelectorAll('.field-star-rating').forEach(container => {
                    const fieldId = container.getAttribute('data-field-id');
                    const input = document.getElementById('star_' + fieldId);
                    if (input) {
                        totalPoints += parseInt(input.value) || 0;
                        maxPoints += 5;
                    }
                });

                if (currentStarRating > 0) {
                    totalPoints += currentStarRating;
                    const maxMain = document.querySelectorAll('.star-clickable').length;
                    maxPoints += maxMain;
                }
                summaryValue.textContent = `${totalPoints} / ${maxPoints} ⭐`;
            }

            const pct = maxPoints > 0 ? Math.round((totalPoints / maxPoints) * 100) : 0;
            summaryFill.style.width = pct + '%';

            // Color based on percentage
            if (pct >= 80) {
                summaryFill.style.background = 'linear-gradient(90deg, #059669, #10b981)';
                summaryMessage.innerHTML = isProfile ? 
                    '<span style="color:#059669; font-weight:bold;">🎉 ¡APROBADO! Excelente dominio.</span>' : 
                    '🎉 ¡Excelente trabajo! / Ausgezeichnet!';
            } else if (pct >= 50) {
                summaryFill.style.background = 'linear-gradient(90deg, #f59e0b, #fbbf24)';
                summaryMessage.innerHTML = isProfile ? 
                    '<span style="color:#f59e0b; font-weight:bold;">⚠️ NECESITAS 80% PARA APROBAR. ¡Sigue revisando!</span>' : 
                    '👍 ¡Buen avance! / Guter Fortschritt!';
            } else if (pct > 0) {
                summaryFill.style.background = 'linear-gradient(90deg, #ef4444, #f87171)';
                summaryMessage.innerHTML = isProfile ? 
                    '<span style="color:#ef4444; font-weight:bold;">❌ DEBES REPETIR. Lee detenidamente el documento.</span>' : 
                    '💪 ¡Sigue adelante! / Weiter so!';
            } else {
                summaryFill.style.background = '#e2e8f0';
                summaryMessage.textContent = '';
            }

            // Expose percentage for save logic
            window.currentScorePct = pct;
        }

        function selectAvatar(avatarChar) {
            const photoInput = document.getElementById('profile_photo');
            const avatarDisplay = document.getElementById('currentAvatarDisplay');

            // Update hidden input if it exists
            if (photoInput) {
                photoInput.value = avatarChar;
            }
            
            // Update visual display if it exists
            if (avatarDisplay) {
                avatarDisplay.innerText = avatarChar;
            }
            
            // Update selection highlight if options exist
            document.querySelectorAll('.avatar-option').forEach(el => {
                el.classList.remove('selected');
                if (el.getAttribute('data-avatar') === avatarChar) {
                    el.classList.add('selected');
                    try {
                        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    } catch(e) {}
                }
            });
        }

        // Dummy function called by existing data restoration code
        function showCapturedPhoto(photoData) {
            const photoInput = document.getElementById('profile_photo');
            const photoDisplay = document.getElementById('capturedPhotoDisplay');
            const startArea = document.getElementById('cameraStartArea');

            if (photoInput) photoInput.value = '';
            if (photoDisplay) photoDisplay.style.display = 'none';
            if (startArea) startArea.style.display = 'block';
        }

        document.addEventListener('DOMContentLoaded', async () => {
            const activityId = '<%= activity.id %>';
            const form = document.getElementById('activityForm');
            const inputs = form.querySelectorAll('input, textarea, select');
            const saveBtn = document.getElementById('saveBtn');
            const saveStatus = document.getElementById('saveStatus');

            function t(key) {
                const lang = window.langUtils ? window.langUtils.getLang() : 'de';
                return (window.i18n && window.i18n[lang] && window.i18n[lang][key]) || key;
            }

            // ── Load existing data ──
            try {
                const response = await fetch('/api/load/' + activityId);
                const result = await response.json();

                if (result.success && result.data) {
                    const savedData = result.data;
                    inputs.forEach(input => {
                        if (savedData[input.id] !== undefined) {
                            if (input.type === 'checkbox') {
                                input.checked = savedData[input.id] === true;
                            } else {
                                input.value = savedData[input.id];
                            }
                        }
                    });
                    // Restore star rating
                    if (savedData.star_rating) {
                        setStarRating(parseInt(savedData.star_rating));
                    }
                    // Restore profile photo (avatar)
                    if (savedData.profile_photo) {
                        selectAvatar(savedData.profile_photo);
                    }
                    // Restore field stars
                    if (activityId !== 'profile') {
                        recalculateInteractiveStars();
                    } else {
                        document.querySelectorAll('.field-star-rating').forEach(container => {
                            const fieldId = container.getAttribute('data-field-id');
                            const starKey = 'star_' + fieldId;
                            if (savedData[starKey]) {
                                setFieldStar(fieldId, parseInt(savedData[starKey]));
                            }
                        });
                        updateStarSummary();
                    }
                    if (activityId === 'profile' && window.currentScorePct > 0) {
                        if (typeof setEvaluationMode === 'function') setEvaluationMode();
                    }
                } else {
                    throw new Error("No data from server");
                }
            } catch (e) {
                console.log('Loading from localStorage fallback');
                const storageKey = 'medienpass_' + activityId;
                try {
                    const localData = JSON.parse(localStorage.getItem(storageKey) || '{}');
                    inputs.forEach(input => {
                        if (localData[input.id] !== undefined) {
                            if (input.type === 'checkbox') {
                                input.checked = localData[input.id] === true;
                            } else {
                                input.value = localData[input.id];
                            }
                        }
                    });
                    if (localData.star_rating) {
                        setStarRating(parseInt(localData.star_rating));
                    }
                    // Restore profile photo (avatar)
                    if (localData.profile_photo) {
                        selectAvatar(localData.profile_photo);
                    }
                    // Restore field stars
                    if (activityId !== 'profile') {
                        recalculateInteractiveStars();
                    } else {
                        document.querySelectorAll('.field-star-rating').forEach(container => {
                            const fieldId = container.getAttribute('data-field-id');
                            const starKey = 'star_' + fieldId;
                            if (localData[starKey]) {
                                setFieldStar(fieldId, parseInt(localData[starKey]));
                            }
                        });
                        updateStarSummary();
                    }
                    if (activityId === 'profile' && window.currentScorePct > 0) {
                        if (typeof setEvaluationMode === 'function') setEvaluationMode();
                    }
                } catch (ex) { /* ignore */ }
            }

            function collectData() {
                const data = {};
                inputs.forEach(input => {
                    if (input.type === 'checkbox') {
                        data[input.id] = input.checked;
                    } else {
                        data[input.id] = input.value;
                    }
                });
                return data;
            }

            function saveLocally() {
                const storageKey = 'medienpass_' + activityId;
                localStorage.setItem(storageKey, JSON.stringify(collectData()));
            }

            inputs.forEach(input => {
                input.addEventListener('change', () => {
                    saveLocally();
                    if (activityId !== 'profile') recalculateInteractiveStars();
                });
                input.addEventListener('input', () => {
                    saveLocally();
                    if (activityId !== 'profile') recalculateInteractiveStars();
                });
            });

            function showToast(message, type = 'success') {
                const container = document.getElementById('toast-container');
                const toast = document.createElement('div');
                toast.className = 'toast toast-' + type;
                toast.innerHTML = '<i class="fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-triangle') + '"></i> ' + message;
                container.appendChild(toast);
                setTimeout(() => toast.classList.add('show'), 10);
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }

            async function performSave() {
                const isProfile = activityId === 'profile';
                if (isProfile && window.currentScorePct < 80) {
                    alert('⚠️ No has alcanzado el 80% necesario para aprobar. Por favor, revisa el documento y vuelve a intentar el cuestionario.');
                    return;
                }

                const data = collectData();

                // --- Validation for ESTE SOY YO (Profile) ---
                if (activityId === 'profile') {
                    let hasError = false;
                    Object.keys(data).forEach(key => {
                        if (key.startsWith('teacher_')) {
                            const val = data[key] ? data[key].trim() : '';
                            const field = document.getElementById(key);
                            if (!val) {
                                hasError = true;
                                if (field) field.classList.add('input-error');
                            } else {
                                if (field) {
                                    field.classList.remove('input-error');
                                    data[key] = val.toUpperCase();
                                }
                            }
                        }
                    });

                    if (hasError) {
                        showToast(t('fillRequiredFields') || 'Por favor, llena los campos obligatorios.', 'error');
                        return;
                    }
                }

                saveLocally();

                const saveBtnQuiz = document.getElementById('saveBtnQuiz');
                const saveStatusQuiz = document.getElementById('saveStatusQuiz');

                const disableButtons = (disabled) => {
                    if (saveBtn) saveBtn.disabled = disabled;
                    if (saveBtnQuiz) saveBtnQuiz.disabled = disabled;
                };

                const updateButtonContent = (html) => {
                    if (saveBtn) saveBtn.innerHTML = html;
                    if (saveBtnQuiz) saveBtnQuiz.innerHTML = html;
                };

                disableButtons(true);
                updateButtonContent('<i class="fas fa-spinner fa-spin"></i> ' + t('saving'));

                try {
                    const response = await fetch('/api/save/' + activityId, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    const updateStatus = (html, className) => {
                        if (saveStatus) {
                            saveStatus.innerHTML = html;
                            saveStatus.className = className;
                        }
                        if (saveStatusQuiz) {
                            saveStatusQuiz.innerHTML = html;
                            saveStatusQuiz.className = className;
                        }
                    };

                    if (result.success) {
                        if (result.localOnly) {
                            showToast(t('savedLocal'), 'success');
                            updateStatus('<i class="fas fa-check-circle"></i> ' + t('localSave') + ' ' + new Date().toLocaleTimeString(), 'save-status saved');
                        } else {
                            showToast(t('savedSuccess'), 'success');
                            updateStatus('<i class="fas fa-check"></i> ' + t('lastSaved') + ' ' + new Date().toLocaleTimeString(), 'save-status saved');
                        }

                        // Update header avatar dynamically if on profile page
                        if (isProfile) {
                            const avatarVal = document.getElementById('profile_photo')?.value;
                            const headerAvatar = document.getElementById('headerUserAvatar');
                            if (headerAvatar && avatarVal) {
                                if (avatarVal.length < 15) {
                                    headerAvatar.innerHTML = avatarVal;
                                    headerAvatar.style.fontSize = '1.1em';
                                } else if (avatarVal.startsWith('data:image')) {
                                    headerAvatar.innerHTML = `<img src="${avatarVal}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">`;
                                }
                            }
                        }
                    } else {
                        showToast(t('saveError'), 'error');
                        updateStatus('<i class="fas fa-exclamation-triangle"></i> ' + t('saveError'), 'save-status error');
                    }
                } catch (e) {
                    console.error('Save error:', e);
                    showToast(t('noConnection'), 'error');
                    const errStatus = '<i class="fas fa-wifi"></i> ' + t('noConnection');
                    if (saveStatus) {
                        saveStatus.innerHTML = errStatus;
                        saveStatus.className = 'save-status error';
                    }
                    if (saveStatusQuiz) {
                        saveStatusQuiz.innerHTML = errStatus;
                        saveStatusQuiz.className = 'save-status error';
                    }
                }

                disableButtons(false);
                updateButtonContent('<i class="fas fa-cloud-upload-alt"></i> ' + t('save'));
            }

            if (saveBtn) saveBtn.addEventListener('click', performSave);
            if (saveBtnQuiz) saveBtnQuiz.addEventListener('click', performSave);

            // ═══ MULTIMEDIA PRODUCT ═══
            const mmActivityId = '<%= activity.id %>';
            const mmSubject = '<%= activity.subject || activity.id %>';
            let mmSelectedType = '';
            let mmHasProduct = false;

            // Load existing multimedia product
            if (mmActivityId !== 'profile' && mmActivityId !== 'notes') {
                try {
                    const mmRes = await fetch('/api/student/multimedia-product/' + mmActivityId);
                    const mmData = await mmRes.json();
                    if (mmData.success && mmData.data) {
                        const p = mmData.data;
                        mmHasProduct = true;
                        toggleMultimediaForm(true);
                        selectMmType(p.product_type);
                        if (document.getElementById('mm_description')) document.getElementById('mm_description').value = p.description || '';
                        if (document.getElementById('mm_link')) document.getElementById('mm_link').value = p.link || '';
                        if (document.getElementById('mm_image_url')) {
                            document.getElementById('mm_image_url').value = p.image_url || '';
                            if (p.image_url) previewMmImage(p.image_url);
                        }
                        document.getElementById('mmSaveStatus').textContent = '✅ Producto guardado previamente';
                    }
                } catch(e) { /* no multimedia yet */ }
            }

            window.saveAvatarAndContinue = async function(btnEl) {
                const avatar = document.getElementById('profile_photo').value;
                if (!avatar) return alert('Por favor, selecciona un avatar primero.');
                
                const btn = btnEl || document.querySelector('.avatar-selector-container button.save-btn') || event?.currentTarget;
                if (!btn) return;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';
                btn.disabled = true;

                const data = collectData();
                saveLocally();

                try {
                    const response = await fetch('/api/save/' + activityId, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const resData = await response.json();
                    if (resData.success) {
                        showToast('¡Avatar guardado con éxito!', 'success');
                        
                        // Update header avatar dynamically!
                        const headerAvatar = document.getElementById('headerUserAvatar');
                        if (headerAvatar && avatar) {
                            if (avatar.length < 15) {
                                headerAvatar.innerHTML = avatar;
                                headerAvatar.style.fontSize = '1.1em';
                            } else if (avatar.startsWith('data:image')) {
                                headerAvatar.innerHTML = `<img src="${avatar}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">`;
                            }
                        }

                        // Alerta invitando a la evaluación
                        alert('¡Excelente! Has guardado tu perfil inicial.\n\nAhora estás invitado a completar la evaluación de tus competencias (Reto 0). ¡Sigue adelante!');
                        
                        // Cambiar a modo evaluación y scroll
                        if (setEvaluationMode) {
                            setEvaluationMode();
                        } else {
                            const saveActions = document.querySelector('.save-actions');
                            if (saveActions) saveActions.scrollIntoView({behavior: 'smooth'});
                        }
                    } else {
                        showToast('Error guardando el avatar.', 'error');
                    }
                } catch (e) {
                    showToast('Error de red al guardar.', 'error');
                }
                
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            };
        });

        // Multimedia helper functions (outside DOMContentLoaded)
        function toggleMultimediaForm(show) {
            document.getElementById('mmYesBtn')?.classList.toggle('active', show);
            document.getElementById('mmNoBtn')?.classList.toggle('active', !show);
            const form = document.getElementById('mmProductForm');
            if (form) form.style.display = show ? 'block' : 'none';
        }

        function selectMmType(type) {
            document.querySelectorAll('.multimedia-type-btn[data-type]').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.type === type);
            });
            const inp = document.getElementById('mm_product_type');
            if (inp) inp.value = type;
        }

        function previewMmImage(url) {
            const wrap = document.getElementById('mm_image_preview');
            const img = document.getElementById('mm_preview_img');
            if (url && wrap && img) {
                img.src = url;
                wrap.style.display = 'block';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const imgInput = document.getElementById('mm_image_url');
            if (imgInput) imgInput.addEventListener('blur', () => previewMmImage(imgInput.value));
        });

        async function saveMultimediaProduct() {
            const actId = '<%= activity.id %>';
            const subject = '<%= activity.subject || activity.id %>';
            const product_type = document.getElementById('mm_product_type')?.value;
            if (!product_type) {
                document.getElementById('mmSaveStatus').innerHTML = '⚠️ Selecciona primero el tipo de producto';
                return;
            }
            const description = document.getElementById('mm_description')?.value || '';
            const link = document.getElementById('mm_link')?.value || '';
            const image_url = document.getElementById('mm_image_url')?.value || '';

            document.getElementById('mmSaveBtn').disabled = true;
            document.getElementById('mmSaveStatus').textContent = 'Guardando...';
            try {
                const res = await fetch('/api/student/multimedia-product', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ activity_id: actId, subject, product_type, description, link, image_url })
                });
                const result = await res.json();
                if (result.success) {
                    document.getElementById('mmSaveStatus').innerHTML = '✅ ¡Producto multimedia guardado exitosamente!';
                    if (image_url) previewMmImage(image_url);
                } else {
                    document.getElementById('mmSaveStatus').innerHTML = '❌ Error: ' + (result.message || 'No se pudo guardar');
                }
            } catch(e) {
                document.getElementById('mmSaveStatus').innerHTML = '❌ Error de conexión';
            }
            document.getElementById('mmSaveBtn').disabled = false;
        }
        
        // Funciones de cámara han sido eliminadas para utilizar el selector de avatares.
    

            
    

            window.toggleAccordionPanel = function(num) {
                const panels = document.querySelectorAll('.accordion-panel');
                panels.forEach(p => {
                    const pNum = parseInt(p.getAttribute('id').split('-')[1]);
                    const content = p.querySelector('.accordion-content');
                    const header = p.querySelector('.accordion-header');
                    const arrow = p.querySelector('.panel-arrow');
                    
                    if (pNum === num) {
                        const isVisible = content.style.display === 'block';
                        content.style.display = isVisible ? 'none' : 'block';
                        if (header) header.classList.toggle('active', !isVisible);
                        if (arrow) arrow.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(180deg)';
                    } else {
                        content.style.display = 'none';
                        if (header) header.classList.remove('active');
                        if (arrow) arrow.style.transform = 'rotate(0deg)';
                    }
                });
            };

            window.advanceAccordionPanel = function(num) {
                toggleAccordionPanel(num + 1);
                setTimeout(() => {
                    const nextHeader = document.querySelector(`#panel-${num + 1} .accordion-header`);
                    if (nextHeader) nextHeader.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 150);
            };

            window.saveProfileModule = async function(num, btnEl) {
                if (!btnEl) return;
                
                if (num === 2) {
                    const avatarVal = document.getElementById('profile_photo').value;
                    if (!avatarVal) {
                        alert('Por favor, selecciona un avatar primero.');
                        return;
                    }
                }

                const originalHtml = btnEl.innerHTML;
                btnEl.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';
                btnEl.disabled = true;

                const data = collectData();
                saveLocally();

                try {
                    const response = await fetch('/api/save/profile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const resData = await response.json();
                    if (resData.success) {
                        showToast('¡Módulo ' + num + ' guardado con éxito!', 'success');
                        
                        if (num === 2) {
                            const avatarVal = document.getElementById('profile_photo').value;
                            const headerAvatar = document.getElementById('headerUserAvatar');
                            if (headerAvatar && avatarVal) {
                                headerAvatar.innerHTML = avatarVal;
                                headerAvatar.style.fontSize = '1.1em';
                            }
                        }

                        if (num < 5) {
                            advanceAccordionPanel(num);
                        } else {
                            const successBanner = document.getElementById('reto0-success-banner');
                            if (successBanner) {
                                successBanner.style.display = 'block';
                                successBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                        }
                    } else {
                        showToast('Error al guardar el módulo.', 'error');
                    }
                } catch (e) {
                    console.error('Error saving profile module:', e);
                    showToast('Error de red. Intenta de nuevo.', 'error');
                } finally {
                    btnEl.innerHTML = originalHtml;
                    btnEl.disabled = false;
                }
            };
</script>
