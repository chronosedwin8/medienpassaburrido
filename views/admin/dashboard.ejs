        .year-current strong { font-size: 1.5em; color: #111; }
        .year-state { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 0.8em; font-weight: 700; background: #f1f1f1; color: #54595f; }
        .year-state.on { background: #111; color: #fff; }
        .year-add { display: flex; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-top: 18px; padding-top: 16px; border-top: 1px solid #e2e2e2; }
        .year-add label { display: grid; gap: 4px; font-size: 0.85em; font-weight: 700; color: #111; }
        .year-add input { width: 130px; padding: 9px 12px; border: 2px solid #e2e2e2; border-radius: 10px; font: inherit; font-size: 1em; }
        .year-add input:focus { border-color: #21529b; outline: none; }
        .year-add-preview { padding: 9px 0; color: #54595f; font-weight: 700; }
    </style>
    <%- include('../partials/brand-head') %>
</head>

<body>
    <%
    // Perfil de quien entró (services/access.js). Sin datos de acceso, el panel es de solo lectura.
    const panelAccess = locals.access || { role: 'coordinador', perms: {}, isDeveloper: false };
    const isDev = !!panelAccess.isDeveloper;
    %>
    <%- include('../partials/admin-sidebar') %>

    <div class="admin-container" data-profile="<%= panelAccess.role %>">
        <!-- ═══════════ MAIN TAB: CONTENIDOS GLOBALES ═══════════ -->
        <div class="tab-content active" id="maintab-contenidos">
            <div class="sub-nav no-print" style="display: none !important;">
                <button class="sub-nav-btn active" id="sub-btn-students" onclick="switchSub('students')"><span data-i18n="adm_estudiantes"><%= locals.t('adm_estudiantes') %></span></button>
            </div>


            <!-- ── SUB: ESTUDIANTES ── -->
            <div class="sub-section active" id="sub-students">
                <% if (!isDev) { %>
                    <p class="readonly-note"><i class="fas fa-eye"></i> <span data-i18n="adm_solo_lectura_estudiantes"><%= locals.t('adm_solo_lectura_estudiantes') %></span></p>
                <% } %>
                <% if (isDev) { %>
                <div class="admin-card">
                    <h2><i class="fas fa-user-plus"></i> <span data-i18n="adm_agregar_estudiantes_en_bloque"><%= locals.t('adm_agregar_estudiantes_en_bloque') %></span></h2>
                    <p style="color: #6b7280; font-size: 0.9em;"><span data-i18n="adm_ingresa_un_estudiante_por_linea_en"><%= locals.t('adm_ingresa_un_estudiante_por_linea_en') %></span> <strong><span data-i18n="adm_codigo_nombre_completo_clase"><%= locals.t('adm_codigo_nombre_completo_clase') %></span></strong> <span data-i18n="adm_ej_2401_juan_perez_garcia_4a"><%= locals.t('adm_ej_2401_juan_perez_garcia_4a') %></span></p>

                    <div class="bulk-form">
                        <textarea id="bulkInput" placeholder="2401, Juan Pérez García, 4A
2402, María López Martínez, 4A
2403, Carlos Rodríguez Díaz, 4B
2501, Ana Schmidt Mueller, 5A"></textarea>
                        <div>
                            <button class="btn btn-primary" onclick="bulkAddStudents()"><i class="fas fa-upload"></i>
                                <span data-i18n="adm_importar_estudiantes"><%= locals.t('adm_importar_estudiantes') %></span></button>
                        </div>
                    </div>
                </div>
                <% } %>

                <div class="admin-card">
                    <h2><i class="fas fa-list"></i> <span data-i18n="adm_estudiantes_registrados"><%= locals.t('adm_estudiantes_registrados') %></span></h2>
                    <div class="filter-bar">
                        <select id="filterClass" onchange="filterStudents()">
                            <option value="" data-i18n-option="adm_todas_las_clases"><%= locals.t('adm_todas_las_clases') %></option>
                            <% 
                               const uniqueClasses = [...new Set(students.map(s => s.class_name))].filter(Boolean).sort();
                               uniqueClasses.forEach(cls => { 
                            %>
                                <option value="<%= cls %>"><%= cls %></option>
                            <% }) %>
                        </select>
                        <% if (isDev) { %>
                        <input type="search" id="searchStudentCode" class="search-field" autocomplete="off" oninput="filterStudents()" placeholder="<%= locals.t('adm_buscar_por_codigo') %>" data-i18n-placeholder="adm_buscar_por_codigo" aria-label="<%= locals.t('adm_buscar_por_codigo') %>">
                        <% } %>
                        <input type="search" id="searchStudentNames" class="search-field" autocomplete="off" oninput="filterStudents()" placeholder="<%= locals.t('adm_buscar_por_nombre') %>" data-i18n-placeholder="adm_buscar_por_nombre" aria-label="<%= locals.t('adm_buscar_por_nombre') %>">
                        <input type="search" id="searchStudentSurnames" class="search-field" autocomplete="off" oninput="filterStudents()" placeholder="<%= locals.t('adm_buscar_por_apellidos') %>" data-i18n-placeholder="adm_buscar_por_apellidos" aria-label="<%= locals.t('adm_buscar_por_apellidos') %>">
                        <button type="button" class="search-clear" onclick="clearStudentSearch()"><i class="fas fa-eraser"></i> <span data-i18n="adm_limpiar_busqueda"><%= locals.t('adm_limpiar_busqueda') %></span></button>
                        <span id="studentCount" style="color: #6b7280; font-size: 0.9em;"></span>
                    </div>

                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th><span data-i18n="adm_n"><%= locals.t('adm_n') %></span></th>
                                <% if (isDev) { %><th><span data-i18n="adm_codigo"><%= locals.t('adm_codigo') %></span></th><% } %>
                                <th><span data-i18n="adm_nombre"><%= locals.t('adm_nombre') %></span></th>
                                <th><span data-i18n="adm_clase"><%= locals.t('adm_clase') %></span></th>
                                <th><span data-i18n="adm_creado"><%= locals.t('adm_creado') %></span></th>
                                <th><span data-i18n="adm_acciones"><%= locals.t('adm_acciones') %></span></th>
                            </tr>
                        </thead>
                        <tbody id="studentsTableBody">
                            <% students.forEach(s=> { const search = s.search || {}; %>
                                <tr data-class="<%= s.class_name %>" data-id="<%= s.id %>" data-search-code="<%= isDev ? (search.code || '') : '' %>" data-search-names="<%= search.names || '' %>" data-search-surnames="<%= search.surnames || '' %>">
                                    <td><strong><%= s.list_number || '—' %></strong></td>
                                    <% if (isDev) { %>
                                    <td>
                                        <%= s.student_code || '—' %>
                                    </td>
                                    <% } %>
                                    <td><strong>
                                            <%= s.full_name || s.username %>
                                        </strong></td>
                                    <td><span class="count-badge">
                                            <%= s.class_name %>
                                        </span></td>
                                    <td>
                                        <%= s.created_at ? new Date(s.created_at).toLocaleDateString(locals.t('adm_js_locale')) : '—' %>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm" style="background:#8b5cf6;color:white;margin-right:4px;" onclick="viewStudentProfile('<%= s.id %>')" title="<%= locals.t('adm_ver_perfil') %>" data-i18n-title="adm_ver_perfil"><i class="fas fa-eye"></i></button>
                                        <% if (isDev) { %><button class="btn btn-danger btn-sm" onclick="deleteStudent('<%= s.id %>')"><i class="fas fa-trash"></i></button><% } %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <p id="studentsEmpty" class="search-empty" hidden><span data-i18n="adm_sin_resultados_busqueda"><%= locals.t('adm_sin_resultados_busqueda') %></span></p>
                    <div id="paginationControls"
                        style="display: flex; justify-content: center; align-items: center; margin-top: 20px; gap: 10px;">
                    </div>
                </div>
            </div>

            <!-- ── SUB: DOCENTES ── -->
            <div class="sub-section" id="sub-teachers">
                <div class="admin-card">
                    <h2><i class="fas fa-user-tie"></i> <span data-i18n="adm_docentes_registrados"><%= locals.t('adm_docentes_registrados') %></span></h2>
                    <p style="color: #6b7280; font-size: 0.9em;"><span data-i18n="adm_docentes_ayuda_busqueda"><%= locals.t('adm_docentes_ayuda_busqueda') %></span></p>
                    <div class="filter-bar">
                        <input type="search" id="searchTeacherNames" class="search-field" autocomplete="off" oninput="renderTeachers()" placeholder="<%= locals.t('adm_buscar_por_nombre') %>" data-i18n-placeholder="adm_buscar_por_nombre" aria-label="<%= locals.t('adm_buscar_por_nombre') %>">
                        <input type="search" id="searchTeacherSurnames" class="search-field" autocomplete="off" oninput="renderTeachers()" placeholder="<%= locals.t('adm_buscar_por_apellidos') %>" data-i18n-placeholder="adm_buscar_por_apellidos" aria-label="<%= locals.t('adm_buscar_por_apellidos') %>">
                        <% if (isDev) { %>
                        <input type="search" id="searchTeacherDoc" class="search-field" autocomplete="off" inputmode="numeric" oninput="renderTeachers()" placeholder="<%= locals.t('adm_buscar_por_documento') %>" data-i18n-placeholder="adm_buscar_por_documento" aria-label="<%= locals.t('adm_buscar_por_documento') %>">
                        <% } %>
                        <button type="button" class="search-clear" onclick="clearTeacherSearch()"><i class="fas fa-eraser"></i> <span data-i18n="adm_limpiar_busqueda"><%= locals.t('adm_limpiar_busqueda') %></span></button>
                        <span id="teacherCount" style="color: #6b7280; font-size: 0.9em;"></span>
                    </div>
                    <p id="teachersLoading" style="color:#64748b;" hidden><i class="fas fa-spinner fa-spin"></i> <span data-i18n="adm_cargando"><%= locals.t('adm_cargando') %></span></p>
                    <div style="overflow-x: auto;">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th><span data-i18n="adm_n"><%= locals.t('adm_n') %></span></th>
                                    <th><span data-i18n="adm_apellidos"><%= locals.t('adm_apellidos') %></span></th>
                                    <th><span data-i18n="adm_nombres"><%= locals.t('adm_nombres') %></span></th>
                                    <% if (isDev) { %><th><span data-i18n="adm_documento"><%= locals.t('adm_documento') %></span></th><% } %>
                                    <th><span data-i18n="adm_email"><%= locals.t('adm_email') %></span></th>
                                    <th><span data-i18n="adm_materia_docente"><%= locals.t('adm_materia_docente') %></span></th>
                                    <th><span data-i18n="adm_rol_docente"><%= locals.t('adm_rol_docente') %></span></th>
                                    <th><span data-i18n="adm_ind_segmento"><%= locals.t('adm_ind_segmento') %></span></th>
                                    <th><span data-i18n="<%= isDev ? 'adm_acciones' : 'adm_tc_capacitacion' %>"><%= locals.t(isDev ? 'adm_acciones' : 'adm_tc_capacitacion') %></span></th>
                                </tr>
                            </thead>
                            <tbody id="teachersTableBody"></tbody>
                        </table>
                    </div>
                    <p id="teachersEmpty" class="search-empty" hidden><span data-i18n="adm_sin_resultados_busqueda"><%= locals.t('adm_sin_resultados_busqueda') %></span></p>
                </div>

                <% if (isDev) { %>
                <div class="admin-card">
                    <h2><i class="fas fa-database"></i> <span data-i18n="adm_editor_de_base_de_datos"><%= locals.t('adm_editor_de_base_de_datos') %></span></h2>
                    <p style="color: #6b7280; font-size: 0.9em;"><span data-i18n="adm_consulta_y_edita_registros"><%= locals.t('adm_consulta_y_edita_registros') %></span></p>
                    <div style="display:flex; gap:10px; flex-wrap:wrap; margin: 12px 0;">
                        <button class="btn btn-primary" onclick="loadDbTable('students')"><i class="fas fa-users"></i> <span data-i18n="adm_estudiantes"><%= locals.t('adm_estudiantes') %></span></button>
                        <button class="btn btn-primary" onclick="loadDbTable('teachers')"><i class="fas fa-chalkboard-teacher"></i> <span data-i18n="adm_docentes"><%= locals.t('adm_docentes') %></span></button>
                        <button class="btn" style="background:#fbbf24; color:#fff;" onclick="loadPendingTeachers()"><i class="fas fa-user-clock"></i> <span data-i18n="adm_solicitudes_registro"><%= locals.t('adm_solicitudes_registro') %></span></button>
                        <button class="btn btn-success" id="dbAddBtn" style="display:none;" onclick="openDbAdd()"><i class="fas fa-plus"></i> <span data-i18n="adm_agregar_nuevo"><%= locals.t('adm_agregar_nuevo') %></span></button>
                        <button class="btn btn-danger btn-sm" id="dbCancelEdit" style="display:none;" onclick="cancelDbEdit()"><i class="fas fa-times"></i> <span data-i18n="adm_cancelar_edicion_creacion"><%= locals.t('adm_cancelar_edicion_creacion') %></span></button>
                    </div>
                    <div id="dbLoadingMsg" style="display:none; text-align:center; padding:20px;"><i class="fas fa-spinner fa-spin"></i> <span data-i18n="adm_cargando_tabla"><%= locals.t('adm_cargando_tabla') %></span></div>
                    <div id="dbEditorArea" style="display:none;">
                        <div style="margin-bottom:10px; font-weight:bold; color: var(--admin-primary);" id="dbTableTitle"></div>
                        <div style="overflow-x:auto;">
                            <table class="admin-table" id="dbTable" style="min-width:600px;">
                                <thead id="dbTableHead"></thead>
                                <tbody id="dbTableBody"></tbody>
                            </table>
                        </div>
                        <div id="dbEditForm" style="display:none; margin-top:20px; padding:20px; background:#f8fafc; border-radius:10px; border:1px solid #cbd5e1;">
                            <h3 id="dbEditTitle" style="margin:0 0 16px;"><i class="fas fa-edit"></i> <span data-i18n="adm_editar_registro"><%= locals.t('adm_editar_registro') %></span></h3>
                            <div id="dbEditFields" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap:14px;"></div>
                            <div style="margin-top:16px; display:flex; gap:10px;">
                                <button class="btn btn-success" onclick="saveDbRecord()"><i class="fas fa-save"></i> <span data-i18n="adm_guardar_en_bd"><%= locals.t('adm_guardar_en_bd') %></span></button>
                                <button class="btn btn-danger btn-sm" onclick="cancelDbEdit()"><i class="fas fa-times"></i> <span data-i18n="adm_cancelar"><%= locals.t('adm_cancelar') %></span></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Solicitudes de Registro (Oculto por defecto) -->
                <div class="admin-card" id="pendingTeachersPanel" style="display:none; border-left: 4px solid #fbbf24;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <h2><i class="fas fa-user-clock" style="color: #fbbf24;"></i> <span data-i18n="adm_solicitudes_de_registro_docentes"><%= locals.t('adm_solicitudes_de_registro_docentes') %></span></h2>
                        <button class="btn btn-danger btn-sm" onclick="document.getElementById('pendingTeachersPanel').style.display='none'"><i class="fas fa-times"></i> <span data-i18n="adm_cerrar"><%= locals.t('adm_cerrar') %></span></button>
                    </div>
                    <p style="color: #6b7280; font-size: 0.9em;"><span data-i18n="adm_estos_docentes_se_han_registrado_en"><%= locals.t('adm_estos_docentes_se_han_registrado_en') %></span></p>
                    <div id="pendingLoading" style="text-align:center; padding:15px; display:none;"><i class="fas fa-spinner fa-spin"></i> <span data-i18n="adm_cargando"><%= locals.t('adm_cargando') %></span></div>
                    <div style="overflow-x: auto;">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th><span data-i18n="adm_fecha"><%= locals.t('adm_fecha') %></span></th>
                                    <th><span data-i18n="adm_documento"><%= locals.t('adm_documento') %></span></th>
                                    <th><span data-i18n="adm_nombres"><%= locals.t('adm_nombres') %></span></th>
                                    <th><span data-i18n="adm_apellidos"><%= locals.t('adm_apellidos') %></span></th>
                                    <th><span data-i18n="adm_email"><%= locals.t('adm_email') %></span></th>
                                    <th><span data-i18n="adm_materia_docente"><%= locals.t('adm_materia_docente') %></span></th>
                                    <th><span data-i18n="adm_acciones"><%= locals.t('adm_acciones') %></span></th>
                                </tr>
                            </thead>
                            <tbody id="pendingTeachersBody"></tbody>
                        </table>
                    </div>
                </div>
                <% } %>
            </div>

            <% if (isDev) { %>
            <!-- ── SUB: CONFIGURACIÓN ── -->
            <div class="sub-section" id="sub-config">
                <div class="admin-card">
                    <h2><i class="fas fa-book"></i> <span data-i18n="adm_configuracion_de_asignaturas_por"><%= locals.t('adm_configuracion_de_asignaturas_por') %></span></h2>
                    <p style="color: #6b7280; font-size: 0.9em;"><span data-i18n="adm_selecciona_las_asignaturas_que_se"><%= locals.t('adm_selecciona_las_asignaturas_que_se') %></span></p>

                    <div style="overflow-x: auto;">
                        <table class="admin-table" id="subjectConfigTable">
                            <thead>
                                <tr>
                                    <th style="min-width:90px; position:sticky; left:0; background:#f8fafc; z-index:1">
                                        Klasse</th>
                                    <% subjects.forEach(s=> { %>
                                        <th style="text-align:center; min-width:80px;">
                                            <span style="font-size:1.3em">
                                                <%= s.icon %>
                                            </span><br>
                                            <span style="font-size:0.7em; color:#475569" data-lang-content="<%= JSON.stringify(s.name) %>">
                                                <%= s.name[lang] || s.name.es %>
                                            </span><br>
                                            <button class="btn btn-sm" onclick="toggleAllForSubject('<%= s.id %>')"
                                                style="margin-top:4px; font-size:0.6em; padding:2px 5px; background:<%= s.color %>; color:white; border:none; border-radius:5px; cursor:pointer; opacity:0.85;"
                                                title="<%= locals.t('adm_toggle_subject_all') %>: <%= s.name[lang] || s.name.es %>">
                                                ✓ K1-K6
                                            </button>
                                        </th>
                                        <% }) %>
                                            <th style="text-align:center">Klasse</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% uniqueClasses.forEach(cls => { %>
                                        <tr>
                                            <td style="position:sticky; left:0; background:#fff; z-index:1;">
                                                <strong style="color:#4338ca" translate="no" class="notranslate">Klasse <%= cls %></strong>
                                            </td>
                                            <% subjects.forEach(s=> { %>
                                                <td style="text-align:center">
                                                    <label class="sc-toggle">
                                                        <input type="checkbox" class="sc-cb"
                                                            data-klasse="<%= cls %>" data-subject="<%= s.id %>">
                                                        <span class="sc-slider" style="--sc-color: <%= s.color %>"></span>
                                                    </label>
                                                </td>
                                                <% }) %>
                                                    <td style="text-align:center">
                                                        <button class="btn btn-sm btn-primary"
                                                            onclick="toggleAllForKlasse('<%= cls %>')">
                                                            <span data-i18n="adm_all"><%= locals.t('adm_all') %></span>
                                                        </button>
                                                    </td>
                                        </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <div style="margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap;">
                        <button class="btn btn-success" onclick="saveSubjectConfig()">
                            <i class="fas fa-save"></i> <span data-i18n="adm_guardar_configuracion"><%= locals.t('adm_guardar_configuracion') %></span>
                        </button>
                        <button class="btn btn-primary" onclick="selectAllGlobal()">
                            <i class="fas fa-check-double"></i> <span data-i18n="adm_seleccionar_todo"><%= locals.t('adm_seleccionar_todo') %></span>
                        </button>
                        <button class="btn btn-danger" onclick="deselectAllGlobal()">
                            <i class="fas fa-times"></i> <span data-i18n="adm_deseleccionar_todo"><%= locals.t('adm_deseleccionar_todo') %></span>
                        </button>
                    </div>
                </div>

                <!-- KMK Levels / Retos Config -->
                <div class="admin-card">
                    <h2><i class="fas fa-layer-group"></i> <span data-i18n="adm_configuracion_de_retos_niveles_kmk"><%= locals.t('adm_configuracion_de_retos_niveles_kmk') %></span></h2>
                    <p style="color: #6b7280; font-size: 0.9em;"><span data-i18n="adm_selecciona_los_retos_niveles_kmk"><%= locals.t('adm_selecciona_los_retos_niveles_kmk') %></span></p>

                    <div style="overflow-x: auto;">
                        <table class="admin-table" id="levelConfigTable">
                            <thead>
                                <tr>
                                    <th style="min-width:90px; position:sticky; left:0; background:#f8fafc; z-index:1">
                                        Klasse</th>
                                    <% levels.forEach(lvl=> { %>
                                        <th style="text-align:center; min-width:80px;">
                                            <span style="font-size:1.3em">
                                                <%= lvl.icon %>
                                            </span><br>
                                            <span style="font-size:0.7em; color:#475569"><span data-i18n="adm_reto"><%= locals.t('adm_reto') %></span> <%= lvl.id %></span><br>
                                            <button class="btn btn-sm" onclick="toggleAllForLevel('<%= lvl.id %>')"
                                                style="margin-top:4px; font-size:0.6em; padding:2px 5px; background:<%= lvl.color %>; color:white; border:none; border-radius:5px; cursor:pointer; opacity:0.85;"
                                                title="Activar/desactivar Reto <%= lvl.id %> en todas las Klassen">
                                                ✓ K1-K6
                                            </button>
                                        </th>
                                        <% }) %>
                                            <th style="text-align:center">Klasse</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% uniqueClasses.forEach(cls => { %>
                                        <tr>
                                            <td style="position:sticky; left:0; background:#fff; z-index:1;">
                                                <strong style="color:#4338ca" translate="no" class="notranslate">Klasse <%= cls %></strong>
                                            </td>
                                            <% levels.forEach(lvl=> { %>
                                                <td style="text-align:center">
                                                    <label class="sc-toggle">
                                                        <input type="checkbox" class="lc-cb" data-klasse="<%= cls %>"
                                                            data-level="<%= lvl.id %>">
                                                        <span class="sc-slider" style="--sc-color: <%= lvl.color %>"></span>
                                                    </label>
                                                </td>
                                                <% }) %>
                                                    <td style="text-align:center">
                                                        <button class="btn btn-sm btn-primary"
                                                            onclick="toggleAllLevelsForKlasse('<%= cls %>')">
                                                            <span data-i18n="adm_all"><%= locals.t('adm_all') %></span>
                                                        </button>
                                                    </td>
                                        </tr>
                                <% }) %>
                            </tbody>
                        </table>
