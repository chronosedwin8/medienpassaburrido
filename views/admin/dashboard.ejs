        // Toggle ALL Klassen for a specific subject (column toggle)
        function toggleAllForSubject(subjectId) {
            const cbs = document.querySelectorAll(`.sc-cb[data-subject="${subjectId}"]`);
            const allChecked = [...cbs].every(cb => cb.checked);
            cbs.forEach(cb => cb.checked = !allChecked);
        }

        function selectAllGlobal() {
            document.querySelectorAll('.sc-cb').forEach(cb => cb.checked = true);
