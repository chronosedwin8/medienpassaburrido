        async function loadPspMatrix() {
            const table = document.getElementById('pspMatrixTable');
            const thead = document.getElementById('pspMatrixHeader');
            const tbody = document.getElementById('pspMatrixBody');
            const loading = document.getElementById('pspMatrixLoading');

            table.style.display = 'none';
            loading.style.display = 'block';
            loading.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + window.t('adm_cargando_matriz_global');

            try {
                const res = await fetch('/api/admin/psp-matrix');
                const result = await res.json();

                loading.style.display = 'none';
                if (result.success && result.matrix) {
                    table.style.display = 'table';
                    const subjectsList = <%- JSON.stringify(subjects) %>;
                    
                    // Header
                    let thHtml = '<th>Klasse</th>';
                    subjectsList.forEach(s => {
                        thHtml += `<th style="text-align:center;">${s.icon} <br/> <small>${s.name[window.langUtils.getLang()] || s.name.es}</small></th>`;
                    });
                    thead.innerHTML = thHtml;

                    // Body
                    let tbHtml = '';
                    Object.keys(result.matrix).sort().forEach(className => {
                        tbHtml += `<tr><td><strong>${className}</strong></td>`;
                        subjectsList.forEach(s => {
                            const data = result.matrix[className][s.id];
                            if(data && data.studentCount > 0) {
                                let colors = '#ef4444'; 
                                if(data.avg > 30) colors = '#f59e0b';
                                if(data.avg > 70) colors = '#10b981';
                                tbHtml += `<td style="text-align:center; font-weight:bold; color: ${colors}">${data.avg}%<br/><small style="color:#64748b;font-weight:normal;">(${data.studentCount} ${window.t('adm_js_est_abrev')})</small></td>`;
                            } else {
                                tbHtml += `<td style="text-align:center; color:#cbd5e1;">—</td>`;
                            }
                        });
                        tbHtml += `</tr>`;
                    });
                    tbody.innerHTML = tbHtml;
                } else {
                    loading.style.display = 'block';
                    loading.innerHTML = '<span style="color:red">' + window.t('adm_js_error_matriz') + '</span>';
                }
            } catch(e) {
                loading.style.display = 'block';
                loading.innerHTML = '<span style="color:red">' + window.t('adm_error_de_conexion') + '</span>';
            }
        }
        
        loadPspMatrix();

        // ── PSP Indicators ──
        async function loadPspIndicators() {
            const cls = document.getElementById('pspClassFilter').value;
            if (!cls) return showToast(window.t('adm_selecciona_una_clase_primero'), true);

            const tbody = document.getElementById('pspTableBody');
            const avgDiv = document.getElementById('pspClassAvg');
            const table = document.getElementById('pspTable');

            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;"><i class="fas fa-spinner fa-spin"></i> ' + window.t('adm_js_cargando_indicadores') + '</td></tr>';
            table.style.display = 'table';
            avgDiv.innerHTML = '';

            try {
                const res = await fetch('/api/admin/psp-indicators/' + cls);
                const result = await res.json();

                if (result.success && result.students) {
                    if (result.students.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">' + window.t('adm_js_no_hay_estudiantes_clase') + '</td></tr>';
                        return;
                    }

                    let html = '';
                    let totalProgress = 0;

                    result.students.forEach(s => {
                        totalProgress += s.progress;

                        // Progress bar building
                        let barColor = '#ef4444'; // red
                        if (s.progress > 30) barColor = '#f59e0b'; // orange
                        if (s.progress > 70) barColor = '#10b981'; // green

                        const progressBar = `
                            <div style="background: #e2e8f0; border-radius: 10px; height: 12px; width: 100%; overflow: hidden; margin-top: 5px;">
                                <div style="background: ${barColor}; height: 100%; width: ${s.progress}%; transition: 0.5s;"></div>
                            </div>
                        `;

                        // Teacher status text formatting
                        let evalBadge = s.evaluation_passed
                            ? '<span style="color:#059669;font-weight:bold;"><i class="fas fa-check-circle"></i> ' + window.t('adm_js_aprobado') + '</span>'
                            : '<span style="color:#ef4444;"><i class="fas fa-times-circle"></i> ' + window.t('adm_js_pendiente') + '</span>';

                        if (s.teacher === 'Sin asigar') evalBadge = '<span style="color:#94a3b8;">—</span>';

                        html += `
                            <tr>
                                <td><strong>${escapeHtml(s.name)}</strong></td>
                                <td>${escapeHtml(s.teacher)}</td>
                                <td>${evalBadge}</td>
                                <td><span class="count-badge">${s.retosCompleted} / 6</span></td>
                                <td style="width: 200px;">
                                    <div style="font-size: 0.8em; font-weight: bold; text-align: right; color: ${barColor}">${s.progress}%</div>
                                    ${progressBar}
                                </td>
                            </tr>
                        `;
                    });

                    tbody.innerHTML = html;
                    const avgProgress = Math.round(totalProgress / result.students.length);
                    avgDiv.innerHTML = `<i class="fas fa-chart-pie"></i> ${window.t('adm_js_promedio_cumplimiento')} ${cls}: ${avgProgress}%`;
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:red;">' + window.t('adm_js_error_cargar_datos') + '</td></tr>';
                }
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:red;">' + window.t('adm_error_de_conexion') + '</td></tr>';
            }
        }

