            document.querySelectorAll('.sc-cb').forEach(cb => cb.checked = false);
        }

        async function saveSubjectConfig() {
            const config = {};
            document.querySelectorAll('.sc-cb').forEach(cb => {
                const klasse = cb.getAttribute('data-klasse');
                const subject = cb.getAttribute('data-subject');
                if (!config[klasse]) config[klasse] = {};
                config[klasse][subject] = cb.checked;
            });

            try {
                const res = await fetch('/api/admin/subject-config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(config)
                });
                const result = await res.json();
                if (result.success) {
                    showToast(window.t('adm_configuracion_de_asignaturas'));
                } else {
                    showToast(window.t('adm_error') + (result.message || 'Error desconocido'), true);
                }
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        async function loadSubjectConfig() {
            try {
                const res = await fetch('/api/admin/subject-config');
                const result = await res.json();
                if (result.success && result.config) {
                    Object.entries(result.config).forEach(([klasse, subjects]) => {
                        Object.entries(subjects).forEach(([subject, enabled]) => {
                            const cb = document.querySelector(`.sc-cb[data-klasse="${klasse}"][data-subject="${subject}"]`);
                            if (cb) cb.checked = enabled;
                        });
                    });
                }
            } catch (e) { /* config not saved yet */ }
        }

        // Load saved subject config on page load (la tabla de Configuración es del desarrollador)
        if (IS_DEV) loadSubjectConfig();

