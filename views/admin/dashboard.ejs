        async function saveDbRecord() {
            if (!dbCurrentTable) return;
            const updates = {};
            document.querySelectorAll('#dbEditFields input[data-field]').forEach(inp => {
                const field = inp.getAttribute('data-field');
                if (!['id','created_at','updated_at'].includes(field)) {
                    updates[field] = inp.value;
                }
            });

            // Si es la tabla teachers, normalizar el correo y autocompletar id/subject si es nuevo
            if (dbCurrentTable === 'teachers') {
                if (updates.email) {
                    updates.email = updates.email.trim().toLowerCase();
                }
                if (!dbEditingRecord) {
                    updates.id = 'teacher_' + (updates.email || '');
                    updates.subject = '';
                }
            }

            // Si es teachers, guardar el rol extra
            if (dbCurrentTable === 'teachers') {
                const roleSelect = document.getElementById('dbedit_extra_role');
                const targetEmail = (updates.email || '').trim().toLowerCase();
                if (roleSelect && targetEmail) {
                    try {
                        await fetch('/api/admin/teacher-roles', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ email: targetEmail, role: roleSelect.value })
                        });
                        adminTeacherRolesMap[targetEmail] = roleSelect.value;
                    } catch(e){}
                }
            }

            try {
                let url = `/api/admin/db-records/${dbCurrentTable}`;
                if (dbEditingRecord) {
                    url += '/' + dbEditingRecord.id;
                }
                
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updates)
                });
                const result = await res.json();
                if (result.success) {
                    showToast(dbEditingRecord ? window.t('adm_js_registro_actualizado') : window.t('adm_js_registro_creado'));
                    cancelDbEdit();
                    loadDbTable(dbCurrentTable);
                    if (dbCurrentTable === 'teachers') loadTeachersList(); // la lista de arriba
                } else {
                    showToast(window.t('adm_error') + result.message, true);
                }
            } catch(e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        function cancelDbEdit() {
            dbEditingRecord = null;
            document.getElementById('dbEditForm').style.display = 'none';
            document.getElementById('dbCancelEdit').style.display = 'none';
        }

        // ── Mapeo de profesores: tabla clase × materia, editable fila por fila ──
        // El filtro abre en Alemán. Al editar, cada celda ofrece los nombres de la tabla de docentes
        // y los que ya están en el mapeo; una celda vacía quita al docente de esa materia.
        let teacherMapping = null; // { "KLASSE 6 (K6A)": { aleman: "NOMBRE" } }
        let tmEditingClass = null;

        function enterTeacherMapping() {
            if (!teacherSubjectsData) loadTeacherSubjects();
            if (!teacherMapping) loadTeacherMapping();
        }

        // ── Asignatura de cada docente (la que usan los informes por materia) ──
        // Lista de docentes registrados: su asignatura se corrige aquí (o se asigna si no tiene) y se
        // compara con lo que dice el mapeo por clase.
        let teacherSubjectsData = null;
        async function loadTeacherSubjects() {
            try {
                const data = await (await fetch('/api/admin/teacher-subjects')).json();
                teacherSubjectsData = data.success ? data : { error: true };
            } catch (e) {
                teacherSubjectsData = { error: true };
            }
            renderTeacherSubjects();
        }

        function renderTeacherSubjects() {
            const out = document.getElementById('tsOutput');
            const data = teacherSubjectsData;
            if (!out || !data) return;
            if (data.error) { out.innerHTML = `<p style="color:#b91c1c;">${escapeHtml(window.t('adm_error_de_conexion'))}</p>`; return; }
            const T = key => escapeHtml(window.t(key));
            const list = data.teachers || [];
            const noSubject = list.filter(t => !t.subject).length;
            const mismatch = list.filter(t => t.mismatch).length;
            document.getElementById('tsSummary').innerHTML =
                `<div class="tc-stat"><i class="fas fa-user-tie"></i><strong>${list.length}</strong><span>${T('adm_tc_docentes')}</span></div>`
                + `<div class="tc-stat warn"><i class="fas fa-circle-question"></i><strong>${noSubject}</strong><span>${T('adm_ts_sin_asignatura')}</span></div>`
                + `<div class="tc-stat warn"><i class="fas fa-shuffle"></i><strong>${mismatch}</strong><span>${T('adm_pt_no_coinciden')}</span></div>`
                + (data.mappingChanges > 0 ? `<div class="pt-apply"><button type="button" class="btn btn-primary" onclick="applyMappingSubjects(${Number(data.mappingChanges)})"><i class="fas fa-wand-magic-sparkles"></i> ${escapeHtml(window.t('adm_pt_aplicar_mapeo').replace('{n}', data.mappingChanges))}</button></div>` : '');

            const filter = document.getElementById('tsFilter').value;
            const subject = document.getElementById('tsSubject').value;
            const query = searchValue('tsSearch');
            const rows = list.filter(t => (filter === 'none' ? !t.subject : filter === 'mismatch' ? t.mismatch : true)
                && (!subject || t.subject === subject)
                && matchesWords(normalizeSearch(`${t.name} ${t.email}`), query));
            if (!rows.length) { out.innerHTML = `<p class="cert-empty">${T('adm_sin_resultados_busqueda')}</p>`; return; }
            const subjectName = id => (id ? escapeHtml(certSubjectLabel(id)) : '—');
            out.innerHTML = `<div class="snp-table-wrap"><table class="pt-table"><thead><tr><th>#</th><th>${T('adm_js_docente')}</th><th>${T('adm_ts_asignatura')}</th><th>${T('adm_pt_segun_mapeo')}</th><th>${T('adm_acciones')}</th></tr></thead><tbody>`
                + rows.map((t, i) => {
                    const options = TEACHER_SUBJECTS.map(s => `<option value="${escapeHtml(s.id)}" ${s.id === t.subject ? 'selected' : ''}>${escapeHtml(certSubjectLabel(s.id))}</option>`).join('');
                    const empty = t.subject ? '' : `<option value="" selected>${T('adm_ts_elegir')}</option>`;
                    const flag = !t.subject ? ` <span class="tc-badge warn">${T('adm_ts_sin_asignatura')}</span>`
                        : t.mismatch ? ` <span class="tc-badge warn" title="${T('adm_pt_no_coincide_ayuda')}">${T('adm_pt_no_coincide')}</span>` : '';
                    const use = t.suggested ? ` <button type="button" class="pt-btn" onclick="saveTeacherSubject('${escapeHtml(t.id)}', '${escapeHtml(t.suggested)}')"><i class="fas fa-wand-magic-sparkles"></i> ${T('adm_pt_usar_mapeo')}: ${subjectName(t.suggested)}</button>` : '';
                    const chips = t.mapped.length
                        ? t.mapped.map(m => `<span class="tc-chip ${m.subject === t.subject ? 'ok' : 'warn'}" title="${escapeHtml(m.classes.join(', '))}">${subjectName(m.subject)} · ${escapeHtml(m.classes.join(', '))}</span>`).join(' ')
                        : `<span style="color:#94a3b8;">${T('adm_pt_no_en_mapeo')}</span>`;
                    return `<tr>
                        <td>${i + 1}</td>
                        <td><strong>${escapeHtml(t.name)}</strong>${t.email ? `<br><small style="color:#64748b;">${escapeHtml(t.email)}</small>` : ''}</td>
                        <td><div class="pt-subject"><select aria-label="${T('adm_ts_asignatura')}" onchange="saveTeacherSubject('${escapeHtml(t.id)}', this.value)">${empty}${options}</select>${flag}${use}</div></td>
                        <td class="tc-chips">${chips}</td>
                        <td class="tchr-actions-cell">${teacherActions(t)}</td>
                    </tr>`;
                }).join('') + '</tbody></table></div>';
        }

        async function saveTeacherSubject(id, subject) {
            if (!subject) return;
            try {
                const result = await (await fetch('/api/admin/teachers/' + encodeURIComponent(id) + '/subject', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ subject })
                })).json();
                if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                showToast(window.t('adm_pt_materia_guardada'));
                await loadTeacherSubjects();
                teacherRows = null; // la lista de Docentes se vuelve a cargar con la asignatura nueva
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        // Todas las clases (las de los estudiantes y las de Configuración) aparecen en la tabla, aunque
        // aún no tengan docentes; las filas vacías no se guardan.
        function mappingClassId(key) {
            const m = /\(([^)]+)\)/.exec(key || '');
            return (m ? m[1] : String(key || '')).toUpperCase().replace(/\s+/g, '');
        }
        function withAllClasses(config) {
            const result = { ...(config || {}) };
            const present = new Set(Object.keys(result).map(mappingClassId));
            (window.MAPPING_CLASSES || []).forEach(key => {
                if (!present.has(mappingClassId(key))) result[key] = {};
            });
            return result;
        }

        async function loadTeacherMapping() {
            const loading = document.getElementById('tmLoading');
            loading.style.display = 'block';
            tmEditingClass = null;
            try {
                const [mapping, teachers] = await Promise.all([
                    fetch('/api/admin/teacher-mapping').then(r => r.json()),
                    teacherRows ? Promise.resolve({ success: true, teachers: teacherRows }) : fetch('/api/admin/teachers').then(r => r.json()).catch(() => ({ teachers: [] }))
                ]);
                if (!mapping.success) throw new Error(mapping.message || '');
                teacherMapping = withAllClasses(mapping.config);
                const names = new Set();
                (teachers.teachers || []).forEach(t => {
                    const name = [t.first_name, t.last_name].filter(Boolean).join(' ').trim();
                    if (name) names.add(name.toUpperCase());
                });
                Object.values(teacherMapping).forEach(row => Object.values(row).forEach(n => names.add(n)));
                document.getElementById('tmTeacherNames').innerHTML = [...names].sort((a, b) => a.localeCompare(b, 'es'))
                    .map(n => `<option value="${escapeHtml(n)}">`).join('');
                renderTeacherMapping();
            } catch (e) {
                showToast(window.t('adm_error_de_conexion_al_cargar_mapeo'), true);
            } finally {
                loading.style.display = 'none';
            }
        }

        function mappingSubjects() {
            const filter = document.getElementById('tmSubjectFilter').value;
            return filter ? TEACHER_SUBJECTS.filter(s => s.id === filter) : TEACHER_SUBJECTS;
        }

        function renderTeacherMapping() {
            if (!teacherMapping) return;
            const cols = mappingSubjects();
            const query = searchValue('tmClassSearch');
            document.getElementById('tmTableHead').innerHTML = `<tr><th>${escapeHtml(window.t('adm_clase'))}</th>
                ${cols.map(s => `<th>${escapeHtml(certSubjectLabel(s.id))}</th>`).join('')}<th>${escapeHtml(window.t('adm_acciones'))}</th></tr>`;
            const classes = Object.keys(teacherMapping).sort((a, b) => a.localeCompare(b, 'es', { numeric: true }))
                .filter(cls => cls === tmEditingClass || matchesWords(normalizeSearch(cls + ' ' + cols.map(s => teacherMapping[cls][s.id] || '').join(' ')), query));
            document.getElementById('tmTableBody').innerHTML = classes.map(cls => {
                const row = teacherMapping[cls];
                const editing = cls === tmEditingClass;
                const cells = cols.map(s => editing
                    ? `<td><input type="text" list="tmTeacherNames" data-subject="${s.id}" value="${escapeHtml(row[s.id] || '')}" aria-label="${escapeHtml(certSubjectLabel(s.id))}"></td>`
                    : `<td>${row[s.id] ? escapeHtml(row[s.id]) : '<span class="tm-empty">—</span>'}</td>`).join('');
                const actions = editing
                    ? `<button type="button" class="btn btn-sm btn-success" onclick="saveMappingRow()"><i class="fas fa-save"></i> ${escapeHtml(window.t('adm_guardar'))}</button>
                       <button type="button" class="btn btn-sm btn-light" onclick="cancelMappingRow()"><i class="fas fa-times"></i> ${escapeHtml(window.t('adm_cancelar'))}</button>`
                    : `<button type="button" class="btn btn-sm btn-edit" data-class="${escapeHtml(cls)}" onclick="editMappingRow(this.dataset.class)" ${tmEditingClass ? 'disabled' : ''}><i class="fas fa-pen"></i> ${escapeHtml(window.t('adm_editar'))}</button>`;
                return `<tr class="${editing ? 'editing' : ''}" data-class="${escapeHtml(cls)}"><td><strong class="notranslate" translate="no">${escapeHtml(cls)}</strong></td>${cells}<td><div class="row-actions">${actions}</div></td></tr>`;
            }).join('') || `<tr><td colspan="${cols.length + 2}" class="cert-empty">${escapeHtml(window.t('adm_sin_resultados_busqueda'))}</td></tr>`;
        }

        function editMappingRow(cls) {
            tmEditingClass = cls;
            renderTeacherMapping();
            const first = document.querySelector('#tmTableBody tr.editing input');
            if (first) first.focus();
        }

        function cancelMappingRow() {
            tmEditingClass = null;
            renderTeacherMapping();
        }

        async function saveMappingRow() {
            const cls = tmEditingClass;
            if (!cls) return;
            const row = { ...teacherMapping[cls] };
            document.querySelectorAll('#tmTableBody tr.editing input[data-subject]').forEach(input => {
                const name = input.value.trim().replace(/\s+/g, ' ');
                if (name) row[input.dataset.subject] = name;
                else delete row[input.dataset.subject];
            });
            const config = Object.fromEntries(Object.entries({ ...teacherMapping, [cls]: row }).filter(([, r]) => Object.keys(r).length));
            try {
                const result = await (await fetch('/api/admin/teacher-mapping', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(config)
                })).json();
                if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                teacherMapping = withAllClasses(result.config || config);
                tmEditingClass = null;
                renderTeacherMapping();
                showToast(window.t('adm_mapeo_de_profesores_guardado'));
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        // ── Filter students & Pagination ──
        let currentPage = 1;
        const itemsPerPage = 30;
        let filteredRows = [];
        let showAllRows = false; // true when a specific class is selected

        // Búsquedas sin tildes ni mayúsculas, como searchText() en server.js
        function normalizeSearch(value) {
            return String(value || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
        }
        // Cada palabra buscada debe aparecer: "gar per" encuentra "perez garcia"
        function matchesWords(text, query) {
            return !query || query.split(' ').every(word => (text || '').includes(word));
        }
        function searchValue(id) {
            const input = document.getElementById(id);
            return input ? normalizeSearch(input.value) : '';
        }

        function filterStudents(resetPage = true) {
            const filter = document.getElementById('filterClass').value;
            const code = searchValue('searchStudentCode');
            const names = searchValue('searchStudentNames');
            const surnames = searchValue('searchStudentSurnames');
            const rows = document.querySelectorAll('#studentsTableBody tr');
            filteredRows = [];

            rows.forEach(row => {
                const d = row.dataset;
                const visible = (!filter || d.class === filter)
                    && (!code || (d.searchCode || '').includes(code))
                    && matchesWords(d.searchNames, names)
                    && matchesWords(d.searchSurnames, surnames);
                if (visible) {
                    filteredRows.push(row);
                } else {
                    row.style.display = 'none';
                }
            });

            // When a specific Klasse is selected, show ALL students (no pagination)
            showAllRows = !!filter;

            if (resetPage) currentPage = 1;
            renderPagination();
            document.getElementById('studentCount').textContent = filteredRows.length + ' ' + window.t('adm_js_estudiantes_n');
            document.getElementById('studentsEmpty').hidden = filteredRows.length > 0 || rows.length === 0;
        }

        function clearStudentSearch() {
            ['searchStudentCode', 'searchStudentNames', 'searchStudentSurnames'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
            filterStudents();
        }

        // ── Docentes: lista con buscador por nombre, apellidos y documento ──
        // Se pide al servidor cada vez que se abre la sección (así refleja lo editado en el editor de BD).
        // El documento se muestra enmascarado (••••1234): con él y el correo se entra al portal docente.
        const TEACHER_SUBJECTS = <%- JSON.stringify(subjects.map(s => ({ id: s.id, name: s.name, icon: s.icon }))) %>;
        const TEACHER_ROLE_COLORS = { desarrollador: '#9333ea', coordinador: '#2563eb', directivo: '#059669' };
        let teacherRows = null;

        function normalizeDoc(value) {
            return String(value || '').replace(/[^0-9a-z]/gi, '').toLowerCase();
        }
        function maskDoc(value) {
            const doc = normalizeDoc(value);
            return doc ? '••••' + doc.slice(-4) : '—';
        }
        function teacherRoleLabel(role) {
            const key = role === 'profesor' ? 'adm_rol_badge_profesor' : 'adm_role_' + role;
            const label = window.t(key);
            return label === key ? role : label;
        }

        async function loadTeachersList() {
            const loading = document.getElementById('teachersLoading');
            loading.hidden = false;
            try {
                const res = await fetch('/api/admin/teachers');
                const result = await res.json();
                if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                teacherRows = result.teachers.map(t => ({
                    ...t,
                    search: { names: normalizeSearch(t.first_name), surnames: normalizeSearch(t.last_name), doc: normalizeDoc(t.doc_number) }
                }));
                teacherEditingId = null;
                renderTeachers();
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            } finally {
                loading.hidden = true;
            }
        }

        function renderTeachers() {
            if (!teacherRows) return;
            const names = searchValue('searchTeacherNames');
            const surnames = searchValue('searchTeacherSurnames');
            const docInput = document.getElementById('searchTeacherDoc');
            const doc = normalizeDoc(docInput ? docInput.value : '');
            const lang = window.langUtils.getLang();

            const list = teacherRows.filter(t => t.id === teacherEditingId || (matchesWords(t.search.names, names)
                && matchesWords(t.search.surnames, surnames)
                && (!doc || t.search.doc.includes(doc))));

            document.getElementById('teachersTableBody').innerHTML = list.map((t, i) => {
                if (t.id === teacherEditingId) return teacherEditRow(t, i);
                const subject = TEACHER_SUBJECTS.find(s => s.id === t.subject);
                const subjectLabel = subject ? `${subject.icon} ${escapeHtml(subject.name[lang] || subject.name.es)}` : escapeHtml(t.subject || '—');
                const roleColor = TEACHER_ROLE_COLORS[t.role] || '#64748b';
                // Directivo y coordinador: sin documento ni edición; en su lugar, la capacitación KMK
                const lastCell = IS_DEV
                    ? `<div class="row-actions"><button type="button" class="btn btn-sm btn-edit" data-id="${escapeHtml(t.id)}" onclick="editTeacherRow(this.dataset.id)" ${teacherEditingId ? 'disabled' : ''}><i class="fas fa-pen"></i> ${escapeHtml(window.t('adm_editar'))}</button>`
                        + (isOwnTeacher(t) ? '' : `<button type="button" class="btn btn-sm btn-danger" data-id="${escapeHtml(t.id)}" onclick="openTeacherDialog('delete', this.dataset.id)" ${teacherEditingId ? 'disabled' : ''}><i class="fas fa-trash-can"></i> ${escapeHtml(window.t('adm_doc_eliminar'))}</button>`)
                        + `</div>`
                    : (t.training_completed
                        ? `<span class="tc-badge ok"><i class="fas fa-check-circle"></i> ${escapeHtml(window.t('adm_tc_capacitado'))}</span>`
                        : `<span class="tc-badge warn"><i class="fas fa-clock"></i> ${escapeHtml(window.t('adm_tc_sin_capacitar'))}</span>`);
                return `<tr>
                    <td><strong>${i + 1}</strong></td>
                    <td><strong>${escapeHtml(t.last_name || '—')}</strong></td>
                    <td>${escapeHtml(t.first_name || '—')}</td>
                    ${IS_DEV ? `<td><span class="doc-masked">${escapeHtml(maskDoc(t.doc_number))}</span></td>` : ''}
                    <td>${escapeHtml(t.email || '—')}</td>
                    <td>${subjectLabel}</td>
                    <td><span class="count-badge" style="background:${roleColor}; color:white;">${escapeHtml(teacherRoleLabel(t.role))}</span></td>
                    <td>${(t.segments || []).map(s => escapeHtml(window.t('adm_ind_seg_' + s))).join(', ') || `<span style="color:#94a3b8;">${escapeHtml(window.t('adm_ind_seg_sin'))}</span>`}</td>
                    <td>${lastCell}</td>
                </tr>`;
            }).join('');

            document.getElementById('teacherCount').textContent = list.length + ' ' + window.t('adm_js_docentes_lower');
            document.getElementById('teachersEmpty').hidden = list.length > 0;
        }

        // ── Docentes: edición en la fila (nombres, apellidos, correo, materia y rol) ──
        let teacherEditingId = null;

        function subjectOptions(selected) {
            const lang = window.langUtils.getLang();
            const known = TEACHER_SUBJECTS.some(s => s.id === selected);
            return `<option value="">${escapeHtml(window.t('adm_sin_materia'))}</option>`
                + (selected && !known ? `<option value="${escapeHtml(selected)}" selected>${escapeHtml(selected)}</option>` : '')
                + TEACHER_SUBJECTS.map(s => `<option value="${s.id}" ${s.id === selected ? 'selected' : ''}>${s.icon} ${escapeHtml(s.name[lang] || s.name.es)}</option>`).join('');
        }

        function teacherEditRow(t, i) {
            const roles = ['profesor', 'coordinador', 'directivo', 'desarrollador']; // "admin" es desarrollador
            return `<tr class="editing" data-id="${escapeHtml(t.id)}">
                <td><strong>${i + 1}</strong></td>
                <td><input type="text" data-field="last_name" value="${escapeHtml(t.last_name || '')}" aria-label="${escapeHtml(window.t('adm_apellidos'))}"></td>
                <td><input type="text" data-field="first_name" value="${escapeHtml(t.first_name || '')}" aria-label="${escapeHtml(window.t('adm_nombres'))}"></td>
                <td><span class="doc-masked">${escapeHtml(maskDoc(t.doc_number))}</span></td>
                <td><input type="email" data-field="email" value="${escapeHtml(t.email || '')}" aria-label="${escapeHtml(window.t('adm_email'))}"></td>
                <td><select data-field="subject" aria-label="${escapeHtml(window.t('adm_materia_docente'))}">${subjectOptions(t.subject || '')}</select></td>
                <td><select data-field="role" aria-label="${escapeHtml(window.t('adm_rol_docente'))}">${roles.map(r => `<option value="${r}" ${r === t.role ? 'selected' : ''}>${escapeHtml(teacherRoleLabel(r))}</option>`).join('')}</select></td>
                <td><div class="teacher-segments">${['preescolar', 'primaria', 'secundaria'].map(s => `<label><input type="checkbox" data-segment="${s}" ${(t.segments || []).includes(s) ? 'checked' : ''}> ${escapeHtml(window.t('adm_ind_seg_' + s))}</label>`).join('')}</div></td>
                <td><div class="row-actions">
                    <button type="button" class="btn btn-sm btn-success" onclick="saveTeacherRow()"><i class="fas fa-save"></i> ${escapeHtml(window.t('adm_guardar'))}</button>
                    <button type="button" class="btn btn-sm btn-light" onclick="cancelTeacherRow()"><i class="fas fa-times"></i> ${escapeHtml(window.t('adm_cancelar'))}</button>
                </div></td>
            </tr>`;
        }

        function editTeacherRow(id) {
            teacherEditingId = id;
            renderTeachers();
            const first = document.querySelector('#teachersTableBody tr.editing input');
            if (first) first.focus();
        }

        function cancelTeacherRow() {
            teacherEditingId = null;
            renderTeachers();
        }

        async function saveTeacherRow() {
            const row = document.querySelector('#teachersTableBody tr.editing');
            if (!row) return;
            const body = {};
            row.querySelectorAll('[data-field]').forEach(el => { body[el.dataset.field] = el.value.trim(); });
            body.segments = [...row.querySelectorAll('[data-segment]:checked')].map(el => el.dataset.segment);
            try {
                const result = await (await fetch('/api/admin/teachers/' + encodeURIComponent(teacherEditingId), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })).json();
                if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                const t = result.teacher;
                const idx = teacherRows.findIndex(r => r.id === t.id);
                if (idx >= 0) {
                    teacherRows[idx] = { ...teacherRows[idx], ...t,
                        search: { names: normalizeSearch(t.first_name), surnames: normalizeSearch(t.last_name), doc: normalizeDoc(t.doc_number) } };
                }
                teacherEditingId = null;
                renderTeachers();
                showToast(window.t('adm_js_docente_guardado'));
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        function clearTeacherSearch() {
            ['searchTeacherNames', 'searchTeacherSurnames', 'searchTeacherDoc'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
            renderTeachers();
        }

        // ── Editar y eliminar un docente desde cualquier lista de docentes (solo el desarrollador) ──
        // Docentes registrados, Docentes pendientes de certificación, Mapeo › Asignatura de cada docente,
        // Capacitación KMK y Docentes y cursos abren el mismo cuadro. Nadie se elimina a sí mismo.
        const MY_EMAIL = (window.ADMIN_ACCESS && window.ADMIN_ACCESS.email) || '';
        const TEACHER_ROLES = ['profesor', 'coordinador', 'directivo', 'desarrollador']; // "admin" es desarrollador
        let teacherDialog = { mode: null, id: null, busy: false };

        const isOwnTeacher = t => !!MY_EMAIL && String((t && t.email) || '').trim().toLowerCase() === MY_EMAIL;

        // Botones Editar / Eliminar de una fila. t: { id, email }. Los docentes que solo están en el
        // mapeo (id "mapeo:…") no tienen cuenta: no hay nada que editar ni borrar.
        function teacherActions(t, { edit = true } = {}) {
            if (!IS_DEV || !t || t.id == null || String(t.id).startsWith('mapeo:')) return '';
            const id = escapeHtml(t.id);
            const T = key => escapeHtml(window.t(key));
            return `<span class="tchr-actions">`
                + (edit ? `<button type="button" class="pt-btn" data-id="${id}" onclick="openTeacherDialog('edit', this.dataset.id)"><i class="fas fa-pen"></i> ${T('adm_editar')}</button>` : '')
                + (isOwnTeacher(t) ? '' : `<button type="button" class="pt-btn danger" data-id="${id}" onclick="openTeacherDialog('delete', this.dataset.id)"><i class="fas fa-trash-can"></i> ${T('adm_doc_eliminar')}</button>`)
                + `</span>`;
        }

        async function openTeacherDialog(mode, id) {
            const dialog = document.getElementById('teacherDialog');
            if (!dialog) return;
            if (!teacherRows) await loadTeachersList();
            const t = (teacherRows || []).find(r => String(r.id) === String(id));
            if (!t) return showToast(window.t('adm_doc_no_encontrado'), true);
            teacherDialog = { mode, id: t.id, busy: false };
            const T = key => escapeHtml(window.t(key));
            const title = document.getElementById('teacherDialogTitle');
            const body = document.getElementById('teacherDialogBody');
            const actions = document.getElementById('teacherDialogActions');
            const fullName = `${t.first_name || ''} ${t.last_name || ''}`.trim() || t.email || '—';
            const subject = TEACHER_SUBJECTS.find(s => s.id === t.subject);
            const lang = window.langUtils.getLang();
            const subjectLabel = subject ? `${subject.icon} ${escapeHtml(subject.name[lang] || subject.name.es)}` : T('adm_sin_materia');

            if (mode === 'delete') {
                title.className = 'danger';
                title.innerHTML = `<i class="fas fa-trash-can"></i> ${T('adm_doc_eliminar_titulo')}`;
                body.innerHTML = `<dl class="td-facts">
                        <dt>${T('adm_js_docente')}</dt><dd>${escapeHtml(fullName)}</dd>
                        <dt>${T('adm_email')}</dt><dd>${escapeHtml(t.email || '—')}</dd>
                        <dt>${T('adm_materia_docente')}</dt><dd>${subjectLabel}</dd>
                        <dt>${T('adm_rol_docente')}</dt><dd>${escapeHtml(teacherRoleLabel(t.role))}</dd>
                        <dt>${T('adm_tc_capacitacion')}</dt><dd>${T(t.training_completed ? 'adm_tc_capacitado' : 'adm_tc_sin_capacitar')}${t.training_score != null ? ' · ' + escapeHtml(t.training_score) + ' %' : ''}</dd>
                    </dl>
                    <p class="td-warn"><i class="fas fa-triangle-exclamation"></i> ${T('adm_doc_eliminar_aviso')}</p>
                    <p class="td-note">${T('adm_doc_eliminar_respaldo')}</p>`;
                actions.innerHTML = `<button type="button" class="btn btn-light" onclick="closeTeacherDialog()">${T('adm_cancelar')}</button>`
                    + `<button type="submit" class="btn btn-danger" id="teacherDialogSubmit"><i class="fas fa-trash-can"></i> ${T('adm_doc_eliminar_definitivo')}</button>`;
            } else {
                const own = isOwnTeacher(t);
                title.className = '';
                title.innerHTML = `<i class="fas fa-user-pen"></i> ${T('adm_doc_editar_titulo')}`;
                body.innerHTML = `<label>${T('adm_nombres')}<input type="text" data-field="first_name" required maxlength="80" value="${escapeHtml(t.first_name || '')}" autocomplete="off"></label>
                    <label>${T('adm_apellidos')}<input type="text" data-field="last_name" required maxlength="80" value="${escapeHtml(t.last_name || '')}" autocomplete="off"></label>
                    <label>${T('adm_email')}<input type="email" data-field="email" required maxlength="120" value="${escapeHtml(t.email || '')}" autocomplete="off" ${own ? 'readonly' : ''}></label>
                    <label>${T('adm_materia_docente')}<select data-field="subject">${subjectOptions(t.subject || '')}</select></label>
                    <label>${T('adm_rol_docente')}<select data-field="role" ${own ? 'disabled' : ''}>${TEACHER_ROLES.map(r => `<option value="${r}" ${r === t.role ? 'selected' : ''}>${escapeHtml(teacherRoleLabel(r))}</option>`).join('')}</select></label>
                    <fieldset style="border:none; padding:0; margin:0;"><legend style="font-size:0.85em; font-weight:600; color:#334155; margin-bottom:4px;">${T('adm_ind_segmento')}</legend>
                        <div class="td-segments">${['preescolar', 'primaria', 'secundaria'].map(s => `<label><input type="checkbox" data-segment="${s}" ${(t.segments || []).includes(s) ? 'checked' : ''}> ${T('adm_ind_seg_' + s)}</label>`).join('')}</div>
                    </fieldset>
                    ${own ? `<p class="td-note">${T('adm_doc_editar_propio')}</p>` : ''}`;
                actions.innerHTML = `<button type="button" class="btn btn-light" onclick="closeTeacherDialog()">${T('adm_cancelar')}</button>`
                    + `<button type="submit" class="btn btn-success" id="teacherDialogSubmit"><i class="fas fa-save"></i> ${T('adm_guardar')}</button>`;
            }
            if (!dialog.open) dialog.showModal();
            const first = mode === 'delete' ? dialog.querySelector('.btn-light') : body.querySelector('input');
            if (first) first.focus();
        }

        function closeTeacherDialog() {
            const dialog = document.getElementById('teacherDialog');
            if (dialog && dialog.open) dialog.close();
            teacherDialog = { mode: null, id: null, busy: false };
        }

        async function submitTeacherDialog(event) {
            event.preventDefault();
            if (!teacherDialog.id || teacherDialog.busy) return;
            const { mode, id } = teacherDialog;
            const button = document.getElementById('teacherDialogSubmit');
            teacherDialog.busy = true;
            if (button) button.disabled = true;
            try {
                if (mode === 'delete') {
                    const result = await (await fetch('/api/admin/teachers/' + encodeURIComponent(id), { method: 'DELETE' })).json();
                    if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                    teacherRows = (teacherRows || []).filter(r => String(r.id) !== String(id));
                    if (String(teacherEditingId) === String(id)) teacherEditingId = null;
                    closeTeacherDialog();
                    renderTeachers();
                    showToast(result.mappedClasses
                        ? window.t('adm_doc_eliminado_mapeo').replace('{n}', result.mappedClasses)
                        : window.t('adm_doc_eliminado'));
                } else {
                    const form = document.getElementById('teacherDialogForm');
                    if (!form.reportValidity()) return;
                    const t = teacherRows.find(r => String(r.id) === String(id));
                    const body = { role: t ? t.role : 'profesor' };
                    form.querySelectorAll('[data-field]').forEach(el => { if (!el.disabled) body[el.dataset.field] = el.value.trim(); });
                    body.segments = [...form.querySelectorAll('[data-segment]:checked')].map(el => el.dataset.segment);
                    const result = await (await fetch('/api/admin/teachers/' + encodeURIComponent(id), {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
                    })).json();
                    if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                    const saved = result.teacher;
                    const idx = teacherRows.findIndex(r => String(r.id) === String(saved.id));
                    if (idx >= 0) {
                        teacherRows[idx] = { ...teacherRows[idx], ...saved,
                            search: { names: normalizeSearch(saved.first_name), surnames: normalizeSearch(saved.last_name), doc: normalizeDoc(saved.doc_number) } };
                    }
                    closeTeacherDialog();
                    renderTeachers();
                    showToast(window.t('adm_js_docente_guardado'));
                }
                refreshTeacherReports();
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            } finally {
                teacherDialog.busy = false;
                if (button) button.disabled = false;
            }
        }

        // Vuelve a pedir los informes de docentes que ya se abrieron (con sus filtros actuales)
        function refreshTeacherReports() {
            if (pendingTeachersData) loadTeacherStatus();
            if (teacherSubjectsData) loadTeacherSubjects();
            if (kmkAllTeachersData && kmkAllTeachersData.length) loadKmkTeachers().then(filterKmkTeachers);
            if (tcData) loadTeacherCourses();
        }

        // ── Capacitación y ayuda: videos del botón AYUDA y correos para docentes ──
        let helpVideosAdmin = [];
        let campaignData = null;
        let campaignPoll = null;
        const campaignText = value => (value && (value[window.langUtils.getLang()] || value.es)) || '';

        async function enterHelpModule() {
            try {
                const [videos, state] = await Promise.all([
                    fetch('/api/admin/help-videos').then(r => r.json()),
                    fetch('/api/admin/campaign').then(r => r.json())
                ]);
                helpVideosAdmin = videos.videos || [];
                campaignData = state;
                renderHelpModule();
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        function renderHelpModule() {
            renderHelpVideos();
            renderCampaign();
        }

        function renderHelpVideos() {
            const box = document.getElementById('helpVideosAdmin');
            if (!box) return;
            box.innerHTML = helpVideosAdmin.map(video => `<div class="help-video-row">
                <label for="hv_${escapeHtml(video.id)}"><strong>${escapeHtml(campaignText(video.title))}</strong></label>
                <input type="url" id="hv_${escapeHtml(video.id)}" data-video="${escapeHtml(video.id)}" value="${escapeHtml(video.url || '')}" placeholder="https://..." autocomplete="off">
                <details><summary>${escapeHtml(window.t('adm_cap_guion'))}</summary><p style="white-space:pre-line;">${escapeHtml(video.script || '')}</p></details>
            </div>`).join('');
        }

        async function saveHelpVideos() {
            const links = {};
            document.querySelectorAll('#helpVideosAdmin [data-video]').forEach(input => { links[input.dataset.video] = input.value.trim(); });
            try {
                const result = await (await fetch('/api/admin/help-videos', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ links })
                })).json();
                if (!result.success) return showToast(window.t('adm_cap_enlace_invalido'), true);
                helpVideosAdmin = result.videos;
                renderHelpVideos();
                showToast(window.t('adm_cap_guardado'));
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        function renderCampaign() {
            if (!campaignData) return;
            const { service, settings, emails, stats } = campaignData;
            const banner = document.getElementById('campaignService');
            banner.className = service.configured ? 'campaign-banner ok' : 'campaign-banner warn';
            banner.textContent = service.configured
                ? window.t('adm_cap_servicio_ok').replace('{from}', service.from)
                : window.t('adm_cap_servicio_falta').replace('{faltan}', service.missing.join(', '));
            document.getElementById('campaignAppUrl').value = settings.appUrl || '';
            document.getElementById('campaignHelpSegment').value = settings.helpSegment || '';

            const subjectOptionsHtml = TEACHER_SUBJECTS.map(s => `<option value="${s.id}">${s.icon} ${escapeHtml(campaignText(s.name))}</option>`).join('');
            document.getElementById('campaignEmails').innerHTML = emails.map((email, i) => {
                const stat = stats[email.id] || { sent: 0, failed: 0 };
                const id = escapeHtml(email.id);
                return `<details class="campaign-email" data-email="${id}" ${i === 0 ? 'open' : ''}>
                    <summary><strong>${escapeHtml(window.t('adm_cap_correo'))} ${i + 1}</strong> · ${escapeHtml(window.t('adm_cap_dia'))} ${email.day} · ${escapeHtml(email.subject)}
                        <span class="count-badge">${stat.sent} ${escapeHtml(window.t('adm_cap_enviados'))}${stat.failed ? ' · ' + stat.failed + ' ' + escapeHtml(window.t('adm_cap_fallidos')) : ''}</span></summary>
                    <label for="ce_subject_${id}">${escapeHtml(window.t('adm_cap_asunto'))}</label>
                    <input type="text" id="ce_subject_${id}" maxlength="200" value="${escapeHtml(email.subject)}">
                    <label for="ce_body_${id}">${escapeHtml(window.t('adm_cap_cuerpo'))}</label>
                    <textarea id="ce_body_${id}" rows="9" maxlength="8000">${escapeHtml(email.body)}</textarea>
                    <p class="campaign-hint">${escapeHtml(window.t('adm_cap_marcadores'))}</p>
                    <div class="row-actions">
                        <button type="button" class="btn btn-sm btn-success" onclick="saveCampaignEmail('${id}')"><i class="fas fa-save"></i> ${escapeHtml(window.t('adm_guardar'))}</button>
                        <button type="button" class="btn btn-sm btn-light" onclick="previewCampaignEmail('${id}')"><i class="fas fa-eye"></i> ${escapeHtml(window.t('adm_cap_vista_previa'))}</button>
                        <button type="button" class="btn btn-sm btn-light" ${service.configured ? '' : 'disabled'} onclick="testCampaignEmail('${id}')"><i class="fas fa-vial"></i> ${escapeHtml(window.t('adm_cap_enviar_prueba'))}</button>
                    </div>
                    <div class="campaign-preview" id="ce_preview_${id}" hidden></div>
                    <div class="campaign-send">
                        <label for="ce_filter_${id}">${escapeHtml(window.t('adm_cap_destinatarios'))}</label>
                        <select id="ce_filter_${id}" onchange="campaignFilterChanged('${id}')">
                            <option value="all" ${email.audience === 'all' ? 'selected' : ''}>${escapeHtml(window.t('adm_cap_todos'))}</option>
                            <option value="untrained" ${email.audience === 'untrained' ? 'selected' : ''}>${escapeHtml(window.t('adm_cap_sin_capacitar'))}</option>
                            <option value="subject">${escapeHtml(window.t('adm_cap_por_materia'))}</option>
                        </select>
                        <select id="ce_subject_filter_${id}" hidden onchange="campaignFilterChanged('${id}')" aria-label="${escapeHtml(window.t('adm_materia_docente'))}">${subjectOptionsHtml}</select>
                        <button type="button" class="btn btn-sm btn-primary" onclick="checkCampaignRecipients('${id}')"><i class="fas fa-users"></i> ${escapeHtml(window.t('adm_cap_ver_destinatarios'))}</button>
                        <div id="ce_recipients_${id}" class="campaign-recipients"></div>
                    </div>
                </details>`;
            }).join('');
            renderCampaignJob();
        }

        function campaignFilterBody(id) {
            const type = document.getElementById('ce_filter_' + id).value;
            const body = { emailId: id, type };
            if (type === 'subject') body.subject = document.getElementById('ce_subject_filter_' + id).value;
            return body;
        }

        function campaignFilterChanged(id) {
            document.getElementById('ce_subject_filter_' + id).hidden = document.getElementById('ce_filter_' + id).value !== 'subject';
            document.getElementById('ce_recipients_' + id).innerHTML = '';
        }

        async function campaignPost(url, body) {
            const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            return response.json();
        }

        async function saveCampaignSettings() {
            try {
                const result = await campaignPost('/api/admin/campaign/settings', {
                    appUrl: document.getElementById('campaignAppUrl').value,
                    helpSegment: document.getElementById('campaignHelpSegment').value
                });
                if (!result.success) return showToast(window.t('adm_cap_enlace_invalido'), true);
                campaignData.settings = result.settings;
                showToast(window.t('adm_cap_guardado'));
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        async function saveCampaignEmail(id) {
            try {
                const result = await campaignPost('/api/admin/campaign/emails/' + encodeURIComponent(id), {
                    subject: document.getElementById('ce_subject_' + id).value,
                    body: document.getElementById('ce_body_' + id).value
                });
                if (!result.success) return showToast(window.t('adm_cap_correo_incompleto'), true);
                campaignData.emails = campaignData.emails.map(email => email.id === id ? result.email : email);
                showToast(window.t('adm_cap_guardado'));
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        async function previewCampaignEmail(id) {
            const box = document.getElementById('ce_preview_' + id);
            try {
                const result = await campaignPost('/api/admin/campaign/preview', {
                    emailId: id,
                    subject: document.getElementById('ce_subject_' + id).value,
                    body: document.getElementById('ce_body_' + id).value
                });
                if (!result.success) return showToast(window.t('adm_error'), true);
                box.hidden = false;
                box.innerHTML = `<p><strong>${escapeHtml(window.t('adm_cap_asunto'))}:</strong> ${escapeHtml(result.subject)}</p>
                    ${result.missingVideos.length ? `<p class="campaign-banner warn">${escapeHtml(window.t('adm_cap_faltan_videos'))}: ${escapeHtml(result.missingVideos.join(', '))}</p>` : ''}
                    <iframe sandbox title="${escapeHtml(window.t('adm_cap_vista_previa'))}" srcdoc="${escapeHtml(result.html)}"></iframe>`;
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        async function testCampaignEmail(id) {
            try {
                const result = await campaignPost('/api/admin/campaign/test', { emailId: id });
                if (result.success) showToast(window.t('adm_cap_prueba_enviada').replace('{to}', result.to));
                else showToast(window.t('adm_error') + (result.message || result.code || ''), true);
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        async function checkCampaignRecipients(id) {
            const box = document.getElementById('ce_recipients_' + id);
            try {
                const result = await campaignPost('/api/admin/campaign/recipients', campaignFilterBody(id));
                if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                const canSend = campaignData.service.configured && result.count > 0 && !(campaignData.job && campaignData.job.running);
                box.innerHTML = `<p><strong>${result.count}</strong> ${escapeHtml(window.t('adm_cap_docentes_recibiran'))}
                        ${result.alreadySent ? ' · ' + result.alreadySent + ' ' + escapeHtml(window.t('adm_cap_ya_recibieron')) : ''}
                        ${result.invalid ? ' · ' + result.invalid + ' ' + escapeHtml(window.t('adm_cap_sin_correo')) : ''}</p>
                    ${result.external.length ? `<p class="campaign-banner warn">${escapeHtml(window.t('adm_cap_fuera_dominio'))}: ${escapeHtml(result.external.join(', '))}</p>` : ''}
                    ${result.missingVideos.length ? `<p class="campaign-banner warn">${escapeHtml(window.t('adm_cap_faltan_videos'))}: ${escapeHtml(result.missingVideos.join(', '))}</p>` : ''}
                    <button type="button" class="btn btn-success" ${canSend ? '' : 'disabled'} onclick="sendCampaignEmail('${escapeHtml(id)}', ${result.count})"><i class="fas fa-paper-plane"></i> ${escapeHtml(window.t('adm_cap_enviar_a').replace('{n}', result.count))}</button>`;
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        async function sendCampaignEmail(id, count) {
            if (!confirm(window.t('adm_cap_confirmar').replace('{n}', count))) return;
            const codes = {
                count_changed: 'adm_cap_cambio_destinatarios', no_app_url: 'adm_cap_falta_enlace',
                busy: 'adm_cap_ocupado', not_configured: 'adm_cap_no_configurado', no_recipients: 'adm_cap_sin_destinatarios'
            };
            try {
                const result = await campaignPost('/api/admin/campaign/send', { ...campaignFilterBody(id), confirmCount: count });
                if (!result.success) {
                    showToast(codes[result.code] ? window.t(codes[result.code]) : window.t('adm_error') + (result.message || ''), true);
                    return checkCampaignRecipients(id);
                }
                campaignData.job = result.job;
                renderCampaignJob();
                startCampaignPoll();
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        function renderCampaignJob() {
            const box = document.getElementById('campaignJob');
            const job = campaignData && campaignData.job;
            if (!box) return;
            if (!job) { box.innerHTML = ''; return; }
            box.className = 'campaign-banner ' + (job.failed ? 'warn' : 'ok');
            box.innerHTML = `${job.running ? '<i class="fas fa-spinner fa-spin"></i> ' : ''}${escapeHtml(window.t(job.running ? 'adm_cap_enviando' : 'adm_cap_envio_terminado'))}: ${job.sent} / ${job.total}${job.failed ? ' · ' + job.failed + ' ' + escapeHtml(window.t('adm_cap_fallidos')) : ''}`
                + job.errors.map(error => `<div style="font-size:0.85em;">${escapeHtml(error)}</div>`).join('');
        }

        function startCampaignPoll() {
            clearInterval(campaignPoll);
            campaignPoll = setInterval(async () => {
                try {
                    const state = await (await fetch('/api/admin/campaign')).json();
                    campaignData.job = state.job;
                    campaignData.stats = state.stats;
                    renderCampaignJob();
                    if (!state.job || !state.job.running) {
                        clearInterval(campaignPoll);
                        campaignData = state;
                        renderCampaign();
                    }
                } catch (e) { /* se reintenta en el siguiente ciclo */ }
            }, 3000);
        }

        // ── Materias: nombre DE/EN/ES, ícono, color y activa/inactiva ──
        // Una materia inactiva no se ofrece en los combos ni al estudiante; no se borra nada.
        let subjectRows = null;
        let subjectEditingId = null;

        async function loadSubjectsAdmin() {
            const loading = document.getElementById('subjectsLoading');
            loading.hidden = false;
            try {
                const result = await (await fetch('/api/admin/subjects')).json();
                if (!result.success) throw new Error(result.message || '');
                subjectRows = result.subjects;
                subjectEditingId = null;
                renderSubjectsAdmin();
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            } finally {
                loading.hidden = true;
            }
        }

        function renderSubjectsAdmin() {
            if (!subjectRows) return;
            document.getElementById('subjectsTableBody').innerHTML = subjectRows.map(s => {
                const state = `<span class="subject-state ${s.active ? 'on' : 'off'}">${escapeHtml(window.t(s.active ? 'adm_materia_activa' : 'adm_materia_inactiva'))}</span>`;
                if (s.id === subjectEditingId) {
                    return `<tr class="editing" data-id="${s.id}">
                        <td><input type="text" class="icon-input" data-field="icon" value="${escapeHtml(s.icon)}" maxlength="8" aria-label="${escapeHtml(window.t('adm_materias_icono'))}"></td>
                        ${['de', 'en', 'es'].map(l => `<td><input type="text" data-field="name_${l}" value="${escapeHtml(s.name[l] || '')}" maxlength="60" aria-label="${l.toUpperCase()}"></td>`).join('')}
                        <td><input type="color" data-field="color" value="${escapeHtml(s.color)}" aria-label="${escapeHtml(window.t('adm_materias_color'))}"></td>
                        <td><label style="display:inline-flex; align-items:center; gap:6px; cursor:pointer;"><input type="checkbox" data-field="active" ${s.active ? 'checked' : ''}> ${escapeHtml(window.t('adm_materia_activa'))}</label></td>
                        <td>${s.teachers}</td>
                        <td>${s.classes}</td>
                        <td><div class="row-actions">
                            <button type="button" class="btn btn-sm btn-success" onclick="saveSubjectRow()"><i class="fas fa-save"></i> ${escapeHtml(window.t('adm_guardar'))}</button>
                            <button type="button" class="btn btn-sm btn-light" onclick="subjectEditingId = null; renderSubjectsAdmin();"><i class="fas fa-times"></i> ${escapeHtml(window.t('adm_cancelar'))}</button>
                        </div></td>
                    </tr>`;
                }
                return `<tr class="${s.active ? '' : 'subject-inactive'}" data-id="${s.id}">
                    <td style="font-size:1.3em;">${escapeHtml(s.icon)}</td>
                    <td>${escapeHtml(s.name.de)}</td>
                    <td>${escapeHtml(s.name.en)}</td>
                    <td>${escapeHtml(s.name.es)}${s.custom ? ` <span class="tc-badge muted" title="${escapeHtml(window.t('adm_mat_nueva_ayuda'))}">${escapeHtml(window.t('adm_mat_generica'))}</span>` : ''}</td>
                    <td><span class="subject-swatch" style="background:${escapeHtml(s.color)}"></span></td>
                    <td>${state}</td>
                    <td>${s.teachers}</td>
                    <td>${s.classes}</td>
                    <td><button type="button" class="btn btn-sm btn-edit" data-id="${s.id}" onclick="subjectEditingId = this.dataset.id; renderSubjectsAdmin();" ${subjectEditingId ? 'disabled' : ''}><i class="fas fa-pen"></i> ${escapeHtml(window.t('adm_editar'))}</button></td>
                </tr>`;
            }).join('');
        }

        function toggleNewSubjectForm(open) {
            const form = document.getElementById('newSubjectForm');
            form.hidden = !open;
            document.getElementById('newSubjectBtn').hidden = open;
            if (open) document.getElementById('newSubjectEs').focus();
            else form.reset();
        }

        async function createSubject(event) {
            event.preventDefault();
            const value = id => document.getElementById(id).value.trim();
            const body = {
                name: { es: value('newSubjectEs'), de: value('newSubjectDe'), en: value('newSubjectEn') },
                icon: value('newSubjectIcon'),
                color: document.getElementById('newSubjectColor').value,
                enableAll: document.getElementById('newSubjectEnableAll').checked
            };
            const button = document.getElementById('newSubjectSave');
            button.disabled = true;
            try {
                const result = await (await fetch('/api/admin/subjects', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })).json();
                if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                const s = result.subject;
                subjectRows = [...(subjectRows || []), s];
                TEACHER_SUBJECTS.push({ id: s.id, name: s.name, icon: s.icon });
                toggleNewSubjectForm(false);
                renderSubjectsAdmin();
                translateSubjectOptions();
                showToast(window.t('adm_mat_creada').replace('{materia}', s.name[window.langUtils ? window.langUtils.getLang() : 'es'] || s.name.es));
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            } finally {
                button.disabled = false;
            }
        }

        async function saveSubjectRow() {
            const row = document.querySelector('#subjectsTableBody tr.editing');
            if (!row) return;
            const field = name => row.querySelector(`[data-field="${name}"]`);
            const body = {
                icon: field('icon').value.trim(),
                color: field('color').value,
                active: field('active').checked,
                name: { de: field('name_de').value.trim(), en: field('name_en').value.trim(), es: field('name_es').value.trim() }
            };
            try {
                const result = await (await fetch('/api/admin/subjects/' + encodeURIComponent(subjectEditingId), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })).json();
                if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                const saved = result.subject;
                const idx = subjectRows.findIndex(s => s.id === saved.id);
                subjectRows[idx] = { ...subjectRows[idx], ...saved };
                // Combos de esta página que se arman con JavaScript (los demás, al recargar)
                const pos = TEACHER_SUBJECTS.findIndex(s => s.id === saved.id);
                if (saved.active) {
                    const entry = { id: saved.id, name: saved.name, icon: saved.icon };
                    if (pos >= 0) TEACHER_SUBJECTS[pos] = entry;
                    else TEACHER_SUBJECTS.splice(subjectRows.filter((s, i) => i < idx && s.active).length, 0, entry);
                } else if (pos >= 0) {
                    TEACHER_SUBJECTS.splice(pos, 1);
                }
                subjectEditingId = null;
                renderSubjectsAdmin();
                translateSubjectOptions();
                showToast(window.t('adm_js_materia_guardada'));
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        // ── Año escolar: año en curso, lista de años y agregar años nuevos ──
        // El año en curso es el que ven los estudiantes y con el que se guardan sus respuestas.
        // Quitar un año de la lista no borra nada; el servidor solo lo permite sin respuestas guardadas.
        let schoolYearsData = null;

        async function loadSchoolYears() {
            const loading = document.getElementById('yearsLoading');
            loading.hidden = false;
            try {
                const result = await (await fetch('/api/admin/school-years')).json();
                if (!result.success) throw new Error(result.message || '');
                applySchoolYears(result);
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            } finally {
                loading.hidden = true;
            }
        }

        // Pinta la tabla y pone el año en curso en la barra superior, en el título y en el filtro de Inicio
        function applySchoolYears(payload) {
            schoolYearsData = payload;
            const active = payload.years.find(y => y.active) || {};
            document.getElementById('yearCurrentLabel').textContent = active.label || '';
            const chip = document.querySelector('#adminYearChip strong');
            if (chip) chip.textContent = active.label || '';
            const filter = document.getElementById('filterYear');
            if (filter) {
                const chosen = filter.value;
                filter.innerHTML = payload.years.slice().reverse().map(y => `<option value="${y.id}">${escapeHtml(y.label)}</option>`).join('');
                filter.value = payload.years.some(y => y.id === chosen) ? chosen : active.id;
            }
            const startInput = document.getElementById('yearAddStart');
            if (startInput && !startInput.value) startInput.value = payload.nextStart;
            previewSchoolYear();
            renderSchoolYears();
        }

        function renderSchoolYears() {
            if (!schoolYearsData) return;
            const t = key => escapeHtml(window.t(key));
            document.getElementById('yearsTableBody').innerHTML = schoolYearsData.years.slice().reverse().map(y => {
                const responses = y.responses === null ? '—' : y.responses;
                const canRemove = !y.active && y.responses === 0;
                return `<tr data-year="${y.id}">
                    <td><strong class="notranslate" translate="no">${escapeHtml(y.label)}</strong></td>
                    <td><span class="year-state ${y.active ? 'on' : ''}">${t(y.active ? 'adm_anio_estado_en_curso' : 'adm_anio_estado_disponible')}</span></td>
                    <td>${responses}</td>
                    <td><div class="row-actions">
                        ${y.active ? '' : `<button type="button" class="btn btn-sm btn-primary" onclick="setActiveSchoolYear('${y.id}')"><i class="fas fa-calendar-check"></i> ${t('adm_anio_marcar_en_curso')}</button>`}
                        ${canRemove ? `<button type="button" class="btn btn-sm btn-light" onclick="removeSchoolYear('${y.id}')"><i class="fas fa-minus-circle"></i> ${t('adm_anio_quitar')}</button>` : ''}
                    </div></td>
                </tr>`;
            }).join('');
        }

        function schoolYearLabel(start) {
            const year = Number(start);
            return Number.isInteger(year) && year >= 2000 && year <= 2098 ? `${year} - ${year + 1}` : '';
        }

        function previewSchoolYear() {
            const input = document.getElementById('yearAddStart');
            const preview = document.getElementById('yearAddPreview');
            if (input && preview) preview.textContent = schoolYearLabel(input.value) ? '→ ' + schoolYearLabel(input.value) : '';
        }

        async function schoolYearRequest(url, options, okKey) {
            try {
                const result = await (await fetch(url, options)).json();
                if (!result.success) {
                    showToast(result.message || window.t('adm_error'), true);
                    return false;
                }
                applySchoolYears(result);
                showToast(window.t(okKey));
                return true;
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
                return false;
            }
        }

        async function addSchoolYear(event) {
            event.preventDefault();
            const input = document.getElementById('yearAddStart');
            if (!schoolYearLabel(input.value)) return showToast(window.t('adm_anio_err_invalido'), true);
            const added = await schoolYearRequest('/api/admin/school-years', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ start: Number(input.value) })
            }, 'adm_anio_agregado');
            if (added) {
                input.value = schoolYearsData.nextStart;
                previewSchoolYear();
            }
        }

        async function setActiveSchoolYear(id) {
            const year = (schoolYearsData.years.find(y => y.id === id) || {}).label || id;
            if (!confirm(window.t('adm_anio_confirmar_en_curso').replace('{year}', year))) return;
            await schoolYearRequest('/api/admin/school-years/active', {
                method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id })
            }, 'adm_anio_en_curso_guardado');
        }

        async function removeSchoolYear(id) {
            const year = (schoolYearsData.years.find(y => y.id === id) || {}).label || id;
            if (!confirm(window.t('adm_anio_confirmar_quitar').replace('{year}', year))) return;
            await schoolYearRequest('/api/admin/school-years/' + encodeURIComponent(id), { method: 'DELETE' }, 'adm_anio_quitado');
        }

        // Nombre de las materias en los combos fijos de la página (Mapeo y Avance retos)
        function translateSubjectOptions() {
            document.querySelectorAll('option[data-subject-option]').forEach(opt => {
                const s = TEACHER_SUBJECTS.find(x => x.id === opt.dataset.subjectOption);
                if (s) opt.textContent = certSubjectLabel(s.id);
            });
        }

        function renderPagination() {
            filteredRows.forEach(row => row.style.display = 'none');

            if (showAllRows) {
                // Show ALL rows for the selected class
                filteredRows.forEach(row => row.style.display = '');
                updatePaginationUI();
                return;
            }

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            for (let i = startIndex; i < endIndex && i < filteredRows.length; i++) {
                filteredRows[i].style.display = '';
            }
            updatePaginationUI();
        }

        function updatePaginationUI() {
            const paginationDiv = document.getElementById('paginationControls');
            if (!paginationDiv) return;

            if (showAllRows) {
                paginationDiv.style.display = 'none';
                return;
            }

            const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
            if (totalPages <= 1) {
                paginationDiv.style.display = 'none';
                return;
            }

            paginationDiv.style.display = 'flex';
            let html = '';
            html += `<button class="btn btn-primary btn-sm" onclick="changePage(currentPage - 1)" ${currentPage === 1 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}><i class="fas fa-chevron-left"></i> ${window.t('adm_js_anterior')}</button>`;
            html += `<span style="font-weight: 600; color: #475569;">${window.t('adm_js_pagina')} ${currentPage} ${window.t('adm_js_de')} ${totalPages}</span>`;
            html += `<button class="btn btn-primary btn-sm" onclick="changePage(currentPage + 1)" ${currentPage === totalPages ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>${window.t('adm_js_siguiente')} <i class="fas fa-chevron-right"></i></button>`;

            paginationDiv.innerHTML = html;
        }

        function changePage(page) {
            const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderPagination();
        }

        filterStudents();

        // ── Bulk add students ──
        async function bulkAddStudents() {
            const input = document.getElementById('bulkInput').value.trim();
            if (!input) return showToast(window.t('adm_por_favor_ingresa_los_datos'), true);

            const lines = input.split('\n').filter(l => l.trim());
            const students = [];

            for (const line of lines) {
                const parts = line.split(',').map(p => p.trim());
                let code = null, fullName = '', className = '';

                if (parts.length >= 3) {
                    code = parts[0];
                    fullName = parts[1];
                    className = parts[2];
                } else if (parts.length === 2) {
                    fullName = parts[0];
                    className = parts[1];
                } else {
                    continue;
                }

                const nameWords = fullName.toLowerCase().split(' ').filter(w => w);
                let baseUsername = nameWords[0] || 'estudiante';
                let username = baseUsername;

                // Tratar de hacer el username único en el lote
                let wordIndex = 1;
                while (students.some(s => s.username === username && s.class_name === className)) {
                    if (wordIndex < nameWords.length) {
                        // Agregar la primera letra del siguiente apellido/nombre (ej: santiago f , santiago h)
                        username = baseUsername + ' ' + nameWords[wordIndex].charAt(0);
                        wordIndex++;
                    } else {
                        // Si ya no hay palabras, ponerle un número
                        username = baseUsername + ' ' + wordIndex;
                        wordIndex++;
                    }
                }

                students.push({
                    code: code,
                    full_name: fullName,
                    username: username,
                    class_name: className
                });
            }

            if (students.length === 0) return showToast(window.t('adm_formato_invalido'), true);

            try {
                const res = await fetch('/api/admin/students/bulk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ students })
                });
                const result = await res.json();

                if (result.success) {
                    showToast(`✅ ${result.count} ${window.t('adm_js_estudiantes_importados')}`);
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast(window.t('adm_error') + (result.message || 'Error desconocido'), true);
                }
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        // ── Delete student ──
        async function deleteStudent(id) {
            if (!confirm(window.t('adm_eliminar_este_estudiante_y_todos_sus'))) return;
            try {
                const res = await fetch('/api/admin/students/' + id, { method: 'DELETE' });
                const result = await res.json();
                if (result.success) {
                    document.querySelector(`tr[data-id="${id}"]`).remove();
                    showToast(window.t('adm_estudiante_eliminado'));
                    filterStudents(false);
                }
            } catch (e) {
                showToast(window.t('adm_error_al_eliminar'), true);
            }
        }

        // ── Certificados Medienpass ──
        // Estudiante: clase + materia habilitada (Configuración) → certificado con los retos 0-6
        // ganados (80 %, lo calcula el servidor) y el correo que el estudiante dejó al ganar.
        // Profesor: un certificado por docente que aprobó el test KMK (training_completed).
        // Se imprimen en un iframe aparte, solo con los certificados y sus estilos (#certStyles).
        let certMode = 'student';
        let certSubjectConfig = null;
        let certData = null; // { mode, rows, className?, subject? }
        const CERT_RETOS = [0, 1, 2, 3, 4, 5, 6];

        // Sin el icono en los certificados: en Windows las banderas se ven como letras ("GB Inglés")
        function certSubjectLabel(id, withIcon = false) {
            const subject = TEACHER_SUBJECTS.find(s => s.id === id);
            const lang = window.langUtils.getLang();
            if (!subject) return id || '—';
            const name = subject.name[lang] || subject.name.es;
            return withIcon ? `${subject.icon} ${name}` : name;
        }
        function certDate(value) {
            const date = value ? new Date(value) : new Date();
            return date.toLocaleDateString(window.t('adm_js_locale'), { year: 'numeric', month: 'long', day: 'numeric' });
        }
        function certReplace(text, values) {
            return Object.entries(values).reduce((out, [k, v]) => out.replace('{' + k + '}', v), text);
        }

        async function enterCertificates() {
            if (!certSubjectConfig) {
                try {
                    const result = await (await fetch('/api/admin/subject-config')).json();
                    certSubjectConfig = result.config || {};
                } catch (e) {
                    certSubjectConfig = {};
                }
            }
            fillCertSubjects();
        }

        // Solo las materias habilitadas para la clase elegida
        function fillCertSubjects() {
            const select = document.getElementById('certSubject');
            if (!select) return;
            const className = document.getElementById('certClass').value;
            const enabled = (certSubjectConfig && certSubjectConfig[className]) || {};
            const previous = select.value;
            const options = TEACHER_SUBJECTS.filter(s => enabled[s.id] === true);
            select.innerHTML = `<option value="">${escapeHtml(window.t('adm_seleccionar_materia'))}</option>`
                + options.map(s => `<option value="${s.id}">${escapeHtml(certSubjectLabel(s.id, true))}</option>`).join('');
            if (options.some(s => s.id === previous)) select.value = previous;
        }

        function setCertMode(mode) {
            certMode = mode;
            document.querySelectorAll('.cert-mode-btn').forEach(b => {
                b.classList.toggle('active', b.dataset.mode === mode);
                b.setAttribute('aria-pressed', b.dataset.mode === mode ? 'true' : 'false');
            });
            document.getElementById('certStudentFilters').hidden = mode !== 'student';
            document.getElementById('certTeacherFilters').hidden = mode !== 'teacher';
            certData = null;
            document.getElementById('certOutput').innerHTML = '';
            document.getElementById('certActions').hidden = true;
            if (mode === 'teacher') loadTeacherCertificates();
        }

        function certLoading() {
            document.getElementById('certActions').hidden = true;
            document.getElementById('certOutput').innerHTML = '<p class="cert-empty"><i class="fas fa-spinner fa-spin"></i> ' + escapeHtml(window.t('adm_cargando')) + '</p>';
        }

        async function loadStudentCertificates() {
            const className = document.getElementById('certClass').value;
            const subject = document.getElementById('certSubject').value;
            if (!className || !subject) return showToast(window.t('adm_js_cert_elige_clase_materia'), true);
            certLoading();
            try {
                const res = await fetch(`/api/admin/certificates/students/${encodeURIComponent(className)}/${encodeURIComponent(subject)}`);
                const result = await res.json();
                if (!result.success) throw new Error(result.message || '');
                certData = { mode: 'student', rows: result.students, className, subject };
                renderCertificates();
            } catch (e) {
                certData = null;
                document.getElementById('certOutput').innerHTML = '<p class="cert-empty">' + escapeHtml(window.t('adm_error_de_conexion')) + '</p>';
            }
        }

        async function loadTeacherCertificates() {
            certLoading();
            try {
                const result = await (await fetch('/api/admin/teachers')).json();
                if (!result.success) throw new Error(result.message || '');
                certData = { mode: 'teacher', rows: result.teachers.filter(t => t.training_completed) };
                renderCertificates();
            } catch (e) {
                certData = null;
                document.getElementById('certOutput').innerHTML = '<p class="cert-empty">' + escapeHtml(window.t('adm_error_de_conexion')) + '</p>';
            }
        }

        // Certificados de estudiantes y docentes: hoja apaisada tipo diapositiva con los colores del
        // colegio (negro, rojo, dorado y azul), textos tipo frase y las dos firmas (claves
        // est_cert_firma1_* y est_cert_firma2_*, editables en Textos e idiomas).
        // Escudo del colegio (public/img/escudo-colegio.png); URL completa para el iframe de impresión
        const CERT_LOGO_URL = location.origin + '/img/escudo-colegio.png';

        // "ADOLFO MARIO BALAGUERA GARCIA" → "Adolfo Mario Balaguera Garcia" (las partículas, en minúscula)
        const NAME_PARTICLES = new Set(['de', 'del', 'la', 'las', 'los', 'y', 'e', 'van', 'von', 'der', 'da', 'di']);
        function properName(text) {
            return String(text || '').trim().toLocaleLowerCase('es').split(/\s+/).map((word, i) =>
                (i > 0 && NAME_PARTICLES.has(word)) ? word
                    : word.split('-').map(part => part.charAt(0).toLocaleUpperCase('es') + part.slice(1)).join('-')).join(' ');
        }

        function certSide(icon) {
            return `<aside class="mp-cert-side">
                    <span class="mp-cert-logo"><img src="${CERT_LOGO_URL}" alt="Colegio Alemán · Deutsche Schule Barranquilla"></span>
                    <span class="mp-cert-brand">Medienpass</span>
                    <span class="mp-cert-school">Deutsche Schule Barranquilla<br>Colegio Alemán</span>
                    <span class="mp-cert-badge" aria-hidden="true">${icon}</span>
                </aside>`;
        }

        function certSigns() {
            // Las mismas claves que el certificado del estudiante (partials/reto-certificate.ejs)
            const sign = n => `<div class="mp-cert-sign"><strong>${escapeHtml(window.t(`est_cert_firma${n}_nombre`))}</strong><span>${escapeHtml(window.t(`est_cert_firma${n}_cargo`))}</span></div>`;
            return `<div class="mp-cert-signs">${sign(1)}${sign(2)}</div>`;
        }

        function studentCertificate(s) {
            const cells = s.retos.map(r => `<div class="mp-cert-reto ${r.won ? 'won' : ''}">
                    <span class="mp-cert-reto-name">${escapeHtml(window.t('adm_cert_reto'))} ${r.n}</span>
                    <span class="mp-cert-reto-mark">${r.won ? '✔' : '—'}</span>
                    <span class="mp-cert-reto-score">${r.won ? (r.kind === 'hits' ? `${r.score}/${r.max}` : `⭐ ${r.score}/${r.max}`) : ''}</span>
                </div>`).join('');
            const lastWin = s.retos.filter(r => r.won && r.date).map(r => r.date).sort().pop();
            return `<article class="mp-cert">
                <div class="mp-cert-flag" aria-hidden="true"></div>
                <div class="mp-cert-body">
                    ${certSide('🏆')}
                    <section class="mp-cert-main">
                        <p class="mp-cert-kicker">${escapeHtml(window.t('adm_cert_titulo'))}</p>
                        <p class="mp-cert-lead">${escapeHtml(window.t('adm_cert_otorga'))}</p>
                        <p class="mp-cert-name">${escapeHtml(properName(s.name))}</p>
                        <p class="mp-cert-meta">${escapeHtml(window.t('adm_cert_clase'))} ${escapeHtml(certData.className)}${s.code ? ' · ' + escapeHtml(window.t('adm_cert_codigo')) + ' ' + escapeHtml(s.code) : ''}</p>
                        <p class="mp-cert-lead">${escapeHtml(window.t('adm_cert_retos_materia'))} <strong class="mp-cert-subject">${escapeHtml(certSubjectLabel(certData.subject))}</strong></p>
                        <div class="mp-cert-retos">${cells}</div>
                        ${s.email ? `<p class="mp-cert-email">${escapeHtml(s.email)}</p>` : ''}
                        <p class="mp-cert-date">Barranquilla, ${escapeHtml(certDate(lastWin))}</p>
                        ${certSigns()}
                    </section>
                </div>
            </article>`;
        }

        function teacherCertificate(t) {
            const name = properName([t.first_name, t.last_name].filter(Boolean).join(' '));
            return `<article class="mp-cert teacher">
                <div class="mp-cert-flag" aria-hidden="true"></div>
                <div class="mp-cert-body">
                    ${certSide('🎓')}
                    <section class="mp-cert-main">
                        <p class="mp-cert-kicker">${escapeHtml(window.t('adm_cert_titulo_docente'))}</p>
                        <p class="mp-cert-lead">${escapeHtml(window.t('adm_cert_otorga'))}</p>
                        <p class="mp-cert-name">${escapeHtml(name)}</p>
                        ${t.subject ? `<p class="mp-cert-meta">${escapeHtml(window.t('adm_cert_docente_de'))} <strong class="mp-cert-subject">${escapeHtml(certSubjectLabel(t.subject))}</strong></p>` : ''}
                        <p class="mp-cert-lead">${escapeHtml(window.t('adm_cert_aprobo_kmk'))}</p>
                        ${t.training_score != null ? `<p class="mp-cert-score">${escapeHtml(window.t('adm_js_cert_puntaje'))}: ${escapeHtml(t.training_score)} %</p>` : ''}
                        <p class="mp-cert-date">Barranquilla, ${escapeHtml(certDate(t.training_date))}</p>
                        ${certSigns()}
                    </section>
                </div>
            </article>`;
        }

        function renderCertificates() {
            const output = document.getElementById('certOutput');
            if (!certData || !output) return;
            let html = '';
            let certs = [];

            if (certData.mode === 'student') {
                const rows = certData.rows;
                certs = rows.filter(s => s.wonCount > 0);
                document.getElementById('certSummary').textContent = certReplace(window.t('adm_js_cert_resumen_est'), { n: certs.length, total: rows.length });
                if (rows.length) {
                    html += `<div style="overflow-x:auto;"><table class="admin-table cert-table"><thead><tr>
                        <th>#</th><th>${escapeHtml(window.t('adm_nombre'))}</th><th>${escapeHtml(window.t('adm_email'))}</th>
                        ${CERT_RETOS.map(n => `<th title="${escapeHtml(window.t('adm_cert_reto'))} ${n}">R${n}</th>`).join('')}
                        <th>${escapeHtml(window.t('adm_js_cert_ganados'))}</th></tr></thead><tbody>`;
                    rows.forEach((s, i) => {
                        html += `<tr><td>${i + 1}</td><td><strong>${escapeHtml(s.name)}</strong></td>
                            <td>${s.email ? escapeHtml(s.email) : `<span class="cert-muted">${escapeHtml(window.t('adm_js_cert_sin_correo'))}</span>`}</td>
                            ${s.retos.map(r => `<td class="cert-cell ${r.won ? 'won' : ''}" title="${r.max ? `${r.score}/${r.max} (${r.pct} %)` : ''}">${r.won ? '✔' : '—'}</td>`).join('')}
                            <td><span class="count-badge">${s.wonCount}</span></td></tr>`;
                    });
                    html += '</tbody></table></div>';
                }
                if (!certs.length) html += `<p class="cert-empty">${escapeHtml(window.t('adm_js_cert_ninguno_est'))}</p>`;
            } else {
                const query = searchValue('certTeacherSearch');
                certs = certData.rows.filter(t => matchesWords(normalizeSearch(`${t.first_name || ''} ${t.last_name || ''}`), query));
                document.getElementById('certSummary').textContent = certReplace(window.t('adm_js_cert_resumen_doc'), { n: certData.rows.length });
                if (certs.length) {
                    html += `<div style="overflow-x:auto;"><table class="admin-table cert-table"><thead><tr>
                        <th>#</th><th>${escapeHtml(window.t('adm_apellidos'))}</th><th>${escapeHtml(window.t('adm_nombres'))}</th>
                        <th>${escapeHtml(window.t('adm_materia_docente'))}</th><th>${escapeHtml(window.t('adm_js_cert_puntaje'))}</th>
                        <th>${escapeHtml(window.t('adm_js_cert_fecha_test'))}</th></tr></thead><tbody>`;
                    certs.forEach((t, i) => {
                        html += `<tr><td>${i + 1}</td><td><strong>${escapeHtml(t.last_name || '—')}</strong></td><td>${escapeHtml(t.first_name || '—')}</td>
                            <td>${escapeHtml(certSubjectLabel(t.subject))}</td><td>${t.training_score != null ? escapeHtml(t.training_score) + ' %' : '—'}</td>
                            <td>${t.training_date ? escapeHtml(certDate(t.training_date)) : '—'}</td></tr>`;
                    });
                    html += '</tbody></table></div>';
                } else {
                    html += `<p class="cert-empty">${escapeHtml(window.t(certData.rows.length ? 'adm_sin_resultados_busqueda' : 'adm_js_cert_ninguno_doc'))}</p>`;
                }
            }

            if (certs.length) {
                html += `<div class="cert-list" id="certPrintArea">${certs.map(c => certData.mode === 'student' ? studentCertificate(c) : teacherCertificate(c)).join('')}</div>`;
            }
            output.innerHTML = html;
            document.getElementById('certActions').hidden = !certs.length;
        }

        // Imprime solo los certificados (un certificado por página) en un iframe aparte
        function printCertificates() {
            const area = document.getElementById('certPrintArea');
            if (!area) return;
            const frame = document.createElement('iframe');
            frame.setAttribute('aria-hidden', 'true');
            frame.style.cssText = 'position:fixed; right:0; bottom:0; width:0; height:0; border:0;';
            document.body.appendChild(frame);
            const doc = frame.contentDocument;
            doc.open();
            doc.write(`<!doctype html><html lang="${window.langUtils.getLang()}"><head><meta charset="utf-8"><title>${escapeHtml(window.t('adm_certificados_medienpass'))}</title>
                <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&family=Roboto+Slab:wght@500;700&display=swap" rel="stylesheet">
                <style>${document.getElementById('certStyles').textContent} body { margin: 0; background: white; }</style></head>
                <body>${area.innerHTML}</body></html>`);
            doc.close();
            // Se imprime (en A4 horizontal) cuando cargaron el logo y las letras (o fallaron), para que salgan en el PDF
            const images = [...doc.images].map(img => img.complete ? null : new Promise(done => { img.onload = img.onerror = done; }));
            const fonts = doc.fonts && doc.fonts.ready ? doc.fonts.ready.catch(() => null) : null;
            Promise.race([Promise.all([...images, fonts]), new Promise(done => setTimeout(done, 3000))]).then(() => {
                frame.contentWindow.focus();
                frame.contentWindow.print();
                setTimeout(() => frame.remove(), 1000);
            });
        }

        // ── Subject Configuration ──
        function toggleAllForKlasse(klasse) {
            const cbs = document.querySelectorAll(`.sc-cb[data-klasse="${klasse}"]`);
            const allChecked = [...cbs].every(cb => cb.checked);
            cbs.forEach(cb => cb.checked = !allChecked);
