    <script>
    async function loadPendingTeachers() {
        const panel = document.getElementById('pendingTeachersPanel');
        panel.style.display = 'block';
        panel.scrollIntoView({ behavior: 'smooth' });
        
        const loader = document.getElementById('pendingLoading');
        const tbody = document.getElementById('pendingTeachersBody');
        loader.style.display = 'block';
        tbody.innerHTML = '';
        
        try {
            const res = await fetch('/api/admin/pending-teachers');
            const data = await res.json();
            if(!data.success) throw new Error('Error al cargar');
            
            if(data.pending.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding: 20px; color: var(--mp-text-faint);">No hay solicitudes de registro pendientes.</td></tr>';
            } else {
                data.pending.forEach(p => {
                    const date = new Date(p.date).toLocaleString('es');
                    tbody.innerHTML += `
                        <tr>
                            <td>${date}</td>
                            <td><strong>${p.doc_number}</strong></td>
                            <td>${p.first_name}</td>
                            <td>${p.last_name}</td>
                            <td>${p.email}</td>
                            <td>
                                <button class="btn btn-sm" style="background:var(--mp-ok); color:white; margin-right:5px;" onclick="approveTeacher('${p.id}')" title="Aprobar"><i class="fas fa-check"></i></button>
                                <button class="btn btn-sm btn-danger" onclick="rejectTeacher('${p.id}')" title="Rechazar"><i class="fas fa-times"></i></button>
                            </td>
                        </tr>
                    `;
                });
            }
        } catch(e) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color: red;">Error cargando solicitudes.</td></tr>';
        }
        loader.style.display = 'none';
    }

    async function approveTeacher(id) {
        if(!confirm('¿Estás seguro de que quieres APROBAR este docente? Se le dará acceso permanente.')) return;
        try {
            const res = await fetch('/api/admin/approve-teacher/' + id, { method: 'POST' });
            const data = await res.json();
            alert(data.success ? '✅ ' + data.message : '❌ Error: ' + data.message);
            loadPendingTeachers(); // Reload list
        } catch(e) {
            alert('Error de red');
        }
    }

    async function rejectTeacher(id) {
        if(!confirm('¿Estás seguro de que quieres RECHAZAR y eliminar esta solicitud?')) return;
        try {
            const res = await fetch('/api/admin/reject-teacher/' + id, { method: 'POST' });
            const data = await res.json();
            alert(data.success ? '✅ ' + data.message : '❌ Error: ' + data.message);
            loadPendingTeachers(); // Reload list
        } catch(e) {
            alert('Error de red');
        }
    }
    
    // Set default tab on load
    document.addEventListener('DOMContentLoaded', () => {
        switchMainTab('executive');
    });
</script>
</body>

</html>