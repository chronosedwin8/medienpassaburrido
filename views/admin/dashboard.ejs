        // ── Bulk add students ──
        async function bulkAddStudents() {
            const input = document.getElementById('bulkInput').value.trim();
            if (!input) return showToast('Por favor ingresa los datos', true);

            const lines = input.split('\n').filter(l => l.trim());
            const students = [];

            for (const line of lines) {
                const parts = line.split(',').map(p => p.trim());
                let code = null, fullName = '', className = '';

                if (parts.length >= 3) {
                    code = parts[0];
                    fullName = parts[1];
                    className = parts[2];
                } else if (parts.length === 2) {
                    fullName = parts[0];
                    className = parts[1];
                } else {
                    continue;
                }

                const nameWords = fullName.toLowerCase().split(' ').filter(w => w);
                let baseUsername = nameWords[0] || 'estudiante';
                let username = baseUsername;

                // Tratar de hacer el username único en el lote
                let wordIndex = 1;
                while (students.some(s => s.username === username && s.class_name === className)) {
                    if (wordIndex < nameWords.length) {
                        // Agregar la primera letra del siguiente apellido/nombre (ej: santiago f , santiago h)
                        username = baseUsername + ' ' + nameWords[wordIndex].charAt(0);
                        wordIndex++;
                    } else {
                        // Si ya no hay palabras, ponerle un número
                        username = baseUsername + ' ' + wordIndex;
                        wordIndex++;
                    }
                }

                students.push({
                    code: code,
                    full_name: fullName,
                    username: username,
                    class_name: className
                });
            }

            if (students.length === 0) return showToast('Formato inválido', true);

            try {
                const res = await fetch('/api/admin/students/bulk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ students })
                });
                const result = await res.json();

                if (result.success) {
                    showToast(`✅ ${result.count} estudiante(s) importados`);
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast('Error: ' + (result.message || 'Error desconocido'), true);
                }
            } catch (e) {
                showToast('Error de conexión', true);
            }
        }

