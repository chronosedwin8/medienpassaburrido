                            }
                        });
                        tbHtml += `</tr>`;
                    });
                    tbody.innerHTML = tbHtml;
                } else {
                    loading.style.display = 'block';
                    loading.innerHTML = '<span style="color:red">Error al cargar matriz</span>';
                }
            } catch(e) {
                loading.style.display = 'block';
                loading.innerHTML = '<span style="color:red">Error de conexión</span>';
            }
        }
        
        loadPspMatrix();

        // ── PSP Indicators ──
        async function loadPspIndicators() {
            const cls = document.getElementById('pspClassFilter').value;
            if (!cls) return showToast('Selecciona una clase primero', true);

            const tbody = document.getElementById('pspTableBody');
            const avgDiv = document.getElementById('pspClassAvg');
            const table = document.getElementById('pspTable');

            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;"><i class="fas fa-spinner fa-spin"></i> Cargando indicadores...</td></tr>';
            table.style.display = 'table';
            avgDiv.innerHTML = '';

            try {
                const res = await fetch('/api/admin/psp-indicators/' + cls);
                const result = await res.json();

                if (result.success && result.students) {
                    if (result.students.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">No hay estudiantes en esta clase.</td></tr>';
                        return;
                    }

                    let html = '';
                    let totalProgress = 0;

                    result.students.forEach(s => {
                        totalProgress += s.progress;

                        // Progress bar building
                        let barColor = 'var(--mp-danger)'; // red
                        if (s.progress > 30) barColor = 'var(--mp-warn)'; // orange
                        if (s.progress > 70) barColor = 'var(--mp-ok)'; // green

                        const progressBar = `
                            <div style="background: var(--mp-border); border-radius: 10px; height: 12px; width: 100%; overflow: hidden; margin-top: 5px;">
                                <div style="background: ${barColor}; height: 100%; width: ${s.progress}%; transition: 0.5s;"></div>
                            </div>
                        `;

                        // Teacher status text formatting
                        let evalBadge = s.evaluation_passed
                            ? '<span style="color:var(--mp-ok);font-weight:bold;"><i class="fas fa-check-circle"></i> Aprobado</span>'
                            : '<span style="color:var(--mp-danger);"><i class="fas fa-times-circle"></i> Pendiente</span>';

                        if (s.teacher === 'Sin asigar') evalBadge = '<span style="color:var(--mp-text-faint);">—</span>';

                        html += `
                            <tr>
                                <td><strong>${s.name}</strong></td>
                                <td>${s.teacher}</td>
                                <td>${evalBadge}</td>
                                <td><span class="count-badge">${s.retosCompleted} / 6</span></td>
                                <td style="width: 200px;">
                                    <div style="font-size: 0.8em; font-weight: bold; text-align: right; color: ${barColor}">${s.progress}%</div>
                                    ${progressBar}
                                </td>
                            </tr>
                        `;
                    });

                    tbody.innerHTML = html;
                    const avgProgress = Math.round(totalProgress / result.students.length);
                    avgDiv.innerHTML = `<i class="fas fa-chart-pie"></i> Promedio de Cumplimiento del Grupo ${cls}: ${avgProgress}%`;
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:red;">Error al cargar datos.</td></tr>';
                }
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:red;">Error de conexión.</td></tr>';
            }
        }

        // ════════════════════════════════════════
        // KMK TRAINING — JAVASCRIPT
        // ════════════════════════════════════════
        let kmkSubjectChartInstance = null;
        let kmkAllTeachersData = [];
        let kmkQuizQuestions = [];
        let kmkQuizAnswers = {};

        function showKmkPanel(panel) {
            ['stats','teachers','quiz'].forEach(p => {
                document.getElementById('kmk-panel-' + p).style.display = p === panel ? '' : 'none';
                const btn = document.getElementById('kmk-btn-' + p);
                if (btn) btn.classList.toggle('active', p === panel);
            });
        }

        async function loadKmkStats() {
            document.getElementById('kmk-stats-loading').style.display = 'block';
            document.getElementById('kmk-global-kpi').style.display = 'none';
            document.getElementById('kmk-chart-area').style.display = 'none';
            document.getElementById('kmk-subject-cards').innerHTML = '';
            try {
                const res = await fetch('/api/admin/kmk-training-stats');
                const result = await res.json();
                document.getElementById('kmk-stats-loading').style.display = 'none';
                if (!result.success) { showToast('Error cargando stats KMK', true); return; }

                // Global KPI
                const { coveragePct, trained, total, stats } = result;
                document.getElementById('kmk-global-pct').textContent = coveragePct + '%';
                document.getElementById('kmk-trained-count').textContent = trained;
                document.getElementById('kmk-total-count').textContent = total;
                setTimeout(() => { document.getElementById('kmk-global-bar').style.width = coveragePct + '%'; }, 100);
                document.getElementById('kmk-global-status').textContent = coveragePct >= 70 ? '✅' : (coveragePct >= 50 ? '⚠️' : '🔴');
                document.getElementById('kmk-global-kpi').style.display = 'block';

                // Chart
                document.getElementById('kmk-chart-area').style.display = 'block';
                const labels = stats.map(s => s.icon + ' ' + s.subjectName);
                const data = stats.map(s => s.pct);
                const bgColors = stats.map(s => s.pct >= 70 ? 'rgba(16,185,129,0.75)' : (s.pct >= 50 ? 'rgba(245,158,11,0.75)' : 'rgba(239,68,68,0.75)'));

                if (kmkSubjectChartInstance) kmkSubjectChartInstance.destroy();
                kmkSubjectChartInstance = new Chart(document.getElementById('kmkSubjectChart'), {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [
                            {
                                label: '% Docentes Capacitados',
                                data,
                                backgroundColor: bgColors,
                                borderRadius: 8,
                                borderSkipped: false
                            },
                            {
                                label: 'Meta 70%',
                                data: stats.map(() => 70),
                                type: 'line',
                                borderColor: 'var(--mp-ok)',
                                borderDash: [6,4],
                                borderWidth: 2,
                                pointRadius: 0,
                                fill: false,
                                tension: 0
                            }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' },
                            tooltip: {
                                callbacks: {
                                    label: ctx => ctx.dataset.label === 'Meta 70%'
                                        ? 'Meta: 70%'
                                        : `${ctx.parsed.y}% (${stats[ctx.dataIndex]?.trained || 0}/${stats[ctx.dataIndex]?.total || 0} docentes)`
                                }
                            }
                        },
                        scales: {
                            y: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' }, grid: { color: 'var(--mp-surface-alt)' } },
                            x: { grid: { display: false } }
                        }
                    }
                });

                // Subject cards
                const cardsEl = document.getElementById('kmk-subject-cards');
                cardsEl.innerHTML = stats.map(s => {
                    const color = s.pct >= 70 ? 'var(--mp-ok)' : (s.pct >= 50 ? 'var(--mp-warn)' : 'var(--mp-danger)');
                    const teacherList = (s.teachers || []).map(t =>
                        `<div class="training-teacher-item">✅ <strong>${t.name}</strong>
                         <small style="margin-left:auto;color:var(--mp-text-faint);">${t.date ? new Date(t.date).toLocaleDateString('es') : ''} ${t.score ? '· ' + t.score + '/25' : ''}</small></div>`
                    ).join('') || '<div style="color:var(--mp-text-faint);font-size:0.82em;">No hay docentes capacitados aún.</div>';
                    return `<div class="training-subject-card" style="border-left-color:${color};">
                        <div class="tsc-header"><span style="font-size:1.4em;">${s.icon}</span>${s.subjectName}</div>
                        <div class="tsc-pct" style="color:${color};">${s.pct}%</div>
                        <small style="color:var(--mp-text-faint);">${s.trained} / ${s.total} docentes</small>
                        <div class="tsc-bar"><div class="tsc-bar-fill" style="width:${s.pct}%;background:${color};"></div></div>
                        <div class="tsc-teachers">${teacherList}</div>
                    </div>`;
                }).join('');

            } catch(e) {
                document.getElementById('kmk-stats-loading').style.display = 'none';
                showToast('Error de conexión al cargar stats KMK', true);
            }
        }

        async function loadKmkTeachers() {
            document.getElementById('kmk-teachers-table-wrap').innerHTML = '<p style="text-align:center;padding:20px;"><i class="fas fa-spinner fa-spin"></i> Cargando...</p>';
            try {
                const res = await fetch('/api/admin/kmk-trained-teachers');
                const result = await res.json();
                if (!result.success) { showToast('Error cargando docentes', true); return; }
                kmkAllTeachersData = result.teachers;
                renderKmkTeachersTable(kmkAllTeachersData);
            } catch(e) {
                showToast('Error de conexión', true);
            }
        }

        function renderKmkTeachersTable(teachers) {
            const wrap = document.getElementById('kmk-teachers-table-wrap');
            if (!teachers.length) {
                wrap.innerHTML = '<p style="text-align:center;color:var(--mp-text-faint);padding:20px;">No se encontraron docentes.</p>';
                return;
            }
            let html = `<table class="admin-table"><thead><tr>
                <th>Docente</th><th>Asignatura</th><th>Estado</th><th>Fecha</th><th>Puntaje</th>
            </tr></thead><tbody>`;
            teachers.forEach(t => {
                const nombre = ((t.first_name || '') + ' ' + t.last_name).trim() || t.id;
                const asig = t.subject_assigned || t.subject || '—';
                const estado = t.training_completed
                    ? '<span style="color:var(--mp-ok);font-weight:600;"><i class="fas fa-check-circle"></i> Capacitado</span>'
                    : '<span style="color:var(--mp-danger);"><i class="fas fa-times-circle"></i> Pendiente</span>';
                const fecha = t.training_date ? new Date(t.training_date).toLocaleDateString('es') : '—';
                const score = t.training_score != null ? `<strong style="color:${t.training_score >= 75 ? 'var(--mp-ok)' : 'var(--mp-danger)'}">${t.training_score}%</strong>` : '—';
                html += `<tr data-name="${nombre.toLowerCase()}" data-subject="${(t.subject_assigned||'').toLowerCase()}">
                    <td><strong>${nombre}</strong></td><td>${asig}</td><td>${estado}</td><td>${fecha}</td><td>${score}</td>
                </tr>`;
            });
            html += '</tbody></table>';
            wrap.innerHTML = html;
        }

        function filterKmkTeachers() {
            const search = (document.getElementById('kmkTeacherSearch')?.value || '').toLowerCase();
            const subj = (document.getElementById('kmkSubjectFilter')?.value || '').toLowerCase();
            const filtered = kmkAllTeachersData.filter(t => {
                const nombre = ((t.first_name || '') + ' ' + t.last_name).toLowerCase();
                const asig = (t.subject_assigned || t.subject || '').toLowerCase();
                return (!search || nombre.includes(search)) && (!subj || asig.includes(subj));
            });
            renderKmkTeachersTable(filtered);
        }

        // ── KMK Quiz ──
        async function initKmkQuiz() {
            const teacherId = document.getElementById('kmkQuizTeacherSelect').value;
            if (!teacherId) { showToast('Selecciona un docente primero', true); return; }
            document.getElementById('kmk-quiz-area').innerHTML = '<p style="text-align:center"><i class="fas fa-spinner fa-spin"></i> Cargando preguntas...</p>';
            try {
                const res = await fetch('/api/kmk-training/questions');
                const result = await res.json();
                if (!result.success) { showToast('Error cargando preguntas', true); return; }
                kmkQuizQuestions = result.questions;
                kmkQuizAnswers = {};
                renderKmkQuiz();
            } catch(e) { showToast('Error de conexión', true); }
        }

        function renderKmkQuiz() {
            const categories = [
                { key: 'fundamentos', label: '📚 Fundamentos KMK' },
                { key: 'busqueda', label: '🔍 Búsqueda y Análisis de Información' },
                { key: 'seguridad', label: '🛡️ Seguridad y Privacidad Digital' },
                { key: 'produccion', label: '🎨 Producción de Contenido Digital' },
                { key: 'comunicacion', label: '🤝 Comunicación y Colaboración Digital' }
            ];
            const answered = Object.keys(kmkQuizAnswers).length;
            const total = kmkQuizQuestions.length;
            let html = `<div class="kmk-quiz-container">
                <div class="kmk-progress-bar-wrap"><div class="kmk-progress-bar" style="width:${Math.round((answered/total)*100)}%"></div></div>
                <p style="font-size:0.85em;color:var(--mp-text-faint);text-align:right;margin-top:4px;">${answered}/${total} respondidas</p>`;

            categories.forEach(cat => {
                const catQuestions = kmkQuizQuestions.filter(q => q.category === cat.key);
                if (!catQuestions.length) return;
                html += `<div class="kmk-category-header"><i class="fas fa-layer-group"></i>${cat.label}</div>`;
                catQuestions.forEach((q, qi) => {
                    const answered = kmkQuizAnswers[q.id];
                    const cardClass = answered !== undefined
                        ? (answered === q.correct ? 'answered-correct' : 'answered-wrong') : '';
                    html += `<div class="kmk-question-card ${cardClass}" id="qcard-${q.id}">
                        <div class="kmk-question-num">Pregunta ${kmkQuizQuestions.indexOf(q)+1} / ${total}
                            <span class="kmk-difficulty diff-${q.difficulty}">${q.difficulty}</span>
                        </div>
                        <div class="kmk-question-text">${q.question}</div>
                        <div class="kmk-options">`;
                    q.options.forEach((opt, oi) => {
                        let cls = '';
                        if (answered !== undefined) {
                            if (oi === q.correct) cls = 'correct';
                            else if (oi === answered && answered !== q.correct) cls = 'wrong';
                        }
                        html += `<div class="kmk-option ${cls}" onclick="answerKmkQuestion('${q.id}',${oi},${q.correct})" id="kmkopt-${q.id}-${oi}">
                            <span style="min-width:22px;font-weight:700;">${String.fromCharCode(65+oi)}.</span>${opt}
                        </div>`;
                    });
                    const expDisplay = answered !== undefined ? 'block' : 'none';
                    html += `</div>
                        <div class="kmk-explanation" id="exp-${q.id}" style="display:${expDisplay};">
                            💡 <strong>Explicación:</strong> ${q.explanation}
                        </div>
                    </div>`;
                });
            });

            // If all answered, show result + register button
            if (answered === total) {
                const correct = Object.entries(kmkQuizAnswers).filter(([qid, ans]) => {
                    const q = kmkQuizQuestions.find(q => q.id === qid);
                    return q && ans === q.correct;
                }).length;
                const pct = Math.round((correct/total)*100);
                const passed = pct >= 70;
                html += `<div class="kmk-result-card" style="${passed ? '' : 'background:linear-gradient(135deg,var(--mp-danger-soft),var(--mp-danger-soft));border-color:var(--mp-danger);'}">
                    <div class="kmk-result-pct" style="color:${passed ? 'var(--mp-ok)' : 'var(--mp-danger)'}">${pct}%</div>
                    <p style="font-size:1.2em;font-weight:700;margin:8px 0;">${correct} / ${total} respuestas correctas</p>
                    <p style="color:${passed ? 'var(--mp-ok)' : 'var(--mp-danger)'};font-weight:600;">${passed ? '🎓 ¡Capacitación KMK aprobada!' : '⚠️ Puntaje insuficiente. Se requiere 70% para aprobar.'}</p>
                    ${passed ? `<button class="btn btn-success" style="margin-top:16px;font-size:1em;" onclick="registerKmkTraining(${correct}, ${total})">
                        <i class="fas fa-save"></i> Registrar Capacitación Aprobada
                    </button>` : `<button class="btn btn-primary" style="margin-top:16px;" onclick="initKmkQuiz()">
                        <i class="fas fa-redo"></i> Intentar de nuevo
                    </button>`}
                </div>`;
            } else {
                html += `<div style="text-align:center;padding:20px;">
                    <button class="btn btn-primary" onclick="renderKmkQuiz()" style="opacity:0.5;cursor:default;" disabled>
                        Responde todas las preguntas para ver el resultado
                    </button>
                </div>`;
            }

            html += '</div>';
            document.getElementById('kmk-quiz-area').innerHTML = html;
        }

        function answerKmkQuestion(qId, selectedIdx, correctIdx) {
            if (kmkQuizAnswers[qId] !== undefined) return; // already answered
            kmkQuizAnswers[qId] = selectedIdx;
            // Show explanation
            const exp = document.getElementById('exp-' + qId);
            if (exp) exp.style.display = 'block';
            // Update card class
            const card = document.getElementById('qcard-' + qId);
            if (card) card.classList.add(selectedIdx === correctIdx ? 'answered-correct' : 'answered-wrong');
            // Update options visual
            kmkQuizQuestions.find(q => q.id === qId)?.options.forEach((_, oi) => {
                const opt = document.getElementById(`kmkopt-${qId}-${oi}`);
                if (!opt) return;
                if (oi === correctIdx) opt.classList.add('correct');
                else if (oi === selectedIdx) opt.classList.add('wrong');
            });
            // Update progress bar
            const answered = Object.keys(kmkQuizAnswers).length;
            const total = kmkQuizQuestions.length;
            const bar = document.querySelector('.kmk-progress-bar');
            if (bar) bar.style.width = Math.round((answered/total)*100) + '%';
            // If all answered, re-render to show result
            if (answered === total) setTimeout(() => renderKmkQuiz(), 400);
        }

        async function registerKmkTraining(score, total) {
            const teacherId = document.getElementById('kmkQuizTeacherSelect').value;
            if (!teacherId) { showToast('No se pudo identificar el docente', true); return; }
            try {
                const res = await fetch('/api/kmk-training/complete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ teacher_id: teacherId, score, total })
                });
                const result = await res.json();
                if (result.success) {
                    showToast('✅ ¡Capacitación KMK registrada exitosamente!');
                    kmkQuizAnswers = {};
                    document.getElementById('kmkQuizTeacherSelect').value = '';
                    document.getElementById('kmk-quiz-area').innerHTML = '<p style="text-align:center;color:var(--mp-ok);padding:20px;font-weight:600;"><i class="fas fa-check-circle fa-2x"></i><br>Capacitación registrada. Puedes ver el docente en la pestaña "Cobertura por Asignatura".</p>';
                } else {
                    showToast('Error: ' + result.message, true);
                }
            } catch(e) { showToast('Error de conexión', true); }
        }

        // Load teacher list for quiz select on page load
        (async () => {
            try {
                const res = await fetch('/api/admin/kmk-trained-teachers');
                const result = await res.json();
                if (result.success) {
                    const sel = document.getElementById('kmkQuizTeacherSelect');
                    result.teachers.forEach(t => {
                        const name = ((t.first_name || '') + ' ' + (t.last_name || '')).trim() || t.id;
                        const opt = document.createElement('option');
                        opt.value = t.id;
                        opt.textContent = name + (t.training_completed ? ' ✅' : '');
                        sel.appendChild(opt);
                    });
                }
            } catch(e) {}
        })();

        // ════════════════════════════════════════
        // MULTIMEDIA STATS — JAVASCRIPT
        // ════════════════════════════════════════
        let mmSubjectChartInstance = null;
        let mmAllProductsData = [];

        async function loadMultimediaStats() {
            document.getElementById('mm-loading').style.display = 'block';
            document.getElementById('mm-chart-area').style.display = 'none';
            document.getElementById('mm-subject-cards').style.display = 'none';
            document.getElementById('mm-products-detail').style.display = 'none';
            try {
                const [statsRes, prodRes] = await Promise.all([
                    fetch('/api/admin/multimedia-stats'),
                    fetch('/api/admin/multimedia-products')
                ]);
                const statsResult = await statsRes.json();
                const prodResult = await prodRes.json();
                document.getElementById('mm-loading').style.display = 'none';

                if (!statsResult.success) { showToast('Error cargando stats multimedia', true); return; }
                const { stats, totalStudents } = statsResult;
                mmAllProductsData = prodResult.products || [];

                // Chart
                document.getElementById('mm-chart-area').style.display = 'block';
                const labels = stats.map(s => s.icon + ' ' + s.subjectName);
                const data = stats.map(s => s.pct);
                const bgColors = stats.map(s => s.pct >= 85 ? 'rgba(2,132,199,0.75)' : (s.pct >= 50 ? 'rgba(245,158,11,0.75)' : 'rgba(239,68,68,0.75)'));

                if (mmSubjectChartInstance) mmSubjectChartInstance.destroy();
                mmSubjectChartInstance = new Chart(document.getElementById('mmSubjectChart'), {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [
                            {
                                label: '% Estudiantes con producto publicado',
                                data,
                                backgroundColor: bgColors,
                                borderRadius: 8,
                                borderSkipped: false
                            },
                            {
                                label: 'Meta 85%',
                                data: stats.map(() => 85),
                                type: 'line',
                                borderColor: 'var(--mp-danger)',
                                borderDash: [6,4],
                                borderWidth: 2.5,
                                pointRadius: 0,
                                fill: false,
                                tension: 0
                            }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' },
                            tooltip: {
                                callbacks: {
                                    label: ctx => ctx.dataset.label === 'Meta 85%'
                                        ? 'Meta: 85%'
                                        : `${ctx.parsed.y}% (${stats[ctx.dataIndex]?.uniqueStudents || 0} estudiantes / ${totalStudents} total · ${stats[ctx.dataIndex]?.totalProducts || 0} productos)`
                                }
                            }
                        },
                        scales: {
                            y: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' }, grid: { color: 'var(--mp-surface-alt)' } },
                            x: { grid: { display: false } }
                        }
                    }
                });

                // Subject cards
                const cardsEl = document.getElementById('mm-subject-cards');
                cardsEl.style.display = 'grid';
                const typeIcons = { video: '🎬', presentacion: '📊', canvas: '🎨', otro: '📁' };
                const typeCounts = (products) => {
                    const counts = {};
                    products.forEach(p => { counts[p.product_type] = (counts[p.product_type] || 0) + 1; });
                    return Object.entries(counts).map(([t, c]) => `${typeIcons[t] || '📁'} ${t}: ${c}`).join(' · ');
                };
                cardsEl.innerHTML = stats.map(s => {
                    const color = s.pct >= 85 ? '#0284c7' : (s.pct >= 50 ? 'var(--mp-warn)' : 'var(--mp-danger)');
                    return `<div class="training-subject-card" style="border-left-color:${color};">
                        <div class="tsc-header"><span style="font-size:1.4em;">${s.icon}</span>${s.subjectName}</div>
                        <div class="tsc-pct" style="color:${color};">${s.pct}%</div>
                        <small style="color:var(--mp-text-faint);">${s.uniqueStudents} estudiantes · ${s.totalProducts} productos</small>
                        <div class="tsc-bar"><div class="tsc-bar-fill" style="width:${s.pct}%;background:${color};"></div></div>
                        ${s.totalProducts > 0 ? `<div style="margin-top:8px;font-size:0.8em;color:var(--mp-text-faint);">${typeCounts(s.products)}</div>` : '<div style="font-size:0.8em;color:var(--mp-text-faint);margin-top:8px;">Sin productos aún</div>'}
                    </div>`;
                }).join('');

                // Products detail
                document.getElementById('mm-products-detail').style.display = 'block';
                renderMmProductsList(mmAllProductsData);

            } catch(e) {
                document.getElementById('mm-loading').style.display = 'none';
                showToast('Error de conexión al cargar multimedia', true);
            }
        }

        function filterMmProducts() {
            const subj = document.getElementById('mmProductSubjectFilter').value;
            const type = document.getElementById('mmProductTypeFilter').value;
            const filtered = mmAllProductsData.filter(p =>
                (!subj || p.subject === subj) && (!type || p.product_type === type)
            );
            renderMmProductsList(filtered);
        }

        function renderMmProductsList(products) {
            const list = document.getElementById('mm-products-list');
            if (!products.length) {
                list.innerHTML = '<p style="text-align:center;color:var(--mp-text-faint);padding:20px;">No se encontraron productos con los filtros aplicados.</p>';
                return;
            }
            const typeIcons = { video: '🎬', presentacion: '📊', canvas: '🎨', otro: '📁' };
            const typeClasses = { video: 'mm-type-video', presentacion: 'mm-type-presentacion', canvas: 'mm-type-canvas', otro: 'mm-type-otro' };
            list.innerHTML = products.slice(0, 100).map(p => {
                const student = p.students;
                const studentName = student ? (student.full_name || student.username) : '—';
                const studentClass = student ? student.class_name : '';
                const linkHtml = p.link
                    ? `<a href="${p.link}" target="_blank" rel="noopener" style="color:#0284c7;font-size:0.85em;word-break:break-all;"><i class="fas fa-external-link-alt"></i> ${p.link.slice(0,60)}...</a>`
                    : '';
                const imgHtml = p.image_url
                    ? `<img src="${p.image_url}" alt="Producto" style="max-width:120px;max-height:90px;border-radius:6px;border:1px solid var(--mp-border);margin-top:8px;" onerror="this.style.display='none'">`
                    : '';
                return `<div class="mm-product-card">
                    <div>
                        <span class="mm-product-type-badge ${typeClasses[p.product_type] || 'mm-type-otro'}">${typeIcons[p.product_type] || '📁'} ${p.product_type}</span>
                        ${imgHtml}
                    </div>
                    <div>
                        <div style="font-weight:700;color:var(--mp-text);margin-bottom:4px;">${studentName} <span class="count-badge">${studentClass}</span></div>
                        <div style="font-size:0.82em;color:var(--mp-text-faint);margin-bottom:6px;">${p.subject} · ${new Date(p.created_at).toLocaleDateString('es')}</div>
                        <div style="font-size:0.9em;color:var(--mp-text-soft);">${p.description || '<em style="color:var(--mp-text-faint);">Sin descripción</em>'}</div>
                        ${linkHtml}
                    </div>
                    <div style="font-size:0.75em;color:var(--mp-text-faint);text-align:right;white-space:nowrap;">${p.activity_id}</div>
                </div>`;
            }).join('');
            if (products.length > 100) {
                list.innerHTML += `<p style="text-align:center;color:var(--mp-text-faint);font-size:0.85em;padding:10px;">Mostrando los primeros 100 de ${products.length} productos.</p>`;
            }
        }
        // ─── RETO 0 STATS ───
        async function loadReto0Stats() {
            const loading = document.getElementById('reto0-loading');
            const content = document.getElementById('reto0-stats-content');
            loading.style.display = 'block';
            content.style.display = 'none';

            try {
                const res = await fetch('/api/admin/reto0-stats');
                const data = await res.json();

                if (data.success) {
                    document.getElementById('reto0-global-pct').textContent = data.completionPct + '%';
                    document.getElementById('reto0-completed-count').textContent = data.completedCount;
                    document.getElementById('reto0-total-students').textContent = data.totalStudents;
                    
                    // Update main KPI card
                    const kpiPct = document.getElementById('kpi-reto0-pct');
                    if (kpiPct) kpiPct.textContent = data.passingPct + '%';

                    // Fill class table
                    const classBody = document.getElementById('reto0-class-body');
                    classBody.innerHTML = '';
                    Object.keys(data.classStats).forEach(cls => {
                        const s = data.classStats[cls];
                        const row = `
                            <tr>
                                <td><strong>${cls}</strong></td>
                                <td>${s.total}</td>
                                <td>${s.completed}</td>
                                <td><span class="count-badge" style="background:${s.pct >= 100 ? 'var(--mp-ok-soft)' : 'var(--mp-accent-soft)'}; color:${s.pct >= 100 ? 'var(--mp-ok)' : '#1e40af'}">${s.pct}%</span></td>
                                <td>
                                    <div style="width:100px; background:var(--mp-border); height:8px; border-radius:4px; overflow:hidden;">
                                        <div style="width:${s.pct}%; height:100%; background:${s.pct >= 100 ? 'var(--mp-ok)' : 'var(--mp-accent)'};"></div>
                                    </div>
                                </td>
                            </tr>
                        `;
                        classBody.insertAdjacentHTML('beforeend', row);
                    });

                    // Fill questions grid
                    const questionsGrid = document.getElementById('reto0-questions-grid');
                    questionsGrid.innerHTML = '';
                    data.questions.forEach(q => {
                        const qNum = q.id.replace('eval_q', '');
                        const card = `
                            <div style="padding:10px; background:var(--mp-surface); border:1px solid var(--mp-border); border-radius:8px; text-align:center;">
                                <div style="font-size:0.7em; color:var(--mp-text-faint); font-weight:700;">Q${qNum}</div>
                                <div style="font-size:1.1em; font-weight:900; color:var(--mp-text);">${q.pct}%</div>
                                <div style="width:100%; height:4px; background:var(--mp-surface-alt); border-radius:2px; margin-top:5px; overflow:hidden;">
                                    <div style="width:${q.pct}%; height:100%; background:var(--mp-accent);"></div>
                                </div>
                            </div>
                        `;
                        questionsGrid.insertAdjacentHTML('beforeend', card);
                    });

                    content.style.display = 'block';
                }
            } catch (e) {
                console.error(e);
                alert("Error al cargar estadísticas de Reto 0");
            }
            loading.style.display = 'none';
        }

        async function viewStudentProfile(studentId) {
            try {
                const res = await fetch('/api/admin/student-profile/' + studentId);
                const data = await res.json();
                
                if (!data.success) {
                    return alert('Error al cargar el perfil: ' + (data.message || 'Desconocido'));
                }

                const s = data.student;
                const profile = data.profileData || {};

                // Actualizar Modal UI
                document.getElementById('spModalName').innerText = s.full_name || s.username || 'Sin Nombre';
                document.getElementById('spModalClass').innerText = s.class_name || '-';
                
                // Mostrar Avatar o Placeholder
                const avatarDiv = document.getElementById('spModalAvatar');
                if (profile.profile_photo && profile.profile_photo.length < 15) {
                    avatarDiv.innerHTML = `<div style="font-size: 4em; line-height: 1;">${profile.profile_photo}</div>`;
                } else if (profile.profile_photo && profile.profile_photo.startsWith('data:image')) {
                    avatarDiv.innerHTML = `<img src="${profile.profile_photo}" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover;">`;
                } else {
                    avatarDiv.innerHTML = `<i class="fas fa-user-circle" style="font-size: 5em; color: var(--mp-border-strong);"></i>`;
                }

                // Generar lista de respuestas
                const listDiv = document.getElementById('spModalAnswers');
                let answersHtml = '';
                
                const excludeKeys = ['profile_photo', 'star_rating'];
                
                for (const [key, value] of Object.entries(profile)) {
                    if (excludeKeys.includes(key)) continue;
                    
                    let displayValue = value;
                    if (typeof value === 'boolean') {
                        displayValue = value ? 'Sí' : 'No';
                    } else if (Array.isArray(value)) {
                        displayValue = value.join(', ');
                    } else if (!value) {
                        displayValue = '<em style="color:var(--mp-text-faint)">Sin respuesta</em>';
                    }

                    answersHtml += `
                        <div style="margin-bottom: 8px; border-bottom: 1px solid var(--mp-surface-alt); padding-bottom: 8px;">
                            <span style="font-size: 0.8em; font-weight: bold; color: var(--mp-text-faint); display: block; text-transform: uppercase;">${key.replace(/_/g, ' ')}</span>
                            <span style="color: var(--mp-text);">${displayValue}</span>
                        </div>
                    `;
                }

                if (!answersHtml) {
                    answersHtml = '<p style="color:var(--mp-text-faint); text-align:center; padding: 20px;">Este estudiante aún no ha completado el Reto 0.</p>';
                }

                listDiv.innerHTML = answersHtml;
                
                // Mostrar calificación de estrellas si existe
                const starsDiv = document.getElementById('spModalStars');
                if (profile.star_rating) {
                    let stars = '';
                    for(let i=0; i<5; i++) {
                        stars += `<i class="fas fa-star" style="color: ${i < profile.star_rating ? 'var(--mp-warn)' : 'var(--mp-border)'}"></i>`;
                    }
                    starsDiv.innerHTML = stars;
                    starsDiv.style.display = 'block';
                } else {
                    starsDiv.style.display = 'none';
                }

                // Abrir modal
                document.getElementById('studentProfileModalOverlay').style.display = 'flex';

            } catch (e) {
                console.error(e);
                alert('Error de red al cargar el perfil.');
            }
        }

        function closeStudentProfileModal() {
            document.getElementById('studentProfileModalOverlay').style.display = 'none';
        }

    // ════════════════════════════════════════
    // EXECUTIVE DASHBOARD TABS LOGIC
    // ════════════════════════════════════════
    let chartKlasseInst, chartSubjectInst;

    async function refreshExecutiveData() {
        const filterPeriodEl = document.getElementById('filterPeriod');
        const filterYearEl = document.getElementById('filterYear');
        if (!filterPeriodEl || !filterYearEl) return;

        const period = filterPeriodEl.value;
        const year = filterYearEl.value;
        
        // Load KPIs
        try {
            const resp = await fetch('/api/admin/kpis');
            const data = await resp.json();
            if (data.success) {
                document.getElementById('kpiStudents').textContent = data.kpis.totalStudents;
                document.getElementById('kpiProgress').textContent = data.kpis.progressRate + '%';
                document.getElementById('kpiTeachers').textContent = data.kpis.teachersCertified + '%';
                document.getElementById('kpiDevices').textContent = data.kpis.totalDevices;
                document.getElementById('kpiIncidents').textContent = data.kpis.openIncidents;
            }
        } catch (e) { console.error('Error loading KPIs:', e); }

        // Load charts
        try {
            const resp = await fetch('/api/admin/progress-by-klasse?year=' + year);
            const data = await resp.json();
            if (data.success) {
                updateKlasseChart(data.data);
            }
        } catch (e) { console.error('Error loading Klasse chart:', e); }

        try {
            const resp = await fetch('/api/admin/progress-by-subject?year=' + year);
            const data = await resp.json();
            if (data.success) {
                updateSubjectChart(data.data);
            }
        } catch (e) { console.error('Error loading Subject chart:', e); }

        // Load no progress students
        try {
            const resp = await fetch('/api/admin/students-without-progress?year=' + year);
            const data = await resp.json();
            if (data.success) {
                renderNoProgressList(data.students);
            }
        } catch (e) { console.error('Error loading no progress:', e); }

        // Load pending teachers
        try {
            const resp = await fetch('/api/admin/teachers-status');
            const data = await resp.json();
            if (data.success) {
                renderPendingTeachers(data.pending);
            }
        } catch (e) { console.error('Error loading teachers:', e); }
    }

    function updateKlasseChart(data) {
        const canvas = document.getElementById('chartKlasse');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (chartKlasseInst) chartKlasseInst.destroy();
        chartKlasseInst = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(d => d.klasse),
                datasets: [{
                    label: '% Progreso',
                    data: data.map(d => d.progress),
                    backgroundColor: data.map(d => d.progress >= 100 ? 'var(--mp-ok)' : d.progress >= 50 ? 'var(--mp-warn)' : 'var(--mp-danger)')
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, max: 100 } }
            }
        });
    }

    function updateSubjectChart(data) {
        const canvas = document.getElementById('chartSubject');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (chartSubjectInst) chartSubjectInst.destroy();
        chartSubjectInst = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(d => d.subject),
                datasets: [{
                    label: 'Estudiantes Activos',
                    data: data.map(d => d.count),
                    backgroundColor: ['var(--mp-danger)', '#0ea5e9', '#ea580c', 'var(--mp-ok)', 'var(--mp-accent)']
                }]
            },
            options: {
                responsive: true
            }
        });
    }

    function renderNoProgressList(students) {
        const el = document.getElementById('noProgressList');
        if (!el) return;
        if (!students || students.length === 0) {
            el.innerHTML = '<p style="color:var(--mp-ok);"><i class="fas fa-check-circle"></i> ¡Todos los estudiantes tienen progreso!</p>';
            return;
        }
        let html = '<table><thead><tr><th>Estudiante</th><th>Clase</th></tr></thead><tbody>';
        students.slice(0, 10).forEach(s => {
            html += `<tr><td>${s.name}</td><td>${s.class}</td></tr>`;
        });
        html += '</tbody></table>';
        if (students.length > 10) html += `<p style="color:var(--mp-text-faint);">...y ${students.length - 10} más</p>`;
        el.innerHTML = html;
    }

    function renderPendingTeachers(teachers) {
        const el = document.getElementById('pendingTeachersList');
        if (!el) return;
        if (!teachers || teachers.length === 0) {
            el.innerHTML = '<p style="color:var(--mp-ok);"><i class="fas fa-check-circle"></i> ¡Todos los docentes están certificados!</p>';
            return;
        }
        let html = '<table><thead><tr><th>Docente</th><th>Materia</th><th>Estado y Sugerencia</th></tr></thead><tbody>';
        teachers.forEach(t => {
            let statusHtml = '<span class="badge badge-warning">Sin iniciar</span>';
            if (t.score !== undefined && t.score !== null && t.score < 75) {
                statusHtml = `<span class="badge badge-danger">Falló (${t.score}%) - Revisar contenidos KMK</span>`;
            } else if (t.score !== undefined && t.score !== null) {
                statusHtml = `<span class="badge badge-warning">Pendiente (${t.score}%)</span>`;
            }
            html += `<tr><td>${t.name}</td><td>${t.subject || 'N/A'}</td><td>${statusHtml}</td></tr>`;
        });
        html += '</tbody></table>';
        el.innerHTML = html;
    }

    // ════════════════════════════════════════
    // INVENTORY TABS LOGIC
    // ════════════════════════════════════════
    let editingInventoryDevice = null;

    async function loadInventoryDevices() {
        const locationEl = document.getElementById('filterLocation');
        const statusEl = document.getElementById('filterStatus');
        if (!locationEl || !statusEl) return;

        const location = locationEl.value;
        const status = statusEl.value;
        
        let url = '/api/devices';
        const params = [];
        if (location) params.push('location=' + location);
        if (status) params.push('status=' + status);
        if (params.length) url += '?' + params.join('&');

        try {
            const resp = await fetch(url);
            const result = await resp.json();
            
            const tbody = document.getElementById('devicesTableBody');
            if (!tbody) return;

            if (!result.success || !result.devices.length) {
                tbody.innerHTML = 
                    '<tr><td colspan="7" style="text-align:center; color:var(--mp-text-faint);">No hay equipos registrados</td></tr>';
                updateInventoryStats([]);
                return;
            }

            updateInventoryStats(result.devices);
            
            tbody.innerHTML = result.devices.map(d => `
                <tr>
                    <td><strong>${d.serial_number}</strong></td>
                    <td>${d.type}</td>
                    <td>${d.brand || ''} ${d.model || ''}</td>
                    <td>${d.location}</td>
                    <td><span class="badge badge-${d.status}">${getInventoryStatusLabel(d.status)}</span></td>
                    <td style="max-width:150px; overflow:hidden; text-overflow:ellipsis;">${d.notes || '—'}</td>
                    <td>
                        <button class="btn btn-sm btn-primary" onclick="openInventoryEditModal(${JSON.stringify(d).replace(/"/g, '&quot;')})">
                            <i class="fas fa-edit"></i>
                        </button>
                    </td>
                </tr>
            `).join('');
        } catch (e) {
            console.error('Error loading devices:', e);
            showToast('Error al cargar equipos', true);
        }
    }

    function updateInventoryStats(devices) {
        const total = devices.length;
        const available = devices.filter(d => d.status === 'available').length;
        const assigned = devices.filter(d => d.status === 'assigned').length;
        const maintenance = devices.filter(d => d.status === 'maintenance' || d.status === 'broken').length;
        
        const statTotal = document.getElementById('statTotal');
        const statAvailable = document.getElementById('statAvailable');
        const statAssigned = document.getElementById('statAssigned');
        const statMaintenance = document.getElementById('statMaintenance');

        if (statTotal) statTotal.textContent = total;
        if (statAvailable) statAvailable.textContent = available;
        if (statAssigned) statAssigned.textContent = assigned;
        if (statMaintenance) statMaintenance.textContent = maintenance;
    }

    function getInventoryStatusLabel(status) {
        const labels = {
            'available': 'Disponible',
            'assigned': 'Asignado',
            'maintenance': 'En Mantenimiento',
            'broken': 'Dañado'
        };
        return labels[status] || status;
    }

    function openInventoryAddModal() {
        editingInventoryDevice = null;
        const modal = document.getElementById('deviceModal');
        if (!modal) return;

        document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus"></i> Agregar Equipo';
        document.getElementById('deviceForm').reset();
        document.getElementById('deviceId').value = '';
        modal.classList.add('active');
    }

    function openInventoryEditModal(device) {
        editingInventoryDevice = device;
        const modal = document.getElementById('deviceModal');
        if (!modal) return;

        document.getElementById('modalTitle').innerHTML = '<i class="fas fa-edit"></i> Editar Equipo';
        document.getElementById('deviceId').value = device.id;
        document.getElementById('serial_number').value = device.serial_number;
        document.getElementById('type').value = device.type;
        document.getElementById('brand').value = device.brand || '';
        document.getElementById('model').value = device.model || '';
        document.getElementById('location').value = device.location;
        document.getElementById('status').value = device.status;
        document.getElementById('notes').value = device.notes || '';
        modal.classList.add('active');
    }

    function closeInventoryModal() {
        const modal = document.getElementById('deviceModal');
        if (modal) modal.classList.remove('active');
    }

    // Attach inventory form listener on load
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('deviceForm');
        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const device = {
                    serial_number: document.getElementById('serial_number').value,
                    type: document.getElementById('type').value,
                    brand: document.getElementById('brand').value || null,
                    model: document.getElementById('model').value || null,
                    location: document.getElementById('location').value,
                    status: document.getElementById('status').value,
                    notes: document.getElementById('notes').value || null
                };

                const id = document.getElementById('deviceId').value;
                const url = id ? '/api/devices/' + id : '/api/devices';
                const method = id ? 'PUT' : 'POST';

                try {
                    const resp = await fetch(url, {
                        method: method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(device)
                    });
                    const result = await resp.json();
                    
                    if (result.success) {
                        showToast(id ? 'Equipo actualizado' : 'Equipo agregado');
                        closeInventoryModal();
                        loadInventoryDevices();
                    } else {
                        showToast(result.message || 'Error', true);
                    }
                } catch (e) {
                    showToast('Error de conexión', true);
                }
            });
        }
    });
        </script>

