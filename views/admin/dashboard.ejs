        // ── Filter students & Pagination ──
        let currentPage = 1;
        const itemsPerPage = 30;
        let filteredRows = [];
        let showAllRows = false; // true when a specific class is selected

        function filterStudents(resetPage = true) {
            const filter = document.getElementById('filterClass').value;
            const rows = document.querySelectorAll('#studentsTableBody tr');
            filteredRows = [];

            rows.forEach(row => {
                const cls = row.getAttribute('data-class');
                if (!filter || cls === filter) {
                    filteredRows.push(row);
                } else {
                    row.style.display = 'none';
                }
            });

            // When a specific Klasse is selected, show ALL students (no pagination)
            showAllRows = !!filter;

            if (resetPage) currentPage = 1;
            renderPagination();
            document.getElementById('studentCount').textContent = filteredRows.length + ' estudiante(s)';
        }

        function renderPagination() {
            filteredRows.forEach(row => row.style.display = 'none');

            if (showAllRows) {
                // Show ALL rows for the selected class
                filteredRows.forEach(row => row.style.display = '');
                updatePaginationUI();
                return;
            }

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            for (let i = startIndex; i < endIndex && i < filteredRows.length; i++) {
                filteredRows[i].style.display = '';
            }
            updatePaginationUI();
        }

        function updatePaginationUI() {
            const paginationDiv = document.getElementById('paginationControls');
            if (!paginationDiv) return;

            if (showAllRows) {
                paginationDiv.style.display = 'none';
                return;
            }

            const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
            if (totalPages <= 1) {
                paginationDiv.style.display = 'none';
                return;
            }

            paginationDiv.style.display = 'flex';
            let html = '';
            html += `<button class="btn btn-primary btn-sm" onclick="changePage(currentPage - 1)" ${currentPage === 1 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}><i class="fas fa-chevron-left"></i> Anterior</button>`;
            html += `<span style="font-weight: 600; color: var(--mp-text-soft);">Página ${currentPage} de ${totalPages}</span>`;
            html += `<button class="btn btn-primary btn-sm" onclick="changePage(currentPage + 1)" ${currentPage === totalPages ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>Siguiente <i class="fas fa-chevron-right"></i></button>`;

            paginationDiv.innerHTML = html;
        }

        function changePage(page) {
            const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderPagination();
        }

