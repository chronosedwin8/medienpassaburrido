        // ── Teacher Reports & Pagination ──
        let teacherData = [];
        let curTeacherPage = 1;
        const teacherItemsPerPage = 15;

        async function loadTeacherReports() {
            try {
                document.getElementById('teacherReportOutput').innerHTML = '<p><i class="fas fa-spinner fa-spin"></i> ' + window.t('adm_cargando_reporte_de_docentes') + '</p>';
                const res = await fetch('/api/admin/teacher-reports');
                const result = await res.json();
                if (result.success) {
                    teacherData = result.teachers;
                    curTeacherPage = 1;
                    renderTeacherReports();
                } else {
                    document.getElementById('teacherReportOutput').innerHTML = '<p style="color:red">' + window.t('adm_js_error_cargar_docentes') + '</p>';
                }
            } catch (e) {
                document.getElementById('teacherReportOutput').innerHTML = '<p style="color:red">' + window.t('adm_error_de_conexion') + '</p>';
            }
        }

        function renderTeacherReports() {
            const output = document.getElementById('teacherReportOutput');
            const startIndex = (curTeacherPage - 1) * teacherItemsPerPage;
            const endIndex = startIndex + teacherItemsPerPage;
            const pageData = teacherData.slice(startIndex, endIndex);

            if (pageData.length === 0) {
                output.innerHTML = '<p>' + window.t('adm_js_sin_docentes_grupos') + '</p>';
                document.getElementById('teacherPaginationControls').style.display = 'none';
                return;
            }

            let html = `
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>${window.t('adm_js_docente')}</th>
                            <th>${window.t('adm_js_total_grupos')}</th>
                            <th>${window.t('adm_js_grupos_asignados')}</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            pageData.forEach(t => {
                html += `
                    <tr>
                        <td><strong>${escapeHtml(t.name)}</strong></td>
                        <td><span class="count-badge">${t.groupsCount}</span></td>
                        <td><small style="color:#64748b">${escapeHtml(t.groups)}</small></td>
                    </tr>
                `;
            });

            html += `</tbody></table>`;
            output.innerHTML = html;

            // Pagination UI
            const totalPages = Math.ceil(teacherData.length / teacherItemsPerPage);
            const pagControls = document.getElementById('teacherPaginationControls');
            if (totalPages > 1) {
                pagControls.style.display = 'flex';
                let pgHtml = `<button class="btn btn-primary btn-sm" onclick="changeTeacherPage(curTeacherPage - 1)" ${curTeacherPage === 1 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}><i class="fas fa-chevron-left"></i> ${window.t('adm_js_anterior')}</button>`;
                pgHtml += `<span style="font-weight: 600; color: #475569;">${window.t('adm_js_pagina')} ${curTeacherPage} ${window.t('adm_js_de')} ${totalPages}</span>`;
