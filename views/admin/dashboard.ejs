                    updates[field] = inp.value;
                }
            });

            // Si es la tabla teachers, normalizar el correo y autocompletar id/subject si es nuevo
            if (dbCurrentTable === 'teachers') {
                if (updates.email) {
                    updates.email = updates.email.trim().toLowerCase();
                }
                if (!dbEditingRecord) {
                    updates.id = 'teacher_' + (updates.email || '');
                    updates.subject = '';
                }
            }

            // Si es teachers, guardar el rol extra
            if (dbCurrentTable === 'teachers') {
                const roleSelect = document.getElementById('dbedit_extra_role');
                const targetEmail = (updates.email || '').trim().toLowerCase();
                if (roleSelect && targetEmail) {
