                    <label><strong><span data-i18n="adm_periodo"><%= locals.t('adm_periodo') %></span></strong></label>
                    <select id="filterPeriod">
                        <option value="all" data-i18n-option="adm_todos"><%= locals.t('adm_todos') %></option>
                        <option value="1" data-i18n-option="adm_periodo_1"><%= locals.t('adm_periodo_1') %></option>
                        <option value="2" data-i18n-option="adm_periodo_2"><%= locals.t('adm_periodo_2') %></option>
                        <option value="3" data-i18n-option="adm_periodo_3"><%= locals.t('adm_periodo_3') %></option>
                        <option value="4" data-i18n-option="adm_periodo_4"><%= locals.t('adm_periodo_4') %></option>
                    </select>
                    <label><strong><span data-i18n="adm_ano"><%= locals.t('adm_ano') %></span></strong></label>
                    <%# Años de Administración › Año escolar; el año en curso viene elegido %>
                    <select id="filterYear" onchange="refreshExecutiveData()">
                        <% (locals.schoolYears || []).slice().reverse().forEach(y => { %>
                            <option value="<%= y.id %>" <%= y.active ? 'selected' : '' %>><%= y.label %></option>
                        <% }) %>
                    </select>
                    <button onclick="refreshExecutiveData()"><i class="fas fa-sync-alt"></i> <span data-i18n="adm_actualizar"><%= locals.t('adm_actualizar') %></span></button>
                    <button onclick="window.print()"><i class="fas fa-print"></i> <span data-i18n="adm_imprimir"><%= locals.t('adm_imprimir') %></span></button>
                </div>

                <!-- KPI Cards -->
                <div class="kpi-grid">
                    <div class="kpi-card">
                        <div class="icon">👥</div>
                        <div class="value" id="kpiStudents">0</div>
                        <div class="label"><span data-i18n="adm_ind_estudiantes_base"><%= locals.t('adm_ind_estudiantes_base') %></span></div>
                    </div>
                    <div class="kpi-card success">
                        <div class="icon">🏆</div>
                        <div class="value" id="kpiProgress">0%</div>
                        <div class="label"><span data-i18n="adm_ind_b_meta"><%= locals.t('adm_ind_b_meta') %></span></div>
                    </div>
                    <div class="kpi-card success">
                        <div class="icon">🎓</div>
                        <div class="value" id="kpiTeachers">0%</div>
                        <div class="label"><span data-i18n="adm_ind_a_meta"><%= locals.t('adm_ind_a_meta') %></span></div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="charts-grid">
                    <div class="chart-card">
                        <h3><i class="fas fa-chart-bar"></i> <span data-i18n="adm_progreso_por_klasse_k3_k9"><%= locals.t('adm_progreso_por_klasse_k3_k9') %></span></h3>
                        <canvas id="chartKlasse" height="200"></canvas>
                    </div>
                    <div class="chart-card">
                        <h3><i class="fas fa-chart-bar"></i> <span data-i18n="adm_progreso_por_materia"><%= locals.t('adm_progreso_por_materia') %></span></h3>
                        <canvas id="chartSubject" height="200"></canvas>
                    </div>
                </div>

                <!-- Tables -->
                <div class="tables-grid">
                    <%# Por clase: estudiantes que no han guardado ningún reto en el año elegido (services/no_progress.js) %>
                    <div class="table-card snp-card" id="noProgressCard">
                        <div class="snp-head">
                            <h3><i class="fas fa-user-clock"></i> <span data-i18n="adm_snp_titulo"><%= locals.t('adm_snp_titulo') %></span></h3>
                            <select id="snpSegment" onchange="renderNoProgressList()" aria-label="<%= locals.t('adm_ind_segmento') %>">
                                <option value="" data-i18n-option="adm_snp_todos_segmentos"><%= locals.t('adm_snp_todos_segmentos') %></option>
                                <option value="preescolar" data-i18n-option="adm_ind_seg_preescolar"><%= locals.t('adm_ind_seg_preescolar') %></option>
                                <option value="primaria" data-i18n-option="adm_ind_seg_primaria"><%= locals.t('adm_ind_seg_primaria') %></option>
                                <option value="secundaria" data-i18n-option="adm_ind_seg_secundaria"><%= locals.t('adm_ind_seg_secundaria') %></option>
                            </select>
                        </div>
                        <p class="tc-note" data-i18n="adm_snp_ayuda"><%= locals.t('adm_snp_ayuda') %></p>
                        <div id="noProgressList">
                            <p style="color:#64748b;"><span data-i18n="adm_cargando"><%= locals.t('adm_cargando') %></span></p>
                        </div>
                    </div>
                    <div class="table-card">
                        <h3><i class="fas fa-chalkboard-teacher"></i> <span data-i18n="adm_docentes_pendientes_de_certificacion"><%= locals.t('adm_docentes_pendientes_de_certificacion') %></span></h3>
                        <div id="pendingTeachersList">
                            <p style="color:#64748b;"><span data-i18n="adm_cargando"><%= locals.t('adm_cargando') %></span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%# Datos fijos para el JavaScript del panel %>
        <script>
            window.ADMIN_ACCESS = <%- JSON.stringify({ role: panelAccess.role, isDeveloper: isDev, email: String((locals.adminUser && locals.adminUser.email) || '').trim().toLowerCase() }).replace(/</g, '\\u003c') %>;
            window.MAPPING_CLASSES = <%- JSON.stringify(locals.mappingClasses || []) %>;
        </script>

    </div><!-- end admin-container -->


    <!-- Toast -->
    <div class="admin-toast" id="adminToast"></div>

    <script>
        // ── Indicadores institucionales: a) profesores capacitados, b) mínimo 3 de 6 retos, c) evidencias ──
        let indicatorData = null;

        async function loadAllKpis() {
            const loading = document.getElementById('indicatorsLoading');
            if (loading) loading.hidden = false;
            try {
                const result = await (await fetch('/api/admin/indicators')).json();
                if (!result.success) return showToast(window.t('adm_error') + (result.message || ''), true);
                indicatorData = result.indicators;
                renderIndicators();
            } catch (e) {
                showToast(window.t('adm_error_de_conexion'), true);
            } finally {
                if (loading) loading.hidden = true;
            }
        }

        function indicatorCell(item) {
            if (!item || !item.total) return '<span style="color:#94a3b8;">—</span>';
            return `<strong>${item.pct}%</strong> <span style="color:#64748b;">(${item.value} ${escapeHtml(window.t('adm_ind_de'))} ${item.total})</span>`;
        }

        function renderIndicators() {
            if (!indicatorData) return;
            const cards = [
                { key: 'teachers', icon: '🎓', title: 'adm_ind_a_titulo', detail: 'adm_ind_a_detalle', from: '#059669', to: '#047857' },
                { key: 'students', icon: '🏆', title: 'adm_ind_b_titulo', detail: 'adm_ind_b_detalle', from: '#4f46e5', to: '#6d28d9' },
                { key: 'evidence', icon: '📎', title: 'adm_ind_c_titulo', detail: 'adm_ind_c_detalle', from: '#0284c7', to: '#0369a1' }
            ];
            document.getElementById('indicatorCards').innerHTML = cards.map(card => {
                const item = indicatorData[card.key];
                return `<div class="kpi-goal-card" data-indicator="${card.key}" style="background:linear-gradient(135deg,${card.from},${card.to});">
                    <div class="kpi-icon">${card.icon}</div>
                    <div class="kpi-pct">${item.pct}%</div>
                    <div class="kpi-label"><strong>${escapeHtml(window.t(card.title))}</strong><br>${item.value} ${escapeHtml(window.t('adm_ind_de'))} ${item.total} · ${escapeHtml(window.t('adm_ind_meta'))} ${item.goal}%</div>
                    <div class="indicator-bar" role="img" aria-label="${item.pct}% / ${item.goal}%">
                        <div class="indicator-bar-fill" style="width:${Math.min(100, item.pct)}%;"></div>
                        <div class="indicator-bar-goal" style="left:${item.goal}%;"></div>
                    </div>
                    <div class="kpi-label" style="font-size:0.8em;">${escapeHtml(window.t(card.detail))}</div>
                </div>`;
            }).join('');

            const rows = ['preescolar', 'primaria', 'secundaria'].map(segment => `<tr data-segment="${segment}">
                <td><strong>${escapeHtml(window.t('adm_ind_seg_' + segment))}</strong></td>
                <td>${indicatorCell(indicatorData.teachers.segments[segment])}</td>
                <td>${indicatorCell(indicatorData.students.segments[segment])}</td>
                <td>${indicatorCell(indicatorData.evidence.segments[segment])}</td>
            </tr>`);
            const noSegment = indicatorData.teachers.segments.sin_segmento;
            if (noSegment && noSegment.total) {
                rows.push(`<tr data-segment="sin_segmento">
                    <td><strong>${escapeHtml(window.t('adm_ind_seg_sin'))}</strong></td>
                    <td>${indicatorCell(noSegment)}</td><td>${indicatorCell(null)}</td><td>${indicatorCell(null)}</td>
                </tr>`);
            }
            rows.push(`<tr data-segment="total" style="background:#f8fafc;">
                <td><strong>${escapeHtml(window.t('adm_ind_total'))}</strong></td>
                <td>${indicatorCell(indicatorData.teachers)}</td>
                <td>${indicatorCell(indicatorData.students)}</td>
                <td>${indicatorCell(indicatorData.evidence)}</td>
            </tr>`);
            document.getElementById('indicatorSegments').innerHTML = rows.join('');
            renderIndicatorClasses();
        }

        function renderIndicatorClasses() {
            if (!indicatorData) return;
            const segment = document.getElementById('indicatorSegmentFilter').value;
            const list = indicatorData.classes.filter(row => !segment || row.segment === segment);
            document.getElementById('indicatorClasses').innerHTML = list.map(row => `<tr>
                <td><strong>${escapeHtml(row.className)}</strong></td>
                <td>${escapeHtml(window.t('adm_ind_seg_' + row.segment))}</td>
                <td>${row.total}</td>
                <td>${indicatorCell({ value: row.withMin, total: row.total, pct: row.minPct })}</td>
                <td>${indicatorCell({ value: row.withEvidence, total: row.total, pct: row.evidencePct })}</td>
            </tr>`).join('');
        }

        // ── Main tab switching ──
        // ── Navegación con el menú lateral: Inicio · Administración · Indicadores ──
        // Cada acceso del menú (partials/admin-sidebar.ejs) apunta a un bloque de esta página:
        // una pestaña (.tab-content), una subsección de Administración o una tarjeta de Indicadores.
        // La posición queda en la URL (#indicadores/matriz) para volver a ella al recargar o con Atrás.
        // Perfil (services/access.js): el desarrollador ve Administración; directivo y coordinador,
        // Consultas de solo lectura (Estudiantes, Docentes y Certificados). Igual que partials/admin-sidebar.ejs.
        const IS_DEV = !!(window.ADMIN_ACCESS && window.ADMIN_ACCESS.isDeveloper);
        const COMMON_LISTS = {
            estudiantes: { tab: 'contenidos', sub: 'students' },
            docentes: { tab: 'contenidos', sub: 'teachers', onEnter: () => loadTeachersList() },
            certificados: { tab: 'contenidos', sub: 'certificates', onEnter: () => enterCertificates() }
        };
        const ADMIN_SECTIONS = {
            ...(IS_DEV ? {
                administracion: {
                    estudiantes: COMMON_LISTS.estudiantes,
                    docentes: COMMON_LISTS.docentes,
                    materias: { tab: 'contenidos', sub: 'subjects', onEnter: () => loadSubjectsAdmin() },
                    anio: { tab: 'contenidos', sub: 'years', onEnter: () => loadSchoolYears() },
                    configuracion: { tab: 'contenidos', sub: 'config' },
                    certificados: COMMON_LISTS.certificados,
                    mapeo: { tab: 'contenidos', sub: 'mapping', onEnter: () => enterTeacherMapping() },
                    ayuda: { tab: 'contenidos', sub: 'help', onEnter: () => enterHelpModule() },
                    idiomas: { tab: 'contenidos', sub: 'i18n', onEnter: () => loadI18n() }
                }
            } : { consultas: COMMON_LISTS }),
            indicadores: {
                kpis: { card: 'kpi-goals-card' },
                docentes_cursos: { card: 'docentes-cursos-card', onEnter: () => { if (!tcData) loadTeacherCourses(); } },
                avance: { card: 'avance-retos-card', onEnter: () => { if (!retosProgress) loadRetosProgress(); } },
                matriz: { card: 'matriz-global-card' },
                multimedia: { card: 'productos-multimedia-card' },
                kmk: { card: 'kmk-docente-card' },
                grupos: { card: 'grupos-docente-card' },
                psp: { card: 'psp-estudiante-card' }
            }
        };
        // Pestañas sin secciones
        const SINGLE_SECTIONS = {
            inicio: { tab: 'executive' },
        };
        const LISTS_MAIN = IS_DEV ? 'administracion' : 'consultas';
        // Enlaces viejos (#indicadores/reto0) llevan a Avance retos; #administracion y #consultas, a la del perfil
        const SECTION_ALIASES = { reto0: 'avance' };
        let currentMain = null;

        function navigate(main, sub, { updateHash = true } = {}) {
            if (main === 'administracion' || main === 'consultas') main = LISTS_MAIN;
            if (!SINGLE_SECTIONS[main] && !ADMIN_SECTIONS[main]) main = 'inicio';
            if (SECTION_ALIASES[sub]) {
                sub = SECTION_ALIASES[sub];
                if (!updateHash) history.replaceState(null, '', `#${main}/${sub}`);
            }
            const single = SINGLE_SECTIONS[main];
            const group = ADMIN_SECTIONS[main] || {};
            if (!single && !group[sub]) sub = Object.keys(group)[0];
            const target = single || group[sub];
            const enteringMain = main !== currentMain;

            // Acceso activo en el menú lateral (partials/admin-sidebar.ejs)
            document.querySelectorAll('.admin-tab').forEach(b => b.classList.toggle('active', b.dataset.main === main));
            document.querySelectorAll('.admin-subtab').forEach(b => {
                b.classList.toggle('active', b.dataset.main === main && b.dataset.sub === sub);
            });

            // Contenido visible
            const tabName = target.card ? 'monitoreo' : target.tab;
            document.querySelectorAll('.tab-content').forEach(el => el.classList.toggle('active', el.id === 'maintab-' + tabName));
            if (target.sub) {
                document.querySelectorAll('.sub-section').forEach(el => el.classList.toggle('active', el.id === 'sub-' + target.sub));
            }
            if (target.card) {
                Object.values(ADMIN_SECTIONS.indicadores).forEach(({ card }) => {
                    const el = document.getElementById(card);
                    if (el) el.style.display = card === target.card ? '' : 'none';
                });
            }

            // Datos (los mismos cargadores de antes)
            if (main === 'inicio') {
                refreshExecutiveData();
            } else if (main === 'indicadores' && enteringMain) {
                loadAllKpis();
                loadKmkStats();
                loadMultimediaStats();
            }
            if (target.onEnter) target.onEnter();
            currentMain = main;

            // Si la dirección pedía una sección que este perfil no tiene, se corrige sin crear historial
            const hash = single ? '#' + main : `#${main}/${sub}`;
            if (location.hash !== hash) {
                if (updateHash) history.pushState(null, '', hash);
                else history.replaceState(null, '', hash);
            }
            window.scrollTo(0, 0);
        }

        function navigateFromHash() {
            const [main, sub] = decodeURIComponent(location.hash.replace(/^#/, '')).split('/');
            navigate(main || 'inicio', sub, { updateHash: false });
        }
        window.addEventListener('popstate', navigateFromHash);

        // Al cambiar de idioma, lang.js traduce los textos fijos; aquí se vuelve a dibujar lo
        // que arma JavaScript (tablas, gráficos, avisos) en la sección visible.
        document.addEventListener('langchange', () => {
            if (!currentMain) return; // primera carga: navigate() aún no dibujó nada
            filterStudents(false); // contador y paginación de Estudiantes
            renderTeachers();
            renderSubjectsAdmin();
            translateSubjectOptions();
            renderTeacherMapping();
            renderRetosProgress();
            renderHelpModule();
            renderTeacherCourses();
            fillCertSubjects();
            if (certData) renderCertificates();
            if (currentMain === 'inicio') {
                refreshExecutiveData();
            } else if (currentMain === 'indicadores') {
                loadAllKpis();
                loadKmkStats();
                loadMultimediaStats();
            }
        });

        // Nombres anteriores, por si algún botón o enlace todavía los usa
        function switchMainTab(name) {
            if (name === 'monitoreo') navigate('indicadores');
            else if (name === 'contenidos') navigate(LISTS_MAIN);
            else navigate('inicio');
        }

        function switchSub(name) {
            const entry = Object.entries(ADMIN_SECTIONS[LISTS_MAIN]).find(([, s]) => s.sub === name);
            navigate(LISTS_MAIN, entry ? entry[0] : undefined);
        }

        // ── Toast ──
        function showToast(msg, isError) {
            const toast = document.getElementById('adminToast');
            toast.textContent = msg;
            toast.style.background = isError ? '#ef4444' : '#059669';
            toast.style.display = 'block';
            setTimeout(() => toast.style.display = 'none', 3000);
        }

        // ── I18N Editor ──
        // Un diccionario por portal (comun, docentes, admin, manuales); se guarda solo con el botón.
        let i18nData = null;
        let i18nSection = 'comun';

        function escapeHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        async function loadI18n() {
            const grid = document.getElementById('i18nEditorGrid');
            const loading = document.getElementById('i18nLoading');
            const saveBtn = document.getElementById('i18nSaveBtn');
            i18nSection = document.getElementById('i18nSectionFilter').value || 'comun';
            grid.style.display = 'none';
            saveBtn.style.display = 'none';
            loading.style.display = 'block';
            try {
                const res = await fetch('/api/admin/i18n?section=' + encodeURIComponent(i18nSection));
                const result = await res.json();
                loading.style.display = 'none';
                if (result.success && result.i18n) {
                    i18nData = result.i18n;
                    renderI18nGrid(i18nData);
                    grid.style.display = 'block';
                    saveBtn.style.display = 'inline-block';
                } else {
                    showToast(window.t('adm_error') + (result.message || 'No se pudieron cargar las traducciones'), true);
                }
            } catch(e) {
                loading.style.display = 'none';
                showToast(window.t('adm_error_de_conexion_al_cargar_i18n'), true);
            }
        }

        function renderI18nGrid(data) {
            const tbody = document.getElementById('i18nTableBody');
            const langs = Object.keys(data); // ['de', 'en', 'es']
            const allKeys = new Set();
            langs.forEach(l => Object.keys(data[l]).forEach(k => allKeys.add(k)));
            
            let html = '';
            allKeys.forEach(key => {
                const k = escapeHtml(key);
                const cell = lang => {
                    const value = data[lang] ? (data[lang][key] || '') : '';
                    // Textos largos (párrafos de manuales) en un área de texto
                    return value.length > 80
                        ? `<td><textarea class="i18n-input" data-lang="${lang}" data-key="${k}" rows="3" style="width:100%; padding:4px 8px; border:1px solid #e2e8f0; border-radius:4px; font:inherit;">${escapeHtml(value)}</textarea></td>`
                        : `<td><input type="text" class="i18n-input" data-lang="${lang}" data-key="${k}" value="${escapeHtml(value)}" style="width:100%; padding:4px 8px; border:1px solid #e2e8f0; border-radius:4px;"></td>`;
                };
                html += `<tr data-key="${k}">
                    <td style="color:#64748b; font-size:0.85em; font-family:monospace;"><code>${k}</code></td>
                    ${cell('de')}${cell('en')}${cell('es')}
                </tr>`;
            });
            tbody.innerHTML = html;
        }

        function filterI18nRows() {
            const search = (document.getElementById('i18nSearch').value || '').toLowerCase();
            const lang = document.getElementById('i18nLangFilter').value;
            document.querySelectorAll('#i18nTableBody tr').forEach(row => {
                const key = row.getAttribute('data-key') || '';
                const inputs = row.querySelectorAll('.i18n-input');
                let visible = key.toLowerCase().includes(search);
                if (!visible) {
                    inputs.forEach(inp => { if (inp.value.toLowerCase().includes(search)) visible = true; });
                }
                // Language column filter
                if (lang !== 'all') {
                    const colMap = { de: 1, en: 2, es: 3 };
                    row.querySelectorAll('td').forEach((td, idx) => {
                        if (idx === 0) return; // key col always visible
                        td.style.display = (lang === 'all' || idx === colMap[lang]) ? '' : 'none';
                    });
                } else {
                    row.querySelectorAll('td').forEach(td => td.style.display = '');
                }
                row.style.display = visible ? '' : 'none';
            });
        }

        async function saveI18n() {
            if (!i18nData) return showToast(window.t('adm_carga_las_traducciones_primero'), true);
            // Collect all changed values from inputs
            const updated = JSON.parse(JSON.stringify(i18nData));
            document.querySelectorAll('.i18n-input').forEach(inp => {
                const lang = inp.getAttribute('data-lang');
                const key = inp.getAttribute('data-key');
                if (!updated[lang]) updated[lang] = {};
                updated[lang][key] = inp.value;
            });
            try {
                const res = await fetch('/api/admin/i18n', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ section: i18nSection, i18n: updated })
                });
                const result = await res.json();
                if (result.success) {
                    i18nData = updated;
                    showToast(window.t('adm_textos_actualizados_correctamente'));
                } else {
                    showToast(window.t('adm_error') + result.message, true);
                }
            } catch(e) {
                showToast(window.t('adm_error_de_conexion_al_guardar'), true);
            }
        }

        // ── Database Editor ──
        let dbCurrentTable = null;
        let dbEditingRecord = null;
        let adminTeacherRolesMap = {};

        async function loadDbTable(table) {
            dbCurrentTable = table;
            const loading = document.getElementById('dbLoadingMsg');
            const area = document.getElementById('dbEditorArea');
            const title = document.getElementById('dbTableTitle');
            area.style.display = 'none';
            loading.style.display = 'block';
            cancelDbEdit();
            try {
                if (table === 'teachers') {
                    try {
                        const rRes = await fetch('/api/admin/teacher-roles');
                        const rData = await rRes.json();
                        if (rData.success) adminTeacherRolesMap = rData.roles || {};
                    } catch(e){}
                }

                const res = await fetch('/api/admin/db-records/' + table);
                const result = await res.json();
                loading.style.display = 'none';
                if (!result.success) return showToast(window.t('adm_error') + result.message, true);
                
                const records = result.records || [];
                area.style.display = 'block';
                title.innerHTML = `<i class="fas fa-table"></i> ${window.t('adm_js_tabla')} <strong>${table}</strong> — ${records.length} ${window.t('adm_js_registros')}`;
                
                if (records.length === 0) {
                    document.getElementById('dbTableHead').innerHTML = '';
                    document.getElementById('dbTableBody').innerHTML = '<tr><td>' + window.t('adm_js_no_hay_registros') + '</td></tr>';
                    document.getElementById('dbAddBtn').style.display = 'inline-block'; // Allow adding to empty table
                    return;
                }

                document.getElementById('dbAddBtn').style.display = 'inline-block';

                // Build header from first record keys
                const keys = Object.keys(records[0]);
                const displayKeys = keys.filter(k => !['password', 'doc_number'].includes(k));
                let headHtml = '<tr>' + displayKeys.map(k => `<th data-field="${k}">${k}</th>`).join('');
                if (table === 'teachers') headHtml += '<th>' + window.t('adm_js_rol_extra') + '</th>';
                headHtml += '<th>' + window.t('adm_acciones') + '</th></tr>';
                document.getElementById('dbTableHead').innerHTML = headHtml;

                // Build rows
                let rows = '';
                records.forEach((rec, idx) => {
                    let rowHtml = `<tr data-idx="${idx}">` + 
                        displayKeys.map(k => {
                            const val = rec[k] != null ? String(rec[k]) : '—';
                            return `<td style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${val}">${val}</td>`;
                        }).join('');
                    
                    if (table === 'teachers') {
                        const extraRole = adminTeacherRolesMap[(rec.email || '').toLowerCase()] || 'profesor';
                        let badgeBg = '#64748b';
                        if (extraRole === 'desarrollador') badgeBg = '#9333ea';
                        else if (extraRole === 'coordinador') badgeBg = '#2563eb';
                        else if (extraRole === 'directivo') badgeBg = '#059669';
                        rowHtml += `<td><span style="background:${badgeBg}; color:white; padding:4px 10px; border-radius:12px; font-size:0.8em; font-weight:bold; text-transform:uppercase; display:inline-block;">${extraRole}</span></td>`;
                    }

                    rowHtml += `<td style="white-space:nowrap;">
                            <button class="btn btn-sm" style="background:#6366f1;color:white;margin-right:4px;" onclick='openDbEdit(${JSON.stringify(rec)})'><i class="fas fa-edit"></i></button>
                            <button class="btn btn-sm" style="background:#ef4444;color:white;" onclick="deleteDbRecord('${rec.id}')"><i class="fas fa-trash"></i></button>
                        </td></tr>`;
                    rows += rowHtml;
                });
                document.getElementById('dbTableBody').innerHTML = rows;
            } catch(e) {
                loading.style.display = 'none';
                showToast(window.t('adm_error_de_conexion'), true);
            }
        }

        async function deleteDbRecord(id) {
            if (!confirm(window.t('adm_estas_seguro_de_que_deseas_eliminar'))) return;
            try {
                const res = await fetch(`/api/admin/db-records/${dbCurrentTable}/${id}`, { method: 'DELETE' });
                const result = await res.json();
                if (result.success) {
                    showToast(window.t('adm_registro_eliminado'));
                    loadDbTable(dbCurrentTable);
                    if (dbCurrentTable === 'teachers') loadTeachersList(); // la lista de arriba
                } else {
                    showToast(window.t('adm_error') + result.message, true);
                }
            } catch(e) { showToast(window.t('adm_error_de_conexion'), true); }
        }

