<%- include('../layout/head', { title: 'Administración — MedienPass', lang: typeof lang !== 'undefined' ? lang : 'es' }) %>

<style>
.mp-auth-wrap { flex:1; display:grid; place-items:center; padding: var(--mp-5) var(--mp-4); }
.mp-auth-card { width:100%; max-width:390px; }
.mp-auth-head { text-align:center; margin-bottom: var(--mp-6); }
.mp-auth-mark {
    width:44px; height:44px; margin:0 auto var(--mp-4);
    border-radius: var(--mp-radius);
    background: var(--mp-text); color: var(--mp-bg);
    display:grid; place-items:center; font-weight:700; font-size: var(--mp-text-lg);
}
</style>

<div class="mp-auth-wrap">
    <div class="mp-auth-card">
        <div class="mp-auth-head">
            <div class="mp-auth-mark" aria-hidden="true">M</div>
            <h1 style="font-size: var(--mp-text-2xl); margin-bottom: var(--mp-1);">Administración</h1>
            <p class="mp-faint mp-sm">Acceso restringido al personal autorizado</p>
        </div>

        <div class="mp-card">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mp-alert mp-alert--danger" role="alert" style="margin-bottom: var(--mp-4);"><%= error %></div>
            <% } %>

            <form method="POST" action="/admin/login" class="mp-stack">
                <div class="mp-field">
                    <label class="mp-label" for="email">Correo</label>
                    <input class="mp-input" type="email" id="email" name="email"
                           autocomplete="username" required autofocus>
                </div>

                <div class="mp-field">
                    <label class="mp-label" for="password">Contraseña</label>
                    <input class="mp-input" type="password" id="password" name="password"
                           autocomplete="current-password" required>
                </div>

                <button type="submit" class="mp-btn mp-btn--primary mp-btn--block mp-btn--lg">
                    Iniciar sesión
                </button>
            </form>
        </div>

        <p style="margin-top: var(--mp-5); text-align:center;" class="mp-sm mp-faint">
            <a href="/teacher/login">Área docente</a> · <a href="/login">Área de estudiantes</a>
        </p>
    </div>
</div>

<%- include('../layout/foot') %>
