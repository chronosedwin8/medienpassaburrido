<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin — MedienPass</title>
    <%- i18nScripts() %>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        /* Estilo del colegio: fondo gris claro, tarjeta blanca con el logo y la franja Alemania · Colombia */
        body {
            background: #f6f6f6;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 24px 16px;
            box-sizing: border-box;
        }
        body::before { content: ''; position: fixed; inset: 0 0 auto 0; height: 6px; background: linear-gradient(90deg, #111111 0 16.66%, #c03928 16.66% 33.33%, #f0ce2d 33.33% 75%, #21529b 75% 87.5%, #c03928 87.5% 100%); }

        .admin-login-card {
            position: relative;
            background: white;
            border-radius: 20px;
            padding: 30px 36px 34px;
            max-width: 460px;
            width: 100%;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 18px 40px rgba(0, 0, 0, 0.08);
            text-align: center;
            box-sizing: border-box;
        }

        .admin-login-logo { display: block; width: 180px; max-width: 65%; height: auto; margin: 6px auto 12px; }
        .admin-login-card h1 { font-family: 'Roboto Slab', 'Roboto', serif; font-size: 1.6em; color: #111111; margin: 0 0 4px; }
        .admin-login-card p { color: #54595f; margin: 0 0 20px; }

        .admin-login-card input {
            width: 100%;
            padding: 13px 16px;
            border: 2px solid #e2e2e2;
            border-radius: 12px;
            font-size: 1em;
            font-family: inherit;
            box-sizing: border-box;
        }
        .admin-login-card input:focus { border-color: #21529b; outline: none; box-shadow: 0 0 0 4px rgba(33, 82, 155, 0.14); }

        .login-submit {
            width: 100%;
            padding: 14px;
            background: #c03928;
            color: white;
            border: none;
            border-radius: 999px;
            font-family: inherit;
            font-size: 1.05em;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s, box-shadow 0.2s;
        }
        .login-submit:hover { background: #a92106; box-shadow: 0 8px 20px rgba(192, 57, 40, 0.25); }

        .admin-error {
            background: #fef2f2;
            color: #b91c1c;
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 0.9em;
            text-align: left;
        }

        .field { text-align: left; margin-bottom: 16px; }
        .field label { display: block; font-weight: 700; color: #111111; font-size: 0.9em; margin-bottom: 6px; }

        /* Perfiles */
        .profile-list { display: grid; gap: 10px; text-align: left; }
        .profile-option {
            display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 12px;
            padding: 14px 16px; border-radius: 14px; border: 2px solid var(--profile-border); background: var(--profile-bg);
            color: #1e293b; text-decoration: none; transition: transform 0.2s, border-color 0.2s;
        }
        .profile-option:hover, .profile-option:focus-visible { transform: translateY(-2px); border-color: var(--profile-color); }
        .profile-option .profile-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--profile-color); color: white; font-size: 1.2em; }
        .profile-option strong { display: block; color: var(--profile-color); font-size: 1em; }
        .profile-option small { display: block; color: #475569; font-size: 0.82em; line-height: 1.35; margin-top: 2px; }
        .profile-option .fa-chevron-right { color: var(--profile-color); }

        .profile-chosen {
            display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;
            padding: 10px 14px; margin-bottom: 18px; border-radius: 12px; background: var(--profile-bg); border: 2px solid var(--profile-border); text-align: left;
        }
        .profile-chosen span { color: var(--profile-color); font-weight: 700; }
        .profile-chosen a { color: #475569; font-size: 0.85em; text-decoration: underline; }

        .profile-coordinador { --profile-color: #21529b; --profile-bg: #eef4fb; --profile-border: #bcd2ee; }
        .profile-directivo { --profile-color: #a92106; --profile-bg: #fdf4f3; --profile-border: #f6cbc5; }
        .profile-desarrollador { --profile-color: #111111; --profile-bg: #f6f6f6; --profile-border: #d6d6d6; }

        .back-link { display: block; margin-top: 20px; color: #54595f; text-decoration: none; font-size: 0.9em; font-weight: 700; }
        .back-link:hover { color: #c03928; }

        @media (max-width: 420px) {
            .admin-login-card { padding: 28px 18px; }
            .profile-option { grid-template-columns: 40px 1fr; }
            .profile-option .fa-chevron-right { display: none; }
        }
    </style>
    <%- include('../partials/brand-head') %>
</head>

<%
const profileInfo = {
    coordinador: { icon: 'fa-clipboard-check', desc: 'adm_login_desc_coordinador' },
    directivo: { icon: 'fa-landmark', desc: 'adm_login_desc_directivo' },
    desarrollador: { icon: 'fa-code', desc: 'adm_login_desc_desarrollador' }
};
%>

<body>
    <main class="admin-login-card <%= profile ? 'profile-' + profile : '' %>">
        <div style="display: flex; justify-content: flex-end; margin: -20px -10px 4px 0;">
            <%- include('../partials/lang-switch') %>
        </div>
        <img class="admin-login-logo" src="/img/logo-colegio.png" width="511" height="360" alt="Colegio Alemán · Deutsche Schule Barranquilla">
        <h1><span data-i18n="adm_login_administracion"><%= locals.t('adm_login_administracion') %></span></h1>
        <p><span data-i18n="adm_login_medienpass_panel_de_control"><%= locals.t('adm_login_medienpass_panel_de_control') %></span></p>

        <% if (error) { %>
            <div class="admin-error" role="alert"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <% if (!profile) { %>
            <%# Paso 1: elegir el perfil %>
            <p style="color:#111111; font-weight:700; margin-bottom:12px;"><span data-i18n="adm_login_elige_perfil"><%= locals.t('adm_login_elige_perfil') %></span></p>
            <nav class="profile-list" aria-label="<%= locals.t('adm_login_elige_perfil') %>">
                <% profiles.forEach(p => { const info = profileInfo[p]; %>
                    <a class="profile-option profile-<%= p %>" href="/admin/login?perfil=<%= p %>" data-profile="<%= p %>">
                        <span class="profile-icon" aria-hidden="true"><i class="fas <%= info.icon %>"></i></span>
                        <span>
                            <strong data-i18n="adm_login_soy_<%= p %>"><%= locals.t('adm_login_soy_' + p) %></strong>
                            <small data-i18n="<%= info.desc %>"><%= locals.t(info.desc) %></small>
                        </span>
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </a>
                <% }) %>
            </nav>
        <% } else { const info = profileInfo[profile]; %>
            <%# Paso 2: correo y documento del perfil elegido %>
            <div class="profile-chosen">
                <span><i class="fas <%= info.icon %>"></i> <span data-i18n="adm_role_<%= profile %>"><%= locals.t('adm_role_' + profile) %></span></span>
                <a href="/admin/login"><span data-i18n="adm_login_cambiar_perfil"><%= locals.t('adm_login_cambiar_perfil') %></span></a>
            </div>
            <form method="POST" action="/admin/login">
                <input type="hidden" name="profile" value="<%= profile %>">
                <div class="field">
                    <label for="adminEmail"><i class="fas fa-envelope"></i> <span data-i18n="adm_login_correo_institucional"><%= locals.t('adm_login_correo_institucional') %></span></label>
                    <input type="text" id="adminEmail" name="email" value="<%= email || '' %>" placeholder="nombre@colegioaleman.edu.co" autocomplete="username" autofocus required>
                </div>
                <div class="field" style="margin-bottom: 20px;">
                    <label for="adminDoc"><i class="fas fa-id-card"></i> <span data-i18n="adm_login_numero_de_documento"><%= locals.t('adm_login_numero_de_documento') %></span></label>
                    <input type="password" id="adminDoc" name="password" placeholder="<%= locals.t('adm_login_tu_numero_de_documento') %>" data-i18n-placeholder="adm_login_tu_numero_de_documento" autocomplete="current-password" required>
                </div>
                <button type="submit" class="login-submit"><i class="fas fa-sign-in-alt"></i> <span data-i18n="adm_login_ingresar_al_panel"><%= locals.t('adm_login_ingresar_al_panel') %></span></button>
            </form>
        <% } %>

        <a href="/login" class="back-link"><i class="fas fa-arrow-left"></i> <span data-i18n="adm_login_volver_al_inicio"><%= locals.t('adm_login_volver_al_inicio') %></span></a>
    </main>
</body>

</html>
