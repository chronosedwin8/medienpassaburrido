<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.t('adm_phi_titulo') %> - Medienpass</title>
    <%- i18nScripts() %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <%- include('../partials/brand-head') %>
    <style>
        :root { --ph-ink: #111; --ph-muted: #54595f; --ph-line: #e2e2e2; --ph-red: #a92106; --ph-green: #15803d; }
        body { font-family: 'Inter', system-ui, sans-serif; background: #f8fafc; color: var(--ph-ink); margin: 0; }
        main { max-width: 1000px; margin: 0 auto; padding: 28px 16px 60px; display: flex; flex-direction: column; gap: 18px; }
        .ph-card { background: #fff; border: 1px solid var(--ph-line); border-radius: 16px; padding: 20px; }
        h1 { margin: 0 0 6px; font-size: 1.5em; }
        p { color: var(--ph-muted); line-height: 1.45; margin: 0; }
        .ph-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 14px; }
        .ph-stat { border: 1px solid var(--ph-line); border-radius: 12px; padding: 12px; }
        .ph-stat strong { display: block; font-size: 1.4em; }
        .ph-stat span { color: var(--ph-muted); font-size: .85em; }
        .ph-btn { display: inline-flex; gap: 8px; align-items: center; border-radius: 999px; padding: 10px 18px; font: inherit; font-weight: 700; cursor: pointer; border: 2px solid var(--ph-ink); background: #fff; color: var(--ph-ink); }
        .ph-btn.primary { background: var(--ph-ink); color: #fff; }
        .ph-btn:disabled { opacity: .5; cursor: wait; }
        .ph-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: .88em; margin-top: 10px; }
        th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--ph-line); }
        details { margin-top: 12px; } summary { cursor: pointer; font-weight: 700; }
        .ph-msg { font-weight: 600; } .ph-ok { color: var(--ph-green); } .ph-err { color: var(--ph-red); }
        a.back { color: var(--ph-ink); font-weight: 600; }
        .ph-scroll { max-height: 320px; overflow: auto; }
    </style>
</head>
<body>
<main>
    <a class="back" href="/admin"><i class="fas fa-arrow-left"></i> <span data-i18n="adm_phi_volver"><%= locals.t('adm_phi_volver') %></span></a>
    <section class="ph-card">
        <h1 data-i18n="adm_phi_titulo"><%= locals.t('adm_phi_titulo') %></h1>
        <p data-i18n="adm_phi_intro"><%= locals.t('adm_phi_intro') %></p>
        <div class="ph-stats" id="stats"></div>
    </section>

    <% if (isDeveloper) { %>
    <section class="ph-card">
        <h2 style="margin:0 0 6px;font-size:1.15em" data-i18n="adm_phi_sync_titulo"><%= locals.t('adm_phi_sync_titulo') %></h2>
        <p data-i18n="adm_phi_sync_intro"><%= locals.t('adm_phi_sync_intro') %></p>
        <div class="ph-row">
            <button class="ph-btn" id="previewBtn" onclick="preview()"><i class="fas fa-magnifying-glass"></i> <span data-i18n="adm_phi_revisar"><%= locals.t('adm_phi_revisar') %></span></button>
            <button class="ph-btn primary" id="applyBtn" onclick="applySync()" disabled><i class="fas fa-arrows-rotate"></i> <span data-i18n="adm_phi_aplicar"><%= locals.t('adm_phi_aplicar') %></span></button>
            <span class="ph-msg" id="msg" role="status"></span>
        </div>
        <div id="plan"></div>
    </section>
    <% } %>
</main>
<script>
    const T = (k, f) => (window.t && window.t(k) !== k ? window.t(k) : f || k);
    const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    async function api(url, opts = {}) {
        const res = await fetch(url, { headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', ...opts });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || 'HTTP ' + res.status);
        return json;
    }
    function stat(value, label) { return `<div class="ph-stat"><strong>${esc(value)}</strong><span>${esc(label)}</span></div>`; }
    async function loadStatus() {
        const box = document.getElementById('stats');
        try {
            const s = await api('/api/admin/phidias/status');
            box.innerHTML = stat(s.phidias.students, T('adm_phi_estudiantes', 'Estudiantes en Phidias'))
                + stat(s.phidias.fetchedAt ? new Date(s.phidias.fetchedAt).toLocaleString() : '—', T('adm_phi_actualizado', 'Última lectura'))
                + stat(s.sso.configured ? '✅' : '—', T('adm_phi_sso', 'Ingreso con Microsoft'))
                + stat(s.assignments.backend === 'supabase' ? 'Supabase' : T('adm_phi_archivo_local', 'Archivo local'), T('adm_phi_asignaciones_en', 'Asignaciones guardadas en'));
        } catch (e) { box.textContent = e.message; }
    }
    let lastPlan = null;
    function table(rows, cols) {
        if (!rows.length) return '<p>—</p>';
        return `<div class="ph-scroll"><table><thead><tr>${cols.map(c => `<th>${esc(c[1])}</th>`).join('')}</tr></thead><tbody>${rows.map(r => `<tr>${cols.map(c => `<td>${esc(r[c[0]])}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
    }
    async function preview() {
        const btn = document.getElementById('previewBtn'); btn.disabled = true;
        const msg = document.getElementById('msg'); msg.textContent = T('adm_phi_leyendo', 'Leyendo Phidias…'); msg.className = 'ph-msg';
        try {
            const json = await api('/api/admin/phidias/sync-preview?refresh=1');
            lastPlan = json.plan;
            const cols = [['code', T('adm_phi_codigo', 'Código')], ['full_name', T('adm_phi_nombre', 'Nombre')], ['from', T('adm_phi_antes', 'Antes')], ['to', T('adm_phi_despues', 'Ahora')]];
            document.getElementById('plan').innerHTML =
                `<details open><summary>${esc(T('adm_phi_nuevos', 'Nuevos'))}: ${json.plan.summary.create}</summary>${table(json.plan.create.map(r => ({ ...r, from: '—', to: r.class_name })), cols)}</details>`
              + `<details><summary>${esc(T('adm_phi_cambian', 'Cambian de curso o nombre'))}: ${json.plan.summary.update}</summary>${table(json.plan.update, cols)}</details>`
              + `<details><summary>${esc(T('adm_phi_inactivos', 'Ya no están en Phidias (pasan a «sinact»)'))}: ${json.plan.summary.deactivate}</summary>${table(json.plan.deactivate, cols)}</details>`;
            document.getElementById('applyBtn').disabled = !(json.plan.summary.create + json.plan.summary.update + json.plan.summary.deactivate);
            msg.textContent = '';
            loadStatus();
        } catch (e) { msg.textContent = e.message; msg.className = 'ph-msg ph-err'; }
        btn.disabled = false;
    }
    async function applySync() {
        if (!lastPlan) return;
        const btn = document.getElementById('applyBtn'); btn.disabled = true;
        const msg = document.getElementById('msg'); msg.textContent = T('adm_phi_aplicando', 'Aplicando…'); msg.className = 'ph-msg';
        try {
            const json = await api('/api/admin/phidias/sync', { method: 'POST', body: '{}' });
            const r = json.result;
            msg.textContent = `${T('adm_phi_listo', 'Listo')}: +${r.created} · ${r.updated} · ${r.deactivated}` + (r.errors.length ? ` · ${r.errors.length} ${T('adm_phi_errores', 'errores')}` : '');
            msg.className = 'ph-msg ' + (r.errors.length ? 'ph-err' : 'ph-ok');
            lastPlan = null;
        } catch (e) { msg.textContent = e.message; msg.className = 'ph-msg ph-err'; btn.disabled = false; }
    }
    loadStatus();
</script>
</body>
</html>
