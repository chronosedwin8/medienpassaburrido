<%- include('partials/header') %>

<!-- Welcome Modal Overlay -->
<div id="welcomeModal" class="welcome-modal-overlay" style="display: none;">
    <div class="welcome-modal-card">
        <div class="welcome-modal-icon">✨</div>
        <h2 class="welcome-modal-title" data-i18n="welcomeTitle">BIENVENIDO A TU MEDIEN PASS</h2>
        <p class="welcome-modal-text" data-i18n="welcomeModalText">"POR FAVOR SELECCIONA TU IDIOMA SEGÚN LA ASIGNATURA A DESARROLLAR"</p>
        <button id="closeWelcomeModal" class="welcome-modal-btn" data-i18n="accept">Aceptar</button>
    </div>
</div>

    <!-- ═══ Early Script: define functions before buttons use them ═══ -->
        <script>
        // ─── Dashboard Language Switching ───
        function switchDashLang(lang, preventLoop) {
            // Update language tab buttons (if any remain)
            document.querySelectorAll('.lang-tab-btn').forEach(btn => {
                btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
            });

            // Call full language switch (updates data-i18n, data-lang-content, etc.)
            if (window.langUtils && !preventLoop) {
                window.langUtils.switchLang(lang);
            }

            // Update subject pill sub-names (show secondary language)
            document.querySelectorAll('[data-lang-sub]').forEach(el => {
                try {
                    const names = JSON.parse(el.getAttribute('data-lang-sub'));
                    if (lang === 'de') el.textContent = names.es || '';
                    else if (lang === 'en') el.textContent = names.es || '';
                    else el.textContent = names.de || '';
                } catch (e) { /* ignore */ }
            });

            // Update subject pill main names
            document.querySelectorAll('.subject-name-main[data-lang-content]').forEach(el => {
                try {
                    const names = JSON.parse(el.getAttribute('data-lang-content'));
                    el.textContent = names[lang] || names.de || '';
                } catch (e) { /* ignore */ }
            });
        }

        // ─── Subject Filtering (from header pills) ───
        function filterSubject(subject) {
            document.querySelectorAll('.subject-pill').forEach(btn => {
                btn.classList.toggle('active', btn.getAttribute('data-subject') === subject);
            });
            if (subject === 'all') {
                card.style.display = '';
            } else {
                card.style.display = card.getAttribute('data-subject') === subject ? '' : 'none';
            }
        }
    </script>

    <!-- ═══ Bienvenida: saludo con el nombre, clase y año escolar en curso ═══ -->
    <%# El año lo fija el desarrollador en Administración › Año escolar; el estudiante no lo elige. %>
    <% const heroNames = studentNames(student); %>
    <section class="dsb-hero" aria-labelledby="heroTitle">
        <div>
            <p class="dsb-eyebrow"><span class="notranslate" translate="no">MedienPass</span> · <span data-i18n="hdr_brand_sub"><%= locals.t('hdr_brand_sub') %></span></p>
            <h1 class="dsb-hero-title" id="heroTitle">👋 <span data-i18n="hello"><%= locals.t('hello') %></span>, <span class="notranslate" translate="no"><%= heroNames.first %></span>!</h1>
            <p class="dsb-hero-sub" data-i18n="welcome"><%= locals.t('welcome') %></p>
        </div>
        <dl class="dsb-facts">
            <div>
                <dt data-i18n="hdr_estudiante"><%= locals.t('hdr_estudiante') %></dt>
                <dd><i class="fas fa-user" aria-hidden="true"></i><span class="notranslate" translate="no"><%= heroNames.full %></span></dd>
            </div>
            <div>
                <dt data-i18n="classLabel"><%= locals.t('classLabel') %></dt>
                <dd><i class="fas fa-school" aria-hidden="true"></i><span class="notranslate" translate="no"><%= student.class_name %></span></dd>
            </div>
            <div>
                <dt data-i18n="schoolYear"><%= locals.t('schoolYear') %></dt>
                <dd id="currentSchoolYear" data-year="<%= currentYear %>"><i class="fas fa-calendar-days" aria-hidden="true"></i><span class="notranslate" translate="no"><%= (locals.schoolYear || {}).label || '' %></span></dd>
            </div>
        </dl>
    </section>

    <!-- ═══ Actividades asignadas por los docentes (GET /api/student/assignments) ═══ -->
    <% const myAssignments = typeof assignedActivities !== 'undefined' ? assignedActivities : []; %>
    <% if (myAssignments.length) { %>
    <section class="assigned-box" aria-labelledby="assignedTitle">
        <h2 id="assignedTitle"><i class="fas fa-list-check" aria-hidden="true"></i> <span data-i18n="est_asig_titulo"><%= locals.t('est_asig_titulo') %></span></h2>
        <div class="assigned-list">
            <% myAssignments.forEach(a => { const done = a.retos.every(r => r.status === 'won'); %>
            <article class="assigned-card <%= done ? 'is-done' : '' %>">
                <header>
                    <strong><%= a.title %></strong>
                    <% if (a.due_date) { %><span class="assigned-due"><i class="fas fa-calendar" aria-hidden="true"></i> <span data-i18n="est_asig_hasta"><%= locals.t('est_asig_hasta') %></span> <%= a.due_date %></span><% } %>
                </header>
                <% if (a.note) { %><p class="assigned-note"><%= a.note %></p><% } %>
                <div class="assigned-retos">
                    <% a.retos.forEach(r => { %>
                    <a class="assigned-reto st-<%= r.status %>" href="<%= r.href %>" data-assign-subject="<%= a.subject %>">
                        <span><%= r.status === 'won' ? '✅' : r.status === 'started' ? '🟡' : '⏳' %></span>
                        <span><%= r.reto === 0 ? locals.t('est_idx_reto_0_este_soy_yo') : locals.t('est_idx_reto_' + r.reto) %></span>
                    </a>
                    <% }) %>
                </div>
                <% if (a.by) { %><small class="assigned-by"><span data-i18n="est_asig_por"><%= locals.t('est_asig_por') %></span> <%= a.by %></small><% } %>
            </article>
            <% }) %>
        </div>
    </section>
    <% } %>

    <!-- ═══ Subject Dropdown Selector ═══ -->
    <div class="large-subject-select-container">
        <label for="subjectCombo" class="subject-combo-label">
            <i class="fas fa-graduation-cap"></i> <span data-i18n="selectSubjectLabel">SELECCIONA LA ASIGNATURA A TRABAJAR</span>
        </label>
        <select id="subjectCombo" class="large-subject-combo">
            <option value="" disabled selected data-i18n-option="est_idx_selecciona_la_asignatura_a_trabajar"><%= locals.t('est_idx_selecciona_la_asignatura_a_trabajar') %></option>
            <% (subjects || []).filter(sub => sub.active !== false).forEach(sub => { %>
                <% const isEnabled = !(enabledSubjects && enabledSubjects[sub.id] === false); %>
                <option value="<%= sub.id %>" <%= !isEnabled ? 'disabled' : '' %> data-names='<%- JSON.stringify(sub.name).replace(/'/g, "&#39;") %>' data-icon="<%= sub.icon %>">
                    <%= sub.icon %> <%= sub.name.es %> <%= !isEnabled ? '(No habilitada)' : '' %>
                </option>
            <% }); %>
        </select>
    </div>

    <!-- Placeholder when no subject is selected -->
    <div id="noSubjectSelectedPlaceholder" class="no-subject-placeholder">
        <div class="placeholder-icon">📚</div>
        <p class="placeholder-main" data-i18n="noSubjectSelectedMain">Por favor selecciona la asignatura en la que vas a trabajar.</p>
        <p class="placeholder-sub" data-i18n="noSubjectSelectedSub">Bitte wähle das Fach aus, an dem du arbeiten möchtest.</p>
    </div>

    <!-- ═══ Retos 0 a 6 de la materia elegida: siempre visibles, sin segundo combo ═══ -->
    <%# Cada reto de cada materia ya está en el HTML (enlace directo): mostrarlos solo depende de
        elegir la materia. El servidor envía de cada reto solo { id, level, subject, fields } (slimActivity). %>
    <div class="challenges-grid all-retos" id="challengesContainer" style="display: none;">
        <div class="challenge-card-wrapper" id="wrapper-reto-0">
            <div class="challenge-subpanel" id="subpanel-reto-0">
                <div class="subpanel-content">
                    <a href="/profile" class="pastel-sub-activity-btn" id="card-profile">
                        <div class="sub-btn-content">
                            <span class="sub-btn-icon">👤</span>
                            <div class="sub-btn-info">
                                <span class="sub-btn-title"><span data-i18n="est_idx_reto_0_este_soy_yo"><%= locals.t('est_idx_reto_0_este_soy_yo') %></span></span>
                                <span class="sub-btn-progress-text" id="status-reto-0"><span data-i18n="est_idx_pendiente"><%= locals.t('est_idx_pendiente') %></span></span>
                            </div>
                        </div>
                        <div class="sub-btn-progress-container">
                            <div class="sub-btn-progress-fill" id="btn-progress-fill-0" style="width: 0%;"></div>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <% for (let lvl = 1; lvl <= 6; lvl++) { %>
            <div class="challenge-card-wrapper" id="wrapper-reto-<%= lvl %>">
                <div class="challenge-subpanel" id="subpanel-reto-<%= lvl %>">
                    <div class="subpanel-content">
                        <% (retoCards[lvl] || []).forEach(activity => { %>
                            <a href="/activity/<%= currentYear %>/<%= activity.id %>"
                               class="pastel-sub-activity-btn"
                               id="card-<%= activity.id %>"
                               data-subject="<%= activity.subject %>" style="display: none;">
                                <div class="sub-btn-content">
                                    <span class="sub-btn-icon"><%= activity.icon || '📝' %></span>
                                    <div class="sub-btn-info">
                                        <span class="sub-btn-title"><span data-lang-content='<%- JSON.stringify(activity.title).replace(/'/g, "&#39;") %>'><%= activity.title[locals.lang] || activity.title.es %></span></span>
                                        <span class="sub-btn-progress-text" id="text-<%= activity.id %>"><span data-i18n="est_idx_sin_iniciar"><%= locals.t('est_idx_sin_iniciar') %></span></span>
                                    </div>
                                </div>
                                <div class="sub-btn-progress-container">
                                    <div class="sub-btn-progress-fill" id="bar-<%= activity.id %>" style="width: 0%;"></div>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <style>
        .all-retos { display: none; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin-top: 24px; }
        .all-retos.is-open { display: grid !important; }
        .all-retos .challenge-card-wrapper, .all-retos .challenge-subpanel, .all-retos .subpanel-content { display: contents; }
        .all-retos .pastel-sub-activity-btn { width: auto; max-width: none; margin: 0; }
        .all-retos .reto-num { font-weight: 800; }
        .assigned-box { margin: 18px 0 8px; padding: 18px; border-radius: 16px; background: #fff8e6; border: 1px solid #f5d27a; }
        .assigned-box h2 { margin: 0 0 12px; font-size: 1.15em; display: flex; gap: 8px; align-items: center; }
        .assigned-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
        .assigned-card { background: #fff; border: 1px solid #f0e2b6; border-radius: 12px; padding: 12px 14px; }
        .assigned-card.is-done { border-color: #86efac; background: #f0fdf4; }
        .assigned-card header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px; }
        .assigned-due { font-size: .85em; color: #92400e; font-weight: 600; }
        .assigned-note { margin: 6px 0 0; font-size: .9em; color: #475569; }
        .assigned-retos { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
        .assigned-reto { display: inline-flex; gap: 6px; align-items: center; padding: 6px 10px; border-radius: 999px; border: 1px solid #e2e8f0; text-decoration: none; color: #111; font-size: .86em; font-weight: 600; background: #fff; }
        .assigned-reto.st-won { border-color: #86efac; }
        .assigned-reto.st-started { border-color: #fcd34d; }
        .assigned-by { display: block; margin-top: 8px; color: #64748b; }
        @media (max-width: 480px) { .all-retos { grid-template-columns: 1fr; } }
    </style>

    <!-- ═══ Dashboard Script ═══ -->
    <script>
        // localStorage / sessionStorage pueden estar bloqueados (modo privado, políticas del colegio):
        // antes eso detenía el script y elegir la materia no hacía nada.
        const safeStorage = {
            get(store, key) { try { return window[store].getItem(key); } catch (e) { return null; } },
            set(store, key, value) { try { window[store].setItem(key, value); } catch (e) { /* sin almacenamiento */ } }
        };

        document.addEventListener('DOMContentLoaded', () => {
            const subjectCombo = document.getElementById('subjectCombo');
            const placeholder = document.getElementById('noSubjectSelectedPlaceholder');
            const container = document.getElementById('challengesContainer');
            // Retos 1-6 de cada nivel, livianos: { id, level, subject, fields }
            const retoIndex = <%- JSON.stringify(slimRetos) %>;
            window.latestProgressResult = <%- JSON.stringify(progress) %>;
            const reto0Status = <%- JSON.stringify(typeof reto0Status !== 'undefined' ? reto0Status : {}) %>;
            // Avance del Reto 0 por materia (services/reto0_progress.js): { materia: { done, pct } }
            const reto0Progress = <%- JSON.stringify(typeof reto0Progress !== 'undefined' ? reto0Progress : {}) %>;
            const T = (key, fallback) => (window.t && window.t(key) !== key ? window.t(key) : fallback);

            function retosOf(subject) {
                const out = [];
                for (let lvl = 1; lvl <= 6; lvl++) (retoIndex[lvl] || []).forEach(a => { if (a.subject === subject) out.push(a); });
                return out;
            }

            function updateProgressLabels(progress) {
                const subject = subjectCombo.value;
                if (!subject) return;

                // Reto 0: uno por materia, con el avance real de sus 5 paneles
                const profileCard = document.getElementById('card-profile');
                const status0 = document.getElementById('status-reto-0');
                const fill0 = document.getElementById('btn-progress-fill-0');
                const won0 = !!reto0Status[subject];
                const r0 = reto0Progress[subject] || { done: 0, pct: 0 };
                const pct0 = won0 ? 100 : r0.pct;
                if (fill0) fill0.style.width = pct0 + '%';
                if (profileCard) {
                    profileCard.href = '/profile?subject=' + encodeURIComponent(subject);
                    profileCard.classList.remove('sub-btn-completed', 'sub-btn-not-started');
                }
                if (status0) {
                    if (won0) {
                        status0.textContent = T('est_idx_reto0_ganado', '¡Ganado!');
                        if (profileCard) profileCard.classList.add('sub-btn-completed');
                    } else if (r0.done > 0) {
                        status0.textContent = T('est_idx_reto0_en_curso', 'En curso') + ' · ' + r0.done + '/5';
                    } else {
                        status0.textContent = T('est_idx_pendiente', 'Pendiente');
                        if (profileCard) profileCard.classList.add('sub-btn-not-started');
                    }
                }

                retosOf(subject).forEach(act => {
                    const btn = document.getElementById('card-' + act.id);
                    const text = document.getElementById('text-' + act.id);
                    const fill = document.getElementById('bar-' + act.id);
                    const prog = progress[act.id];
                    if (btn) btn.classList.remove('sub-btn-completed', 'sub-btn-not-started');
                    if (prog && prog.fieldsCompleted > 0 && act.fields > 0) {
                        const pct = Math.min(Math.round((prog.fieldsCompleted / act.fields) * 100), 100);
                        if (fill) fill.style.width = pct + '%';
                        if (text) text.textContent = pct >= 100 ? T('est_idx_completado', 'Completado') : pct + '%';
                        if (btn && pct >= 100) btn.classList.add('sub-btn-completed');
                    } else {
                        if (fill) fill.style.width = '0%';
                        if (text) text.textContent = T('est_idx_sin_iniciar', 'Sin iniciar');
                        if (btn) btn.classList.add('sub-btn-not-started');
                    }
                });
            }

            // Muestra el Reto 0 y los retos 1 a 6 de la materia en una cuadrícula
            window.showAllRetos = function (subject) {
                if (!subject) {
                    container.classList.remove('is-open');
                    container.style.display = 'none';
                    if (placeholder) placeholder.style.display = 'block';
                    return;
                }
                if (placeholder) placeholder.style.display = 'none';
                container.style.display = '';
                container.classList.add('is-open');
                container.querySelectorAll('.pastel-sub-activity-btn[data-subject]').forEach(btn => {
                    btn.style.display = btn.getAttribute('data-subject') === subject ? 'flex' : 'none';
                });
                // Alemán e Inglés se muestran en su idioma sin cambiar la preferencia del estudiante
                if (window.langUtils && window.langUtils.showSubjectLang) window.langUtils.showSubjectLang(subject);
                updateProgressLabels(window.latestProgressResult || {});
            };

            subjectCombo.addEventListener('change', e => {
                safeStorage.set('localStorage', 'selectedSubject', e.target.value);
                showAllRetos(e.target.value);
            });
            const saved = safeStorage.get('localStorage', 'selectedSubject');
            const savedOpt = saved ? subjectCombo.querySelector('option[value="' + CSS.escape(saved) + '"]') : null;
            if (savedOpt && !savedOpt.disabled) {
                subjectCombo.value = saved;
                showAllRetos(saved);
            } else {
                showAllRetos('');
            }

            // Un reto asignado abre su materia aquí también
            document.querySelectorAll('[data-assign-subject]').forEach(link => link.addEventListener('click', () => {
                safeStorage.set('localStorage', 'selectedSubject', link.getAttribute('data-assign-subject'));
            }));

            document.addEventListener('langchange', () => updateProgressLabels(window.latestProgressResult || {}));

            const welcomeModal = document.getElementById('welcomeModal');
            const closeWelcomeModal = document.getElementById('closeWelcomeModal');
            if (welcomeModal && !safeStorage.get('sessionStorage', 'welcomeModalShown')) welcomeModal.style.display = 'flex';
            if (closeWelcomeModal) {
                closeWelcomeModal.addEventListener('click', () => {
                    welcomeModal.style.display = 'none';
                    safeStorage.set('sessionStorage', 'welcomeModalShown', 'true');
                });
            }
        });
    </script>

<%- include('partials/footer') %>
