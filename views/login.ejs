<%- include('layout/head', { title: 'Entrar — MedienPass', bodyClass: 'mp-auth', lang: lang }) %>

<style>
/* Pantalla de acceso: una sola columna centrada, sin distracciones. */
.mp-auth-wrap {
    flex: 1;
    display: grid;
    place-items: center;
    padding: var(--mp-5) var(--mp-4);
}
.mp-auth-card { width: 100%; max-width: 400px; }
.mp-auth-head { text-align: center; margin-bottom: var(--mp-6); }
.mp-auth-mark {
    width: 44px; height: 44px; margin: 0 auto var(--mp-4);
    border-radius: var(--mp-radius);
    background: var(--mp-accent); color: var(--mp-accent-text);
    display: grid; place-items: center;
    font-weight: 700; font-size: var(--mp-text-lg);
}
.mp-auth-title { font-size: var(--mp-text-2xl); margin-bottom: var(--mp-1); }
.mp-auth-sub { color: var(--mp-text-faint); font-size: var(--mp-text-sm); }
.mp-auth-foot {
    margin-top: var(--mp-5); text-align: center;
    font-size: var(--mp-text-sm); color: var(--mp-text-faint);
}
</style>

<div class="mp-auth-wrap">
    <div class="mp-auth-card">

        <div class="mp-auth-head">
            <div class="mp-auth-mark" aria-hidden="true">M</div>
            <h1 class="mp-auth-title">MedienPass</h1>
            <p class="mp-auth-sub"><%= t('schoolFooter') %></p>
        </div>

        <div class="mp-card">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mp-alert mp-alert--danger" role="alert" style="margin-bottom: var(--mp-4);">
                    <%= error %>
                </div>
            <% } %>

            <form method="POST" action="/login" class="mp-stack" autocomplete="on">

                <div class="mp-field">
                    <label class="mp-label" for="username"><%= t('loginName') %></label>
                    <input class="mp-input" type="text" id="username" name="username"
                           autocomplete="given-name" required autofocus
                           placeholder="<%= t('loginNamePlaceholder') %>">
                </div>

                <div class="mp-field">
                    <label class="mp-label" for="class_name"><%= t('loginClass') %></label>
                    <select class="mp-select" id="class_name" name="class_name" required>
                        <option value=""><%= t('loginClassPlaceholder') %></option>
                        <% (uniqueClasses && uniqueClasses.length ? uniqueClasses : []).forEach(function (c) { %>
                            <option value="<%= c %>"><%= c %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="mp-field">
                    <label class="mp-label" for="student_code">
                        <%= t('loginCode') %>
                        <span class="mp-label__hint">— <%= t('loginCodeHint') %></span>
                    </label>
                    <input class="mp-input mp-mono" type="text" id="student_code" name="student_code"
                           inputmode="numeric" autocomplete="off" required
                           placeholder="000000">
                </div>

                <div class="mp-field">
                    <label class="mp-label" for="lang">
                        <%= t('language') %>
                        <span class="mp-label__hint">— <%= t('loginLangHint') %></span>
                    </label>
                    <select class="mp-select" id="lang" name="lang">
                        <% languages.forEach(function (l) { %>
                            <option value="<%= l %>" <%= lang === l ? 'selected' : '' %>><%= t('langName_' + l) %></option>
                        <% }); %>
                    </select>
                </div>

                <button type="submit" class="mp-btn mp-btn--primary mp-btn--block mp-btn--lg">
                    <%= t('loginSubmit') %>
                </button>
            </form>
        </div>

        <p class="mp-auth-foot">
            <a href="/teacher/login"><%= t('loginTeacherLink') %></a>
        </p>


    </div>
</div>

<%- include('layout/foot') %>
