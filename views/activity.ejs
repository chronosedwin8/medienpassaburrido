                                                            <span class="sad-face-indicator" id="sad_<%= item.id %>" style="display: none;" title="<%= t('starsSadHint') %>">😢</span>
                                                            <input type="hidden" id="star_<%= item.id %>" name="star_<%= item.id %>" value="0">
                                                        </div>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                        <% }) %>
                                    </div>


                                <% } %>

                                        <% if (activity.teachersBySubject && activity.teachersBySubject.length > 0 && activity.id !== 'profile') { %>
                                            <div class="section teachers-by-subject-section">
