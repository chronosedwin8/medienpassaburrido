            color: #ffffff;
            background: #10b981;
            box-shadow: 0 2px 4px rgba(16, 185, 129, 0.2);
            animation: pulse 1.5s infinite;
        }
        .quest-tracker-progress {
            width: 100%;
            height: 8px;
            background: var(--mp-border);
            border-radius: 9999px;
