<%- include('partials/header') %>

    <div class="navigation-bar">

        <a href="/<%= section === 'tecnologia' ? '' : '?year=' + currentYear %>" class="back-link">
            <i class="fas fa-arrow-left"></i> <span data-i18n="back"><%= t('back') %></span>
        </a>
        <button onclick="window.print()" class="print-btn">
            <i class="fas fa-print"></i> <span data-i18n="print"><%= t('print') %></span>
        </button>
    </div>

    <div class="activity-header" style="border-left-color: <%= activity.color || '#ccc' %>;">
        <div class="icon" id="activityHeaderIcon" style="font-size: 4em; color: <%= activity.color || '#333' %>;">
            <%= activity.icon %>
        </div>
        <h1 data-lang-content='<%- JSON.stringify(activity.title) %>'>
            <span class="lang-line lang-primary">
                <%= display(activity.title).primary %>
            </span>
        </h1>
        <% if (activity.subtitle) { %>
            <p class="subtitle" data-lang-content='<%- JSON.stringify(activity.subtitle) %>'>
                <span class="lang-line lang-primary">
                    <%= display(activity.subtitle).primary %>
                </span>
            </p>
        <% } %>
        <% if (activity.instruction) { %>
            <div class="activity-instruction" data-lang-content='<%- JSON.stringify(activity.instruction) %>' style="background: var(--mp-bg); padding: 15px; border-radius: 8px; margin: 15px 0; border-left: 4px solid var(--primary); text-align: left; font-size: 0.95em; color: var(--mp-text);">
                <span class="lang-line lang-primary">
                    <%- activity.instruction.de %>
                </span>
            </div>
        <% } %>

        <% 
        const getStudentGrade = (className) => {
            if (!className) return '5';
            const match = className.match(/\d+/);
            return match ? match[0] : '5';
        };
        const studentGrade = student ? getStudentGrade(student.class_name) : '5';
        const activeSub = activity.subject || 'aleman';
        const activeLvl = activity.level || '1';
        const configKey = `${studentGrade}_${activeSub}_${activeLvl}`;
        let toolDescription = (typeof challengeToolsConfig !== 'undefined' && challengeToolsConfig) ? challengeToolsConfig[configKey] : '';
        let isDefault = false;
        if (!toolDescription || toolDescription.trim().length === 0) {
            if (typeof defaultAgentTools !== 'undefined' && defaultAgentTools && defaultAgentTools[activeLvl]) {
                toolDescription = defaultAgentTools[activeLvl];
                isDefault = true;
            }
        }
        %>

        <% if (toolDescription && (typeof toolDescription === 'string' ? toolDescription.trim().length > 0 : true)) { %>
            <div class="teacher-agent-card">
                <div class="agent-avatar-area">
                    <span class="agent-avatar">🤖</span>
                    <div class="agent-title-area">
                        <h4 data-i18n="teacherAgentTitle"><%= t('teacherAgentTitle') %></h4>
                        <p data-i18n="teacherAgentSub"><%= t('teacherAgentSub') %></p>
                    </div>
                </div>
                <div class="agent-content" <%- isDefault ? `data-lang-content='${JSON.stringify(toolDescription).replace(/'/g, "&#39;")}'` : '' %>>
                    <i class="fa-solid fa-quote-left text-blue-300 mr-1"></i><%= isDefault ? (toolDescription.es || toolDescription.de || '') : toolDescription %><i class="fa-solid fa-quote-right text-blue-300 ml-1"></i>
                </div>
            </div>
        <% } %>




<!-- Star Self-Evaluation -->
<% if (activity.id !== 'profile') { %>
    <div class="star-self-eval" id="starSelfEval" style="margin-top: 20px; padding: 15px; background: var(--mp-bg); border-radius: 8px; border-left: 4px solid var(--mp-accent);">
        <span class="star-eval-label" data-i18n="selfEvaluation"><%= t('selfEvaluation') %></span>
        <p style="font-size: 0.9em; color: var(--mp-text-soft); margin: 5px 0 10px 0;">
            Estimado estudiante, tu autoevaluación será analizada por Inteligencia Artificial, la cual te dará un puntaje teniendo en cuenta tu respuesta y la ampliación de la misma en la sección de ¿Puedes explicar por qué seleccionaste esa respuesta?
        </p>
        <div class="star-rating-interactive" id="starRating">
            <% for (let i=1; i<=5; i++) { %>
                <span class="star-clickable" data-star="<%= i %>"
                    onclick="setStarRating(<%= i %>)">☆</span>
            <% } %>
        </div>
        <input type="hidden" id="star_rating_value" name="star_rating" value="0">
    </div>
<% } %>
</div>

    <form id="activityForm">

        <% if (activity.id === 'profile') { %>

            <!-- ── Barra de progreso Reto 0 (5 paneles) ── -->
            <div class="reto0-progress-bar" id="reto0ProgressBar" style="background:var(--mp-surface-alt);border-radius:12px;padding:10px 16px;margin-bottom:16px;display:flex;align-items:center;gap:12px;">
                <span style="font-size:0.82em;color:var(--mp-text-faint);white-space:nowrap;" data-i18n="progressLabel"><%= t('progressLabel') %></span>
                <div style="flex:1;background:var(--mp-border);border-radius:8px;height:8px;overflow:hidden;">
                    <div id="reto0ProgressFill" style="height:100%;background:linear-gradient(90deg,var(--mp-accent),var(--mp-accent));border-radius:8px;transition:width .4s ease;width:0%;"></div>
                </div>
                <span id="reto0ProgressLabel" style="font-size:0.82em;font-weight:700;color:var(--mp-accent);min-width:36px;text-align:right;">0/5</span>
