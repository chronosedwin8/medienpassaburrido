            color: var(--mp-accent);
            font-weight: bold;
            font-size: 1.1em;
            position: absolute;
            left: 4px;
            top: -1px;
        }

        /* Gamified Quest Tracker */
        .quest-tracker-container {
            background: linear-gradient(135deg, var(--mp-bg) 0%, var(--mp-surface-alt) 100%);
            border: 2px dashed var(--mp-border-strong);
