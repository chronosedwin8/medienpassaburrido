    <script>
        // Reto 0 Practice Mode Logic
        let setEvaluationMode = null;
        document.addEventListener('DOMContentLoaded', function() {
            const isReto0 = '<%= activity.id %>' === 'profile';
            if (isReto0) {
                const formGroups = document.querySelectorAll('.form-group');
                const saveBtn = document.getElementById('saveBtn');
                const startEvalBtn = document.getElementById('start-reto0-eval-btn');
                
                const rawEvidence = <%- JSON.stringify(activity.evidence) %>;
                const quizQuestions = rawEvidence.filter(item => item.id.startsWith('eval_q'));

                let currentHits = 0;
                let currentErrors = 0;
                let currentQuestionIdx = 0;
                let timerInterval = null;
                let secondsElapsed = 0;

                const edilimTranslations = {
                    es: {
                        score: "Aciertos",
                        mistakes: "Errores",
                        time: "Tiempo",
                        correctMsg: "¡Excelente! Respuesta correcta.",
                        tryAgainMsg: "Incorrecto. ¡Inténtalo de nuevo!",
                        gradTitle: "¡FELICITACIONES, CIUDADANO DIGITAL!",
                        gradSubtitle: "Has completado exitosamente la evaluación del Reto Cero de forma interactiva.",
                        gradNextInstructions: "Guarda tu progreso presionando el botón 'GUARDAR' que aparece a continuación.",
                    },
                    de: {
                        score: "Erfolge",
                        mistakes: "Fehler",
                        time: "Zeit",
                        correctMsg: "Hervorragend! Richtige Antwort.",
                        tryAgainMsg: "Falsch. Versuch es noch einmal!",
                        gradTitle: "HERZLICHEN GLÜCKWUNSCH, DIGITALER BÜRGER!",
                        gradSubtitle: "Du hast die Bewertung von Challenge Null erfolgreich und interaktiv abgeschlossen.",
                        gradNextInstructions: "Speichere deinen Fortschritt, indem du auf die Schaltfläche 'SPEICHERN' unten klickst.",
                    },
                    en: {
                        score: "Hits",
                        mistakes: "Mistakes",
                        time: "Time",
                        correctMsg: "Excellent! Correct answer.",
                        tryAgainMsg: "Incorrect. Try again!",
                        gradTitle: "CONGRATULATIONS, DIGITAL CITIZEN!",
                        gradSubtitle: "You have successfully completed the Challenge Zero evaluation interactively.",
                        gradNextInstructions: "Save your progress by clicking the 'SAVE' button below.",
                    }
                };

                function getTranslation(key) {
                    const lang = window.langUtils ? window.langUtils.getLang() : 'de';
                    return (edilimTranslations[lang] && edilimTranslations[lang][key]) || edilimTranslations['de'][key] || key;
                }

                function playBeep(isSuccess) {
                    try {
                        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                        if (!AudioContextClass) return;
                        const ctx = new AudioContextClass();
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        
                        if (isSuccess) {
                            osc.frequency.setValueAtTime(523.25, ctx.currentTime);
                            osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.1);
                            gain.gain.setValueAtTime(0.1, ctx.currentTime);
                            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.35);
                            osc.start(ctx.currentTime);
                            osc.stop(ctx.currentTime + 0.35);
                        } else {
                            osc.frequency.setValueAtTime(150, ctx.currentTime);
                            osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.25);
                            gain.gain.setValueAtTime(0.15, ctx.currentTime);
                            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
                            osc.start(ctx.currentTime);
                            osc.stop(ctx.currentTime + 0.3);
                        }
                    } catch (e) {
                        console.warn('AudioContext failed:', e);
                    }
                }

                window.renderEdilimQuestion = function(index) {
                    const lang = window.langUtils ? window.langUtils.getLang() : 'de';
                    const q = quizQuestions[index];
                    if (!q) return;
                    
                    const questionText = q.label[lang] || q.label.es || q.label;
                    
                    let html = `
                        <div class="edilim-question-title">
                            <span class="edilim-question-num">${index + 1}</span>
                            <h2>${questionText}</h2>
                        </div>
                        <div class="edilim-options-grid">
                    `;
                    
                    q.options.forEach((opt, optIdx) => {
                        const optLabel = typeof opt === 'object' ? (opt.label || opt) : opt;
                        const optText = typeof optLabel === 'object' ? (optLabel[lang] || optLabel.es || optLabel.de || '') : optLabel;
                        
                        html += `
                            <button type="button" class="edilim-option-btn" data-correct="${opt.correct}" onclick="handleOptionClick(this, ${index}, ${optIdx})">
                                <span class="option-letter">${String.fromCharCode(65 + optIdx)}</span>
                                <span class="option-text">${optText}</span>
                            </button>
                        `;
                    });
                    
                    html += `</div>`;
                    
                    document.getElementById('edilim-question-body').innerHTML = html;
                    
                    const feedbackBox = document.getElementById('edilim-feedback-box');
                    feedbackBox.style.display = 'none';
                    feedbackBox.className = 'edilim-feedback';
                };

                window.handleOptionClick = function(btn, qIdx, optIdx) {
                    const isCorrect = btn.getAttribute('data-correct') === 'true';
                    const feedbackBox = document.getElementById('edilim-feedback-box');
                    const optionBtns = document.querySelectorAll('.edilim-option-btn');
                    
                    if (isCorrect) {
                        optionBtns.forEach(b => b.disabled = true);
                        btn.classList.add('correct');
                        playBeep(true);
                        
                        // Check actual radio button in hidden layout
                        const radioId = `${quizQuestions[qIdx].id}_${optIdx}`;
                        const hiddenRadio = document.getElementById(radioId);
                        if (hiddenRadio) {
                            hiddenRadio.checked = true;
                            if (typeof updateStarSummary === 'function') updateStarSummary();
                        }
                        
                        feedbackBox.style.display = 'flex';
                        feedbackBox.className = 'edilim-feedback correct bounce-in';
                        feedbackBox.innerHTML = `<span>🎉</span> <strong>${getTranslation('correctMsg')}</strong>`;
                        
                        currentHits++;
                        document.getElementById('edilim-hits').textContent = currentHits;
                        
                        const pct = Math.round(((qIdx + 1) / quizQuestions.length) * 100);
                        document.getElementById('edilim-progress-fill').style.width = pct + '%';
                        
                        setTimeout(() => {
                            if (currentQuestionIdx < quizQuestions.length - 1) {
                                currentQuestionIdx++;
                                renderEdilimQuestion(currentQuestionIdx);
                            } else {
                                showGraduationScreen();
                            }
                        }, 1500);
                    } else {
                        btn.classList.add('incorrect');
                        btn.classList.add('wobble');
                        btn.disabled = true;
                        playBeep(false);
                        
                        feedbackBox.style.display = 'flex';
                        feedbackBox.className = 'edilim-feedback incorrect shake';
                        feedbackBox.innerHTML = `<span>❌</span> <strong>${getTranslation('tryAgainMsg')}</strong>`;
                        
                        currentErrors++;
                        document.getElementById('edilim-errors').textContent = currentErrors;
                        
                        setTimeout(() => btn.classList.remove('wobble'), 500);
                    }
                };

                function showGraduationScreen() {
                    if (timerInterval) clearInterval(timerInterval);
                    if (typeof saveLocally === 'function') saveLocally();
                    
                    const totalTimeMins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
                    const totalTimeSecs = String(secondsElapsed % 60).padStart(2, '0');
                    
                    let html = `
                        <div class="edilim-graduation-card bounce-in">
                            <div class="grad-badge">🎓🏆🌟</div>
                            <h2>${getTranslation('gradTitle')}</h2>
                            <p class="grad-subtitle">${getTranslation('gradSubtitle')}</p>
                            
                            <div class="grad-stats">
                                <div class="grad-stat-box">
                                    <span class="grad-stat-val">${currentHits}</span>
                                    <span class="grad-stat-lbl">${getTranslation('score')}</span>
                                </div>
                                <div class="grad-stat-box">
                                    <span class="grad-stat-val">${currentErrors}</span>
                                    <span class="grad-stat-lbl">${getTranslation('mistakes')}</span>
                                </div>
                                <div class="grad-stat-box">
                                    <span class="grad-stat-val">${totalTimeMins}:${totalTimeSecs}</span>
                                    <span class="grad-stat-lbl">${getTranslation('time')}</span>
                                </div>
                            </div>
                            
                            <div class="grad-next-steps">
                                <p>👇 ${getTranslation('gradNextInstructions')}</p>
                            </div>
                        </div>
                    `;
                    
                    document.getElementById('edilim-question-body').innerHTML = html;
                    document.getElementById('edilim-progress-fill').style.width = '100%';
                    document.getElementById('edilim-progress-fill').style.background = 'linear-gradient(90deg, var(--mp-ok), var(--mp-ok))';
                    
                    const saveBtnQuiz = document.getElementById('reto0-eval-save-footer');
                    if (saveBtnQuiz) saveBtnQuiz.style.display = 'block';
                    
                    if (saveBtn) saveBtn.style.display = 'inline-block';
                }

                function startTimer() {
                    secondsElapsed = 0;
                    if (timerInterval) clearInterval(timerInterval);
                    timerInterval = setInterval(() => {
                        secondsElapsed++;
                        const mins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
                        const secs = String(secondsElapsed % 60).padStart(2, '0');
                        document.getElementById('edilim-timer').textContent = `${mins}:${secs}`;
                    }, 1000);
                }

                function setPracticeMode() {
                    formGroups.forEach(group => {
                        const radioGroup = group.querySelector('.radio-group');
                        const explanation = group.querySelector('.practice-explanation-box');
                        
                        // Hide standard quiz fields and label headers
                        const hasRadio = group.querySelector('.radio-group');
                        const isLabel = group.querySelector('[id*="eval_kv"]');
                        if (hasRadio || isLabel || (group.innerHTML && group.innerHTML.includes('eval_q'))) {
                            group.style.display = 'none';
                        }
                        
                        if (explanation) {
                            explanation.style.display = 'block';
                            explanation.style.background = 'rgba(74, 144, 226, 0.1)';
                            explanation.style.borderLeft = '4px solid #4a90e2';
                            explanation.style.padding = '15px';
                            explanation.style.margin = '10px 0';
                            explanation.style.borderRadius = '0 8px 8px 0';
                        }
                    });
                    
                    const edilimContainer = document.getElementById('edilim-game-container');
                    if (edilimContainer) edilimContainer.style.display = 'none';
                    
                    if (saveBtn) saveBtn.style.display = 'none';
                    const saveBtnQuiz = document.getElementById('reto0-eval-save-footer');
                    if (saveBtnQuiz) saveBtnQuiz.style.display = 'none';
                }

                setEvaluationMode = function() {
                    formGroups.forEach(group => {
                        const explanation = group.querySelector('.practice-explanation-box');
                        if (explanation) explanation.style.display = 'none';
                        
                        // Hide standard question groups
                        const hasRadio = group.querySelector('.radio-group');
                        const isLabel = group.querySelector('[id*="eval_kv"]');
                        if (hasRadio || isLabel || (group.innerHTML && group.innerHTML.includes('eval_q'))) {
                            group.style.display = 'none';
                        }
                    });
                    
                    const edilimContainer = document.getElementById('edilim-game-container');
                    if (edilimContainer) {
                        edilimContainer.style.display = 'block';
                        
                        currentHits = 0;
                        currentErrors = 0;
                        currentQuestionIdx = 0;
                        document.getElementById('edilim-hits').textContent = '0';
                        document.getElementById('edilim-errors').textContent = '0';
                        document.getElementById('edilim-progress-fill').style.width = '0%';
                        document.getElementById('edilim-progress-fill').style.background = 'linear-gradient(90deg, var(--mp-accent), var(--mp-accent))';
                        
                        renderEdilimQuestion(0);
                        startTimer();
                        
                        edilimContainer.scrollIntoView({ behavior: 'smooth' });
                    }
                    if (startEvalBtn) startEvalBtn.parentElement.style.display = 'none';
                    // Scroll to top of evaluation
                    const evalHeader = document.querySelector('[data-lang-content*="eval_kv"]');
                    if (evalHeader) evalHeader.scrollIntoView({ behavior: 'smooth' });
                }

                // Default to Practice Mode if not already completed
                setPracticeMode();

                // Live translate Edilim headers on language change
                document.addEventListener('langchange', function(e) {
                    const hitsLabelEl = document.querySelector('#edilim-game-container .edilim-stat-group:nth-child(1) .edilim-stat-label');
                    const errorsLabelEl = document.querySelector('#edilim-game-container .edilim-stat-group:nth-child(2) .edilim-stat-label');
                    if (hitsLabelEl) hitsLabelEl.textContent = getTranslation('score');
                    if (errorsLabelEl) errorsLabelEl.textContent = getTranslation('mistakes');
                });

                if (startEvalBtn) {
                    startEvalBtn.addEventListener('click', function() {
                        if (typeof window.visitedSlides === 'undefined' || window.visitedSlides.size < 9) {
                            const lang = window.langUtils ? window.langUtils.getLang() : 'es';
                            let msg = "Hacen falta diapositivas por estudiar para tu evaluación.";
                            if (lang === 'de') {
                                msg = "Es müssen noch Folien für deine Bewertung gelernt werden.";
                            } else if (lang === 'en') {
                                msg = "There are still slides left to study for your evaluation.";
                            }
                            alert(msg);
                            return;
                        }
                        setEvaluationMode();
                    });
                }

                window.triggerReto0Graduation = function(hits, errors = 0, timeSecs = 0) {
                    currentHits = hits;
                    currentErrors = errors;
                    secondsElapsed = timeSecs;
                    var edilimContainer = document.getElementById('edilim-game-container');
                    if (edilimContainer) edilimContainer.style.display = 'block';
                    var practiceFooter = document.getElementById('reto0-practice-footer');
                    if (practiceFooter) practiceFooter.style.display = 'none';
                    showGraduationScreen();
                };
            }
        });
    </script>
    <style>
        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(74, 144, 226, 0.4); }
            70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(74, 144, 226, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(74, 144, 226, 0); }
        }
        .practice-explanation-box p {
            margin: 0;
            line-height: 1.5;
            color: #e0e0e0;
        }

