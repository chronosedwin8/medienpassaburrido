                                                                <input type="radio" name="<%= item.id %>" value="<%= n %>"
                                                                       onchange="if(typeof updateStarSummary === 'function') updateStarSummary()">
                                                                <span class="mp-scale__dot"><%= n %></span>
                                                            </label>
                                                        <% } %>
                                                    </div>
