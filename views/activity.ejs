                                                    <input type="text" id="<%= item.id %>" name="<%= item.id %>" data-i18n-placeholder="answerPlaceholder" placeholder="<%= t('answerPlaceholder') %>">
                                                <% } else if (item.type === 'textarea') { %>
                                                    <textarea id="<%= item.id %>" name="<%= item.id %>" rows="<%= item.rows || 3 %>" data-i18n-placeholder="answerPlaceholder" placeholder="<%= t('answerPlaceholder') %>"></textarea>
                                                <% } else if (item.type === 'number') { %>
                                                    <input type="number" id="<%= item.id %>" name="<%= item.id %>" inputmode="numeric"
                                                           <%= item.min !== undefined ? 'min=' + item.min : '' %>
                                                           <%= item.max !== undefined ? 'max=' + item.max : '' %>
                                                           onchange="if(typeof updateStarSummary === 'function') updateStarSummary()">
                                                <% } else if (item.type === 'date') { %>
                                                    <input type="date" id="<%= item.id %>" name="<%= item.id %>"
                                                           onchange="if(typeof updateStarSummary === 'function') updateStarSummary()">
                                                <% } else if (item.type === 'scale') { %>
                                                    <%
                                                       const escMin = item.min !== undefined ? item.min : 1;
                                                       const escMax = item.max !== undefined ? item.max : 5;
                                                    %>
                                                    <div class="mp-scale" role="radiogroup" id="group_<%= item.id %>">
                                                        <% for (let n = escMin; n <= escMax; n++) { %>
