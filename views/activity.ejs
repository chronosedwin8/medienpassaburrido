                                                                    data-lang-content="<%- JSON.stringify(t.subjectName).replace(/"/g, '&quot;') %>">
                                                                    <span class="lang-line lang-primary">
                                                                        <%= t.subjectName.de %>
                                                                    </span>
                                                                </span>
                                                            </div>
                                                            <div class="teacher-card-input">
                                                                <input type="text" id="<%= t.fieldId %>"
                                                                    name="<%= t.fieldId %>"
                                                                    list="teacher_datalist"
                                                                    data-lang-content="<%- JSON.stringify(t.label).replace(/"/g, '&quot;') %>"
                                                                    placeholder="Name / Nombre"
                                                                    value="<%= (typeof teacherConfig !== 'undefined' && teacherConfig[t.subjectId]) ? teacherConfig[t.subjectId] : 'NO APLICA' %>">
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <datalist id="teacher_datalist">
                                                    <option value="NO APLICA">
                                                    <% if(typeof allTeachers !== 'undefined') { allTeachers.forEach(function(teacher) { %>
                                                        <option value="<%= teacher %>">
                                                    <% }); } %>
                                                </datalist>
                                            </div>
                        <div class="panel-actions" style="text-align: right; margin-top: 20px;">
                            <button type="button" class="save-btn" onclick="saveProfileModule(3, this)" data-lang-content='{"es": "<i class=\"fas fa-save\"></i> Guardar Profesores y Continuar", "de": "<i class=\"fas fa-save\"></i> Lehrer speichern und weiter", "en": "<i class=\"fas fa-save\"></i> Save Teachers and Continue"}'>
                                <span class="lang-line lang-primary"><i class="fas fa-save"></i> Guardar Profesores y Continuar</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Panel 4: Misión importante: descubre qué es el Medienpass -->
                <div class="accordion-panel" id="panel-4">
                    <button type="button" class="accordion-header" onclick="toggleAccordionPanel(4)">
                        <div class="panel-header-left">
                            <span class="panel-num">4</span>
                            <span class="panel-title" data-lang-content='{"es": "Misión importante: descubre qué es el Medienpass", "de": "Wichtige Mission: Entdecke, was der Medienpass ist", "en": "Important mission: discover what the Medienpass is"}'><span class="lang-line lang-primary">Misión importante: descubre qué es el Medienpass</span></span>
                        </div>
                        <span class="panel-arrow">▼</span>
                    </button>
                    <div class="accordion-content" style="display: none;">
                        <p class="panel-description" data-lang-content='{"es": "🧭 Debes hacer clic en los botones de desplazamiento y en los botones explicativos y ganar puntos o XP.", "de": "🧭 Du musst auf die Schaltflächen zum Navigieren und Erklären klicken, um Punkte oder XP zu sammeln.", "en": "🧭 You must click the navigation and explanation buttons to earn points or XP."}'><span class="lang-line lang-primary">🧭 Debes hacer clic en los botones de desplazamiento y en los botones explicativos y ganar puntos o XP.</span></p>
                        <div class="section" id="reto-zero-section" style="padding: 0; background: transparent; border: none; box-shadow: none;">
                <div class="slideshow-container">
                    <!-- Gamified Quest Tracker -->
                    <div class="quest-tracker-container" id="questTracker">
                        <div class="quest-tracker-header">
                            <span class="quest-tracker-title">
                                🧭 <span data-lang-content='{"es": "Misión: ¡Descubre el Medienpass!", "de": "Mission: Entdecke den Medienpass!", "en": "Mission: Discover the Medienpass!"}'>Misión: ¡Descubre el Medienpass!</span>
                            </span>
                            <span class="quest-tracker-stats" id="quest-tracker-count">⭐ 0 XP</span>
                        </div>
                        <div class="quest-tracker-progress">
                            <div class="quest-tracker-fill" id="quest-tracker-fill" style="width: 0%;"></div>
                        </div>
                    </div>

                    <!-- Slide 1 -->
                    <div class="mySlides fade">
                        <div class="slide-card" style="border-top-color: var(--mp-accent);">
                            <div class="slide-icon">🚀</div>
                            <h2 data-lang-content='{"es": "El Pasaporte al Mundo Digital", "de": "Der Reisepass zur digitalen Welt", "en": "The Passport to the Digital World"}'>El Pasaporte al Mundo Digital</h2>
                            <p data-lang-content='{"es": "Guía de Implementación del Medienpass.", "de": "Implementierungsleitfaden für den Medienpass.", "en": "Implementation Guide for the Medienpass."}'>Guía de Implementación del Medienpass</p>
                        </div>
                    </div>
                    <!-- Slide 2 -->
