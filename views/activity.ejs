                            </div>
                        <div class="panel-actions" style="text-align: right; margin-top: 20px;">
                            <button type="button" class="save-btn" onclick="saveProfileModule(1, this)" data-lang-content='{"es": "<i class=\"fas fa-save\"></i> Guardar mi Avatar y Continuar", "de": "<i class=\"fas fa-save\"></i> Avatar speichern und weiter", "en": "<i class=\"fas fa-save\"></i> Save my Avatar and Continue"}'>
                                <span class="lang-line lang-primary"><i class="fas fa-save"></i> Guardar mi Avatar y Continuar</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Panel 2: Este soy yo!!! -->
                <div class="accordion-panel" id="panel-2">
                    <button type="button" class="accordion-header" onclick="toggleAccordionPanel(2)">
                        <div class="panel-header-left">
                            <span class="panel-num">2</span>
                            <span class="panel-title" data-lang-content='{"es": "Este soy yo!!!", "de": "Das bin ich!!!", "en": "This is me!!!"}'><span class="lang-line lang-primary">Este soy yo!!!</span></span>
                        </div>
                        <span class="panel-arrow">▼</span>
                    </button>
                    <div class="accordion-content" style="display: none;">
                        <p class="panel-description" data-lang-content='{"es": "📝 Completa tu perfil. Tus datos personales son sensibles y merecen ser protegidos de personas extrañas.", "de": "📝 Vervollständige dein Profil. Deine persönlichen Daten sind sensibel und verdienen es, vor Fremden geschützt zu werden.", "en": "📝 Complete your profile. Your personal data is sensitive and deserves to be protected from strangers."}'><span class="lang-line lang-primary">📝 Completa tu perfil. Tus datos personales son sensibles y merecen ser protegidos de personas extrañas.</span></p>
                        
                        <!-- Panel 2 Avatar Display Sync -->
                        <div class="selected-avatar-display" style="text-align: center; margin-bottom: 20px;">
                            <div id="panel2AvatarDisplay" style="font-size: 4em; margin: 10px auto; width: 80px; height: 80px; line-height: 80px; background: var(--mp-accent-soft); border-radius: 50%; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 3px solid var(--mp-accent); color: #1e1b4b; display: flex; align-items: center; justify-content: center;">❓</div>
                        </div>
                        
<div class="profile-fields-section">
    <% activity.evidence.forEach(item=> { %>
        <% if (!item.id.startsWith('eval_q')) { %>
            <div class="form-group">
                <label for="<%= item.id %>" data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                    <span class="lang-line lang-primary">
                        <%= (item.label && item.label.es) || (item.label && item.label.de) || '' %>
                    </span>
                </label>
                <% if (item.type === 'text') { %>
                    <input type="text" id="<%= item.id %>" name="<%= item.id %>" placeholder="Escribe aquí...">
                <% } else if (item.type === 'textarea') { %>
                    <textarea id="<%= item.id %>" name="<%= item.id %>" rows="<%= item.rows || 3 %>" placeholder="Escribe aquí..."></textarea>
                <% } %>
            </div>
        <% } %>
    <% }) %>
</div>

                        <div class="panel-actions" style="text-align: right; margin-top: 20px;">
                            <button type="button" class="save-btn" onclick="saveProfileModule(2, this)" data-lang-content='{"es": "<i class=\"fas fa-save\"></i> Guardar Datos Personales y Continuar", "de": "<i class=\"fas fa-save\"></i> Persönliche Daten speichern und weiter", "en": "<i class=\"fas fa-save\"></i> Save Personal Data and Continue"}'>
                                <span class="lang-line lang-primary"><i class="fas fa-save"></i> Guardar Datos Personales y Continuar</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Panel 3: Escribo los nombres de mis profesores -->
