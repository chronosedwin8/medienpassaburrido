                                                            <option value="<%= opt.value !== undefined ? opt.value : optIdx %>"
                                                                    data-correct="<%= opt.correct ? 'true' : 'false' %>"><%= (typeof opt === 'object') ? display(opt).primary : opt %></option>
                                                        <% }) %>
                                                    </select>
                                                <% } else if (item.type === 'ordering') { %>
                                                    <ol class="mp-order" id="group_<%= item.id %>">
                                                        <% (item.options || []).forEach((opt, optIdx) => { %>
                                                            <li class="mp-order__item">
                                                                <input class="mp-order__pos" type="number" min="1" max="<%= (item.options||[]).length %>"
                                                                       name="<%= item.id %>__<%= opt.value !== undefined ? opt.value : optIdx %>"
                                                                       aria-label="Posicion"
                                                                       onchange="if(typeof updateStarSummary === 'function') updateStarSummary()">
                                                                <span class="lang-line lang-primary"><%= (typeof opt === 'object') ? display(opt).primary : opt %></span>
                                                            </li>
                                                        <% }) %>
                                                    </ol>
                                                <% } else if (item.type === 'checkbox_group') { %>
                                                    <div class="radio-group" id="group_<%= item.id %>">
                                                        <% (item.options || []).forEach((opt, optIdx) => {
                                                            const safeId = item.id + '_' + optIdx;
                                                            const optLabel = (typeof opt === 'object') ? (opt.label || opt) : opt;
                                                        %>
