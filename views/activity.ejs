            padding: 16px;
            border: 1px solid var(--mp-border);
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
        }
        .slide-scroll-content::-webkit-scrollbar {
            width: 8px;
        }
        .slide-scroll-content::-webkit-scrollbar-track {
            background: var(--mp-surface-alt);
            border-radius: 6px;
        }
        .slide-scroll-content::-webkit-scrollbar-thumb {
            background: var(--mp-border-strong);
            border-radius: 6px;
            border: 2px solid var(--mp-surface-alt);
        }
        .slide-scroll-content::-webkit-scrollbar-thumb:hover {
