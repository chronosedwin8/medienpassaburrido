</div>


            <!-- Success Banner for Reto 0 Completion -->
            <div id="reto0-success-banner" class="reto0-success-banner" style="display: none; margin-top: 30px; padding: 25px; background: #eff6ff; border: 2px solid #bfdbfe; border-radius: 20px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.05);">
                <div class="banner-icon" style="font-size: 3.5em; margin-bottom: 15px;">🎉✨🚀</div>
                <h3 style="color: #1e3a8a; font-size: 1.8em; margin-bottom: 10px; font-weight: 700;"><span data-i18n="est_muy_bien_ahora_ve_al_siguiente"><%= locals.t('est_muy_bien_ahora_ve_al_siguiente') %></span></h3>
                <p style="color: #1e40af; font-size: 1.15em; margin-bottom: 20px;"><span data-i18n="est_has_completado_exitosamente_la"><%= locals.t('est_has_completado_exitosamente_la') %></span></p>
                <a href="/" class="btn-back-dashboard" style="display: inline-block; background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; padding: 12px 30px; border-radius: 30px; font-weight: bold; text-decoration: none; box-shadow: 0 4px 15px rgba(59,130,246,0.4); transition: all 0.2s;"><i class="fas fa-arrow-left"></i> <span data-i18n="est_volver_al_dashboard"><%= locals.t('est_volver_al_dashboard') %></span></a>
            </div>

            <%- include('partials/reto-certificate') %>
        <% } %>


        <% if (activity.competencies && activity.competencies.length> 0) { %>
            <div class="section">
                <h2><i class="fas fa-star"></i> <span data-i18n="competenciesTitle">Kompetenzen & Erfolge</span></h2>
                <p class="instruction" data-i18n="competenciesInstruction">Markiere die Fähigkeiten, die du beherrscht:
                </p>
                <div class="competency-list">
                    <% activity.competencies.forEach((comp, index)=> { %>
                        <div class="competency-item">
                            <div class="comp-text" data-lang-content="<%- JSON.stringify(comp).replace(/"/g, '&quot;') %>">
                                <span class="lang-line lang-primary">
                                    <%= typeof comp==='object' ? comp.de : comp %>
                                </span>
                            </div>
                            <div class="comp-achievement">
                                <span class="achievement-icon">
                                    <%= activity.icon %>
                                </span>
                                <label class="custom-checkbox">
                                    <input type="checkbox" id="comp_<%= index %>" name="competency_<%= index %>">
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
            <% } %>

                <% if (activity.competencyGroups && activity.competencyGroups.length> 0) { %>
                    <div class="section competency-groups-section">
                        <div class="comp-group-table">
                            <div class="comp-group-header">
                                <div class="cg-col-comp" data-i18n="competenciaCol">Competencia</div>
                                <div class="cg-col-evidence" data-i18n="evidenciaCol">Evidencia</div>
                                <div class="cg-col-logro" data-i18n="logroCol">Logro</div>
                            </div>
                            <% activity.competencyGroups.forEach((group, gIdx)=> { %>
                                <div class="comp-group-row">
                                    <div class="cg-col-comp">
                                        <div class="cg-comp-text"
                                            data-lang-content="<%- JSON.stringify(group.competency).replace(/"/g, '&quot;') %>">
                                            <span class="lang-line lang-primary">
                                                <%= group.competency.de %>
                                            </span>
                                            <span class="lang-line lang-secondary">
                                                <%= group.competency.es %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="cg-col-evidence">
                                        <% group.evidence.forEach(item=> { %>
                                            <% if (item.type==='label' ) { %>
                                                <div class="cg-evidence-label"
                                                    data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                                                    <span class="lang-line lang-primary">
                                                        <%= item.label.de %>
                                                    </span>
                                                </div>
                                                <% } else if (item.type==='textarea' ) { %>
                                                    <div class="cg-evidence-field">
                                                        <label data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                                                            <span class="lang-line lang-primary">
                                                                <%= item.label.de %>
                                                            </span>
                                                        </label>
                                                        <textarea id="<%= item.id %>" name="<%= item.id %>" rows="2"
                                                            data-i18n-placeholder="answerPlaceholder"
                                                            placeholder="Deine Antwort hier..."></textarea>
                                                    </div>
                                                    <% } else { %>
                                                        <div class="cg-evidence-field">
                                                            <label
                                                                data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                                                                <span class="lang-line lang-primary">
                                                                    <%= item.label.de %>
                                                                </span>
                                                            </label>
                                                            <input type="text" id="<%= item.id %>" name="<%= item.id %>"
                                                                data-i18n-placeholder="answerPlaceholder"
                                                                placeholder="Deine Antwort hier...">
                                                        </div>
                                                        <% } %>
                                                            <% }) %>
                                    </div>
                                    <div class="cg-col-logro">
                                        <% for (let s=1; s <=group.stars; s++) { %>
                                            <div class="cg-star-row">
                                                <span class="cg-star" data-group="<%= gIdx %>" data-star="<%= s %>"
                                                    onclick="setCgStar(<%= gIdx %>, <%= s %>)">☆</span>
                                                <label class="cg-checkbox">
                                                    <input type="checkbox" id="cg_check_<%= gIdx %>_<%= s %>"
                                                        name="cg_check_<%= gIdx %>_<%= s %>">
                                                    <span class="checkmark"></span>
                                                </label>
                                            </div>
                                            <% } %>
                                                <input type="hidden" id="cg_stars_<%= gIdx %>"
                                                    name="cg_stars_<%= gIdx %>" value="0">
                                    </div>
                                </div>
                                <% }) %>
                        </div>

                        <!-- Total Stars Summary -->
                        <div class="cg-total-summary">
                            <span class="cg-total-label">
                                <i class="fas fa-star" style="color: #f59e0b;"></i>
                                <span data-i18n="totalStarsCollected">Ich habe insgesamt gesammelt:</span>
                            </span>
                            <span class="cg-total-value" id="cgTotalValue">0</span>
                            <span class="cg-total-of">/ <%= activity.stars %></span>
                            <span data-lang-content="<%- JSON.stringify(activity.achievement).replace(/"/g, '&quot;') %>">
                                <%= activity.achievement.de %>
                            </span>
                        </div>
                    </div>
                    <% } %>



                                <% if (activity.evidence && activity.evidence.length > 0 && activity.id !== 'profile') { %>
                                    <div class="section">
                                        <h2><i class="fas fa-file-alt"></i> <span data-i18n="evidenceTitle">Nachweise / Evidenz</span></h2>
                                        <%# Temática del reto (Tecnología 1-3: «Misión OASIS», Ready Player One) %>
                                        <% if (activity.theme) { %>
                                            <div class="reto-theme">
                                                <span class="reto-theme-icon" aria-hidden="true">🎮</span>
                                                <p data-lang-content="<%- JSON.stringify(activity.theme).replace(/"/g, '&quot;') %>"><%= activity.theme[lang] || activity.theme.es %></p>
                                            </div>
                                        <% } %>
                                        <%# La inteligencia artificial en la competencia KMK de este reto (data_reto0_quiz.js, KMK_COMPETENCES) %>
                                        <% const kmkAreaOfReto = locals.kmkArea ? locals.kmkArea(activity.level) : null;
                                           if (kmkAreaOfReto && kmkAreaOfReto.ai) { %>
                                            <div class="ai-focus">
                                                <span class="ai-focus-icon" aria-hidden="true">🤖</span>
                                                <p><strong><span data-i18n="est_ia_en_competencia"><%= locals.t('est_ia_en_competencia') %></span> · KMK <%= kmkAreaOfReto.id %> <span data-lang-content="<%- JSON.stringify(kmkAreaOfReto.name).replace(/"/g, '&quot;') %>"><%= kmkAreaOfReto.name[lang] || kmkAreaOfReto.name.es %></span></strong><br>
                                                <span data-lang-content="<%- JSON.stringify(kmkAreaOfReto.ai).replace(/"/g, '&quot;') %>"><%= kmkAreaOfReto.ai[lang] || kmkAreaOfReto.ai.es %></span></p>
                                            </div>
                                        <% } %>
                                        <%
                                            // Retroalimentación (solicitudes 14 y 15): cada pregunta evaluativa (radio con opción
                                            // correcta) es una tarjeta con número grande, color del reto y dibujos de fondo; su
                                            // «¿por qué?» es una tarjeta dividida: XP de la respuesta | estrellas de la explicación.
                                            const isQuizItem = it => it && it.type === 'radio_group' && Array.isArray(it.options) && it.options.some(o => o && o.correct);
                                            const quizNumbers = {};
                                            let quizCount = 0;
                                            activity.evidence.forEach(it => { if (isQuizItem(it)) quizNumbers[it.id] = ++quizCount; });
                                            const qt = key => { const v = locals.t(key); return v === key ? ({ est_quiz_tu_respuesta: 'Tu respuesta', est_quiz_explica_tip: '¡Una buena explicación te da más estrellas!', est_quiz_sin_responder: 'Elige una respuesta' })[key] || key : v; };
                                        %>
                                        <% activity.evidence.forEach(item=> {
                                            const quizN = quizNumbers[item.id];
                                            const explainOf = item.id.endsWith('_explain') ? item.id.slice(0, -8) : null;
                                            const explainN = explainOf ? quizNumbers[explainOf] : null;
                                            const cardClass = quizN ? ' quiz-card quiz-reto-' + activity.level : explainN ? ' quiz-explain-card quiz-reto-' + activity.level : '';
                                        %>
                                            <div class="form-group<%= cardClass %>"<% if (quizN) { %> data-quiz-id="<%= item.id %>"<% } %>>
                                                <% if (quizN) { %>
                                                    <div class="quiz-deco" aria-hidden="true"><% (locals.quizDecor ? locals.quizDecor(activity.level, activity.subject, quizN) : []).forEach((e, di) => { %><span class="quiz-deco-<%= di %>"><%= e %></span><% }) %></div>
                                                    <div class="quiz-num" aria-hidden="true"><%= quizN %></div>
                                                <% } %>
                                                <% if (explainN) { %>
                                                <div class="quiz-split">
                                                    <div class="quiz-split-left" id="quizxp_<%= explainOf %>">
                                                        <span class="quiz-xp-title"><span data-i18n="est_quiz_tu_respuesta"><%= qt('est_quiz_tu_respuesta') %></span> <%= explainN %></span>
                                                        <span class="quiz-face" aria-hidden="true">🤔</span>
                                                        <strong class="quiz-xp-value">—</strong>
                                                        <small class="quiz-xp-note"><span data-i18n="est_quiz_sin_responder"><%= qt('est_quiz_sin_responder') %></span></small>
                                                    </div>
                                                    <div class="quiz-split-right">
                                                        <p class="quiz-explain-tip">✨ <span data-i18n="est_quiz_explica_tip"><%= qt('est_quiz_explica_tip') %></span></p>
                                                <% } %>
                                                <%# Identificador de la competencia KMK que trabaja la pregunta (p. ej. «KMK 1.1 · Buscar y filtrar») %>
                                                <% if (item.type === 'radio_group' && item.kmk) {
                                                    const kmkSub = locals.kmkSubcompetence ? locals.kmkSubcompetence(item.kmk) : null; %>
                                                    <p class="kmk-tag" data-kmk="<%= item.kmk %>">
                                                        <i class="fas fa-bullseye" aria-hidden="true"></i>
                                                        <span class="notranslate" translate="no">KMK <%= item.kmk %></span>
                                                        <% if (kmkSub) { %>· <span data-lang-content="<%- JSON.stringify(kmkSub.name).replace(/"/g, '&quot;') %>"><%= kmkSub.name[lang] || kmkSub.name.es %></span><% } %>
                                                        <% if (item.ai) { %><span class="ai-tag" title="<%= locals.t('est_ia_pregunta') %>" data-i18n-title="est_ia_pregunta"><span aria-hidden="true">🤖</span> <span data-i18n="est_ia_etiqueta"><%= locals.t('est_ia_etiqueta') %></span></span><% } %>
                                                    </p>
                                                <% } %>
                                                <label for="<%= item.id %>" data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                                                    <span class="lang-line lang-primary">
                                                        <%= (item.label && item.label.de) || (item.label && item.label.es) || '' %>
                                                    </span>
                                                </label>

                                                <% if (item.practice_explanation) { %>
                                                    <div class="practice-explanation-box" style="display:none;" data-lang-content="<%- JSON.stringify(item.practice_explanation).replace(/"/g, '&quot;') %>">
                                                        <p><%= item.practice_explanation.es %></p>
                                                    </div>
                                                <% } %>

                                                <% if (item.type === 'text') { %>
                                                    <input type="text" id="<%= item.id %>" name="<%= item.id %>" data-i18n-placeholder="answerPlaceholder" placeholder="Deine Antwort hier...">
                                                <% } else if (item.type === 'textarea') { %>
                                                    <textarea id="<%= item.id %>" name="<%= item.id %>" rows="<%= item.rows || 3 %>" data-i18n-placeholder="answerPlaceholder" placeholder="Deine Antwort hier..."></textarea>
                                                <% } else if (item.type === 'radio_group') { %>
                                                    <div class="radio-group" id="group_<%= item.id %>">
                                                        <% item.options.forEach((opt, optIdx) => {
                                                            const safeId = item.id + '_' + optIdx;
                                                            const optLabel = (typeof opt === 'object') ? (opt.label || opt) : opt;
                                                            %>
                                                            <div class="radio-item" style="margin-bottom:8px; display:flex; align-items:center; gap:10px; cursor:pointer;" onclick="pickRadioOption(event, '<%= safeId %>')">
                                                                <input type="radio" id="<%= safeId %>" name="<%= item.id %>" value="<%= opt.val !== undefined ? opt.val : optIdx %>" data-correct="<%= opt.correct ? 'true' : 'false' %>" onchange="if(typeof updateStarSummary === 'function') updateStarSummary()" style="cursor:pointer; width:18px; height:18px;">
                                                                <label for="<%= safeId %>" style="display:inline; font-weight:normal; cursor:pointer; margin:0;" <% if (typeof opt === 'object') { %> data-lang-content="<%- JSON.stringify(optLabel).replace(/"/g, '&quot;') %>" <% } %>>
                                                                    <% if (typeof opt === 'object') { %>
                                                                        <span class="lang-line lang-primary">
                                                                            <%= optLabel.de || optLabel.es || '' %>
                                                                        </span>
                                                                    <% } else { %>
                                                                        <%= opt %>
                                                                    <% } %>
                                                                </label>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                <% } %>

                                                <% if (quizN) { %>
                                                    <%# La explicación (hint) solo aparece después de responder, en «¿Por qué?» %>
                                                    <div class="quiz-feedback" id="quizfb_<%= item.id %>" role="status" aria-live="polite" hidden
                                                         data-hint="<%- JSON.stringify(item.hint || null).replace(/"/g, '&quot;') %>"></div>
                                                <% } else if (item.hint) { %>
                                                    <div class="question-hint-box" style="margin-top: 8px; font-size: 0.85em; color: #475569; display: flex; align-items: start; gap: 6px; background: #f8fafc; padding: 8px 12px; border-radius: 6px; border-left: 3px solid #f59e0b;">
                                                        <span style="font-size: 1.15em; line-height: 1.2;">💡</span>
                                                        <span class="lang-line lang-primary" data-lang-content="<%- JSON.stringify(item.hint).replace(/"/g, '&quot;') %>"><%= item.hint.de || item.hint.es || '' %></span>
                                                    </div>
                                                <% } %>

                                                <% if (activity.id !== 'profile' && activity.id !== 'notes' && item.type !== 'checkbox_group') { %>
                                                    <% if (!item.id.endsWith('_explain')) { %>
                                                        <div class="field-star-rating" data-field-id="<%= item.id %>">
                                                            <span class="field-star-label">⭐</span>
                                                            <span class="mini-star" data-val="1">☆</span>
                                                            <span class="mini-star" data-val="2">☆</span>
                                                            <span class="mini-star" data-val="3">☆</span>
                                                            <span class="mini-star" data-val="4">☆</span>
                                                            <span class="mini-star" data-val="5">☆</span>
                                                            <span class="sad-face-indicator" id="sad_<%= item.id %>" style="display: none; margin-left: 10px; font-size: 1.2em; cursor: default;" title="<%= locals.t('est_respuesta_incorrecta_sin') %>" data-i18n-title="est_respuesta_incorrecta_sin">😢</span>
                                                            <input type="hidden" id="star_<%= item.id %>" name="star_<%= item.id %>" value="0">
                                                        </div>
                                                    <% } %>
                                                <% } %>
                                                <% if (explainN) { %>
                                                        <div class="quiz-explain-status" id="quizex_<%= explainOf %>" role="status" aria-live="polite"></div>
                                                    </div>
                                                </div>
                                                <% } %>
                                            </div>
                                        <% }) %>
                                    </div>


                                <% } %>

                                        <% if (activity.teachersBySubject && activity.teachersBySubject.length > 0 && activity.id !== 'profile') { %>
                                            <div class="section teachers-by-subject-section">
                                                <h2><i class="fas fa-chalkboard-teacher"></i>
                                                    <span data-i18n="myTeachers">Meine Lehrer*innen / Mis
                                                        Profesores</span>
                                                </h2>
                                                <div class="teachers-grid">
                                                    <% activity.teachersBySubject.forEach(t=> { %>
                                                        <div class="teacher-card"
                                                            style="border-color: <%= t.subjectColor %>">
                                                            <div class="teacher-card-header"
                                                                style="background: <%= t.subjectColor %>15">
                                                                <span class="teacher-subject-icon">
                                                                    <%= t.subjectIcon %>
                                                                </span>
                                                                <span class="teacher-subject-name"
                                                                    data-lang-content="<%- JSON.stringify(t.subjectName).replace(/"/g, '&quot;') %>">
                                                                    <span class="lang-line lang-primary">
                                                                        <%= t.subjectName.de %>
                                                                    </span>
                                                                </span>
                                                            </div>
                                                            <div class="teacher-card-input">
                                                                <input type="text" id="<%= t.fieldId %>"
                                                                    name="<%= t.fieldId %>"
                                                                    list="teacher_datalist"
                                                                    data-lang-content="<%- JSON.stringify(t.label).replace(/"/g, '&quot;') %>"
                                                                    placeholder="<%= locals.t('est_name_nombre') %>" data-i18n-placeholder="est_name_nombre"
                                                                    value="<%= (typeof teacherConfig !== 'undefined' && teacherConfig[t.subjectId]) ? teacherConfig[t.subjectId] : 'NO APLICA' %>">
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <datalist id="teacher_datalist">
                                                    <option value="NO APLICA">
                                                    <% if(typeof allTeachers !== 'undefined') { allTeachers.forEach(function(teacher) { %>
                                                        <option value="<%= teacher %>">
                                                    <% }); } %>
                                                </datalist>
                                            </div>
                                            <% } %>

                                                <% if (activity.achievement) { %>
                                                    <div class="section">
                                                        <div class="achievement-section">
                                                            <label for="achievement_count"
                                                                style="margin: 0; font-size: 1.2em;">
                                                                <i class="fas fa-trophy"></i> <span
                                                                    data-i18n="totalCollected">Ich habe
                                                                    insgesamt gesammelt:</span>
                                                            </label>
                                                            <div class="achievement-input">
                                                                <input type="number" id="achievement_count"
                                                                    name="achievement_count" min="0" max="10">
                                                                <span class="achievement-label"
                                                                    data-lang-content="<%- JSON.stringify(activity.achievement).replace(/"/g, '&quot;') %>">
                                                                    <%= typeof activity.achievement==='object' ?
                                                                        activity.achievement.de : activity.achievement
                                                                        %>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% } %>

                                                        <% if (activity.id !=='profile' && activity.id !=='notes' ) { %>
                                                            <div class="section star-summary-section">
                                                                <div class="star-summary-card" id="starSummaryCard">
                                                                    <i class="fas fa-star"
                                                                        style="color: #f59e0b; font-size: 1.8em;"></i>
                                                                    <div class="star-summary-text">
                                                                        <span class="star-summary-label"
                                                                            data-i18n="starSummaryLabel">Resultado:</span>
                                                                        <span class="star-summary-value"
                                                                            id="starSummaryValue">0
                                                                            / 0
                                                                            ⭐</span>
                                                                    </div>
                                                                    <div class="star-summary-bar">
                                                                        <div class="star-summary-fill"
                                                                            id="starSummaryFill" style="width: 0%;">
                                                                        </div>
                                                                    </div>
                                                                    <p class="star-summary-message"
                                                                        id="starSummaryMessage"></p>
                                                                </div>
                                                            </div>
                                                            <% } %>

                                                                <!-- ═══ EVIDENCIAS DEL RETO (retos 1 a 6) ═══ -->
                                                                <% if (/^reto[1-6]_/.test(activity.id)) { %>
                                                                <div class="multimedia-block" id="evidenceBlock">
                                                                    <h3><span style="font-size:1.3em;">📎</span>
                                                                        <span data-i18n="est_ev_titulo"><%= locals.t('est_ev_titulo') %></span>
                                                                    </h3>
                                                                    <p style="color:#6b7280; font-size:0.9em; margin:0 0 16px;"><span data-i18n="est_ev_intro"><%= locals.t('est_ev_intro') %></span></p>

                                                                    <button type="button" class="save-btn" id="evidenceOpenBtn" aria-expanded="false" aria-controls="evidenceForm" style="background:linear-gradient(135deg,#7c3aed,#a855f7); font-size:0.95em;" onclick="toggleEvidenceForm()">
                                                                        <span aria-hidden="true">📎</span> <span data-i18n="est_ev_boton"><%= locals.t('est_ev_boton') %></span>
                                                                        <span id="evidenceCount" hidden style="margin-left:8px; background:rgba(255,255,255,0.25); padding:2px 10px; border-radius:12px; font-size:0.85em;"></span>
                                                                    </button>

                                                                    <div id="evidenceForm" hidden style="margin-top:16px;">
                                                                        <% [1, 2, 3].forEach(n => { %>
                                                                        <label class="mm-label" for="ev_link_<%= n %>"><span data-i18n="est_ev_vinculo"><%= locals.t('est_ev_vinculo') %></span> <%= n %><% if (n > 1) { %> <span style="font-weight:400; color:#94a3b8;">(<span data-i18n="est_ev_opcional"><%= locals.t('est_ev_opcional') %></span>)</span><% } %></label>
                                                                        <input type="url" id="ev_link_<%= n %>" class="mm-input evidence-link" placeholder="https://..." autocomplete="off">
                                                                        <% }) %>

                                                                        <label class="mm-label" for="ev_type"><span data-i18n="est_tipo_de_producto"><%= locals.t('est_tipo_de_producto') %></span></label>
                                                                        <select id="ev_type" class="mm-input">
                                                                            <option value="otro" data-i18n-option="est_otro"><%= locals.t('est_otro') %></option>
                                                                            <option value="video" data-i18n-option="est_video"><%= locals.t('est_video') %></option>
                                                                            <option value="presentacion" data-i18n-option="est_presentacion"><%= locals.t('est_presentacion') %></option>
                                                                            <option value="canvas" data-i18n-option="est_canvas"><%= locals.t('est_canvas') %></option>
                                                                        </select>

                                                                        <label class="mm-label" for="ev_description"><span data-i18n="est_descripcion_breve_del_producto"><%= locals.t('est_descripcion_breve_del_producto') %></span></label>
                                                                        <textarea id="ev_description" class="mm-input" rows="2" maxlength="500"></textarea>
                                                                        <% if (activity.evidenceExample) { %>
                                                                        <p style="color:#64748b; font-size:0.85em; margin:6px 0 0;" data-lang-content='<%- JSON.stringify(activity.evidenceExample).replace(/&/g, "&amp;").replace(/'/g, "&#39;") %>'><%= activity.evidenceExample[locals.lang] || activity.evidenceExample.es %></p>
                                                                        <% } %>

                                                                        <button type="button" class="save-btn" id="evidenceSaveBtn" style="background:linear-gradient(135deg,#7c3aed,#a855f7); margin-top:18px; font-size:0.95em;" onclick="saveEvidence()">
                                                                            <i class="fas fa-cloud-upload-alt"></i> <span data-i18n="est_ev_guardar"><%= locals.t('est_ev_guardar') %></span>
                                                                        </button>
                                                                        <div id="evidenceStatus" role="status" style="margin-top:8px; font-size:0.85em;"></div>
                                                                    </div>
                                                                </div>
                                                                <% } %>

                                                                <% if (activity.id !== 'profile') { %>
<div class="save-actions">
<button type="button" class="save-btn" id="saveBtn">
                                                                        <i class="fas fa-cloud-upload-alt"></i> <span
                                                                            data-i18n="save">Speichern</span>
                                                                    </button>
                                                                    <div class="save-status" id="saveStatus"></div>
                                                                </div>

                                                                <%- include('partials/reto-certificate') %>
    <% } %>
</form>






    <script>
        // Reto 0 Practice Mode Logic
        let setEvaluationMode = null;
        document.addEventListener('DOMContentLoaded', function() {
            const isReto0 = '<%= activity.id %>' === 'profile';
            if (isReto0) {
                const formGroups = document.querySelectorAll('.form-group');
                const saveBtn = document.getElementById('saveBtn');
                const startEvalBtn = document.getElementById('start-reto0-eval-btn');
                
                const rawEvidence = <%- JSON.stringify(activity.evidence) %>;
                const quizQuestions = rawEvidence.filter(item => item.quiz);

                let currentHits = 0;
                let currentErrors = 0;
                const retriedQuestions = new Set(); // preguntas en las que hubo que intentar de nuevo
                let currentQuestionIdx = 0;
                let timerInterval = null;
                let secondsElapsed = 0;

                const edilimTranslations = {
                    es: {
                        score: "Aciertos",
                        mistakes: "Errores",
                        time: "Tiempo",
                        correctMsg: "¡Excelente! Respuesta correcta.",
                        tryAgainMsg: "Incorrecto. ¡Inténtalo de nuevo!",
                        gradTitle: "¡FELICITACIONES, CIUDADANO DIGITAL!",
                        gradSubtitle: "Has completado exitosamente la evaluación del Reto Cero de forma interactiva.",
                        gradNextInstructions: "Guarda tu progreso presionando el botón 'GUARDAR' que aparece a continuación.",
                    },
                    de: {
                        score: "Erfolge",
                        mistakes: "Fehler",
                        time: "Zeit",
                        correctMsg: "Hervorragend! Richtige Antwort.",
                        tryAgainMsg: "Falsch. Versuch es noch einmal!",
                        gradTitle: "HERZLICHEN GLÜCKWUNSCH, DIGITALER BÜRGER!",
                        gradSubtitle: "Du hast die Bewertung von Challenge Null erfolgreich und interaktiv abgeschlossen.",
                        gradNextInstructions: "Speichere deinen Fortschritt, indem du auf die Schaltfläche 'SPEICHERN' unten klickst.",
                    },
                    en: {
                        score: "Hits",
                        mistakes: "Mistakes",
                        time: "Time",
                        correctMsg: "Excellent! Correct answer.",
                        tryAgainMsg: "Incorrect. Try again!",
                        gradTitle: "CONGRATULATIONS, DIGITAL CITIZEN!",
                        gradSubtitle: "You have successfully completed the Challenge Zero evaluation interactively.",
                        gradNextInstructions: "Save your progress by clicking the 'SAVE' button below.",
                    }
                };

                function getTranslation(key) {
                    const lang = window.langUtils ? window.langUtils.getLang() : 'de';
                    return (edilimTranslations[lang] && edilimTranslations[lang][key]) || edilimTranslations['de'][key] || key;
                }

                function playBeep(isSuccess) {
                    try {
                        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                        if (!AudioContextClass) return;
                        const ctx = new AudioContextClass();
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        
                        if (isSuccess) {
                            osc.frequency.setValueAtTime(523.25, ctx.currentTime);
                            osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.1);
                            gain.gain.setValueAtTime(0.1, ctx.currentTime);
                            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.35);
                            osc.start(ctx.currentTime);
                            osc.stop(ctx.currentTime + 0.35);
                        } else {
                            osc.frequency.setValueAtTime(150, ctx.currentTime);
                            osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.25);
                            gain.gain.setValueAtTime(0.15, ctx.currentTime);
                            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
                            osc.start(ctx.currentTime);
                            osc.stop(ctx.currentTime + 0.3);
                        }
                    } catch (e) {
                        console.warn('AudioContext failed:', e);
                    }
                }

                window.renderEdilimQuestion = function(index) {
                    const lang = window.langUtils ? window.langUtils.getLang() : 'de';
                    const q = quizQuestions[index];
                    if (!q) return;
                    
                    const questionText = q.label[lang] || q.label.es || q.label;
                    
                    let html = `
                        <div class="edilim-question-title">
                            <span class="edilim-question-num">${index + 1}</span>
                            <h2>${questionText}</h2>
                        </div>
                        <div class="edilim-options-grid">
                    `;
                    
                    q.options.forEach((opt, optIdx) => {
                        const optLabel = typeof opt === 'object' ? (opt.label || opt) : opt;
                        const optText = typeof optLabel === 'object' ? (optLabel[lang] || optLabel.es || optLabel.de || '') : optLabel;
                        
                        html += `
                            <button type="button" class="edilim-option-btn" data-correct="${opt.correct}" onclick="handleOptionClick(this, ${index}, ${optIdx})">
                                <span class="option-letter">${String.fromCharCode(65 + optIdx)}</span>
                                <span class="option-text">${optText}</span>
                            </button>
                        `;
                    });
                    
                    html += `</div>`;
                    
                    document.getElementById('edilim-question-body').innerHTML = html;
                    
                    const feedbackBox = document.getElementById('edilim-feedback-box');
                    feedbackBox.style.display = 'none';
                    feedbackBox.className = 'edilim-feedback';
                };

                window.handleOptionClick = function(btn, qIdx, optIdx) {
                    const isCorrect = btn.getAttribute('data-correct') === 'true';
                    const feedbackBox = document.getElementById('edilim-feedback-box');
                    const optionBtns = document.querySelectorAll('.edilim-option-btn');
                    
                    if (isCorrect) {
                        optionBtns.forEach(b => b.disabled = true);
                        btn.classList.add('correct');
                        playBeep(true);
                        
                        // Check actual radio button in hidden layout
                        const radioId = `${quizQuestions[qIdx].id}_${optIdx}`;
                        const hiddenRadio = document.getElementById(radioId);
                        if (hiddenRadio) {
                            hiddenRadio.checked = true;
                            if (typeof updateStarSummary === 'function') updateStarSummary();
                        }
                        
                        feedbackBox.style.display = 'flex';
                        feedbackBox.className = 'edilim-feedback correct bounce-in';
                        feedbackBox.innerHTML = `<span>🎉</span> <strong>${getTranslation('correctMsg')}</strong>`;
                        
                        currentHits++;
                        document.getElementById('edilim-hits').textContent = currentHits;
                        
                        const pct = Math.round(((qIdx + 1) / quizQuestions.length) * 100);
                        document.getElementById('edilim-progress-fill').style.width = pct + '%';
                        
                        setTimeout(() => {
                            if (currentQuestionIdx < quizQuestions.length - 1) {
                                currentQuestionIdx++;
                                renderEdilimQuestion(currentQuestionIdx);
                            } else {
                                showGraduationScreen();
                            }
                        }, 1500);
                    } else {
                        btn.classList.add('incorrect');
                        btn.classList.add('wobble');
                        btn.disabled = true;
                        playBeep(false);
                        
                        feedbackBox.style.display = 'flex';
                        feedbackBox.className = 'edilim-feedback incorrect shake';
                        feedbackBox.innerHTML = `<span>❌</span> <strong>${getTranslation('tryAgainMsg')}</strong>`;
                        
                        currentErrors++;
                        retriedQuestions.add(qIdx);
                        document.getElementById('edilim-errors').textContent = currentErrors;
                        
                        setTimeout(() => btn.classList.remove('wobble'), 500);
                    }
                };

                // Aprendizaje diferenciado: resultado por competencia en la materia del estudiante. Donde
                // necesitó otro intento ve la explicación de esa materia y el enlace a su reto para reforzar.
                // Evaluación: 1-2 Medienpass; 3-8 una por competencia; 9 seguridad (área 4); 10 derechos (área 3).
                const reto0Study = <%- JSON.stringify(activity.study || null).replace(/</g, '\\u003c') %>;
                function renderReto0Route() {
                    if (!reto0Study) return '';
                    const lang = window.langUtils ? window.langUtils.getLang() : 'es';
                    const text = value => (value && (value[lang] || value.es)) || '';
                    const relatedQuestions = { 3: [4, 9], 4: [5, 8] };
                    const rows = reto0Study.examples.map((example, i) => {
                        const area = i + 1;
                        const questions = relatedQuestions[area] || [i + 2];
                        const retried = questions.filter(q => retriedQuestions.has(q));
                        if (!retried.length) {
                            return `<div class="reto0-route-row">✅ ${example.icon} <strong>${text(example.competence)}</strong>: ${window.t('est_r0_ruta_bien')}</div>`;
                        }
                        const explanations = retried.map(q => `<p>${text(quizQuestions[q] && quizQuestions[q].practice_explanation)}</p>`).join('');
                        return `<div class="reto0-route-row reinforce">🔁 ${example.icon} <strong>${text(example.competence)}</strong>: ${window.t('est_r0_ruta_reforzar')}
                            ${explanations}
                            <a href="/activity/2526/reto${area}_<%= activity.subject %>">🎯 ${window.t('est_r0_tu_reto')} ${area} →</a></div>`;
                    }).join('');
                    return `<div class="reto0-route"><h3>${window.t('est_r0_ruta_titulo')} ${text(reto0Study.subjectName)}</h3>${rows}</div>`;
                }

                function showGraduationScreen() {
                    if (timerInterval) clearInterval(timerInterval);
                    
                    const totalTimeMins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
                    const totalTimeSecs = String(secondsElapsed % 60).padStart(2, '0');
                    
                    let html = `
                        <div class="edilim-graduation-card bounce-in">
                            <div class="grad-badge">🎓🏆🌟</div>
                            <h2>${getTranslation('gradTitle')}</h2>
                            <p class="grad-subtitle">${getTranslation('gradSubtitle')}</p>
                            
                            <div class="grad-stats">
                                <div class="grad-stat-box">
                                    <span class="grad-stat-val">${currentHits}</span>
                                    <span class="grad-stat-lbl">${getTranslation('score')}</span>
                                </div>
                                <div class="grad-stat-box">
                                    <span class="grad-stat-val">${currentErrors}</span>
                                    <span class="grad-stat-lbl">${getTranslation('mistakes')}</span>
                                </div>
                                <div class="grad-stat-box">
                                    <span class="grad-stat-val">${totalTimeMins}:${totalTimeSecs}</span>
                                    <span class="grad-stat-lbl">${getTranslation('time')}</span>
                                </div>
                            </div>
                            
                            ${renderReto0Route()}

                            <div class="grad-next-steps">
                                <p>👇 ${getTranslation('gradNextInstructions')}</p>
                            </div>
                        </div>
                    `;
                    
                    document.getElementById('edilim-question-body').innerHTML = html;
                    document.getElementById('edilim-progress-fill').style.width = '100%';
                    document.getElementById('edilim-progress-fill').style.background = 'linear-gradient(90deg, #10b981, #059669)';
                    
                    const saveBtnQuiz = document.getElementById('reto0-eval-save-footer');
                    if (saveBtnQuiz) saveBtnQuiz.style.display = 'block';
                    
                    if (saveBtn) saveBtn.style.display = 'inline-block';
                }

                function startTimer() {
                    secondsElapsed = 0;
                    if (timerInterval) clearInterval(timerInterval);
                    timerInterval = setInterval(() => {
                        secondsElapsed++;
                        const mins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
                        const secs = String(secondsElapsed % 60).padStart(2, '0');
                        document.getElementById('edilim-timer').textContent = `${mins}:${secs}`;
                    }, 1000);
                }

                function setPracticeMode() {
                    formGroups.forEach(group => {
                        const radioGroup = group.querySelector('.radio-group');
                        const explanation = group.querySelector('.practice-explanation-box');
                        
                        // Hide standard quiz fields and label headers
                        const hasRadio = group.querySelector('.radio-group');
                        const isLabel = group.querySelector('[id*="eval_kv"]');
                        if (hasRadio || isLabel || (group.innerHTML && group.innerHTML.includes('eval_q'))) {
                            group.style.display = 'none';
                        }
                        
                        if (explanation) {
                            explanation.style.display = 'block';
                            explanation.style.background = 'rgba(74, 144, 226, 0.1)';
                            explanation.style.borderLeft = '4px solid #4a90e2';
                            explanation.style.padding = '15px';
                            explanation.style.margin = '10px 0';
                            explanation.style.borderRadius = '0 8px 8px 0';
                        }
                    });
                    
                    const edilimContainer = document.getElementById('edilim-game-container');
                    if (edilimContainer) edilimContainer.style.display = 'none';
                    
                    if (saveBtn) saveBtn.style.display = 'none';
                    const saveBtnQuiz = document.getElementById('reto0-eval-save-footer');
                    if (saveBtnQuiz) saveBtnQuiz.style.display = 'none';
                }

                setEvaluationMode = function() {
                    formGroups.forEach(group => {
                        const explanation = group.querySelector('.practice-explanation-box');
                        if (explanation) explanation.style.display = 'none';
                        
                        // Hide standard question groups
                        const hasRadio = group.querySelector('.radio-group');
                        const isLabel = group.querySelector('[id*="eval_kv"]');
                        if (hasRadio || isLabel || (group.innerHTML && group.innerHTML.includes('eval_q'))) {
                            group.style.display = 'none';
                        }
                    });
                    
                    const edilimContainer = document.getElementById('edilim-game-container');
                    if (edilimContainer) {
                        edilimContainer.style.display = 'block';
                        
                        currentHits = 0;
                        currentErrors = 0;
                        retriedQuestions.clear();
                        currentQuestionIdx = 0;
                        document.getElementById('edilim-hits').textContent = '0';
                        document.getElementById('edilim-errors').textContent = '0';
                        document.getElementById('edilim-progress-fill').style.width = '0%';
                        document.getElementById('edilim-progress-fill').style.background = 'linear-gradient(90deg, #4f46e5, #8b5cf6)';
                        
                        renderEdilimQuestion(0);
                        startTimer();
                        
                        edilimContainer.scrollIntoView({ behavior: 'smooth' });
                    }
                    if (startEvalBtn) startEvalBtn.parentElement.style.display = 'none';
                    // Scroll to top of evaluation
                    const evalHeader = document.querySelector('[data-lang-content*="eval_kv"]');
                    if (evalHeader) evalHeader.scrollIntoView({ behavior: 'smooth' });
                }

                // Default to Practice Mode if not already completed
                setPracticeMode();

                // Live translate Edilim headers and question on language change
                document.addEventListener('langchange', function(e) {
                    const hitsLabelEl = document.querySelector('#edilim-game-container .edilim-stat-group:nth-child(1) .edilim-stat-label');
                    const errorsLabelEl = document.querySelector('#edilim-game-container .edilim-stat-group:nth-child(2) .edilim-stat-label');
                    if (hitsLabelEl) hitsLabelEl.textContent = getTranslation('score');
                    if (errorsLabelEl) errorsLabelEl.textContent = getTranslation('mistakes');
                    const edilimContainer = document.getElementById('edilim-game-container');
                    if (edilimContainer && edilimContainer.style.display !== 'none' && typeof renderEdilimQuestion === 'function' && typeof currentQuestionIdx !== 'undefined') {
                        renderEdilimQuestion(currentQuestionIdx);
                    }
                });

                if (startEvalBtn) {
                    startEvalBtn.addEventListener('click', function() {
                        if (typeof window.visitedSlides === 'undefined' || window.visitedSlides.size < document.querySelectorAll('.mySlides').length) {
                            const lang = window.langUtils ? window.langUtils.getLang() : 'es';
                            let msg = "Hacen falta diapositivas por estudiar para tu evaluación.";
                            if (lang === 'de') {
                                msg = "Es müssen noch Folien für deine Bewertung gelernt werden.";
                            } else if (lang === 'en') {
                                msg = "There are still slides left to study for your evaluation.";
                            }
                            alert(msg);
                            return;
                        }
                        setEvaluationMode();
                    });
                }

                window.triggerReto0Graduation = function(hits, errors = 0, timeSecs = 0) {
                    currentHits = hits;
                    currentErrors = errors;
                    secondsElapsed = timeSecs;
                    var edilimContainer = document.getElementById('edilim-game-container');
                    if (edilimContainer) edilimContainer.style.display = 'block';
                    var practiceFooter = document.getElementById('reto0-practice-footer');
                    if (practiceFooter) practiceFooter.style.display = 'none';
                    showGraduationScreen();
                };
            }
        });
    </script>
    <style>
        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(74, 144, 226, 0.4); }
            70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(74, 144, 226, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(74, 144, 226, 0); }
        }
        .practice-explanation-box p {
            margin: 0;
            line-height: 1.5;
            color: #e0e0e0;
        }

        /* Agente del Profesor Card */
        .teacher-agent-card {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            border: 2px solid #bfdbfe;
            border-radius: 16px;
            padding: 20px;
            margin: 20px 0;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.08);
            animation: revealIn 0.6s ease-out;
            text-align: left;
        }
        .agent-avatar-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .agent-avatar {
            font-size: 2.2em;
            background: #fff;
            padding: 8px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.15);
            display: inline-block;
        }
        .agent-title-area h4 {
            margin: 0;
            font-size: 1.15em;
            font-weight: 800;
            color: #1e3a8a;
        }
        .agent-title-area p {
            margin: 2px 0 0 0;
            font-size: 0.85em;
            color: #3b82f6;
            font-weight: 600;
        }
        .agent-content {
            font-size: 0.95em;
            color: #1e3a8a;
            line-height: 1.6;
            background: rgba(255, 255, 255, 0.6);
            padding: 12px 16px;
            border-radius: 10px;
            border-left: 4px solid #3b82f6;
            font-weight: 500;
        }

        /* Scrollable content inside slide-card */
        .slide-scroll-content {
            max-height: 280px;
            overflow-y: auto;
            width: 100%;
            text-align: left;
            padding-right: 12px;
            margin-top: 10px;
            background: #ffffff;
            border-radius: 12px;
            padding: 16px;
            border: 1px solid #e2e8f0;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
        }
        .slide-scroll-content::-webkit-scrollbar {
            width: 8px;
        }
        .slide-scroll-content::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 6px;
        }
        .slide-scroll-content::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 6px;
            border: 2px solid #f1f5f9;
        }
        .slide-scroll-content::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .slide-section-title {
            font-size: 1em;
            font-weight: 700;
            color: #1e293b;
            margin-top: 14px;
            margin-bottom: 6px;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .slide-section-title:first-of-type {
            margin-top: 0;
        }
        .slide-detail-p {
            font-size: 0.9em !important;
            color: #475569 !important;
            line-height: 1.5 !important;
            margin-bottom: 10px !important;
        }
        .slide-bullets {
            list-style-type: none;
            padding-left: 0;
            margin-bottom: 10px;
            margin-top: 5px;
        }
        .slide-bullets li {
            font-size: 0.88em;
            color: #475569;
            margin-bottom: 6px;
            line-height: 1.5;
            padding-left: 18px;
            position: relative;
        }
        .slide-bullets li::before {
            content: "•";
            color: #3b82f6;
            font-weight: bold;
            font-size: 1.1em;
            position: absolute;
            left: 4px;
            top: -1px;
        }

        /* Gamified Quest Tracker */
        .quest-tracker-container {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
            transition: all 0.3s ease;
        }
        .quest-tracker-container.completed {
            background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
            border: 2px solid #10b981;
            box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.1);
        }
        .quest-tracker-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .quest-tracker-title {
            font-size: 0.95em;
            font-weight: 800;
            color: #334155;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .quest-tracker-container.completed .quest-tracker-title {
            color: #065f46;
        }
        .quest-tracker-stats {
            font-size: 0.95em;
            font-weight: 800;
            color: #4f46e5;
            background: #e0e7ff;
            padding: 2px 10px;
            border-radius: 9999px;
            box-shadow: 0 2px 4px rgba(79, 70, 229, 0.1);
        }
        .quest-tracker-container.completed .quest-tracker-stats {
            color: #ffffff;
            background: #10b981;
            box-shadow: 0 2px 4px rgba(16, 185, 129, 0.2);
            animation: pulse 1.5s infinite;
        }
        .quest-tracker-progress {
            width: 100%;
            height: 8px;
            background: #e2e8f0;
            border-radius: 9999px;
            overflow: hidden;
        }
        .quest-tracker-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #3b82f6, #6366f1);
            border-radius: 9999px;
            transition: width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .quest-tracker-container.completed .quest-tracker-fill {
            background: linear-gradient(90deg, #10b981, #059669);
        }

        /* Concept Card Grid */
        .concept-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 15px;
            width: 100%;
        }
        .concept-item-card {
            background: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 14px;
            cursor: pointer;
            text-align: left;
