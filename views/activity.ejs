                                                        <span style="font-size: 1.15em; line-height: 1.2;">💡</span>
                                                        <span class="lang-line lang-primary" data-lang-content="<%- JSON.stringify(item.hint).replace(/"/g, '&quot;') %>"><%= display(item.hint).primary %></span>
                                                    </div>
                                                <% } %>

