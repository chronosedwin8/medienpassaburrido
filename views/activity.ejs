                                                                </label>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                    <p style="font-size:.85em; color:var(--mp-text-faint); margin-top:6px;">Puedes marcar varias respuestas.</p>
                                                <% } else if (item.type === 'radio_group' || item.type === 'true_false') { %>
                                                    <div class="radio-group" id="group_<%= item.id %>">
                                                        <% item.options.forEach((opt, optIdx) => {
                                                            const safeId = item.id + '_' + optIdx;
                                                            const optLabel = (typeof opt === 'object') ? (opt.label || opt) : opt;
                                                            %>
                                                            <div class="radio-item" style="margin-bottom:8px; display:flex; align-items:center; gap:10px; cursor:pointer;" onclick="document.getElementById('<%= safeId %>').checked = true; if(typeof updateStarSummary === 'function') updateStarSummary();">
                                                                <input type="radio" id="<%= safeId %>" name="<%= item.id %>" value="<%= opt.value !== undefined ? opt.value : (opt.val !== undefined ? opt.val : optIdx) %>" data-correct="<%= opt.correct ? 'true' : 'false' %>" onchange="if(typeof updateStarSummary === 'function') updateStarSummary()" style="cursor:pointer; width:18px; height:18px;">
                                                                <label for="<%= safeId %>" style="display:inline; font-weight:normal; cursor:pointer; margin:0;" <% if (typeof opt === 'object') { %> data-lang-content="<%- JSON.stringify(optLabel).replace(/"/g, '&quot;') %>" <% } %>>
                                                                    <% if (typeof opt === 'object') { const _o = display(optLabel); %>
                                                                        <span class="lang-line lang-primary"><%= _o.primary %></span>
                                                                        <% if (_o.support) { %><span class="lang-line lang-secondary"><%= _o.support %></span><% } %>
                                                                    <% } else { %>
                                                                        <%= opt %>
                                                                    <% } %>
                                                                </label>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                <% } %>

                                                <% const _hintTxt = item.hint && (item.hint.de || item.hint.es || item.hint.en || (typeof item.hint === 'string' ? item.hint : '')); %>
                                                <% if (_hintTxt) { %>
