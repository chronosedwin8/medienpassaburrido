            padding: 12px 16px;
            border-radius: 10px;
            border-left: 4px solid var(--mp-accent);
            font-weight: 500;
        }

        /* Scrollable content inside slide-card */
        .slide-scroll-content {
            max-height: 280px;
            overflow-y: auto;
