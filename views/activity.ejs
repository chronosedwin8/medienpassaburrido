                            </span>
                            <span class="cg-total-value" id="cgTotalValue">0</span>
                            <span class="cg-total-of">/ <%= activity.stars %></span>
                            <span data-lang-content="<%- JSON.stringify(activity.achievement).replace(/"/g, '&quot;') %>">
                                <%= activity.achievement.de %>
                            </span>
                        </div>
                    </div>
                    <% } %>



                                <% if (activity.evidence && activity.evidence.length > 0 && activity.id !== 'profile') { %>
