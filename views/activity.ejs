                                            <div class="form-group" id="wrap_<%= item.id %>" data-qtype="<%= item.type %>">
                                                <% const _lbl = display(item.label); %>
                                                <label for="<%= item.id %>" data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                                                    <span class="lang-line lang-primary"><%= _lbl.primary %></span>
                                                    <% if (_lbl.support) { %><span class="lang-line lang-secondary"><%= _lbl.support %></span><% } %>
                                                </label>

                                                <% if (item.practice_explanation) { %>
                                                    <div class="practice-explanation-box" style="display:none;" data-lang-content="<%- JSON.stringify(item.practice_explanation).replace(/"/g, '&quot;') %>">
                                                        <p><%= item.practice_explanation.es %></p>
                                                    </div>
