                                        <span class="concept-title-text" data-lang-content='<%- langJson(card.title) %>'><%= langText(card.title) %></span>
                                        <span class="concept-status-check">🔍</span>
                                    </div>
                                    <div class="concept-body-content">
                                        <p data-lang-content='<%- langJson(card.body) %>'><%= langText(card.body) %></p>
                                        <% if (card.example) { %>
                                        <p class="concept-in-subject"><strong data-lang-content='<%- langJson(inSubject) %>'><%= langText(inSubject) %></strong> <span data-lang-content='<%- langJson(card.example) %>'><%= langText(card.example) %></span></p>
                                        <% if (card.ai) { %>
                                        <p class="concept-ai"><span aria-hidden="true">🤖</span> <strong data-lang-content='<%- langJson(withAi) %>'><%= langText(withAi) %></strong> <span data-lang-content='<%- langJson(card.ai) %>'><%= langText(card.ai) %></span></p>
                                        <% } %>
                                        <a class="concept-reto-link" href="/activity/2526/reto<%= card.reto %>_<%= activity.subject %>" target="_blank" rel="noopener" onclick="event.stopPropagation()">🎯 <span data-i18n="est_r0_tu_reto"><%= locals.t('est_r0_tu_reto') %></span> <%= card.reto %> →</a>
                                        <% } %>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                    <!-- Slide 6 -->
