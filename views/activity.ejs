                                                    onclick="setCgStar(<%= gIdx %>, <%= s %>)">☆</span>
                                                <label class="cg-checkbox">
                                                    <input type="checkbox" id="cg_check_<%= gIdx %>_<%= s %>"
                                                        name="cg_check_<%= gIdx %>_<%= s %>">
                                                    <span class="checkmark"></span>
                                                </label>
                                            </div>
                                            <% } %>
                                                <input type="hidden" id="cg_stars_<%= gIdx %>"
                                                    name="cg_stars_<%= gIdx %>" value="0">
                                    </div>
                                </div>
                                <% }) %>
                        </div>

                        <!-- Total Stars Summary -->
                        <div class="cg-total-summary">
