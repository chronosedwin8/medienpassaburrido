                                            '🤖','👽','👾','🦸‍♂️','🦸‍♀️','🧙‍♂️','🧙‍♀️','🧛‍♂️','🧛‍♀️','🧚‍♂️','🧚‍♀️','🧜‍♂️','🧜‍♀️','🧝‍♂️','🧝‍♀️','🧞‍♂️','🧞‍♀️','🧟‍♂️','🧟‍♀️',
                                            '💻','📱','🎧','🎮','🖥️','⌨️','🖱️','🔋','📡','🛰️','🚀','🛸',
                                            '🧪','⚗️','🔬','⚛️','🔭','🧬','🧫',
                                            '🎨','🖌️','🖍️','🖼️','🎭','🎻','🎸','🎹','🎷','🎺','🎵','🎬',
                                            '⚽','🏀','🏈','⚾','🎾','🏐','🏉','🎱','🥋','🤺','🏊','🚴','🏆',
                                            '📚','📓','📔','📒','📕','📗','📘','📙','📜','📄','📰','🌎','🗺️','🧭','📐','📏','🕰️','💡','🧮','♟️','🎲','🧩','🪁',
                                            '🍎','🍔','🍕','🍦','🍩','✈️','🏎️','🚲','🌈','⭐','🔥','⚡','❄️',
                                            'α','β','γ','δ','ε','ζ','η','θ','ι','κ','λ','μ','ν','ξ','ο','π','ρ','σ','τ','υ','φ','χ','ψ','ω'
                                        ]; %>
                                        <% avatars.forEach((av, idx) => { %>
                                            <div class="avatar-option" data-avatar="<%= av %>" onclick="selectAvatar('<%= av %>')"><%= av %></div>
                                        <% }); %>
                                    </div>
                                    
                                    <div class="selected-avatar-display" style="margin-top: 20px; text-align: center;">
                                        <p style="font-weight: 600; color: var(--mp-accent-hover);">Tu selección:</p>
                                        <div id="currentAvatarDisplay" style="font-size: 4em; margin: 10px auto; width: 80px; height: 80px; line-height: 80px; background: var(--mp-accent-soft); border-radius: 50%; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 3px solid var(--mp-accent); color: #1e1b4b;">❓</div>
                                    </div>

                                    <input type="hidden" id="profile_photo" name="profile_photo" value="">
                                    
                                    <div style="text-align: center; margin-top: 25px;">
                                        <button type="button" class="save-btn" onclick="saveProfileModule(1, this)" style="background: linear-gradient(135deg, var(--mp-ok), var(--mp-ok)); padding: 12px 24px; font-size: 1.1em; border-radius: 30px; box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.4);" data-lang-content='{"es": "<i class=\"fas fa-save\"></i> Guardar mi Avatar y Continuar", "de": "<i class=\"fas fa-save\"></i> Avatar speichern und weiter", "en": "<i class=\"fas fa-save\"></i> Save my Avatar and Continue"}'><span class="lang-line lang-primary"><i class="fas fa-save"></i> Guardar mi Avatar y Continuar</span></button>
                                    </div>
                                </div>

                                <style>
                                    .avatar-grid {
                                        display: flex;
                                        flex-wrap: wrap;
                                        gap: 8px;
                                        justify-content: center;
                                        max-width: 600px;
                                        margin: 0 auto;
                                        max-height: 250px;
                                        overflow-y: auto;
                                        padding: 10px;
                                        border: 2px solid var(--mp-border);
                                        border-radius: 12px;
                                        background: var(--mp-bg);
                                    }
                                    .avatar-option {
                                        font-size: 1.6em;
                                        cursor: pointer;
                                        width: 40px;
                                        height: 40px;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        background: white;
                                        border-radius: 10px;
                                        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
                                        transition: transform 0.2s, background 0.2s;
