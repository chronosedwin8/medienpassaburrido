                    </div>

                    <%
                        // Diapositivas 4 y 5: contenido de la materia (data_reto0_quiz.js); la evaluación pregunta esto
                        const study = activity.study || { subjectName: { es: '', de: '', en: '' }, examples: [], safety: [] };
                        const langJson = obj => JSON.stringify(obj).replace(/&/g, '&amp;').replace(/'/g, '&#39;');
                        const langText = obj => (obj && (obj[locals.lang] || obj.es)) || '';
                        const conceptCard = (id, sound, icon, title, body) => ({ id, sound, icon, title, body });
                        const pillarCards = [
                            conceptCard('pillar1', 'pop', '👤', { es: '1. Centrado en el estudiante', de: '1. Schülerzentriert', en: '1. Student-centred' }, { es: 'Tú eres responsable de tu proceso de aprendizaje.', de: 'Du bist für deinen Lernprozess verantwortlich.', en: 'You are responsible for your own learning.' }),
                            conceptCard('pillar2', 'pop', '📚', { es: '2. Transversal', de: '2. Fächerübergreifend', en: '2. Cross-curricular' }, { es: 'Se usa en todas las materias, también en ' + study.subjectName.es + '.', de: 'Er gilt in allen Fächern, auch in ' + study.subjectName.de + '.', en: 'It is used in every subject, ' + study.subjectName.en + ' included.' }),
                            conceptCard('pillar3', 'pop', '💻', { es: '3. Formato híbrido', de: '3. Hybrides Format', en: '3. Hybrid format' }, { es: 'Tiene versión impresa y digital.', de: 'Es gibt ihn gedruckt und digital.', en: 'It comes in print and digital versions.' })
                        ];
                        const methodCards = [
                            conceptCard('method1', 'coin', '🎯', { es: '1. Haces los retos', de: '1. Du machst die Challenges', en: '1. You do the challenges' }, { es: 'Realizas tareas y retos para aprender a usar la tecnología.', de: 'Du löst Aufgaben und Challenges, um den Umgang mit Technik zu lernen.', en: 'You complete tasks and challenges to learn how to use technology.' }),
                            conceptCard('method2', 'coin', '⭐', { es: '2. Recibes recompensas', de: '2. Du bekommst Belohnungen', en: '2. You earn rewards' }, { es: 'Las estrellas muestran tu progreso y tu esfuerzo.', de: 'Sterne zeigen deinen Fortschritt und deinen Einsatz.', en: 'Stars show your progress and effort.' }),
                            conceptCard('method3', 'coin', '✅', { es: '3. Validación docente', de: '3. Bestätigung durch die Lehrkraft', en: '3. Teacher validation' }, { es: 'Tu profesor o profesora revisa y valida el reto terminado.', de: 'Deine Lehrkraft prüft und bestätigt die fertige Challenge.', en: 'Your teacher reviews and validates the finished challenge.' })
                        ];
                        const kmkCards = [
                            conceptCard('kmk1', 'chime', '🔍', { es: '1. Buscar, procesar y archivar', de: '1. Suchen, Verarbeiten und Aufbewahren', en: '1. Search, process and store' }, { es: 'Buscar y filtrar fuentes, evaluarlas con pensamiento crítico y guardar los archivos ordenados en la nube.', de: 'Quellen suchen und filtern, kritisch bewerten und Dateien geordnet in der Cloud speichern.', en: 'Search and filter sources, evaluate them critically and keep your files organised in the cloud.' }),
                            conceptCard('kmk2', 'chime', '📡', { es: '2. Comunicar y cooperar', de: '2. Kommunizieren und Kooperieren', en: '2. Communicate and cooperate' }, { es: 'Colaborar en equipo, incluso en el mismo documento, aplicando la netiqueta.', de: 'Im Team zusammenarbeiten, auch im selben Dokument, und die Netiquette beachten.', en: 'Work as a team, even in the same document, following netiquette.' }),
                            conceptCard('kmk3', 'chime', '🎨', { es: '3. Producir y presentar', de: '3. Produzieren und Präsentieren', en: '3. Produce and present' }, { es: 'Crear contenidos digitales respetando los derechos de autor y las licencias.', de: 'Digitale Inhalte gestalten und dabei Urheberrecht und Lizenzen beachten.', en: 'Create digital content while respecting copyright and licences.' }),
                            conceptCard('kmk4', 'chime', '🛡️', { es: '4. Protegerse y actuar con seguridad', de: '4. Schützen und sicher agieren', en: '4. Protect yourself and act safely' }, { es: 'Cuidar tu privacidad, tu salud y el medio ambiente al usar tecnología.', de: 'Privatsphäre, Gesundheit und Umwelt bei der Techniknutzung schützen.', en: 'Protect your privacy, your health and the environment when using technology.' }),
                            conceptCard('kmk5', 'chime', '⚙️', { es: '5. Solucionar problemas y actuar', de: '5. Problemlösen und Handeln', en: '5. Solve problems and act' }, { es: 'Encontrar fallas técnicas, elegir la herramienta adecuada y planificar pasos (algoritmos).', de: 'Technische Fehler finden, das passende Werkzeug wählen und Abläufe planen (Algorithmen).', en: 'Find technical faults, choose the right tool and plan steps (algorithms).' }),
                            conceptCard('kmk6', 'chime', '🧠', { es: '6. Analizar y reflexionar', de: '6. Analysieren und Reflektieren', en: '6. Analyse and reflect' }, { es: 'Detectar los intereses detrás de los contenidos y su influencia en nuestras decisiones.', de: 'Interessen hinter Medieninhalten erkennen und ihren Einfluss auf unsere Entscheidungen verstehen.', en: 'Spot the interests behind content and its influence on our decisions.' })
