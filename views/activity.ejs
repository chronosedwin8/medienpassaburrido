                            { icon: '🔄', color: '#10b981', title: { es: '¿Cómo funciona?', de: 'Wie funktioniert er?', en: 'How does it work?' }, intro: { es: 'Un ciclo de tres pasos:', de: 'Ein Zyklus in drei Schritten:', en: 'A three-step cycle:' }, cards: methodCards },
                            { icon: '🧭', color: '#f59e0b', title: { es: 'Las 6 competencias KMK en ' + study.subjectName.es, de: 'Die 6 KMK-Kompetenzen im Fach ' + study.subjectName.de, en: 'The 6 KMK competences in ' + study.subjectName.en }, intro: { es: 'Lo que vas a aprender con el Medienpass, con un ejemplo de cada competencia en esta materia (la evaluación pregunta por ellos):', de: 'Das lernst du mit dem Medienpass, mit einem Beispiel für jede Kompetenz in diesem Fach (die Bewertung fragt danach):', en: 'What you will learn with the Medienpass, with one example of each competence in this subject (the evaluation asks about them):' }, cards: competenceCards },
                            { icon: '🛡️', color: '#ef4444', title: { es: 'Seguridad y derechos en ' + study.subjectName.es, de: 'Sicherheit und Rechte im Fach ' + study.subjectName.de, en: 'Safety and rights in ' + study.subjectName.en }, intro: { es: 'Tres reglas importantes para esta materia; la última, sobre la inteligencia artificial:', de: 'Drei wichtige Regeln für dieses Fach; die letzte zur künstlichen Intelligenz:', en: 'Three important rules for this subject; the last one is about artificial intelligence:' }, cards: safetyCards }
                        ];
                    %>
                    <% slides.forEach((slide, slideIdx) => { %>
                    <!-- Slide <%= slideIdx + 1 %> -->
                    <div class="mySlides fade"<%- slideIdx > 0 ? ' style="display:none;"' : '' %>>
                        <div class="slide-card" style="border-top-color: <%= slide.color %>; text-align: center; align-items: stretch;">
