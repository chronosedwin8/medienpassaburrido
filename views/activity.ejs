                            <div class="edilim-progress-container" style="width: 100%; height: 8px; background: var(--mp-border); border-radius: 9999px; overflow: hidden; margin-bottom: 25px;">
                                <div id="edilim-progress-fill" style="width: 0%; height: 100%; background: linear-gradient(90deg, var(--mp-accent), var(--mp-accent)); border-radius: 9999px; transition: width 0.4s ease;"></div>
