                <a href="/" class="btn-back-dashboard" style="display: inline-block; background: linear-gradient(135deg, var(--mp-accent), var(--mp-accent)); color: white; padding: 12px 30px; border-radius: 30px; font-weight: bold; text-decoration: none; box-shadow: 0 4px 15px rgba(59,130,246,0.4); transition: all 0.2s;"><i class="fas fa-arrow-left"></i> Volver al Dashboard</a>
