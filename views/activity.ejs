            padding-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .slide-section-title:first-of-type {
            margin-top: 0;
        }
        .slide-detail-p {
            font-size: 0.9em !important;
            color: var(--mp-text-soft) !important;
            line-height: 1.5 !important;
            margin-bottom: 10px !important;
        }
        .slide-bullets {
            list-style-type: none;
            padding-left: 0;
            margin-bottom: 10px;
