    <script>
        // ─── Concept Gamification & Sound Logic ───
        const exploredConcepts = new Set();
        const TOTAL_CONCEPTS = document.querySelectorAll('.concept-item-card').length || 1;

        // Custom Sound Player using browser's Web Audio API
        window.playCustomSound = function(type) {
            try {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (!AudioContextClass) return;
                const ctx = new AudioContextClass();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                
                osc.connect(gain);
                gain.connect(ctx.destination);
                
                const now = ctx.currentTime;
                
                if (type === 'pop') {
                    // Short cute bubble pop
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(450, now);
                    osc.frequency.exponentialRampToValueAtTime(1300, now + 0.08);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                } else if (type === 'coin') {
                    // Double coin collector ping
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(987.77, now); // B5
                    osc.frequency.setValueAtTime(1318.51, now + 0.07); // E6
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.setValueAtTime(0.08, now + 0.07);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'chime') {
                    // Shiny magic chime/sparkle
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.exponentialRampToValueAtTime(1567.98, now + 0.22); // G6
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.22);
                    osc.start(now);
                    osc.stop(now + 0.22);
                } else if (type === 'fanfare') {
                    // Triumphant 8-bit victory fanfare (C5, E5, G5, C6)
                    osc.type = 'square';
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    const duration = 0.08;
                    gain.gain.setValueAtTime(0.04, now);
                    notes.forEach((freq, idx) => {
                        const noteTime = now + (idx * duration);
                        osc.frequency.setValueAtTime(freq, noteTime);
                        if (idx === notes.length - 1) {
                            gain.gain.setValueAtTime(0.04, noteTime);
                            gain.gain.exponentialRampToValueAtTime(0.01, noteTime + 0.35);
                        }
                    });
                    osc.start(now);
                    osc.stop(now + (notes.length * duration) + 0.35);
                } else if (type === 'tick') {
                    // Simple interface tick/tap
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(600, now);
                    osc.frequency.exponentialRampToValueAtTime(150, now + 0.05);
                    gain.gain.setValueAtTime(0.05, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                }
            } catch (e) {
                console.warn('Sound play failed:', e);
            }
        };

        // Explore Concept Handler
        window.exploreConcept = function(element, conceptId, soundType, event) {
            // Determine clicked position for float text
            let x = 40;
            let y = 10;
            if (event && event.clientX && event.clientY) {
                const rect = element.getBoundingClientRect();
                x = event.clientX - rect.left;
                y = event.clientY - rect.top;
            }

            // Only add XP and float if not already explored
            if (!exploredConcepts.has(conceptId)) {
                exploredConcepts.add(conceptId);
                
                // Spawn XP Float text
                const xpFloat = document.createElement('span');
                xpFloat.className = 'xp-float';
                xpFloat.textContent = '+10 XP';
                xpFloat.style.left = `${x}px`;
                xpFloat.style.top = `${y}px`;
                element.appendChild(xpFloat);
                setTimeout(() => xpFloat.remove(), 800);

                // Play sound
                playCustomSound(soundType);
                
                // Set discovered class
                element.classList.add('discovered');

                // Update progress bar
                updateQuestTracker();
                saveMissionState();
            } else {
                // If already discovered, just play tick sound and toggle expansion visual (standard check)
                playCustomSound('tick');
                element.classList.add('discovered'); // ensure it stays open
            }
        };

        // La misión se guarda en r0m_<materia> ({ seen, total }) para que vuelva al abrir la página.
        // Solo se envía esa clave: el servidor la combina con lo guardado (no guarda el resto del formulario).
        function missionInput() {
            const subjectInput = document.getElementById('reto0_subject');
            return subjectInput ? document.getElementById('r0m_' + subjectInput.defaultValue) : null;
        }
        function saveMissionState() {
            const input = missionInput();
            if (!input) return;
            const value = JSON.stringify({ seen: [...exploredConcepts], total: TOTAL_CONCEPTS });
            input.value = value;
            const subject = document.getElementById('reto0_subject').defaultValue;
            const body = { reto0_subject: subject };
            body['r0m_' + subject] = value;
            fetch('/api/save/profile', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
                .then(r => r.json()).then(res => { if (res && res.reto0Progress && window.applyReto0Progress) window.applyReto0Progress(res.reto0Progress); })
                .catch(() => { /* se vuelve a intentar con la siguiente tarjeta o al guardar un módulo */ });
        }
        // Al cargar: las tarjetas ya exploradas quedan abiertas y la barra con sus XP (sin fanfarria)
        window.restoreMission = function () {
            const input = missionInput();
            if (!input || !input.value) return;
            let seen = [];
            try { const parsed = JSON.parse(input.value); seen = Array.isArray(parsed) ? parsed : (parsed.seen || []); } catch (e) { seen = []; }
            seen.forEach(id => {
                const card = document.querySelector('.concept-item-card[data-concept="' + CSS.escape(String(id)) + '"]');
                if (!card) return;
                exploredConcepts.add(String(id));
                card.classList.add('discovered');
            });
            updateQuestTracker(true);
        };

        function updateQuestTracker(silent) {
            const countEl = document.getElementById('quest-tracker-count');
            const fillEl = document.getElementById('quest-tracker-fill');
            const trackerContainer = document.getElementById('questTracker');
            if (!countEl || !fillEl) return;

            const size = exploredConcepts.size;
            const pct = (size / TOTAL_CONCEPTS) * 100;
            
            // i18n label
            const lang = window.langUtils ? window.langUtils.getLang() : 'es';
            let label = `${size * 10} XP`;
            if (lang === 'de') {
                label = `${size * 10} XP`;
            } else if (lang === 'en') {
                label = `${size * 10} XP`;
            }
            
            countEl.textContent = `⭐ ${label}`;
            fillEl.style.width = `${pct}%`;

            if (size === TOTAL_CONCEPTS) {
                trackerContainer.classList.add('completed');
                if (silent === true) return;
                // Play final epic fanfare and confetti
                setTimeout(() => {
                    playCustomSound('fanfare');
                    spawnConfetti();
                }, 300);
            }
        }

        function spawnConfetti() {
            const colors = ['#f59e0b', '#10b981', '#3b82f6', '#ef4444', '#8b5cf6', '#ec4899'];
            const container = document.body;
            for (let i = 0; i < 40; i++) {
                const p = document.createElement('div');
                p.style.position = 'fixed';
                p.style.width = Math.random() * 8 + 6 + 'px';
                p.style.height = Math.random() * 8 + 6 + 'px';
                p.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                p.style.left = Math.random() * 100 + 'vw';
                p.style.top = '-10px';
                p.style.borderRadius = '50%';
                p.style.zIndex = '9999';
                p.style.pointerEvents = 'none';
                
                container.appendChild(p);
                
                const duration = Math.random() * 2 + 1.5;
                const drift = (Math.random() - 0.5) * 200;
                
                p.animate([
                    { transform: 'translateY(0) rotate(0deg)', opacity: 1 },
                    { transform: `translateY(105vh) translateX(${drift}px) rotate(${Math.random() * 360}deg)`, opacity: 0 }
                ], {
                    duration: duration * 1000,
                    easing: 'cubic-bezier(0.1, 0.8, 0.3, 1)'
                });
                
                setTimeout(() => p.remove(), duration * 1000);
            }
        }

        // ─── Slide Deck Logic ───
        let slideIndex = 1;
        window.visitedSlides = new Set(); // Start empty so circles are empty on load

        function showSlides(n) {
            let i;
            let slides = document.getElementsByClassName("mySlides");
            let dots = document.getElementsByClassName("dot");
            if (!slides || slides.length === 0) return;
            if (n > slides.length) {slideIndex = 1}
            if (n < 1) {slideIndex = slides.length}
            
            for (i = 0; i < slides.length; i++) {
                slides[i].style.display = "none";
                slides[i].setAttribute('aria-hidden', 'true');
            }
            for (i = 0; i < dots.length; i++) {
                dots[i].classList.remove("active");
                dots[i].removeAttribute('aria-current');
                if (window.visitedSlides.has(i + 1)) {
                    dots[i].classList.add("visited");
                } else {
                    dots[i].classList.remove("visited");
                }
            }
            slides[slideIndex-1].style.display = "block";
            slides[slideIndex-1].setAttribute('aria-hidden', 'false');
            if (dots[slideIndex-1]) {
                dots[slideIndex-1].classList.add("active");
                dots[slideIndex-1].setAttribute('aria-current', 'true');
            }
        }
        function moveSlide(n) {
            // Mark current slide as visited on click before moving
            window.visitedSlides.add(slideIndex);
            slideIndex += n;
            let slides = document.getElementsByClassName("mySlides");
            if (slideIndex > slides.length) {slideIndex = 1}
            if (slideIndex < 1) {slideIndex = slides.length}
            // Mark new slide as visited on click
            window.visitedSlides.add(slideIndex);
            showSlides(slideIndex);
        }
        function currentSlide(n) {
            // Mark slide as visited on click
            window.visitedSlides.add(n);
            showSlides(slideIndex = n);
        }
        // Initialize slideshow on load if elements exist
        document.addEventListener('DOMContentLoaded', () => {
            if (document.getElementsByClassName("mySlides").length > 0) {
                showSlides(slideIndex);
            }
        });
    </script>

    <script>
        // ─── Star Rating ───
        let currentStarRating = 0;
        function setStarRating(rating) {
            currentStarRating = rating;
            document.getElementById('star_rating_value').value = rating;
            const stars = document.querySelectorAll('.star-clickable');
            stars.forEach(star => {
                const val = parseInt(star.getAttribute('data-star'));
                star.textContent = val <= rating ? '★' : '☆';
                star.classList.toggle('star-filled', val <= rating);
            });
        }

        // ─── Mini Star Rating per Field (Automatic Scoring Rules) ───
        function checkCoherence(text) {
            const trimmed = text.trim();
            if (trimmed.length < 40) return false;
            const words = trimmed.split(/\s+/).filter(w => w.length > 0);
            if (words.length < 8) return false;
            
            // Character variety check
            const uniqueChars = new Set(trimmed.toLowerCase().replace(/\s/g, ''));
            if (uniqueChars.size < 5) return false;
            
            // Word variety check
            const uniqueWords = new Set(words.map(w => w.toLowerCase()));
            if (uniqueWords.size < words.length / 2) return false;
            
            return true;
        }

        // Textos de la retroalimentación (claves est_quiz_* de i18n.js; respaldo en español)
        const QUIZ_FALLBACK = {
            est_quiz_correcto: '¡Correcto!',
            est_quiz_incorrecto: 'Esta vez no. La respuesta correcta es la {letra}).',
            est_quiz_por_que: '¿Por qué?',
            est_quiz_xp_correcta: '+3 XP',
            est_quiz_xp_incorrecta: '0 XP',
            est_quiz_nota_correcta: '¡Bien hecho! Ganaste 3 estrellas.',
            est_quiz_nota_incorrecta: 'Esta respuesta no suma, pero tu explicación sí puede darte estrellas.',
            est_quiz_sin_responder: 'Elige una respuesta',
            est_quiz_explica_ok_correcta: '¡Explicación clara! +2 ⭐',
            est_quiz_explica_ok_incorrecta: '¡Explicación clara! +3 ⭐',
            est_quiz_explica_corta: 'Escribe una explicación completa (mínimo 8 palabras y 40 letras). Llevas {n} palabras.',
            est_quiz_explica_cero: 'Por ahora 0 ⭐: escribe por qué elegiste tu respuesta.'
        };
        function qtext(key) {
            const v = window.t ? window.t(key) : key;
            return v && v !== key ? v : (QUIZ_FALLBACK[key] || key);
        }
        function quizLang() { return window.langUtils ? window.langUtils.getLang() : 'es'; }

        // Clic en el renglón de una opción: la primera respuesta queda fija (las demás se desactivan)
        window.pickRadioOption = function (event, radioId) {
            const radio = document.getElementById(radioId);
            if (!radio || radio.disabled) return;
            if (event && event.target === radio) return; // el propio radio ya dispara change
            if (!radio.checked) {
                radio.checked = true;
                radio.dispatchEvent(new Event('change', { bubbles: true }));
            }
        };

        function renderQuizFeedback() {
            document.querySelectorAll('.quiz-card[data-quiz-id]').forEach(card => {
                const id = card.getAttribute('data-quiz-id');
                const radios = [...card.querySelectorAll('input[type="radio"][name="' + id + '"]')];
                const chosen = radios.find(r => r.checked);
                const box = document.getElementById('quizfb_' + id);
                const xp = document.getElementById('quizxp_' + id);
                const exStatus = document.getElementById('quizex_' + id);
                const explain = document.getElementById(id + '_explain');
                const explainText = explain ? explain.value : '';
                const coherent = checkCoherence(explainText);
                const words = explainText.trim() ? explainText.trim().split(/\s+/).length : 0;

                radios.forEach(r => {
                    const row = r.closest('.radio-item');
                    if (!row) return;
                    row.classList.remove('is-correct', 'is-wrong', 'is-locked');
                    if (chosen) {
                        // Primera respuesta fija: las otras opciones quedan desactivadas
                        r.disabled = r !== chosen;
                        row.classList.add('is-locked');
                        if (r.getAttribute('data-correct') === 'true') row.classList.add('is-correct');
                        else if (r === chosen) row.classList.add('is-wrong');
                    }
                });

                if (!chosen) {
                    if (box) { box.hidden = true; box.innerHTML = ''; }
                    if (xp) {
                        xp.className = 'quiz-split-left';
                        xp.querySelector('.quiz-face').textContent = '🤔';
                        xp.querySelector('.quiz-xp-value').textContent = '—';
                        xp.querySelector('.quiz-xp-note').textContent = qtext('est_quiz_sin_responder');
                    }
                    if (exStatus) { exStatus.className = 'quiz-explain-status'; exStatus.textContent = coherent ? qtext('est_quiz_explica_ok_incorrecta').replace('+3', '+2') : ''; }
                    return;
                }

                const correct = chosen.getAttribute('data-correct') === 'true';
                const correctIdx = radios.findIndex(r => r.getAttribute('data-correct') === 'true');
                const letter = ['a', 'b', 'c', 'd', 'e'][correctIdx] || '';
                let hint = null;
                try { hint = JSON.parse(box ? box.getAttribute('data-hint') : 'null'); } catch (e) { hint = null; }
                const hintText = hint ? (hint[quizLang()] || hint.es || '') : '';
                if (box) {
                    box.hidden = false;
                    box.className = 'quiz-feedback ' + (correct ? 'ok' : 'no');
                    const title = document.createElement('strong');
                    title.textContent = (correct ? '🎉 ' + qtext('est_quiz_correcto') : '💡 ' + qtext('est_quiz_incorrecto').replace('{letra}', letter));
                    box.replaceChildren(title);
                    if (hintText) {
                        const why = document.createElement('span');
                        why.className = 'quiz-why';
                        const label = document.createElement('b');
                        label.textContent = qtext('est_quiz_por_que') + ' ';
                        why.append(label, document.createTextNode(hintText));
                        box.append(why);
                    }
                }
                if (xp) {
                    xp.className = 'quiz-split-left ' + (correct ? 'ok' : 'no');
                    xp.querySelector('.quiz-face').textContent = correct ? '😀' : '😢';
                    xp.querySelector('.quiz-xp-value').textContent = qtext(correct ? 'est_quiz_xp_correcta' : 'est_quiz_xp_incorrecta');
                    xp.querySelector('.quiz-xp-note').textContent = qtext(correct ? 'est_quiz_nota_correcta' : 'est_quiz_nota_incorrecta');
                }
                if (exStatus) {
                    exStatus.className = 'quiz-explain-status' + (coherent ? ' ok' : '');
                    if (coherent) exStatus.textContent = qtext(correct ? 'est_quiz_explica_ok_correcta' : 'est_quiz_explica_ok_incorrecta');
                    else if (words > 0) exStatus.textContent = qtext('est_quiz_explica_corta').replace('{n}', words);
                    else exStatus.textContent = qtext('est_quiz_explica_cero');
                }
            });
        }
        window.renderQuizFeedback = renderQuizFeedback;
        document.addEventListener('langchange', () => { if (document.querySelector('.quiz-card')) renderQuizFeedback(); });

        function recalculateInteractiveStars() {
            // Find all radio group questions (like r1_aleman_k5_q1)
            document.querySelectorAll('.radio-group').forEach(group => {
                const fieldId = group.id.replace('group_', '');
                
                // Get corresponding explain field (textarea)
                const explainInput = document.getElementById(fieldId + '_explain');
                const selectedRadio = group.querySelector('input[type="radio"]:checked');
                const starInput = document.getElementById('star_' + fieldId);
                const sadFace = document.getElementById('sad_' + fieldId);
                const starContainer = document.querySelector(`.field-star-rating[data-field-id="${fieldId}"]`);
                
                if (!starInput) return; // Skip if no rating container exists
                
                let stars = 0;
                let showSad = false;
                
                if (selectedRadio) {
                    const isCorrect = selectedRadio.getAttribute('data-correct') === 'true';
                    const explanationText = explainInput ? explainInput.value : '';
                    const hasCoherentExplain = checkCoherence(explanationText);
                    
                    if (isCorrect) {
                        stars = 3;
                        if (hasCoherentExplain) {
                            stars += 2; // total 5
                        }
                    } else {
                        // Incorrect answer
                        if (hasCoherentExplain) {
                            stars = 3; // 1 + 2 = 3
                        } else {
                            stars = 0;
                            showSad = true; // Incorrect AND no coherent argument -> 0 stars + sad face
                        }
                    }
                } else {
                    // Not answered yet
                    stars = 0;
                    showSad = false;
                }
                
                // Update hidden input
                starInput.value = stars;
                
                // Update sad face visual
                if (sadFace) {
                    sadFace.style.display = showSad ? 'inline' : 'none';
                }
                
                // Update stars visual
                if (starContainer) {
                    starContainer.querySelectorAll('.mini-star').forEach(star => {
                        const val = parseInt(star.getAttribute('data-val'));
                        star.textContent = val <= stars ? '★' : '☆';
                        star.classList.toggle('mini-star-filled', val <= stars);
                    });
                }
            });
            
            // Retroalimentación: correcta/incorrecta, «¿Por qué?» y las dos mitades del «¿por qué?»
            renderQuizFeedback();

            // Trigger the general star summary calculation
            if (typeof updateStarSummary === 'function') {
                updateStarSummary();
            }
        }

        function setFieldStar(fieldId, rating) {
            const container = document.querySelector(`.field-star-rating[data-field-id="${fieldId}"]`);
            if (!container) return;

            const hiddenInput = document.getElementById('star_' + fieldId);
            hiddenInput.value = rating;

            container.querySelectorAll('.mini-star').forEach(star => {
                const val = parseInt(star.getAttribute('data-val'));
                star.textContent = val <= rating ? '★' : '☆';
                star.classList.toggle('mini-star-filled', val <= rating);
            });

            updateStarSummary();
        }

        // ─── Competency Group Stars ───
        function setCgStar(groupIdx, starVal) {
            const hidden = document.getElementById('cg_stars_' + groupIdx);
            if (!hidden) return;
            const currentVal = parseInt(hidden.value) || 0;
            const newVal = (currentVal === starVal) ? 0 : starVal;
            hidden.value = newVal;

            // Update star display for this group
            document.querySelectorAll(`.cg-star[data-group="${groupIdx}"]`).forEach(star => {
                const val = parseInt(star.getAttribute('data-star'));
                star.textContent = val <= newVal ? '★' : '☆';
                star.classList.toggle('cg-star-filled', val <= newVal);
            });
            updateCgTotal();
            updateStarSummary();
        }

        function updateCgTotal() {
            const totalEl = document.getElementById('cgTotalValue');
            if (!totalEl) return;
            let total = 0;
            document.querySelectorAll('[id^="cg_stars_"]').forEach(input => {
                total += parseInt(input.value) || 0;
            });
            totalEl.textContent = total;
        }

        function updateStarSummary() {
            const summaryValue = document.getElementById('starSummaryValue');
            const summaryFill = document.getElementById('starSummaryFill');
            const summaryMessage = document.getElementById('starSummaryMessage');
            if (!summaryValue) return;

            const isProfile = '<%= activity.id %>' === 'profile';

            let totalPoints = 0;
            let maxPoints = 0;

            if (isProfile) {
                // Quiz calculation for profile (Reto 0)
                document.querySelectorAll('.radio-group').forEach(group => {
                    maxPoints++;
                    const selected = group.querySelector('input[type="radio"]:checked');
                    if (selected && selected.getAttribute('data-correct') === 'true') {
                        totalPoints++;
                    }
                });
                
                summaryValue.textContent = `${totalPoints} / ${maxPoints} ✅`;
            } else {
                // Normal star calculation
                document.querySelectorAll('.field-star-rating').forEach(container => {
                    const fieldId = container.getAttribute('data-field-id');
                    const input = document.getElementById('star_' + fieldId);
                    if (input) {
                        totalPoints += parseInt(input.value) || 0;
                        maxPoints += 5;
                    }
                });

                if (currentStarRating > 0) {
                    totalPoints += currentStarRating;
                    const maxMain = document.querySelectorAll('.star-clickable').length;
                    maxPoints += maxMain;
                }
                summaryValue.textContent = `${totalPoints} / ${maxPoints} ⭐`;
            }

            const pct = maxPoints > 0 ? Math.round((totalPoints / maxPoints) * 100) : 0;
            summaryFill.style.width = pct + '%';

            // Color based on percentage
            if (pct >= 80) {
                summaryFill.style.background = 'linear-gradient(90deg, #059669, #10b981)';
                summaryMessage.innerHTML = isProfile ? 
                    '<span style="color:#059669; font-weight:bold;">' + window.t('est_js_aprobado') + '</span>' : 
                    window.t('est_js_excelente');
            } else if (pct >= 50) {
                summaryFill.style.background = 'linear-gradient(90deg, #f59e0b, #fbbf24)';
                summaryMessage.innerHTML = isProfile ? 
                    '<span style="color:#f59e0b; font-weight:bold;">' + window.t('est_js_necesitas_80') + '</span>' : 
                    window.t('est_js_buen_avance');
            } else if (pct > 0) {
                summaryFill.style.background = 'linear-gradient(90deg, #ef4444, #f87171)';
                summaryMessage.innerHTML = isProfile ? 
                    '<span style="color:#ef4444; font-weight:bold;">' + window.t('est_js_debes_repetir') + '</span>' : 
                    window.t('est_js_sigue_adelante');
            } else {
                summaryFill.style.background = '#e2e8f0';
                summaryMessage.textContent = '';
            }

            // Expose percentage for save logic
            window.currentScorePct = pct;
        }

        function selectAvatar(avatarChar) {
            const photoInput = document.getElementById('profile_photo');
            const avatarDisplay = document.getElementById('currentAvatarDisplay');
            const panel2Avatar = document.getElementById('panel2AvatarDisplay');
            const activityHeaderIcon = document.getElementById('activityHeaderIcon');
            const headerUserAvatar = document.getElementById('headerUserAvatar');

            // Update hidden input if it exists
            if (photoInput) {
                photoInput.value = avatarChar;
            }
            
            // Update visual displays if they exist
            if (avatarDisplay) {
                avatarDisplay.innerText = avatarChar;
            }
            if (panel2Avatar) {
                panel2Avatar.innerText = avatarChar;
            }
            if (activityHeaderIcon) {
                activityHeaderIcon.innerText = avatarChar;
            }
            if (headerUserAvatar) {
                headerUserAvatar.innerText = avatarChar;
                headerUserAvatar.style.fontSize = '1.1em';
            }
            
            // Update selection highlight if options exist
            document.querySelectorAll('.avatar-option').forEach(el => {
                el.classList.remove('selected');
                if (el.getAttribute('data-avatar') === avatarChar) {
                    el.classList.add('selected');
                    try {
                        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    } catch(e) {}
                }
            });
        }

        // Dummy function called by existing data restoration code
        function showCapturedPhoto(photoData) {
            const photoInput = document.getElementById('profile_photo');
            const photoDisplay = document.getElementById('capturedPhotoDisplay');
            const startArea = document.getElementById('cameraStartArea');

            if (photoInput) photoInput.value = '';
            if (photoDisplay) photoDisplay.style.display = 'none';
            if (startArea) startArea.style.display = 'block';
        }

        document.addEventListener('DOMContentLoaded', async () => {
            const activityId = '<%= activity.id %>';
            const form = document.getElementById('activityForm');
            const inputs = form.querySelectorAll('input, textarea, select');
            const saveBtn = document.getElementById('saveBtn');
            const saveStatus = document.getElementById('saveStatus');

            function t(key) {
                const lang = window.langUtils ? window.langUtils.getLang() : 'de';
                return (window.i18n && window.i18n[lang] && window.i18n[lang][key]) || key;
            }

            function collectData() {
                const data = {};
                inputs.forEach(input => {
                    if (input.id) {
                        if (input.type === 'checkbox') {
                            data[input.id] = input.checked;
                        } else if (input.type === 'radio') {
                            data[input.id] = input.checked;
                            if (input.checked) {
                                data[input.name] = input.value;
                            }
                        } else {
                            data[input.id] = input.value;
                        }
                    }
                });
                return data;
            }
            // Expose collectData globally
            window.collectData = collectData;
            // saveProfileModule (Reto 0) está fuera de este bloque y también muestra avisos
            window.showToast = showToast;

            // ── Guardado SOLO con los botones ──
            // Nada se envía solo: sin autoguardado periódico, sin envío al ocultar o cerrar
            // la pestaña y sin borrador en localStorage. Se compara el formulario con lo
            // último guardado para mostrar "Cambios sin guardar" y avisar antes de salir.
            let savedSnapshot = null; // se fija al terminar de cargar y tras cada guardado
            function hasUnsavedChanges() {
                return savedSnapshot !== null && JSON.stringify(collectData()) !== savedSnapshot;
            }
            function markSaved(snapshot) {
                savedSnapshot = snapshot || JSON.stringify(collectData());
            }
            window.markActivitySaved = markSaved;

            function showUnsavedStatus() {
                if (!hasUnsavedChanges()) return;
                const html = '<i class="fas fa-pen"></i> ' + t('unsavedChanges');
                [saveStatus, document.getElementById('saveStatusQuiz')].forEach(el => {
                    if (el) {
                        el.innerHTML = html;
                        el.className = 'save-status unsaved';
                    }
                });
            }

            window.addEventListener('beforeunload', (e) => {
                if (!hasUnsavedChanges()) return;
                e.preventDefault();
                e.returnValue = ''; // el navegador muestra su aviso estándar
            });

            inputs.forEach(input => {
                input.addEventListener('change', () => {
                    showUnsavedStatus();
                    if (activityId !== 'profile') recalculateInteractiveStars();
                });
                input.addEventListener('input', () => {
                    showUnsavedStatus();
                    if (activityId !== 'profile') recalculateInteractiveStars();
                });
            });

            // ── Certificado Medienpass (partials/reto-certificate.ejs) ──
            // El servidor dice, al cargar y al guardar, si este reto está ganado (retoResult, 80 %) y
            // cómo van los 7 retos (0 a 6) de la materia (medienpass). El cuadro del certificado solo
            // aparece cuando los 7 están ganados; con el correo guardado aparece el certificado de la
            // materia completa para recortarlo y pegarlo en OneNote.
            const INSTITUTIONAL_EMAIL_RE = /^[a-z0-9._%+-]+@colegioaleman\.edu\.co$/;
            const retoState = { result: null, mp: null, email: '', date: null, error: null };

            function renderRetoWin() {
                const box = document.getElementById('retoWin');
                if (!box) return;
                const mp = retoState.mp;
                const complete = !!(mp && mp.complete);
                box.hidden = !complete;
                if (!complete) return;

                const lang = window.langUtils ? window.langUtils.getLang() : 'es';
                const subjectName = mp.subjectName ? (mp.subjectName[lang] || mp.subjectName.es || '') : '';
                document.getElementById('retoWinStatus').textContent = '🏆 '
                    + t('est_mp_completo').replace('{subject}', subjectName) + ' ' + t('est_reto_cert_pide_correo');

                const errorEl = document.getElementById('retoEmailError');
                errorEl.hidden = !retoState.error;
                errorEl.textContent = retoState.error === 'not_complete' ? t('est_correo_no_completo') : t('est_correo_invalido');

                const showCert = !!retoState.email;
                document.getElementById('retoCertificate').hidden = !showCert;
                document.getElementById('retoCertHint').hidden = !showCert;
                if (!showCert) return;
                document.getElementById('retoCertTitle').textContent = (mp.icon ? mp.icon + ' ' : '') + subjectName;
                const chips = document.getElementById('retoCertRetos');
                chips.replaceChildren(...mp.retos.map(r => {
                    const chip = document.createElement('span');
                    chip.className = 'reto-cert-chip';
                    const label = document.createElement('strong');
                    label.textContent = t('est_cert_reto') + ' ' + r.n;
                    chip.append(label, document.createTextNode('✓ ' + r.pct + ' %'));
                    return chip;
                }));
                document.getElementById('retoCertEmail').textContent = retoState.email;
                document.getElementById('retoCertDate').textContent = 'Barranquilla, '
                    + new Date(mp.completedAt || retoState.date || Date.now()).toLocaleDateString(t('com_locale'), { year: 'numeric', month: 'long', day: 'numeric' });
            }
            document.addEventListener('langchange', renderRetoWin);

            const retoEmailBtn = document.getElementById('retoEmailBtn');
            if (retoEmailBtn) {
                retoEmailBtn.addEventListener('click', async () => {
                    const input = document.getElementById('institutional_email');
                    const email = input.value.trim().toLowerCase();
                    if (!INSTITUTIONAL_EMAIL_RE.test(email)) {
                        retoState.error = 'invalid';
                        renderRetoWin();
                        input.focus();
                        return;
                    }
                    input.value = email;
                    retoState.error = null;
                    await performSave();
                    if (!retoState.email) return;
                    // Mostrar el certificado completo, debajo de la cabecera fija, listo para recortar
                    const cert = document.getElementById('retoCertificate');
                    // Alto de la parte fija de arriba: el encabezado con la barra del nombre (en el celular, solo la barra)
                    const headerHeight = ['.dsb-top', '.dsb-student-bar', 'header']
                        .map(sel => document.querySelector(sel))
                        .filter(el => el && ['fixed', 'sticky'].includes(getComputedStyle(el).position))
                        .reduce((max, el) => Math.max(max, el.getBoundingClientRect().height), 0);
                    window.scrollTo({ top: cert.getBoundingClientRect().top + window.scrollY - headerHeight - 16, behavior: 'smooth' });
                });
            }

            // ── Load existing data ──
            let serverData = {};

            try {
                const response = await fetch('/api/load/' + activityId + (activityId === 'profile' ? '?subject=' + encodeURIComponent(<%- JSON.stringify(activity.subject || '') %>) : ''));
                const result = await response.json();
                if (result.success && result.data) {
                    serverData = result.data;
                }
                if (result.reto0Progress && window.applyReto0Progress) window.applyReto0Progress(result.reto0Progress);
                if (result.retoResult !== undefined) {
                    const mp = result.medienpass || null;
                    Object.assign(retoState, {
                        result: result.retoResult,
                        mp,
                        // Con los 7 retos ganados vale el correo de este reto o el que dejó en otro reto de la materia
                        email: (mp && mp.complete && (serverData.institutional_email || mp.email)) || '',
                        date: result.updated_at
                    });
                }
            } catch (e) {
                console.warn('Failed to load server data:', e);
            }

            // Solo cuenta lo guardado en el servidor. Se borra el borrador local de la versión
            // anterior: en equipos compartidos mostraba las respuestas de otro estudiante.
            try { localStorage.removeItem('medienpass_' + activityId); } catch (e) { /* sin almacenamiento */ }
            const mergedData = serverData;

            // Restore field values
            inputs.forEach(input => {
                if (input.id && mergedData[input.id] !== undefined) {
                    if (input.type === 'checkbox' || input.type === 'radio') {
                        input.checked = mergedData[input.id] === true || mergedData[input.id] === 'true';
                    } else {
                        input.value = mergedData[input.id];
                    }
                }
            });
            // La materia del Reto 0 es la de esta página, no la del último guardado
            const reto0SubjectInput = document.getElementById('reto0_subject');
            if (reto0SubjectInput) reto0SubjectInput.value = reto0SubjectInput.defaultValue;
            // Medienpass completo: el correo que ya dejó en otro reto de la materia aparece escrito
            const emailInput = document.getElementById('institutional_email');
            if (emailInput && !emailInput.value && retoState.email) emailInput.value = retoState.email;

            // Restore star rating if applicable
            if (mergedData.star_rating && typeof setStarRating === 'function') {
                setStarRating(parseInt(mergedData.star_rating));
            }

            // Reto 0: la misión vuelve con las tarjetas ya exploradas
            if (typeof window.restoreMission === 'function') window.restoreMission();

            // Restore profile photo (avatar)
            if (mergedData.profile_photo && typeof selectAvatar === 'function') {
                selectAvatar(mergedData.profile_photo);
            }

            // Restore field stars
            if (activityId !== 'profile') {
                if (typeof recalculateInteractiveStars === 'function') {
                    recalculateInteractiveStars();
                }
            } else {
                document.querySelectorAll('.field-star-rating').forEach(container => {
                    const fieldId = container.getAttribute('data-field-id');
                    const starKey = 'star_' + fieldId;
                    if (mergedData[starKey] !== undefined && typeof setFieldStar === 'function') {
                        setFieldStar(fieldId, parseInt(mergedData[starKey]));
                    }
                });
                if (typeof updateStarSummary === 'function') {
                    updateStarSummary();
                }
            }

            // Reto 0: el servidor dice si la evaluación de esta materia ya está ganada (80 %)
            if (activityId === 'profile') {
                const reto0 = retoState.result;
                if (reto0 && reto0.won) {
                    if (typeof window.triggerReto0Graduation === 'function') {
                        window.triggerReto0Graduation(reto0.score);
                    }
                    const successBanner = document.getElementById('reto0-success-banner');
                    if (successBanner) {
                        successBanner.style.display = 'block';
                    }
                } else if (reto0 && reto0.score > 0) {
                    if (typeof setEvaluationMode === 'function') setEvaluationMode();
                }
            }

            renderRetoWin();

            // Estado inicial = lo que vino del servidor (base de "Cambios sin guardar")
            markSaved();

            function showToast(message, type = 'success') {
                const container = document.getElementById('toast-container');
                const toast = document.createElement('div');
                toast.className = 'toast toast-' + type;
                toast.innerHTML = '<i class="fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-triangle') + '"></i> ' + message;
                container.appendChild(toast);
                setTimeout(() => toast.classList.add('show'), 10);
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }

            async function performSave() {
                const isProfile = activityId === 'profile';
                const data = collectData();
                const snapshot = JSON.stringify(data); // antes de normalizar campos de profesores

                // Validation for profile (normalize teacher fields but do not abort saving)
                if (isProfile) {
                    Object.keys(data).forEach(key => {
                        if (key.startsWith('teacher_')) {
                            const val = data[key] ? data[key].trim() : '';
                            const field = document.getElementById(key);
                            if (val) {
                                if (field) field.classList.remove('input-error');
                                data[key] = val.toUpperCase();
                            }
                        }
                    });
                }

                const saveBtnQuiz = document.getElementById('saveBtnQuiz');
                const saveStatusQuiz = document.getElementById('saveStatusQuiz');

                const disableButtons = (disabled) => {
                    if (saveBtn) saveBtn.disabled = disabled;
                    if (saveBtnQuiz) saveBtnQuiz.disabled = disabled;
                };

                const updateButtonContent = (html) => {
                    if (saveBtn) saveBtn.innerHTML = html;
                    if (saveBtnQuiz) saveBtnQuiz.innerHTML = html;
                };

                disableButtons(true);
                updateButtonContent('<i class="fas fa-spinner fa-spin"></i> ' + t('saving'));

                // Timeout duro para que la UI nunca quede colgada en "Guardando...".
                const controller = new AbortController();
                const tid = setTimeout(() => controller.abort(), 10000);
                try {
                    const response = await fetch('/api/save/' + activityId, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data),
                        signal: controller.signal
                    });

                    const result = await response.json();

                    const updateStatus = (html, className) => {
                        if (saveStatus) {
                            saveStatus.innerHTML = html;
                            saveStatus.className = className;
                        }
                        if (saveStatusQuiz) {
                            saveStatusQuiz.innerHTML = html;
                            saveStatusQuiz.className = className;
                        }
                    };

                    if (result.success) {
                        markSaved(snapshot);
                        if (result.retoResult !== undefined) {
                            const wasComplete = !!(retoState.mp && retoState.mp.complete);
                            const mp = result.medienpass || null;
                            Object.assign(retoState, {
                                result: result.retoResult,
                                mp,
                                email: (mp && mp.complete && (result.institutionalEmail || mp.email)) || '',
                                error: result.emailError,
                                date: new Date().toISOString()
                            });
                            renderRetoWin();
                            // Acaba de ganar el último de los 7 retos: se muestra el cuadro del certificado
                            const winBox = document.getElementById('retoWin');
                            if (!wasComplete && mp && mp.complete && winBox && !isProfile) {
                                winBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                        }
                        if (result.localOnly) {
                            showToast(t('savedLocal'), 'success');
                            updateStatus('<i class="fas fa-check-circle"></i> ' + t('localSave') + ' ' + new Date().toLocaleTimeString(), 'save-status saved');
                        } else {
                            showToast(t('savedSuccess'), 'success');
                            updateStatus('<i class="fas fa-check"></i> ' + t('lastSaved') + ' ' + new Date().toLocaleTimeString(), 'save-status saved');
                        }

                        // Update header avatar dynamically if on profile page
                        if (isProfile) {
                            const avatarVal = document.getElementById('profile_photo')?.value;
                            const headerAvatar = document.getElementById('headerUserAvatar');
                            if (headerAvatar && avatarVal) {
                                if (avatarVal.length < 15) {
                                    headerAvatar.innerHTML = avatarVal;
                                    headerAvatar.style.fontSize = '1.1em';
                                } else if (avatarVal.startsWith('data:image')) {
                                    headerAvatar.innerHTML = `<img src="${avatarVal}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">`;
                                }
                            }
                        }

                        // Reto 0 ganado (80 %, calculado por el servidor): graduación y aviso de éxito
                        if (isProfile && retoState.result && retoState.result.won) {
                            if (typeof window.triggerReto0Graduation === 'function') {
                                window.triggerReto0Graduation(retoState.result.score);
                            }
                            const successBanner = document.getElementById('reto0-success-banner');
                            if (successBanner) {
                                successBanner.style.display = 'block';
                                successBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                        } else if (isProfile) {
                            showToast(window.t('est_guardado_recuerda_que_necesitas'), 'warning');
                        }
                    } else {
                        showToast(t('saveError'), 'error');
                        updateStatus('<i class="fas fa-exclamation-triangle"></i> ' + t('saveError'), 'save-status error');
                    }
                } catch (e) {
                    console.error('Save error:', e);
                    showToast(t('noConnection'), 'error');
                    const errStatus = '<i class="fas fa-wifi"></i> ' + t('noConnection');
                    if (saveStatus) {
                        saveStatus.innerHTML = errStatus;
                        saveStatus.className = 'save-status error';
                    }
                    if (saveStatusQuiz) {
                        saveStatusQuiz.innerHTML = errStatus;
                        saveStatusQuiz.className = 'save-status error';
                    }
                } finally {
                    clearTimeout(tid);
                    disableButtons(false);
                    updateButtonContent('<i class="fas fa-cloud-upload-alt"></i> ' + t('save'));
                }
            }

            if (saveBtn) saveBtn.addEventListener('click', performSave);
            // #saveBtnQuiz solo existe en Reto 0; antes se usaba sin declararlo y en las demás
            // actividades lanzaba un error que cortaba el resto (p. ej. cargar el producto multimedia)
            const saveBtnQuizEl = document.getElementById('saveBtnQuiz');
            if (saveBtnQuizEl) saveBtnQuizEl.addEventListener('click', performSave);

            window.saveAvatarAndContinue = async function(btnEl) {
                const avatar = document.getElementById('profile_photo').value;
                if (!avatar) return alert(window.t('est_por_favor_selecciona_un_avatar'));
                
                const btn = btnEl || document.querySelector('.avatar-selector-container button.save-btn') || event?.currentTarget;
                if (!btn) return;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + window.t('saving');
                btn.disabled = true;

                const data = collectData();

                const controller = new AbortController();
                const tid = setTimeout(() => controller.abort(), 10000);
                try {
                    const response = await fetch('/api/save/' + activityId, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data),
                        signal: controller.signal
                    });
                    const resData = await response.json();
                    if (resData.success) {
                        markSaved(JSON.stringify(data));
                        showToast(window.t('est_avatar_guardado_con_exito'), 'success');
                        
                        // Update header avatar dynamically!
                        const headerAvatar = document.getElementById('headerUserAvatar');
                        if (headerAvatar && avatar) {
                            if (avatar.length < 15) {
                                headerAvatar.innerHTML = avatar;
                                headerAvatar.style.fontSize = '1.1em';
                            } else if (avatar.startsWith('data:image')) {
                                headerAvatar.innerHTML = `<img src="${avatar}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">`;
                            }
                        }

                        // Alerta invitando a la evaluación
                        alert(window.t('est_excelente_has_guardado_tu_perfil'));
                        
                        // Cambiar a modo evaluación y scroll
                        if (setEvaluationMode) {
                            setEvaluationMode();
                        } else {
                            const saveActions = document.querySelector('.save-actions');
                            if (saveActions) saveActions.scrollIntoView({behavior: 'smooth'});
                        }
                    } else {
                        showToast(window.t('est_error_guardando_el_avatar'), 'error');
                    }
                } catch (e) {
                    showToast(window.t('est_error_de_red_al_guardar'), 'error');
                } finally {
                    clearTimeout(tid);
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            };
        });

        // Evidencias del reto: hasta 3 vínculos http(s). Se guardan con su propio botón.
        function toggleEvidenceForm(show) {
            const form = document.getElementById('evidenceForm');
            const btn = document.getElementById('evidenceOpenBtn');
            if (!form || !btn) return;
            const open = show === undefined ? form.hidden : show;
            form.hidden = !open;
            btn.setAttribute('aria-expanded', String(open));
            if (open) document.getElementById('ev_link_1').focus({ preventScroll: true });
        }

        function showEvidenceCount(count) {
            const badge = document.getElementById('evidenceCount');
            if (!badge) return;
            badge.hidden = !count;
            badge.textContent = count ? '✔ ' + count : '';
        }

        function setEvidenceStatus(message, isError) {
            const status = document.getElementById('evidenceStatus');
            status.textContent = message;
            status.style.color = isError ? '#dc2626' : '#059669';
        }

        async function loadEvidence() {
            if (!document.getElementById('evidenceBlock')) return;
            try {
                const { data } = await (await fetch('/api/student/multimedia-product/<%= activity.id %>')).json();
                if (!data) return;
                const links = data.links || [];
                links.slice(0, 3).forEach((link, i) => { document.getElementById('ev_link_' + (i + 1)).value = link; });
                if (data.description) document.getElementById('ev_description').value = data.description;
                const type = document.getElementById('ev_type');
                if ([...type.options].some(opt => opt.value === data.product_type)) type.value = data.product_type;
                showEvidenceCount(links.length);
            } catch (e) { /* sin evidencias todavía */ }
        }

        async function saveEvidence() {
            const links = [...document.querySelectorAll('.evidence-link')].map(input => input.value.trim()).filter(Boolean);
            if (!links.length) return setEvidenceStatus(window.t('est_ev_falta_vinculo'), true);
            const saveBtn = document.getElementById('evidenceSaveBtn');
            saveBtn.disabled = true;
            setEvidenceStatus(window.t('saving'));
            const controller = new AbortController();
            const tid = setTimeout(() => controller.abort(), 10000);
            try {
                const result = await (await fetch('/api/student/multimedia-product', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        activity_id: '<%= activity.id %>',
                        links,
                        product_type: document.getElementById('ev_type').value,
                        description: document.getElementById('ev_description').value
                    }),
                    signal: controller.signal
                })).json();
                if (result.success) {
                    showEvidenceCount(links.length);
                    setEvidenceStatus(window.t('est_ev_guardado'));
                } else if (result.code === 'invalid') {
                    setEvidenceStatus(window.t('est_ev_invalido'), true);
                } else {
                    setEvidenceStatus(window.t('est_js_error') + (result.message || window.t('est_js_no_se_pudo_guardar')), true);
                }
            } catch (e) {
                setEvidenceStatus(window.t('est_js_error_conexion'), true);
            } finally {
                clearTimeout(tid);
                saveBtn.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', loadEvidence);

        // Funciones de cámara han sido eliminadas para utilizar el selector de avatares.
    

            
    

            // Avance real del Reto 0 (services/reto0_progress.js): un panel cuenta cuando lo guardado lo
            // completa, no por abrirlo. Llega al cargar y después de cada guardado.
            const _donePanels = new Set();
            let _activePanel = 1;

            function _updateReto0Progress(activeNum) {
                if (activeNum) _activePanel = activeNum;
                const total = 5;
                const done = _donePanels.size;
                const fill = document.getElementById('reto0ProgressFill');
                const lbl  = document.getElementById('reto0ProgressLabel');
                if (fill) fill.style.width = Math.round((done / total) * 100) + '%';
                if (lbl)  lbl.textContent = done + '/' + total;
                document.querySelectorAll('.reto0-step').forEach(el => {
                    const s = parseInt(el.getAttribute('data-step'));
                    const isDone = _donePanels.has(s);
                    const active = s === _activePanel;
                    el.style.background  = isDone ? '#16a34a' : (active ? '#6366f1' : '#e2e8f0');
                    el.style.color       = (active || isDone) ? '#fff' : '#94a3b8';
                    el.style.borderColor = active ? (isDone ? '#14532d' : '#4f46e5') : 'transparent';
                    el.textContent = isDone ? '✓' : String(s);
                    if (isDone && window.t) el.title = window.t('est_r0_panel_listo');
                    if (active) el.setAttribute('aria-current', 'step');
                    else el.removeAttribute('aria-current');
                });
            }

            window.applyReto0Progress = function (progress) {
                if (!progress || !Array.isArray(progress.panels)) return;
                _donePanels.clear();
                progress.panels.forEach((ok, i) => { if (ok) _donePanels.add(i + 1); });
                _updateReto0Progress();
            };

            window.toggleAccordionPanel = function(num) {
                const panels = document.querySelectorAll('.accordion-panel');
                panels.forEach(p => {
                    const pNum = parseInt(p.getAttribute('id').split('-')[1]);
                    const content = p.querySelector('.accordion-content');
                    const header = p.querySelector('.accordion-header');
                    const arrow = p.querySelector('.panel-arrow');

                    if (pNum === num) {
                        const isVisible = content.style.display === 'block';
                        content.style.display = isVisible ? 'none' : 'block';
                        content.setAttribute('aria-hidden', String(isVisible));
                        if (header) header.setAttribute('aria-expanded', String(!isVisible));
                        if (header) header.classList.toggle('active', !isVisible);
                        if (arrow) arrow.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(180deg)';
                    } else {
                        content.style.display = 'none';
                        content.setAttribute('aria-hidden', 'true');
                        if (header) header.setAttribute('aria-expanded', 'false');
                        if (header) header.classList.remove('active');
                        if (arrow) arrow.style.transform = 'rotate(0deg)';
                    }
                });
                _updateReto0Progress(num);
            };

            // Inicializar progreso con el primer panel activo.
            _updateReto0Progress(1);

            window.advanceAccordionPanel = function(num) {
                toggleAccordionPanel(num + 1);
                setTimeout(() => {
                    const nextHeader = document.querySelector(`#panel-${num + 1} .accordion-header`);
                    if (nextHeader) nextHeader.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 150);
            };

            window.saveProfileModule = async function(num, btnEl) {
                if (!btnEl) return;
                
                if (num === 1) {
                    const avatarVal = document.getElementById('profile_photo').value;
                    if (!avatarVal) {
                        alert(window.t('est_por_favor_selecciona_un_avatar'));
                        return;
                    }
                }

                const originalHtml = btnEl.innerHTML;
                btnEl.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + window.t('saving');
                btnEl.disabled = true;

                // Panel 3 cuenta como hecho cuando el estudiante guarda sus profesores con este botón
                if (num === 3) {
                    const teachersSaved = document.getElementById('r0_teachers');
                    if (teachersSaved) teachersSaved.value = new Date().toISOString();
                }
                const data = collectData();

                const controller = new AbortController();
                const tid = setTimeout(() => controller.abort(), 10000);
                try {
                    const response = await fetch('/api/save/profile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data),
                        signal: controller.signal
                    });

                    const resData = await response.json();
                    if (resData.success) {
                        if (window.markActivitySaved) window.markActivitySaved(JSON.stringify(data));
                        if (resData.reto0Progress) window.applyReto0Progress(resData.reto0Progress);
                        showToast(window.t('est_modulo_guardado').replace('{n}', num), 'success');
                        
                        if (num === 1) {
                            const avatarVal = document.getElementById('profile_photo').value;
                            const headerAvatar = document.getElementById('headerUserAvatar');
                            if (headerAvatar && avatarVal) {
                                headerAvatar.innerHTML = avatarVal;
                                headerAvatar.style.fontSize = '1.1em';
                            }
                        }

                        if (num < 5) {
                            advanceAccordionPanel(num);
                        } else {
                            const successBanner = document.getElementById('reto0-success-banner');
                            if (successBanner) {
                                successBanner.style.display = 'block';
                                successBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                        }
                    } else {
                        showToast(window.t('est_error_al_guardar_el_modulo'), 'error');
                    }
                } catch (e) {
                    console.error('Error saving profile module:', e);
                    showToast(window.t('est_error_de_red_intenta_de_nuevo'), 'error');
                } finally {
                    clearTimeout(tid);
                    btnEl.innerHTML = originalHtml;
                    btnEl.disabled = false;
                }
            };
</script>

