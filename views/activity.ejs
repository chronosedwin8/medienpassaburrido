                                                    data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                                                    <span class="lang-line lang-primary">
                                                        <%= item.label.de %>
                                                    </span>
                                                </div>
                                                <% } else if (item.type==='textarea' ) { %>
                                                    <div class="cg-evidence-field">
                                                        <label data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                                                            <span class="lang-line lang-primary">
                                                                <%= item.label.de %>
                                                            </span>
                                                        </label>
                                                        <textarea id="<%= item.id %>" name="<%= item.id %>" rows="2"
                                                            data-i18n-placeholder="answerPlaceholder" placeholder="<%= t('answerPlaceholder') %>"></textarea>
                                                    </div>
                                                    <% } else { %>
                                                        <div class="cg-evidence-field">
                                                            <label
                                                                data-lang-content="<%- JSON.stringify(item.label).replace(/"/g, '&quot;') %>">
                                                                <span class="lang-line lang-primary">
                                                                    <%= item.label.de %>
                                                                </span>
                                                            </label>
                                                            <input type="text" id="<%= item.id %>" name="<%= item.id %>"
                                                                data-i18n-placeholder="answerPlaceholder" placeholder="<%= t('answerPlaceholder') %>">
                                                        </div>
                                                        <% } %>
                                                            <% }) %>
                                    </div>
                                    <div class="cg-col-logro">
                                        <% for (let s=1; s <=group.stars; s++) { %>
                                            <div class="cg-star-row">
