<!-- Instruments Sidebar Partial - Accordion Style with Auto-Collapse & Vertical Scrollbar -->
<aside id="instrumentsSidebar" class="w-full lg:w-80 bg-gradient-to-b from-[#0f0c29] via-[#1e1b4b] to-[#161439] text-[#e2e8f0] rounded-2xl p-4 shadow-2xl border border-indigo-900/40 flex flex-col justify-between shrink-0 sticky top-20 left-0 self-start max-h-[calc(100vh-6rem)] overflow-y-auto sidebar-scroll-wrapper">

    <style>
        .sidebar-scroll-wrapper::-webkit-scrollbar {
            width: 8px;
        }
        .sidebar-scroll-wrapper::-webkit-scrollbar-track {
            background: rgba(15, 12, 41, 0.9);
            border-radius: 9999px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .sidebar-scroll-wrapper::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #6366f1, #3b82f6);
            border-radius: 9999px;
            border: 2px solid rgba(15, 12, 41, 0.9);
        }
        .sidebar-scroll-wrapper::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #818cf8, #60a5fa);
        }
    </style>

    <div class="space-y-3">
        <!-- Sidebar Brand Header -->
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <div class="flex items-center gap-2.5">
                <span class="text-xl">🏫</span>
                <div class="flex flex-col">
                    <span class="font-extrabold text-sm tracking-wider bg-gradient-to-r from-amber-400 via-pink-400 to-indigo-400 bg-clip-text text-transparent">MEDIENPASS</span>
                    <span class="text-[9px] text-slate-400 font-bold uppercase tracking-widest" id="sidebarSubTitle"><span data-i18n="doc_inst_modo_estudiante"><%= locals.t('doc_inst_modo_estudiante') %></span></span>
                </div>
            </div>
            <span class="text-[9px] bg-indigo-500/20 text-indigo-300 font-bold px-2 py-0.5 rounded-md border border-indigo-500/30 uppercase tracking-wider"><span data-i18n="doc_inst_docente"><%= locals.t('doc_inst_docente') %></span></span>
        </div>

        <!-- Scroll Indicator Hint -->
        <div class="flex items-center justify-between text-[9px] text-indigo-300/70 bg-indigo-950/40 px-2 py-1 rounded border border-indigo-800/30 font-mono">
            <span><i class="fa-solid fa-arrows-up-down"></i> <span data-i18n="doc_inst_menu_con_scroll"><%= locals.t('doc_inst_menu_con_scroll') %></span></span>
            <span><span data-i18n="doc_inst_arriba_abajo"><%= locals.t('doc_inst_arriba_abajo') %></span></span>
        </div>

        <!-- ACCORDION 1: KLASSE (GRADO) -->
        <div class="border border-white/10 rounded-xl overflow-hidden bg-black/20">
            <button onclick="toggleSidebarAccordion('acc-klasse')" class="w-full flex items-center justify-between gap-2 p-2.5 text-xs text-left font-extrabold text-slate-200 hover:text-white transition bg-white/5 hover:bg-white/10">
                <span class="flex items-center gap-2">
                    <i class="fas fa-layer-group text-indigo-400"></i>
                    <span><span data-i18n="doc_inst_1_klasse_grado"><%= locals.t('doc_inst_1_klasse_grado') %></span></span>
                </span>
                <div class="flex items-center gap-1.5">
                    <span id="sidebarGradeActiveLabel" class="text-[9px] bg-indigo-500/30 text-indigo-200 px-1.5 py-0.5 rounded font-bold uppercase">Klasse 5</span>
                    <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-300" id="icon-acc-klasse"></i>
                </div>
            </button>
            <div id="acc-klasse" class="hidden p-3 pt-2 space-y-2 border-t border-white/5 animate-fade-in">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] text-slate-400"><span data-i18n="doc_inst_selecciona_el_grado"><%= locals.t('doc_inst_selecciona_el_grado') %></span></span>
                    <button onclick="changeGrade(null)" class="text-[10px] text-amber-400 hover:text-amber-300 font-semibold" title="<%= locals.t('doc_inst_deseleccionar_grado') %>" data-i18n-title="doc_inst_deseleccionar_grado">
                        <i class="fa-solid fa-xmark"></i> <span data-i18n="doc_inst_limpiar"><%= locals.t('doc_inst_limpiar') %></span>
                    </button>
                </div>
                <select id="sidebarGradeSelect" onchange="changeGrade(this.value ? parseInt(this.value, 10) : null); collapseSidebarAccordion('acc-klasse');" 
                        class="w-full bg-[#0f0c29] border border-indigo-500/40 rounded-xl px-3 py-2 text-xs text-white font-bold focus:outline-none focus:border-indigo-400 cursor-pointer shadow-inner">
                    <option value="" data-i18n-option="doc_inst_sin_seleccionar"><%= locals.t('doc_inst_sin_seleccionar') %></option>
                    <option value="2" data-i18n-option="doc_inst_klasse_2_basico"><%= locals.t('doc_inst_klasse_2_basico') %></option>
                    <option value="3" data-i18n-option="doc_inst_klasse_3_basico_1"><%= locals.t('doc_inst_klasse_3_basico_1') %></option>
                    <option value="4" data-i18n-option="doc_inst_klasse_4_intermedio"><%= locals.t('doc_inst_klasse_4_intermedio') %></option>
                    <option value="5" selected data-i18n-option="doc_inst_klasse_5_intermedio_1"><%= locals.t('doc_inst_klasse_5_intermedio_1') %></option>
                    <option value="6" data-i18n-option="doc_inst_klasse_6_avanzado"><%= locals.t('doc_inst_klasse_6_avanzado') %></option>
                    <option value="7" data-i18n-option="doc_inst_klasse_7_avanzado_1"><%= locals.t('doc_inst_klasse_7_avanzado_1') %></option>
                    <option value="8" data-i18n-option="doc_inst_klasse_8_avanzado_2"><%= locals.t('doc_inst_klasse_8_avanzado_2') %></option>
                    <option value="9" data-i18n-option="doc_inst_klasse_9_avanzado_3"><%= locals.t('doc_inst_klasse_9_avanzado_3') %></option>
                    <option value="10" data-i18n-option="doc_inst_klasse_10_avanzado_4"><%= locals.t('doc_inst_klasse_10_avanzado_4') %></option>
                    <option value="11" data-i18n-option="doc_inst_klasse_11_avanzado_5"><%= locals.t('doc_inst_klasse_11_avanzado_5') %></option>
                    <option value="12" data-i18n-option="doc_inst_klasse_12_avanzado_6"><%= locals.t('doc_inst_klasse_12_avanzado_6') %></option>
                </select>
            </div>
        </div>

        <%# Sin acordeón de idiomas: el idioma se cambia con DE | EN | ES del encabezado de la página. %>
        <!-- ACCORDION 2: SELECCIONA EL RETO A EDITAR -->
        <div class="border border-white/10 rounded-xl overflow-hidden bg-black/20">
            <button onclick="toggleSidebarAccordion('acc-retos')" class="w-full flex items-center justify-between gap-2 p-2.5 text-xs text-left font-extrabold text-slate-200 hover:text-white transition bg-white/5 hover:bg-white/10">
                <span class="flex items-center gap-2">
                    <i class="fas fa-th-large text-indigo-400"></i>
                    <span><span data-i18n="doc_inst_2_selecciona_reto"><%= locals.t('doc_inst_2_selecciona_reto') %></span></span>
                </span>
                <div class="flex items-center gap-1.5">
                    <span id="sidebarRetoActiveLabel" class="text-[9px] bg-indigo-500/30 text-indigo-200 px-1.5 py-0.5 rounded font-bold uppercase"><span data-i18n="doc_inst_reto_0"><%= locals.t('doc_inst_reto_0') %></span></span>
                    <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-300" id="icon-acc-retos"></i>
                </div>
            </button>
            <div id="acc-retos" class="hidden p-3 pt-2 space-y-2 border-t border-white/5 animate-fade-in">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-[10px] text-slate-400"><span data-i18n="doc_inst_selecciona_el_reto_individual"><%= locals.t('doc_inst_selecciona_el_reto_individual') %></span></span>
                    <button onclick="selectRetoFilter(null); collapseSidebarAccordion('acc-retos');" class="text-[10px] text-amber-400 hover:text-amber-300 font-semibold" title="<%= locals.t('doc_inst_deseleccionar_reto') %>" data-i18n-title="doc_inst_deseleccionar_reto">
                        <i class="fa-solid fa-xmark"></i> <span data-i18n="doc_inst_limpiar"><%= locals.t('doc_inst_limpiar') %></span>
                    </button>
                </div>
                
                <div class="space-y-1.5" id="retoFilterGrid">
                    <!-- Reto 0 Intro -->
                    <button onclick="selectRetoFilter(0); collapseSidebarAccordion('acc-retos');" id="btn-reto-0" 
                            class="btn-reto-filter w-full px-3 py-2 rounded-lg border transition-all flex items-center justify-between bg-indigo-600/35 border-l-4 border-l-indigo-400 border-indigo-500/40 text-white font-bold text-xs shadow-sm">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-user-circle text-indigo-300"></i>
                            <span><span data-i18n="doc_inst_reto_0_diagnostico_intro"><%= locals.t('doc_inst_reto_0_diagnostico_intro') %></span></span>
                        </div>
                        <span class="text-[9px] bg-blue-500/20 text-blue-300 px-1.5 py-0.5 rounded font-bold"><span data-i18n="doc_inst_intro"><%= locals.t('doc_inst_intro') %></span></span>
                    </button>

                    <!-- Retos 1 al 6 -->
                    <button onclick="selectRetoFilter(1); collapseSidebarAccordion('acc-retos');" id="btn-reto-1" 
                            class="btn-reto-filter w-full px-3 py-2 rounded-lg border border-transparent text-xs font-medium transition-all flex items-center justify-between text-slate-300 hover:bg-white/10 hover:text-white">
                        <div class="flex items-center gap-2"><i class="fas fa-search text-slate-400"></i> <span><span data-i18n="doc_inst_reto_1_busqueda"><%= locals.t('doc_inst_reto_1_busqueda') %></span></span></div>
                    </button>

                    <button onclick="selectRetoFilter(2); collapseSidebarAccordion('acc-retos');" id="btn-reto-2" 
                            class="btn-reto-filter w-full px-3 py-2 rounded-lg border border-transparent text-xs font-medium transition-all flex items-center justify-between text-slate-300 hover:bg-white/10 hover:text-white">
                        <div class="flex items-center gap-2"><i class="fas fa-comments text-slate-400"></i> <span><span data-i18n="doc_inst_reto_2_comunicacion"><%= locals.t('doc_inst_reto_2_comunicacion') %></span></span></div>
                    </button>

                    <button onclick="selectRetoFilter(3); collapseSidebarAccordion('acc-retos');" id="btn-reto-3" 
                            class="btn-reto-filter w-full px-3 py-2 rounded-lg border border-transparent text-xs font-medium transition-all flex items-center justify-between text-slate-300 hover:bg-white/10 hover:text-white">
                        <div class="flex items-center gap-2"><i class="fas fa-palette text-slate-400"></i> <span><span data-i18n="doc_inst_reto_3_produccion"><%= locals.t('doc_inst_reto_3_produccion') %></span></span></div>
                    </button>

                    <button onclick="selectRetoFilter(4); collapseSidebarAccordion('acc-retos');" id="btn-reto-4" 
                            class="btn-reto-filter w-full px-3 py-2 rounded-lg border border-transparent text-xs font-medium transition-all flex items-center justify-between text-slate-300 hover:bg-white/10 hover:text-white">
                        <div class="flex items-center gap-2"><i class="fas fa-shield-alt text-slate-400"></i> <span><span data-i18n="doc_inst_reto_4_seguridad"><%= locals.t('doc_inst_reto_4_seguridad') %></span></span></div>
                    </button>

                    <button onclick="selectRetoFilter(5); collapseSidebarAccordion('acc-retos');" id="btn-reto-5" 
                            class="btn-reto-filter w-full px-3 py-2 rounded-lg border border-transparent text-xs font-medium transition-all flex items-center justify-between text-slate-300 hover:bg-white/10 hover:text-white">
                        <div class="flex items-center gap-2"><i class="fas fa-cogs text-slate-400"></i> <span><span data-i18n="doc_inst_reto_5_resolucion"><%= locals.t('doc_inst_reto_5_resolucion') %></span></span></div>
                    </button>

                    <button onclick="selectRetoFilter(6); collapseSidebarAccordion('acc-retos');" id="btn-reto-6" 
                            class="btn-reto-filter w-full px-3 py-2 rounded-lg border border-transparent text-xs font-medium transition-all flex items-center justify-between text-slate-300 hover:bg-white/10 hover:text-white">
                        <div class="flex items-center gap-2"><i class="fas fa-brain text-slate-400"></i> <span><span data-i18n="doc_inst_reto_6_analisis"><%= locals.t('doc_inst_reto_6_analisis') %></span></span></div>
                    </button>
                </div>

                <!-- Botón Imprimir Cuadernillo PDF -->
                <button onclick="printPDF()" class="w-full mt-3 px-4 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold rounded-xl text-xs transition shadow-lg shadow-blue-500/20 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-file-pdf text-sm"></i> <span data-i18n="doc_inst_imprimir_cuadernillo_pdf"><%= locals.t('doc_inst_imprimir_cuadernillo_pdf') %></span>
                </button>
            </div>
        </div>

        <!-- ACCORDION 3: CONFIRME SU ASIGNATURA -->
        <div class="border border-white/10 rounded-xl overflow-hidden bg-black/20">
            <button onclick="toggleSidebarAccordion('acc-asignatura')" class="w-full flex items-center justify-between gap-2 p-2.5 text-xs text-left font-extrabold text-slate-200 hover:text-white transition bg-white/5 hover:bg-white/10">
                <span class="flex items-center gap-2">
                    <i class="fas fa-book text-indigo-400"></i>
                    <span><span data-i18n="doc_inst_3_confirma_asignatura"><%= locals.t('doc_inst_3_confirma_asignatura') %></span></span>
                </span>
                <div class="flex items-center gap-1.5">
                    <span id="sidebarSubjectActiveLabel" class="text-[9px] bg-indigo-500/30 text-indigo-200 px-1.5 py-0.5 rounded font-bold uppercase"><span data-i18n="doc_inst_aleman"><%= locals.t('doc_inst_aleman') %></span></span>
                    <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-300" id="icon-acc-asignatura"></i>
                </div>
            </button>
            <div id="acc-asignatura" class="hidden p-3 pt-2 space-y-2 border-t border-white/5 animate-fade-in">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-[10px] text-slate-400"><span data-i18n="doc_inst_materias_disponibles"><%= locals.t('doc_inst_materias_disponibles') %></span></span>
                    <button onclick="changeSubject(null); collapseSidebarAccordion('acc-asignatura');" class="text-[10px] text-amber-400 hover:text-amber-300 font-semibold" title="<%= locals.t('doc_inst_deseleccionar_asignatura') %>" data-i18n-title="doc_inst_deseleccionar_asignatura">
                        <i class="fa-solid fa-xmark"></i> <span data-i18n="doc_inst_limpiar"><%= locals.t('doc_inst_limpiar') %></span>
                    </button>
                </div>
                <div class="space-y-1.5" id="sidebarSubjectSelector">
                    <!-- Filled dynamically by JS -->
                </div>
            </div>
        </div>

        <!-- ACCORDION 4: REALIZA LOS CAMBIOS EN TUS RETOS (solo modo editable) -->
        <div class="border border-white/10 rounded-xl overflow-hidden bg-black/20">
            <button onclick="toggleSidebarAccordion('acc-modalidad')" class="w-full flex items-center justify-between gap-2 p-2.5 text-xs text-left font-extrabold text-slate-200 hover:text-white transition bg-white/5 hover:bg-white/10">
                <span class="flex items-center gap-2">
                    <i class="fas fa-sliders text-indigo-400"></i>
                    <span><span data-i18n="doc_inst_4_modalidad_y_pdf"><%= locals.t('doc_inst_4_modalidad_y_pdf') %></span></span>
                </span>
                <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-300" id="icon-acc-modalidad"></i>
            </button>
            <div id="acc-modalidad" class="hidden p-3 pt-2 space-y-3 border-t border-white/5 animate-fade-in">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] text-slate-400"><span data-i18n="doc_inst_modo_de_edicion_activo"><%= locals.t('doc_inst_modo_de_edicion_activo') %></span></span>
                </div>
                <div class="space-y-2">
                    <!-- OPTION: EDITABLE (ÚNICO MODO) -->
                    <button onclick="switchInstrumentMode('editable');" id="btn-mode-editable" 
                            class="w-full text-left px-3.5 py-2.5 rounded-xl border transition-all duration-200 flex items-start gap-2.5 bg-amber-500/20 border-l-4 border-l-amber-500 border-amber-500/40 text-white shadow-lg shadow-amber-950/50">
                        <div class="w-6 h-6 rounded-lg bg-amber-500/30 text-amber-300 flex items-center justify-center text-xs shrink-0 mt-0.5">✏️</div>
                        <div>
                            <h4 class="font-extrabold text-xs text-white leading-tight"><span data-i18n="doc_inst_editable"><%= locals.t('doc_inst_editable') %></span></h4>
                            <p class="text-[9px] text-amber-200/80"><span data-i18n="doc_inst_editar_enunciados_opciones_y"><%= locals.t('doc_inst_editar_enunciados_opciones_y') %></span></p>
                        </div>
                    </button>
                </div>

                <!-- Action Panel for Editable Mode -->
                <div id="sidebarPanelEditable" class="bg-amber-500/10 rounded-xl p-3 border border-amber-500/30 space-y-2 animate-fade-in">
                    <h5 class="text-xs font-bold text-amber-300 flex items-center gap-1.5">
                        <i class="fa-solid fa-pen-to-square"></i> <span data-i18n="doc_inst_acciones_del_editor"><%= locals.t('doc_inst_acciones_del_editor') %></span>
                    </h5>
                    <div class="space-y-1.5 text-xs">
                        <button onclick="addNewQuestionToEditor()" class="w-full py-1.5 px-3 bg-amber-500/20 hover:bg-amber-500/30 text-amber-200 border border-amber-500/40 rounded-lg font-bold transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus text-xs"></i> <span data-i18n="doc_inst_anadir_pregunta"><%= locals.t('doc_inst_anadir_pregunta') %></span>
                        </button>
                        <button onclick="saveCustomInstrumentToServer();" id="btnSaveInstrument" class="w-full py-1.5 px-3 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-lg font-extrabold transition flex items-center justify-center gap-2 shadow-md">
                            <i class="fa-solid fa-floppy-disk"></i> <span data-i18n="doc_inst_guardar_cambios"><%= locals.t('doc_inst_guardar_cambios') %></span>
                        </button>
                        <button onclick="resetInstrumentToDefault()" id="btnResetInstrument" class="w-full py-1.5 px-3 bg-white/5 hover:bg-rose-500/20 text-slate-300 hover:text-rose-200 border border-white/10 rounded-lg font-semibold transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-rotate-left text-xs"></i> <span data-i18n="doc_inst_restablecer_al_sistema"><%= locals.t('doc_inst_restablecer_al_sistema') %></span>
                        </button>
                    </div>
                </div>

                <%# Quién puede guardar y a quién llega (lo escribe student-preview.ejs) %>
                <p id="editorAccessNote" class="text-[10px] leading-snug text-slate-300 bg-black/20 border border-white/10 rounded-lg p-2"></p>
            </div>
        </div>

        <!-- ACCORDION 5: SECUENCIA DE REVISIÓN PERSISTENTE -->
        <div class="border border-white/10 rounded-xl overflow-hidden bg-black/20">
            <button onclick="toggleSidebarAccordion('acc-secuencia')" class="w-full flex items-center justify-between gap-2 p-2.5 text-xs text-left font-extrabold text-slate-200 hover:text-white transition bg-white/5 hover:bg-white/10">
                <span class="flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-emerald-400"></i>
                    <span><span data-i18n="doc_inst_5_secuencia_revision"><%= locals.t('doc_inst_5_secuencia_revision') %></span></span>
                </span>
                <div class="flex items-center gap-1.5">
                    <span id="reviewLangBadge" class="text-[9px] bg-emerald-500/20 text-emerald-300 font-extrabold px-1.5 py-0.5 rounded uppercase">ES</span>
                    <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-300" id="icon-acc-secuencia"></i>
                </div>
            </button>
            <div id="acc-secuencia" class="hidden p-3 pt-2 space-y-3 border-t border-white/5 animate-fade-in">
                <p class="text-[10px] text-slate-400 leading-tight">
                    <span data-i18n="doc_inst_marca_los_retos_revisados_para_el"><%= locals.t('doc_inst_marca_los_retos_revisados_para_el') %></span>
                </p>

                <!-- Sequence Tracker Grid -->
                <div class="bg-black/30 border border-white/10 rounded-xl p-2.5 space-y-1.5" id="reviewSequenceList">
                    <!-- Filled dynamically by JS -->
                </div>

                <!-- Botón Explícito de Guardado -->
                <button onclick="saveReviewSequence()" id="btnSaveReviewSeq" class="w-full py-2 px-3 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold rounded-xl text-xs transition shadow-md flex items-center justify-center gap-2">
                    <i class="fa-solid fa-floppy-disk"></i> <span><span data-i18n="doc_inst_guardar_secuencia_de_revision"><%= locals.t('doc_inst_guardar_secuencia_de_revision') %></span></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Footer / Active Status -->
    <div class="border-t border-white/10 pt-3 space-y-2 text-[11px] text-slate-400 mt-4">
        <div class="flex items-center justify-between">
            <span><span data-i18n="doc_inst_modo_activo"><%= locals.t('doc_inst_modo_activo') %></span></span>
            <span id="labelCurrentMode" class="font-bold text-indigo-300"><span data-i18n="doc_inst_editable"><%= locals.t('doc_inst_editable') %></span></span>
        </div>
    </div>
</aside>

<script>
    function toggleSidebarAccordion(id) {
        const body = document.getElementById(id);
        const icon = document.getElementById(`icon-${id}`);
        if (!body) return;

        const isHidden = body.classList.contains('hidden');
        if (isHidden) {
            body.classList.remove('hidden');
            if (icon) icon.style.transform = 'rotate(180deg)';
        } else {
            body.classList.add('hidden');
            if (icon) icon.style.transform = 'rotate(0deg)';
        }
    }

    function collapseSidebarAccordion(id) {
        const body = document.getElementById(id);
        const icon = document.getElementById(`icon-${id}`);
        if (body) {
            body.classList.add('hidden');
            if (icon) icon.style.transform = 'rotate(0deg)';
        }
    }
</script>
