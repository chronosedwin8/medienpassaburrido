<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MedienPass · Colegio Alemán</title>
    <meta name="description" content="Digitaler MedienPass - Deutsche Schule Barranquilla">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <%- i18nScripts() %>
    <%- include('brand-head') %>
</head>

<%# Encabezado del portal estudiante (también el ingreso y las páginas del docente sin menú lateral).
    Arriba: logo del colegio, idioma, acceso docente y salir. Debajo, para el estudiante, una barra
    negra con su nombre completo, la clase y el año escolar en curso: queda fija al bajar por la
    página (en el celular solo esa barra) y nunca se oculta. %>
<%# Alemán e Inglés en su idioma (server.js useSubjectLang): /js/lang.js lo respeta al cargar %>
<body data-section="<%= typeof section !== 'undefined' ? section : '' %>"<% if (locals.nativeLang) { %> data-native-subject="<%= nativeLang.subject %>" data-page-lang="<%= nativeLang.lang %>"<% } %>>
    <div class="dsb-top">
        <header class="dsb-header">
            <div class="dsb-header-inner">
                <%- include('brand-logo', { brandHref: '/' }) %>
                <div class="dsb-tools">
                    <div class="dsb-lang" role="group" aria-label="Idioma / Sprache / Language">
                        <button type="button" class="lang-btn h-lang-btn <%= lang === 'de' ? 'active' : '' %>" data-lang="de">DE</button>
                        <button type="button" class="lang-btn h-lang-btn <%= lang === 'en' ? 'active' : '' %>" data-lang="en">EN</button>
                        <button type="button" class="lang-btn h-lang-btn <%= lang === 'es' ? 'active' : '' %>" data-lang="es">ES</button>
                    </div>
                    <% if (typeof teacher !== 'undefined' && teacher) { %>
                        <a href="/docs" class="dsb-btn-outline dsb-hide-sm" title="<%= locals.t('hdr_manual_de_usuario') %>" data-i18n-title="hdr_manual_de_usuario">
                            <i class="fas fa-book"></i> <span data-i18n="hdr_manual_de_usuario_2"><%= locals.t('hdr_manual_de_usuario_2') %></span>
                        </a>
                    <% } %>
                    <a href="/teacher/login" class="dsb-btn-outline" title="<%= locals.t('hdr_portal_docente_capacitacion') %>" data-i18n-title="hdr_portal_docente_capacitacion">
                        <i class="fas fa-chalkboard-teacher"></i> <span class="dsb-hide-sm" data-i18n="teacherPortalLabel">Docentes</span>
                    </a>
                    <% if (typeof student !== 'undefined' && student) { %>
                        <a href="/logout" class="dsb-icon-btn" data-i18n-title="logoutTitle" title="<%= locals.t('logoutTitle') %>" aria-label="<%= locals.t('logoutTitle') %>">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    <% } %>
                </div>
            </div>
            <div class="dsb-flag" aria-hidden="true"></div>
        </header>

        <% if (typeof student !== 'undefined' && student) {
            const names = studentNames(student);
            const photo = student.profile_photo;
            const emojiPhoto = photo && photo.length < 15 ? photo : null;
        %>
        <div class="dsb-student-bar" role="region" aria-label="<%= locals.t('hdr_estudiante') %>">
            <div class="dsb-student-inner">
                <div class="dsb-student-who">
                    <span class="dsb-avatar" id="headerUserAvatar" aria-hidden="true"><%= emojiPhoto || names.initial %></span>
                    <span>
                        <span class="dsb-student-label" data-i18n="hdr_estudiante"><%= locals.t('hdr_estudiante') %></span>
                        <strong class="dsb-student-name notranslate" translate="no" id="studentFullName"><%= names.full %></strong>
                    </span>
                </div>
                <div class="dsb-student-facts">
                    <span class="dsb-chip is-class"><span data-i18n="classLabel"><%= locals.t('classLabel') %></span>&nbsp;<span class="notranslate" translate="no"><%= student.class_name %></span></span>
                    <span class="dsb-chip is-year" title="<%= locals.t('hdr_anio_en_curso') %>" data-i18n-title="hdr_anio_en_curso"><i class="fas fa-calendar-days" aria-hidden="true"></i> <span data-i18n="schoolYear"><%= locals.t('schoolYear') %></span>&nbsp;<span class="notranslate" translate="no"><%= (locals.schoolYear || {}).label || '' %></span></span>
                </div>
            </div>
        </div>
        <% } %>
    </div>
    <main class="container">
