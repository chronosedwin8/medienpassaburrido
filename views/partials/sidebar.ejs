<!-- Sidebar EJS Partial -->
<% 
    // Determine active item based on current URL or a variable passed
    // If not passed, we can try to guess it from the context
    if (typeof activeItem === 'undefined') { activeItem = ''; }
%>

<!-- Mobile Nav Toggle Button -->
<button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle Navigation">
    <i class="fas fa-bars"></i>
</button>

<!-- Sidebar Overlay for Mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar Navigation -->
<aside class="sidebar" id="sidebar">
    <!-- Sidebar Header / Brand -->
    <div class="sidebar-brand">
        <a href="/teacher/training" class="sidebar-logo">
            <img class="sidebar-logo-img" src="/img/logo-colegio.png" width="511" height="360" alt="Colegio Alemán · Deutsche Schule Barranquilla">
            <div class="logo-text">
                <span class="logo-title notranslate" translate="no">MEDIENPASS</span>
                <span class="logo-subtitle"><span data-i18n="doc_nav_portal_docente"><%= locals.t('doc_nav_portal_docente') %></span></span>
            </div>
        </a>
        <button class="sidebar-toggle-btn" id="sidebarToggleBtn" title="<%= locals.t('doc_nav_colapsar_menu') %>" data-i18n-title="doc_nav_colapsar_menu">
            <i class="fas fa-chevron-left"></i>
        </button>
    </div>
    <div class="sidebar-flag" aria-hidden="true"></div>

    <!-- Sidebar Menu -->
    <nav class="sidebar-menu">
            <!-- 👨‍🏫 Teacher Menu (el panel admin usa partials/admin-sidebar.ejs, con este mismo estilo) -->
            <div class="menu-label"><span data-i18n="doc_nav_mi_portal"><%= locals.t('doc_nav_mi_portal') %></span></div>
            
            <div class="menu-item">
                <a href="/teacher/training" class="menu-link <%= activeItem === 'training' ? 'active' : '' %>">
                    <div class="link-left">
                        <i class="fas fa-graduation-cap"></i>
                        <span class="link-text"><span data-i18n="doc_nav_capacitacion_kmk"><%= locals.t('doc_nav_capacitacion_kmk') %></span></span>
                    </div>
                </a>
            </div>

            <div class="menu-item">
                <a href="/teacher/evaluation" class="menu-link <%= activeItem === 'evaluation' ? 'active' : '' %>">
                    <div class="link-left">
                        <i class="fas fa-clipboard-check"></i>
                        <span class="link-text"><span data-i18n="doc_nav_test_kmk"><%= locals.t('doc_nav_test_kmk') %></span></span>
                    </div>
                </a>
            </div>

            <%# Configura tus Retos del 0 al 6: el editor de preguntas (antes "Modo Estudiante").
                Consulta los avances: el seguimiento de la clase (antes en "Configura tus Retos"). %>
            <div class="menu-item">
                <a href="/teacher/student-preview" class="menu-link <%= activeItem === 'preview' ? 'active' : '' %>">
                    <div class="link-left">
                        <i class="fas fa-pen-to-square"></i>
                        <span class="link-text"><span data-i18n="doc_nav_configura_retos"><%= locals.t('doc_nav_configura_retos') %></span></span>
                    </div>
                </a>
            </div>

            <div class="menu-item">
                <a href="/teacher/progress" class="menu-link <%= activeItem === 'progress' ? 'active' : '' %>">
                    <div class="link-left">
                        <i class="fas fa-chart-line"></i>
                        <span class="link-text"><span data-i18n="doc_nav_consulta_avances"><%= locals.t('doc_nav_consulta_avances') %></span></span>
                    </div>
                </a>
            </div>

            <div class="menu-label"><span data-i18n="doc_nav_documentacion"><%= locals.t('doc_nav_documentacion') %></span></div>
            <div class="menu-item">
                <a href="/docs" target="_blank" class="menu-link">
                    <div class="link-left">
                        <i class="fas fa-book-open"></i>
                        <span class="link-text"><span data-i18n="doc_nav_manual_de_usuario"><%= locals.t('doc_nav_manual_de_usuario') %></span></span>
                    </div>
                </a>
            </div>
            <div class="menu-item">
                <a href="/" class="menu-link">
                    <div class="link-left">
                        <i class="fas fa-home"></i>
                        <span class="link-text"><span data-i18n="doc_nav_ir_al_app_estudiante"><%= locals.t('doc_nav_ir_al_app_estudiante') %></span></span>
                    </div>
                </a>
            </div>
    </nav>

    <!-- Sidebar Footer / User Section -->
    <div class="sidebar-footer">
        <!-- Sidebar Language Switcher -->
        <div class="dsb-lang sidebar-lang-switch" role="group" aria-label="Idioma / Sprache / Language">
            <button type="button" class="lang-btn h-lang-btn <%= lang === 'de' ? 'active' : '' %>" data-lang="de">DE</button>
            <button type="button" class="lang-btn h-lang-btn <%= lang === 'en' ? 'active' : '' %>" data-lang="en">EN</button>
            <button type="button" class="lang-btn h-lang-btn <%= lang === 'es' ? 'active' : '' %>" data-lang="es">ES</button>
        </div>

        <div class="user-profile">
            <div class="user-avatar">
                <%
                   let initials = 'P';
                   let fullName = 'Docente';
                   if (typeof teacher !== 'undefined' && teacher) {
                       initials = ((teacher.first_name || '').charAt(0) + (teacher.last_name || '').charAt(0)).toUpperCase() || 'P';
                       fullName = (teacher.first_name || '') + ' ' + (teacher.last_name || '');
                   }
                %>
                <%= initials %>
            </div>
            <div class="user-info">
                <span class="user-name"><%= fullName %></span>
                <span class="user-role"><span data-i18n="doc_nav_docente"><%= locals.t('doc_nav_docente') %></span></span>
            </div>
        </div>
        <a href="/teacher/logout" class="menu-link" style="margin: 0; padding: 10px 8px; border: 1.5px solid #a92106; border-radius: 999px; background: #ffffff; color: #a92106; display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700;">
            <i class="fas fa-sign-out-alt"></i>
            <span class="link-text"><span data-i18n="doc_nav_cerrar_sesion"><%= locals.t('doc_nav_cerrar_sesion') %></span></span>
        </a>
    </div>
</aside>

<!-- Sidebar JS Scripts -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('sidebar');
        const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
        const mobileNavToggle = document.getElementById('mobileNavToggle');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        const body = document.body;

        // Add has-sidebar layout class
        body.classList.add('has-sidebar');

        // Toggle sidebar collapse state (Desktop)
        if (sidebarToggleBtn) {
            sidebarToggleBtn.addEventListener('click', function() {
                sidebar.classList.toggle('collapsed');
                body.classList.toggle('sidebar-collapsed');
                
                // Update button icon
                const icon = sidebarToggleBtn.querySelector('i');
                if (sidebar.classList.contains('collapsed')) {
                    icon.className = 'fas fa-chevron-right';
                    sidebarToggleBtn.title = "Expandir menú";
                } else {
                    icon.className = 'fas fa-chevron-left';
                    sidebarToggleBtn.title = "Colapsar menú";
                }
            });
        }

        // Toggle mobile open state
        if (mobileNavToggle) {
            mobileNavToggle.addEventListener('click', function() {
                sidebar.classList.toggle('mobile-open');
            });
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', function() {
                sidebar.classList.remove('mobile-open');
            });
        }
    });
</script>
