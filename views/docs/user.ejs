<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manual de Usuario - Medienpass</title>
    <%- i18nScripts() %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass-panel {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 30px rgba(0, 0, 0, 0.05);
        }
        .guide-tab-btn[aria-selected="true"] { background: var(--tab-color); color: #fff; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.15); }
        .guide-tab-btn[aria-selected="false"] { color: #475569; }
        .guide-tab-btn[aria-selected="false"]:hover { background: #f1f5f9; }
        .guide-steps li::marker { color: var(--tab-color); font-weight: 700; }
        .guide-section { scroll-margin-top: 96px; }
        .tabs-scroll { scrollbar-width: none; }
        .tabs-scroll::-webkit-scrollbar { display: none; }
        [hidden] { display: none !important; }
    </style>
    <%- include('../partials/brand-head') %>
</head>
<%
// Guía por perfil (services/user_guide.js). Cada texto es una clave del diccionario "manuales".
const tabs = locals.guideTabs || [];
const commonCard = locals.guideCommon || { steps: [] };
// Colores del colegio por pestaña: desarrollador negro, coordinación azul, docente verde, estudiante rojo
const palette = {
    purple: { hex: '#111111', soft: 'bg-slate-100', text: 'text-slate-900', ring: 'border-slate-200' },
    blue: { hex: '#21529b', soft: 'bg-blue-50', text: 'text-blue-700', ring: 'border-blue-200' },
    emerald: { hex: '#1f8a4c', soft: 'bg-emerald-50', text: 'text-emerald-700', ring: 'border-emerald-200' },
    violet: { hex: '#c03928', soft: 'bg-dsbred-50', text: 'text-dsbred-700', ring: 'border-dsbred-200' }
};
const commonIcons = ['fa-door-open', 'fa-language', 'fa-circle-question', 'fa-floppy-disk'];
const T = key => locals.t(key);
const backLabel = userRole === 'student' ? 'man_g_volver_inicio' : 'man_user_volver_al_panel';
%>
<body class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 text-slate-800 flex flex-col">

    <!-- Barra superior -->
    <header class="glass-panel sticky top-0 z-50 px-4 sm:px-6 py-3 flex justify-between items-center gap-3 border-b border-white/50">
        <div class="flex items-center gap-3 min-w-0">
            <a href="<%= backLink %>" class="w-10 h-10 shrink-0 rounded-2xl bg-blue-600 hover:bg-blue-700 flex items-center justify-center text-white shadow-lg shadow-blue-500/30 transition" title="<%= T(backLabel) %>" data-i18n-title="<%= backLabel %>">
                <i class="fas fa-arrow-left"></i>
            </a>
            <img src="/img/logo-colegio.png" width="511" height="360" alt="Colegio Alemán · Deutsche Schule Barranquilla" class="block h-9 sm:h-11 w-auto shrink-0">
            <span class="hidden sm:block w-px h-9 bg-slate-200 shrink-0" aria-hidden="true"></span>
            <div class="min-w-0">
                <h1 class="font-bold text-lg leading-tight text-slate-900 truncate"><span data-i18n="man_user_manual_de"><%= T('man_user_manual_de') %></span> <span class="text-blue-600"><span data-i18n="man_user_usuario"><%= T('man_user_usuario') %></span></span></h1>
                <p class="text-xs text-slate-500 font-medium truncate"><span data-i18n="man_user_guias_de_operacion_paso_a_paso"><%= T('man_user_guias_de_operacion_paso_a_paso') %></span></p>
            </div>
        </div>
        <div class="flex items-center gap-3 shrink-0">
            <%- include('../partials/lang-switch') %>
            <a href="<%= backLink %>" class="hidden sm:inline-block px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold rounded-xl transition"><span data-i18n="<%= backLabel %>"><%= T(backLabel) %></span></a>
        </div>
    </header>

    <main class="flex-grow max-w-5xl mx-auto w-full px-4 sm:px-6 py-8 flex flex-col gap-6">

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="p-4 bg-red-100 border border-red-300 text-red-800 rounded-2xl flex items-center gap-3 shadow-md" role="alert">
                <i class="fas fa-exclamation-triangle text-xl text-red-600"></i>
                <p class="font-semibold text-sm"><%= error %></p>
            </div>
        <% } %>

        <!-- Antes de empezar (para todos) -->
        <section class="glass-panel rounded-3xl p-6 sm:p-8" aria-labelledby="commonTitle">
            <h2 id="commonTitle" class="text-xl font-bold text-slate-900 flex items-center gap-2 mb-4">
                <i class="fas <%= commonCard.icon || 'fa-flag-checkered' %> text-amber-500"></i>
                <span data-i18n="<%= commonCard.title %>"><%= T(commonCard.title) %></span>
            </h2>
            <ul class="grid gap-3 sm:grid-cols-2">
                <% commonCard.steps.forEach((key, i) => { %>
                    <li class="flex gap-3 items-start bg-white/70 rounded-2xl p-3 border border-slate-100">
                        <span class="w-9 h-9 shrink-0 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center"><i class="fas <%= commonIcons[i] || 'fa-circle-info' %>"></i></span>
                        <span class="text-sm text-slate-700 leading-relaxed" data-i18n="<%= key %>"><%= T(key) %></span>
                    </li>
                <% }) %>
            </ul>
        </section>

        <!-- Pestañas del perfil -->
        <% if (tabs.length > 1) { %>
            <div class="glass-panel p-2 rounded-2xl overflow-x-auto tabs-scroll" role="tablist" aria-label="<%= T('man_g_en_esta_guia') %>">
                <div class="flex gap-2 min-w-max">
                    <% tabs.forEach((tab, i) => { const c = palette[tab.color] || palette.blue; %>
                        <button type="button" role="tab" id="btn-<%= tab.id %>" class="guide-tab-btn py-3 px-4 rounded-xl font-bold text-sm flex items-center gap-2 transition"
                            style="--tab-color: <%= c.hex %>;" aria-selected="<%= i === 0 ? 'true' : 'false' %>" aria-controls="tab-<%= tab.id %>"
                            data-tab="<%= tab.id %>" onclick="switchTab('<%= tab.id %>')">
                            <i class="fas <%= tab.icon %>"></i> <span data-i18n="<%= tab.title %>"><%= T(tab.title) %></span>
                        </button>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <!-- Buscador -->
        <div class="relative">
            <i class="fas fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
            <input type="search" id="guideSearch" autocomplete="off" oninput="filterGuide()"
                class="w-full pl-11 pr-4 py-3 rounded-2xl border border-slate-200 bg-white/90 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm"
                placeholder="<%= T('man_g_buscar') %>" data-i18n-placeholder="man_g_buscar" aria-label="<%= T('man_g_buscar') %>">
        </div>

        <% tabs.forEach((tab, i) => { const c = palette[tab.color] || palette.blue; %>
            <section id="tab-<%= tab.id %>" class="guide-tab space-y-5" role="tabpanel" aria-labelledby="btn-<%= tab.id %>" data-tab="<%= tab.id %>" style="--tab-color: <%= c.hex %>;" <%= i === 0 ? '' : 'hidden' %>>
                <div class="glass-panel rounded-3xl p-6 sm:p-8">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 shrink-0 rounded-2xl <%= c.soft %> <%= c.text %> flex items-center justify-center text-xl"><i class="fas <%= tab.icon %>"></i></div>
                        <div>
                            <h2 class="text-2xl font-bold text-slate-900" data-i18n="<%= tab.title %>"><%= T(tab.title) %></h2>
                            <p class="text-sm text-slate-600 mt-1 leading-relaxed" data-i18n="<%= tab.intro %>"><%= T(tab.intro) %></p>
                        </div>
                    </div>
                    <nav class="mt-5 guide-toc" aria-label="<%= T('man_g_en_esta_guia') %>">
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2" data-i18n="man_g_en_esta_guia"><%= T('man_g_en_esta_guia') %></p>
                        <div class="flex flex-wrap gap-2">
                            <% tab.sections.forEach((s, n) => { %>
                                <a href="#sec-<%= s.id %>" data-toc="<%= s.id %>" class="px-3 py-1.5 rounded-full text-xs font-semibold border <%= c.ring %> <%= c.soft %> <%= c.text %> hover:brightness-95 transition"><%= n + 1 %>. <span data-i18n="<%= s.title %>"><%= T(s.title) %></span></a>
                            <% }) %>
                        </div>
                    </nav>
                </div>

                <% tab.sections.forEach((s, n) => { %>
                    <article id="sec-<%= s.id %>" class="guide-section glass-panel rounded-3xl p-6 sm:p-7" data-section="<%= s.id %>">
                        <div class="flex items-start justify-between gap-3 flex-wrap">
                            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-3">
                                <span class="w-8 h-8 shrink-0 rounded-full text-white text-sm flex items-center justify-center" style="background: var(--tab-color);"><%= n + 1 %></span>
                                <i class="fas <%= s.icon %> <%= c.text %>"></i>
                                <span data-i18n="<%= s.title %>"><%= T(s.title) %></span>
                            </h3>
                            <% if (s.link) { %>
                                <a href="<%= s.link %>" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-white text-sm font-semibold shadow-sm hover:brightness-110 transition" style="background: var(--tab-color);">
                                    <span data-i18n="man_g_abrir"><%= T('man_g_abrir') %></span> <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                                </a>
                            <% } %>
                        </div>
                        <p class="mt-3 text-xs text-slate-500 flex flex-wrap items-center gap-2">
                            <span class="font-bold uppercase tracking-wider" data-i18n="man_g_donde"><%= T('man_g_donde') %></span>
                            <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-semibold" data-i18n="<%= s.where %>"><%= T(s.where) %></span>
                        </p>
                        <ol class="guide-steps mt-4 list-decimal pl-6 space-y-2 text-sm text-slate-700 leading-relaxed">
                            <% s.steps.forEach(key => { %>
                                <li data-i18n="<%= key %>"><%= T(key) %></li>
                            <% }) %>
                        </ol>
                    </article>
                <% }) %>
            </section>
        <% }) %>

        <p id="guideEmpty" class="text-center text-slate-500 py-10" hidden><span data-i18n="man_g_sin_resultados"><%= T('man_g_sin_resultados') %></span></p>
    </main>

    <footer class="glass-panel mt-auto py-6 px-6 border-t border-white/50 text-center text-xs text-slate-500">
        <p><span data-i18n="man_user_medienpass_app_2026_deutsche_schule"><%= T('man_user_medienpass_app_2026_deutsche_schule') %></span></p>
    </footer>

    <script>
        // Pestañas: la del perfil abre primero; #docente, #estudiante… abre otra directamente.
        // El buscador revisa todas las pestañas del perfil y muestra solo las secciones que coinciden.
        const TAB_IDS = [...document.querySelectorAll('.guide-tab')].map(el => el.dataset.tab);
        let activeTab = TAB_IDS[0];

        function switchTab(id, { updateHash = true } = {}) {
            if (!TAB_IDS.includes(id)) id = TAB_IDS[0];
            activeTab = id;
            document.querySelectorAll('.guide-tab-btn').forEach(btn => btn.setAttribute('aria-selected', btn.dataset.tab === id ? 'true' : 'false'));
            if (updateHash && location.hash !== '#' + id) history.replaceState(null, '', '#' + id);
            filterGuide();
        }

        const normalize = text => String(text || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

        function filterGuide() {
            const query = normalize(document.getElementById('guideSearch').value);
            let shown = 0;
            document.querySelectorAll('.guide-tab').forEach(tab => {
                let inTab = 0;
                tab.querySelectorAll('.guide-section').forEach(section => {
                    const match = !query || normalize(section.textContent).includes(query);
                    section.hidden = !match;
                    const chip = tab.querySelector(`[data-toc="${section.dataset.section}"]`);
                    if (chip) chip.hidden = !match;
                    if (match) inTab++;
                });
                // Sin búsqueda: solo la pestaña activa. Con búsqueda: todas las que tienen coincidencias.
                tab.hidden = query ? inTab === 0 : tab.dataset.tab !== activeTab;
                if (!tab.hidden) shown += inTab;
            });
            document.getElementById('guideEmpty').hidden = shown > 0;
        }

        // Enlace directo a una pestaña (#docente) o a una sección (#sec-doc_test)
        (function openFromHash() {
            const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
            if (TAB_IDS.includes(hash)) return switchTab(hash, { updateHash: false });
            const section = hash.startsWith('sec-') && document.getElementById(hash);
            if (section) {
                switchTab(section.closest('.guide-tab').dataset.tab, { updateHash: false });
                section.scrollIntoView();
            }
        })();
    </script>
<%- include('../partials/help-button') %>
</body>
</html>
