<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manual Técnico - Medienpass</title>
    <%- i18nScripts() %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        pre, code { font-family: 'Fira Code', monospace; }
        .glass-panel {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 30px rgba(0, 0, 0, 0.05);
        }
        pre::-webkit-scrollbar { height: 6px; width: 6px; }
        pre::-webkit-scrollbar-thumb { background: #64748b; border-radius: 4px; }
        .tech-section { scroll-margin-top: 96px; }
    </style>
    <%- include('../partials/brand-head') %>
</head>
<%
// Secciones del manual (services/tech_manual.js); los textos son claves del diccionario "manuales".
const sections = locals.techSections || [];
const T = key => locals.t(key);
const backLink = userRole === 'admin' ? '/admin' : '/teacher/training';
%>
<body class="min-h-screen bg-gradient-to-br from-slate-50 via-purple-50 to-indigo-50 text-slate-800 flex flex-col">

    <header class="glass-panel sticky top-0 z-50 px-4 sm:px-6 py-3 flex justify-between items-center gap-3 border-b border-white/50">
        <div class="flex items-center gap-3 min-w-0">
            <a href="<%= backLink %>" class="w-10 h-10 shrink-0 rounded-2xl bg-purple-600 hover:bg-purple-700 flex items-center justify-center text-white shadow-lg shadow-purple-500/30 transition" title="<%= T('man_tech_volver_al_panel') %>" data-i18n-title="man_tech_volver_al_panel">
                <i class="fas fa-arrow-left"></i>
            </a>
            <img src="/img/logo-colegio.png" width="511" height="360" alt="Colegio Alemán · Deutsche Schule Barranquilla" class="block h-9 sm:h-11 w-auto shrink-0">
            <span class="hidden sm:block w-px h-9 bg-slate-200 shrink-0" aria-hidden="true"></span>
            <div class="min-w-0">
                <h1 class="font-bold text-lg leading-tight text-slate-900 truncate"><span data-i18n="man_tech_manual"><%= T('man_tech_manual') %></span> <span class="text-purple-600"><span data-i18n="man_tech_tecnico"><%= T('man_tech_tecnico') %></span></span></h1>
                <p class="text-xs text-slate-500 font-medium truncate"><span data-i18n="man_tech_arquitectura_base_de_datos_y_codigo"><%= T('man_tech_arquitectura_base_de_datos_y_codigo') %></span></p>
            </div>
        </div>
        <div class="flex items-center gap-3 shrink-0">
            <%- include('../partials/lang-switch') %>
            <a href="/docs" class="hidden sm:inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm transition"><span data-i18n="man_tech_ver_manual_de_usuario"><%= T('man_tech_ver_manual_de_usuario') %></span></a>
        </div>
    </header>

    <div class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-6 py-8 flex flex-col lg:flex-row gap-8 items-start">

        <!-- Índice -->
        <aside class="w-full lg:w-72 shrink-0 glass-panel rounded-3xl p-5 lg:sticky lg:top-24">
            <h2 class="text-xs font-bold uppercase tracking-wider text-purple-600 mb-3 px-2" data-i18n="man_t_indice"><%= T('man_t_indice') %></h2>
            <nav class="grid grid-cols-2 lg:grid-cols-1 gap-1 text-sm font-medium" aria-label="<%= T('man_t_indice') %>">
                <% sections.forEach((s, i) => { %>
                    <a href="#<%= s.id %>" class="flex items-center gap-2 px-3 py-2 rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition">
                        <i class="fas <%= s.icon %> w-5 text-purple-400"></i> <span><%= i + 1 %>. <span data-i18n="<%= s.title %>"><%= T(s.title) %></span></span>
                    </a>
                <% }) %>
            </nav>
            <div class="mt-5 p-4 rounded-2xl bg-gradient-to-br from-purple-600 to-indigo-600 text-white">
                <p class="text-xs text-purple-100 mb-2" data-i18n="man_t_entorno"><%= T('man_t_entorno') %></p>
                <code class="block bg-black/30 px-2.5 py-1.5 rounded-lg text-xs">npm start · npm test</code>
            </div>
        </aside>

        <main class="flex-grow space-y-6 max-w-4xl w-full min-w-0">
            <% sections.forEach((s, i) => { %>
                <section id="<%= s.id %>" class="tech-section glass-panel rounded-3xl p-6 sm:p-8">
                    <div class="flex items-start gap-3 mb-5">
                        <div class="w-12 h-12 shrink-0 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl"><i class="fas <%= s.icon %>"></i></div>
                        <div class="min-w-0">
                            <h2 class="text-2xl font-bold text-slate-900"><%= i + 1 %>. <span data-i18n="<%= s.title %>"><%= T(s.title) %></span></h2>
                            <p class="text-xs text-slate-500 mt-1" data-i18n="<%= s.subtitle %>"><%= T(s.subtitle) %></p>
                        </div>
                    </div>
                    <ul class="list-disc pl-6 space-y-2 text-sm text-slate-700 leading-relaxed marker:text-purple-500">
                        <% s.items.forEach(key => { %>
                            <li data-i18n="<%= key %>"><%= T(key) %></li>
                        <% }) %>
                    </ul>
                    <% if (s.code) { %>
                        <pre class="mt-5 bg-slate-900 text-slate-200 p-5 rounded-2xl text-xs overflow-x-auto leading-normal"><%= s.code %></pre>
                    <% } %>
                </section>
            <% }) %>
        </main>
    </div>

    <footer class="glass-panel mt-auto py-6 px-6 border-t border-white/50 text-center text-xs text-slate-500">
        <p><span data-i18n="man_tech_medienpass_app_2026_deutsche_schule"><%= T('man_tech_medienpass_app_2026_deutsche_schule') %></span></p>
    </footer>
</body>
</html>
