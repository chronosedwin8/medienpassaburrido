<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.t('doc_asig_titulo') %> - Medienpass</title>
    <%- i18nScripts() %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <%- include('../partials/brand-head') %>
    <style>
        :root { --as-ink: #111111; --as-muted: #54595f; --as-line: #e2e2e2; --as-soft: #f6f7f9; --as-blue: #21529b; --as-red: #a92106; --as-green: #15803d; --as-amber: #b45309; }
        body { font-family: 'Inter', system-ui, sans-serif; background: #f8fafc; color: var(--as-ink); margin: 0; }
        .as-main { max-width: 1180px; margin: 0 auto; padding: 28px 20px 60px; display: flex; flex-direction: column; gap: 22px; }
        .as-card { background: #fff; border: 1px solid var(--as-line); border-radius: 16px; padding: 22px; box-shadow: 0 6px 18px rgba(15,23,42,.04); }
        .as-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: flex-end; }
        .as-head h1 { margin: 0 0 4px; font-size: 1.55em; }
        .as-head p { margin: 0; color: var(--as-muted); max-width: 720px; line-height: 1.45; }
        .as-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
        .as-field label, .as-label { display: block; font-weight: 700; font-size: .86em; margin-bottom: 6px; }
        .as-field input, .as-field select, .as-field textarea { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 10px; font: inherit; background: #fff; }
        .as-field textarea { min-height: 64px; resize: vertical; }
        .as-chips { display: flex; flex-wrap: wrap; gap: 8px; }
        .as-chip { position: relative; }
        .as-chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
        .as-chip span { display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border: 1.5px solid #cbd5e1; border-radius: 999px; font-weight: 600; font-size: .88em; background: #fff; }
        .as-chip input:checked + span { background: var(--as-ink); border-color: var(--as-ink); color: #fff; }
        .as-chip input:focus-visible + span { outline: 3px solid #93c5fd; outline-offset: 2px; }
        .as-classes { display: flex; flex-direction: column; gap: 14px; max-height: 460px; overflow: auto; padding-right: 4px; }
        .as-level h4 { margin: 0 0 8px; font-size: .78em; letter-spacing: .06em; text-transform: uppercase; color: var(--as-muted); }
        .as-class { border: 1px solid var(--as-line); border-radius: 12px; margin-bottom: 8px; }
        .as-class-row { display: flex; align-items: center; gap: 10px; padding: 10px 12px; }
        .as-class-row label { display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer; flex: 1; }
        .as-class-row small { color: var(--as-muted); font-weight: 500; }
        .as-link { background: none; border: none; color: var(--as-blue); font-weight: 600; cursor: pointer; font: inherit; font-size: .85em; padding: 4px 6px; }
        .as-students { display: none; border-top: 1px dashed var(--as-line); padding: 10px 12px 12px; columns: 2 240px; column-gap: 18px; }
        .as-students.open { display: block; }
        .as-students label { display: flex; gap: 8px; align-items: center; padding: 4px 0; font-size: .9em; break-inside: avoid; cursor: pointer; }
        .as-students code { color: var(--as-muted); font-size: .85em; }
        .as-selected { margin-top: 10px; font-size: .88em; color: var(--as-muted); }
        .as-btn { display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; padding: 11px 20px; font-weight: 700; cursor: pointer; border: 2px solid var(--as-ink); background: var(--as-ink); color: #fff; font: inherit; font-weight: 700; }
        .as-btn.ghost { background: #fff; color: var(--as-ink); }
        .as-btn.small { padding: 7px 14px; font-size: .85em; }
        .as-btn.danger { border-color: var(--as-red); color: var(--as-red); background: #fff; }
        .as-btn:disabled { opacity: .5; cursor: wait; }
        .as-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; align-items: center; }
        .as-msg { font-size: .9em; font-weight: 600; }
        .as-msg.ok { color: var(--as-green); } .as-msg.err { color: var(--as-red); }
        .as-warn { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 12px; padding: 12px 14px; font-size: .9em; }
        .as-list { display: flex; flex-direction: column; gap: 12px; }
        .as-item { border: 1px solid var(--as-line); border-radius: 14px; padding: 16px; }
        .as-item-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }
        .as-item h3 { margin: 0 0 4px; font-size: 1.05em; }
        .as-meta { color: var(--as-muted); font-size: .86em; display: flex; flex-wrap: wrap; gap: 6px 14px; }
        .as-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
        .as-tag { background: var(--as-soft); border: 1px solid var(--as-line); border-radius: 999px; padding: 3px 10px; font-size: .8em; font-weight: 600; }
        .as-progress { margin-top: 14px; overflow-x: auto; display: none; }
        .as-progress.open { display: block; }
        .as-progress table { width: 100%; border-collapse: collapse; font-size: .88em; }
        .as-progress th, .as-progress td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--as-line); white-space: nowrap; }
        .st-won { color: var(--as-green); font-weight: 700; } .st-started { color: var(--as-amber); font-weight: 700; } .st-pending { color: #94a3b8; }
        .as-toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .as-empty { color: var(--as-muted); text-align: center; padding: 18px; }
        @media (max-width: 640px) { .as-main { padding: 18px 16px 48px; } .as-card { padding: 16px; } }
    </style>
</head>
<body>
<%- include('../partials/sidebar', { context: 'teacher', activeItem: 'assignments' }) %>
<main class="main-content as-main" id="mainContent">
    <section class="as-head">
        <div>
            <h1 data-i18n="doc_asig_titulo"><%= locals.t('doc_asig_titulo') %></h1>
            <p data-i18n="doc_asig_intro"><%= locals.t('doc_asig_intro') %></p>
        </div>
    </section>

    <div id="storageWarn" class="as-warn" hidden data-i18n="doc_asig_aviso_archivo"><%= locals.t('doc_asig_aviso_archivo') %></div>

    <section class="as-card" aria-labelledby="formTitle">
        <h2 id="formTitle" style="margin:0 0 16px;font-size:1.15em" data-i18n="doc_asig_nueva"><%= locals.t('doc_asig_nueva') %></h2>
        <form id="assignForm" onsubmit="return saveAssignment(event)">
            <input type="hidden" id="editId" value="">
            <div class="as-grid">
                <div class="as-field">
                    <label for="fSubject" data-i18n="doc_asig_materia"><%= locals.t('doc_asig_materia') %></label>
                    <select id="fSubject" required>
                        <% subjectList.forEach(s => { %>
                            <option value="<%= s.id %>" <%= teacher && teacher.subject === s.id ? 'selected' : '' %>><%= s.name[lang] || s.name.es %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="as-field">
                    <label for="fTitle" data-i18n="doc_asig_titulo_opcional"><%= locals.t('doc_asig_titulo_opcional') %></label>
                    <input id="fTitle" maxlength="140" placeholder="<%= locals.t('doc_asig_titulo_ph') %>" data-i18n-placeholder="doc_asig_titulo_ph">
                </div>
                <div class="as-field">
                    <label for="fDue" data-i18n="doc_asig_fecha_limite"><%= locals.t('doc_asig_fecha_limite') %></label>
                    <input id="fDue" type="date">
                </div>
            </div>

            <div style="margin-top:18px">
                <span class="as-label" data-i18n="doc_asig_retos"><%= locals.t('doc_asig_retos') %></span>
                <div class="as-chips" id="retoChips">
                    <% [0,1,2,3,4,5,6].forEach(n => { %>
                        <label class="as-chip"><input type="checkbox" name="reto" value="<%= n %>"><span>Reto <%= n %></span></label>
                    <% }) %>
                </div>
            </div>

            <div style="margin-top:18px">
                <div class="as-toolbar" style="justify-content:space-between;margin-bottom:8px">
                    <span class="as-label" style="margin:0" data-i18n="doc_asig_destinatarios"><%= locals.t('doc_asig_destinatarios') %></span>
                    <input id="classSearch" type="search" placeholder="<%= locals.t('doc_asig_buscar_curso') %>" data-i18n-placeholder="doc_asig_buscar_curso" style="padding:8px 12px;border:1px solid #cbd5e1;border-radius:999px;font:inherit;min-width:200px">
                </div>
                <p style="margin:0 0 10px;color:var(--as-muted);font-size:.86em" data-i18n="doc_asig_ayuda_destinatarios"><%= locals.t('doc_asig_ayuda_destinatarios') %></p>
                <div id="classes" class="as-classes"><div class="as-empty" data-i18n="doc_asig_cargando"><%= locals.t('doc_asig_cargando') %></div></div>
                <div class="as-selected" id="selectedSummary"></div>
            </div>

            <div class="as-field" style="margin-top:18px">
                <label for="fNote" data-i18n="doc_asig_nota"><%= locals.t('doc_asig_nota') %></label>
                <textarea id="fNote" maxlength="1000"></textarea>
            </div>

            <div class="as-actions">
                <button class="as-btn" id="saveBtn" type="submit"><i class="fas fa-paper-plane"></i> <span id="saveLabel" data-i18n="doc_asig_guardar"><%= locals.t('doc_asig_guardar') %></span></button>
                <button class="as-btn ghost" type="button" id="cancelEdit" hidden onclick="resetForm()"><span data-i18n="doc_asig_cancelar"><%= locals.t('doc_asig_cancelar') %></span></button>
                <span id="formMsg" class="as-msg" role="status"></span>
            </div>
        </form>
    </section>

    <section class="as-card" aria-labelledby="listTitle">
        <div class="as-toolbar" style="justify-content:space-between;margin-bottom:14px">
            <h2 id="listTitle" style="margin:0;font-size:1.15em" data-i18n="doc_asig_lista"><%= locals.t('doc_asig_lista') %></h2>
            <label style="display:flex;gap:8px;align-items:center;font-size:.9em;cursor:pointer">
                <input type="checkbox" id="showAll" <%= staff.panel ? 'checked' : '' %> onchange="loadAssignments()">
                <span data-i18n="doc_asig_ver_todas"><%= locals.t('doc_asig_ver_todas') %></span>
            </label>
        </div>
        <div id="list" class="as-list"><div class="as-empty" data-i18n="doc_asig_cargando"><%= locals.t('doc_asig_cargando') %></div></div>
    </section>
</main>

<script>
    const T = (key, fallback) => (window.t && window.t(key) !== key ? window.t(key) : fallback || key);
    const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const IS_PANEL = <%- JSON.stringify(!!staff.panel) %>;
    const ME = <%- JSON.stringify(staff.email || '') %>;
    const SUBJECTS = <%- JSON.stringify(subjectList) %>;
    const lang = () => (window.langUtils ? window.langUtils.getLang() : '<%= lang %>');
    const subjectName = id => { const s = SUBJECTS.find(x => x.id === id); return s ? (s.name[lang()] || s.name.es) : id; };

    let classes = [];                 // [{ class_name, count, level }]
    const studentsByClass = {};       // class -> [{ code, full_name }]
    const wholeClasses = new Set();   // cursos completos
    const pickedStudents = new Map(); // code -> { code, full_name, class_name }

    async function api(url, options = {}) {
        const res = await fetch(url, { headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, credentials: 'same-origin', ...options });
        const json = await res.json().catch(() => ({ success: false }));
        if (!res.ok || !json.success) throw new Error(json.message || ('HTTP ' + res.status));
        return json;
    }

    async function loadClasses() {
        try {
            const json = await api('/api/roster/classes');
            classes = json.classes;
            renderClasses();
        } catch (e) {
            document.getElementById('classes').innerHTML = '<div class="as-empty">' + esc(e.message) + '</div>';
        }
    }

    function levelOf(c) {
        if (c.level) return c.level;
        return /^K(\d+)/.test(c.class_name) ? 'Klasse ' + c.class_name.match(/^K(\d+)/)[1] : 'Kindergarten';
    }

    function renderClasses() {
        const q = document.getElementById('classSearch').value.trim().toUpperCase();
        const groups = {};
        classes.filter(c => !q || c.class_name.includes(q)).forEach(c => { (groups[levelOf(c)] = groups[levelOf(c)] || []).push(c); });
        const box = document.getElementById('classes');
        if (!Object.keys(groups).length) { box.innerHTML = '<div class="as-empty">' + esc(T('doc_asig_sin_cursos', 'Sin cursos')) + '</div>'; return; }
        box.innerHTML = Object.entries(groups).map(([level, list]) => `
            <div class="as-level"><h4>${esc(level)}</h4>${list.map(c => `
                <div class="as-class" data-class="${esc(c.class_name)}">
                    <div class="as-class-row">
                        <label><input type="checkbox" class="whole" value="${esc(c.class_name)}" ${wholeClasses.has(c.class_name) ? 'checked' : ''}>
                            <span class="notranslate" translate="no">${esc(c.class_name)}</span>
                            <small>${c.count} ${esc(T('doc_asig_estudiantes', 'estudiantes'))}</small></label>
                        <button type="button" class="as-link" data-toggle="${esc(c.class_name)}">${esc(T('doc_asig_elegir_estudiantes', 'Elegir estudiantes'))}</button>
                    </div>
                    <div class="as-students" id="st_${esc(c.class_name)}"></div>
                </div>`).join('')}</div>`).join('');
        box.querySelectorAll('input.whole').forEach(cb => cb.addEventListener('change', () => {
            if (cb.checked) wholeClasses.add(cb.value); else wholeClasses.delete(cb.value);
            syncStudentBoxes(cb.value);
            summary();
        }));
        box.querySelectorAll('[data-toggle]').forEach(btn => btn.addEventListener('click', () => toggleStudents(btn.dataset.toggle)));
        summary();
    }

    async function toggleStudents(cls) {
        const panel = document.getElementById('st_' + cls);
        if (panel.classList.contains('open')) { panel.classList.remove('open'); return; }
        panel.classList.add('open');
        if (!studentsByClass[cls]) {
            panel.textContent = T('doc_asig_cargando', 'Cargando…');
            try { studentsByClass[cls] = (await api('/api/roster/classes/' + encodeURIComponent(cls) + '/students')).students; }
            catch (e) { panel.textContent = e.message; return; }
        }
        panel.innerHTML = studentsByClass[cls].map(s => `<label><input type="checkbox" class="one" value="${esc(s.code)}" ${pickedStudents.has(s.code) ? 'checked' : ''}> ${esc(s.full_name)} <code>${esc(s.code)}</code></label>`).join('')
            || '<span class="as-empty">' + esc(T('doc_asig_sin_estudiantes', 'Sin estudiantes')) + '</span>';
        panel.querySelectorAll('input.one').forEach(cb => cb.addEventListener('change', () => {
            const s = studentsByClass[cls].find(x => x.code === cb.value);
            if (cb.checked) pickedStudents.set(cb.value, { ...s, class_name: cls }); else pickedStudents.delete(cb.value);
            summary();
        }));
        syncStudentBoxes(cls);
    }

    // Con el curso completo marcado, los estudiantes de ese curso quedan incluidos (y deshabilitados)
    function syncStudentBoxes(cls) {
        const panel = document.getElementById('st_' + cls);
        if (!panel) return;
        panel.querySelectorAll('input.one').forEach(cb => { cb.disabled = wholeClasses.has(cls); if (wholeClasses.has(cls)) cb.checked = true; else cb.checked = pickedStudents.has(cb.value); });
    }

    function summary() {
        const loose = [...pickedStudents.values()].filter(s => !wholeClasses.has(s.class_name));
        const parts = [];
        if (wholeClasses.size) parts.push(T('doc_asig_cursos_completos', 'Cursos completos') + ': ' + [...wholeClasses].join(', '));
        if (loose.length) parts.push(T('doc_asig_estudiantes_sueltos', 'Estudiantes') + ': ' + loose.length);
        document.getElementById('selectedSummary').textContent = parts.join(' · ') || T('doc_asig_nada_elegido', 'Aún no eliges destinatarios.');
    }

    function formValue() {
        return {
            subject: document.getElementById('fSubject').value,
            title: document.getElementById('fTitle').value.trim(),
            due_date: document.getElementById('fDue').value || null,
            note: document.getElementById('fNote').value.trim(),
            retos: [...document.querySelectorAll('#retoChips input:checked')].map(i => Number(i.value)),
            class_names: [...wholeClasses],
            student_codes: [...pickedStudents.values()].filter(s => !wholeClasses.has(s.class_name)).map(s => s.code)
        };
    }

    function setMsg(text, ok) {
        const el = document.getElementById('formMsg');
        el.textContent = text; el.className = 'as-msg ' + (ok ? 'ok' : 'err');
    }

    async function saveAssignment(ev) {
        ev.preventDefault();
        const value = formValue();
        if (!value.retos.length) return setMsg(T('doc_asig_falta_reto', 'Elige al menos un reto.'), false), false;
        if (!value.class_names.length && !value.student_codes.length) return setMsg(T('doc_asig_falta_destinatario', 'Elige al menos un curso o un estudiante.'), false), false;
        const id = document.getElementById('editId').value;
        const btn = document.getElementById('saveBtn');
        btn.disabled = true;
        try {
            await api(id ? '/api/assignments/' + id : '/api/assignments', { method: id ? 'PUT' : 'POST', body: JSON.stringify(value) });
            setMsg(T(id ? 'doc_asig_actualizada' : 'doc_asig_creada', 'Guardado'), true);
            resetForm(true);
            loadAssignments();
        } catch (e) {
            setMsg(e.message, false);
        } finally {
            btn.disabled = false;
        }
        return false;
    }

    function resetForm(keepMsg) {
        document.getElementById('assignForm').reset();
        document.getElementById('editId').value = '';
        document.getElementById('cancelEdit').hidden = true;
        document.getElementById('saveLabel').textContent = T('doc_asig_guardar', 'Asignar');
        wholeClasses.clear(); pickedStudents.clear();
        renderClasses();
        if (!keepMsg) setMsg('', true);
    }

    async function editAssignment(id) {
        const json = await api('/api/assignments/' + id);
        const a = json.assignment;
        document.getElementById('editId').value = a.id;
        document.getElementById('fSubject').value = a.subject;
        document.getElementById('fTitle').value = a.title || '';
        document.getElementById('fDue').value = a.due_date || '';
        document.getElementById('fNote').value = a.note || '';
        document.querySelectorAll('#retoChips input').forEach(i => { i.checked = a.retos.includes(Number(i.value)); });
        wholeClasses.clear(); pickedStudents.clear();
        (a.class_names || []).forEach(c => wholeClasses.add(c));
        json.recipients.filter(r => (a.student_codes || []).includes(r.code)).forEach(r => pickedStudents.set(r.code, r));
        document.getElementById('cancelEdit').hidden = false;
        document.getElementById('saveLabel').textContent = T('doc_asig_guardar_cambios', 'Guardar cambios');
        renderClasses();
        document.getElementById('assignForm').scrollIntoView({ behavior: 'smooth' });
    }

    async function archiveAssignment(id) {
        try { await api('/api/assignments/' + id + '/archive', { method: 'POST', body: JSON.stringify({ active: false }) }); loadAssignments(); }
        catch (e) { setMsg(e.message, false); }
    }

    const STATUS_ICON = { won: '✅', started: '🟡', pending: '⏳' };
    async function showProgress(id) {
        const box = document.getElementById('pg_' + id);
        if (box.classList.contains('open')) { box.classList.remove('open'); return; }
        box.classList.add('open');
        box.textContent = T('doc_asig_cargando', 'Cargando…');
        try {
            const json = await api('/api/assignments/' + id + '/progress');
            const retos = json.assignment.retos;
            box.innerHTML = `<p style="margin:0 0 8px;font-weight:600">${json.summary.done}/${json.summary.total} ${esc(T('doc_asig_completaron', 'completaron'))} · ${json.summary.started} ${esc(T('doc_asig_en_curso', 'en curso'))}</p>
                <table><thead><tr><th>${esc(T('doc_asig_estudiante', 'Estudiante'))}</th><th>${esc(T('doc_asig_curso', 'Curso'))}</th>${retos.map(n => `<th>Reto ${n}</th>`).join('')}</tr></thead>
                <tbody>${json.students.map(s => `<tr><td>${esc(s.full_name || s.code)} <code style="color:#94a3b8">${esc(s.code)}</code></td><td class="notranslate" translate="no">${esc(s.class_name)}</td>
                ${s.retos.map(r => `<td class="st-${r.status}" title="${esc(T('doc_asig_estado_' + r.status, r.status))}">${STATUS_ICON[r.status]} ${r.percent != null && r.status !== 'pending' ? r.percent + '%' : ''}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
        } catch (e) {
            box.textContent = e.message;
        }
    }

    async function loadAssignments() {
        const list = document.getElementById('list');
        const all = document.getElementById('showAll').checked;
        try {
            const json = await api('/api/assignments' + (all ? '?all=1' : '?mine=1'));
            document.getElementById('storageWarn').hidden = json.storage !== 'file';
            if (!json.assignments.length) { list.innerHTML = '<div class="as-empty">' + esc(T('doc_asig_vacio', 'Aún no hay actividades asignadas.')) + '</div>'; return; }
            list.innerHTML = json.assignments.map(a => {
                const mine = IS_PANEL || (a.created_by || '') === ME;
                return `<article class="as-item">
                    <div class="as-item-top">
                        <div>
                            <h3>${esc(a.title)}</h3>
                            <div class="as-meta">
                                <span><i class="fas fa-book"></i> ${esc(subjectName(a.subject))}</span>
                                ${a.due_date ? `<span><i class="fas fa-calendar"></i> ${esc(T('doc_asig_hasta', 'Hasta'))} ${esc(a.due_date)}</span>` : ''}
                                <span><i class="fas fa-user"></i> ${esc(a.created_by_name || a.created_by || '')}</span>
                                <span><i class="fas fa-users"></i> ${a.recipients_count || 0} ${esc(T('doc_asig_estudiantes', 'estudiantes'))}</span>
                            </div>
                            <div class="as-tags">
                                ${a.retos.map(n => `<span class="as-tag">Reto ${n}</span>`).join('')}
                                ${(a.class_names || []).map(c => `<span class="as-tag notranslate" translate="no">${esc(c)}</span>`).join('')}
                                ${(a.student_codes || []).length ? `<span class="as-tag">+${a.student_codes.length} ${esc(T('doc_asig_individuales', 'individuales'))}</span>` : ''}
                            </div>
                            ${a.note ? `<p style="margin:8px 0 0;color:#54595f;font-size:.9em">${esc(a.note)}</p>` : ''}
                        </div>
                        <div class="as-toolbar">
                            <button class="as-btn small ghost" type="button" onclick="showProgress('${a.id}')"><i class="fas fa-chart-line"></i> ${esc(T('doc_asig_ver_avance', 'Avance'))}</button>
                            ${mine ? `<button class="as-btn small ghost" type="button" onclick="editAssignment('${a.id}')"><i class="fas fa-pen"></i> ${esc(T('doc_asig_editar', 'Editar'))}</button>
                            <button class="as-btn small danger" type="button" onclick="archiveAssignment('${a.id}')"><i class="fas fa-box-archive"></i> ${esc(T('doc_asig_archivar', 'Archivar'))}</button>` : ''}
                        </div>
                    </div>
                    <div class="as-progress" id="pg_${a.id}"></div>
                </article>`;
            }).join('');
        } catch (e) {
            list.innerHTML = '<div class="as-empty">' + esc(e.message) + '</div>';
        }
    }

    document.getElementById('classSearch').addEventListener('input', renderClasses);
    document.addEventListener('langchange', () => { renderClasses(); loadAssignments(); });
    loadClasses();
    loadAssignments();
</script>
<%- include('../partials/help-button') %>
</body>
</html>
