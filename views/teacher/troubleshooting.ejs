<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guía de Troubleshooting — MedienPass</title>
    <%- i18nScripts() %>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', system-ui, sans-serif; background: #f8fafc; margin: 0; padding: 0; }
        .header {
            background: linear-gradient(135deg, #1e1b4b, #4338ca);
            color: white; padding: 20px 40px;
            display: flex; justify-content: space-between; align-items: center;
        }
        .header h1 { margin: 0; font-size: 1.4em; }
        .container { max-width: 1200px; margin: 0 auto; padding: 24px; }
        
        .search-box {
            background: white; border-radius: 12px; padding: 20px; margin-bottom: 24px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }
        .search-box input {
            width: 100%; padding: 14px 20px; border: 2px solid #e2e8f0; border-radius: 10px;
            font-size: 1.1em; box-sizing: border-box;
        }
        .search-box input:focus { border-color: #4f46e5; outline: none; }
        
        .category-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 20px; }
        
        .category-card {
            background: white; border-radius: 16px; overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }
        .category-header {
            padding: 16px 20px; color: white; font-weight: 600; font-size: 1.1em;
            display: flex; align-items: center; gap: 10px;
        }
        .category-header i { font-size: 1.3em; }
        .cat-red { background: #dc2626; }
        .cat-blue { background: #0ea5e9; }
        .cat-purple { background: #7c3aed; }
        .cat-orange { background: #ea580c; }
        .cat-green { background: #059669; }
        
        .category-content { padding: 16px; }
        
        .problem-item {
            border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 10px; overflow: hidden;
        }
        .problem-header {
            padding: 12px 16px; background: #f8fafc; cursor: pointer; display: flex;
            justify-content: space-between; align-items: center;
        }
        .problem-header:hover { background: #f1f5f9; }
        .problem-header h4 { margin: 0; font-size: 0.95em; color: #1e293b; }
        .problem-content {
            padding: 0 16px; max-height: 0; overflow: hidden; transition: max-height 0.3s, padding 0.3s;
        }
        .problem-content.open { max-height: 500px; padding: 16px; }
        .problem-content ul { margin: 0; padding-left: 20px; color: #475569; font-size: 0.9em; }
        .problem-content li { margin-bottom: 8px; }
        .problem-content .step { background: #f0f9ff; padding: 8px 12px; border-radius: 6px; margin-bottom: 8px; font-size: 0.85em; }
        
        .emergency-box {
            background: linear-gradient(135deg, #fef2f2, #fee2e2);
            border: 2px solid #ef4444; border-radius: 16px; padding: 24px; margin-bottom: 24px;
        }
        .emergency-box h3 { color: #991b1b; margin: 0 0 16px; }
        .emergency-box .btn { background: #ef4444; color: white; padding: 12px 24px; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 1em; }
        .emergency-box .btn:hover { background: #dc2626; }
        
        .back-link { color: rgba(255,255,255,0.8); text-decoration: none; }
        .back-link:hover { color: white; }
        
        .chevron { transition: transform 0.3s; }
        .problem-item.open .chevron { transform: rotate(180deg); }
        
        .contact-card {
            background: white; border-radius: 16px; padding: 24px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-top: 24px;
        }
        .contact-card h3 { margin: 0 0 16px; color: #1e1b4b; }
        .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
        .contact-item { display: flex; align-items: center; gap: 10px; }
        .contact-item i { color: #4f46e5; font-size: 1.2em; }
    </style>
    <%- include('../partials/brand-head') %>
</head>
<body>
    <%- include('../partials/brand-page-header', {
        pageTitle: 'doc_ts_guia_de_troubleshooting',
        pageSubtitle: 'doc_ts_soluciones_rapidas_a_problemas',
        pageLinks: [
            { href: '/teacher/training', icon: 'fa-arrow-left', key: 'doc_ts_volver_al_portal' }
        ]
    }) %>

    <div class="container">
        <!-- Emergency: se avisa a coordinación o al soporte de sistemas -->
        <div class="emergency-box">
            <h3><span data-i18n="doc_ts_problema_urgente_que_no_puedes"><%= locals.t('doc_ts_problema_urgente_que_no_puedes') %></span></h3>
            <p style="margin: 0;"><span data-i18n="doc_ts_si_necesitas_reportar_una_falla"><%= locals.t('doc_ts_si_necesitas_reportar_una_falla') %></span></p>
        </div>

        <!-- Search -->
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="<%= locals.t('doc_ts_busca_tu_problema_ej_wifi_teams') %>" data-i18n-placeholder="doc_ts_busca_tu_problema_ej_wifi_teams">
        </div>

        <!-- Categories -->
        <div class="category-grid" id="categoriesGrid">
            
            <!-- Red/Conectividad -->
            <div class="category-card" data-category="red">
                <div class="category-header cat-red">
                    <i class="fas fa-wifi"></i> <span data-i18n="doc_ts_red_y_conectividad"><%= locals.t('doc_ts_red_y_conectividad') %></span>
                </div>
                <div class="category-content">
                    <div class="problem-item">
                        <div class="problem-header" onclick="toggleProblem(this)">
                            <h4><span data-i18n="doc_ts_wifi_no_conecta"><%= locals.t('doc_ts_wifi_no_conecta') %></span></h4>
                            <i class="fas fa-chevron-down chevron"></i>
                        </div>
                        <div class="problem-content">
                            <div class="step"><span data-i18n="doc_ts_1_verificar_que_el_dispositivo_tenga"><%= locals.t('doc_ts_1_verificar_que_el_dispositivo_tenga') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_revisar_que_el_icono_de_wifi_no_este"><%= locals.t('doc_ts_revisar_que_el_icono_de_wifi_no_este') %></span></li>
                                <li><span data-i18n="doc_ts_asegurarse_de_estar_en_la_red"><%= locals.t('doc_ts_asegurarse_de_estar_en_la_red') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_2_olvidar_red_y_reconectar"><%= locals.t('doc_ts_2_olvidar_red_y_reconectar') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_ir_a_configuracion_wifi"><%= locals.t('doc_ts_ir_a_configuracion_wifi') %></span></li>
                                <li><span data-i18n="doc_ts_olvidar_la_red_guardada"><%= locals.t('doc_ts_olvidar_la_red_guardada') %></span></li>
                                <li><span data-i18n="doc_ts_volver_a_conectarte_ingresando_la"><%= locals.t('doc_ts_volver_a_conectarte_ingresando_la') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_3_reiniciar_el_dispositivo"><%= locals.t('doc_ts_3_reiniciar_el_dispositivo') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_apagar_completamente_y_volver_a"><%= locals.t('doc_ts_apagar_completamente_y_volver_a') %></span></li>
                            </ul>
                        </div>
                    </div>
                    <div class="problem-item">
                        <div class="problem-header" onclick="toggleProblem(this)">
                            <h4><span data-i18n="doc_ts_teams_no_abre_sesion"><%= locals.t('doc_ts_teams_no_abre_sesion') %></span></h4>
                            <i class="fas fa-chevron-down chevron"></i>
                        </div>
                        <div class="problem-content">
                            <div class="step"><span data-i18n="doc_ts_1_verificar_credenciales_office_365"><%= locals.t('doc_ts_1_verificar_credenciales_office_365') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_usuario_nombre_colegioaleman_edu_co"><%= locals.t('doc_ts_usuario_nombre_colegioaleman_edu_co') %></span></li>
                                <li><span data-i18n="doc_ts_contrasena_la_misma_del_correo"><%= locals.t('doc_ts_contrasena_la_misma_del_correo') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_2_limpiar_cache_de_teams"><%= locals.t('doc_ts_2_limpiar_cache_de_teams') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_cerrar_teams_completamente"><%= locals.t('doc_ts_cerrar_teams_completamente') %></span></li>
                                <li><span data-i18n="doc_ts_ir_a_appdata_microsoft_teams"><%= locals.t('doc_ts_ir_a_appdata_microsoft_teams') %></span></li>
                                <li><span data-i18n="doc_ts_eliminar_carpeta_cache"><%= locals.t('doc_ts_eliminar_carpeta_cache') %></span></li>
                                <li><span data-i18n="doc_ts_volver_a_abrir_teams"><%= locals.t('doc_ts_volver_a_abrir_teams') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_3_probar_en_navegador"><%= locals.t('doc_ts_3_probar_en_navegador') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_ir_a_teams_microsoft_com"><%= locals.t('doc_ts_ir_a_teams_microsoft_com') %></span></li>
                                <li><span data-i18n="doc_ts_si_funciona_ahi_reinstalar_la_app"><%= locals.t('doc_ts_si_funciona_ahi_reinstalar_la_app') %></span></li>
                            </ul>
                        </div>
                    </div>
                    <div class="problem-item">
                        <div class="problem-header" onclick="toggleProblem(this)">
                            <h4><span data-i18n="doc_ts_onedrive_no_sincroniza"><%= locals.t('doc_ts_onedrive_no_sincroniza') %></span></h4>
                            <i class="fas fa-chevron-down chevron"></i>
                        </div>
                        <div class="problem-content">
                            <div class="step"><span data-i18n="doc_ts_1_verificar_conexion_a_internet"><%= locals.t('doc_ts_1_verificar_conexion_a_internet') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_abrir_cualquier_pagina_web"><%= locals.t('doc_ts_abrir_cualquier_pagina_web') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_2_reiniciar_sincronizacion"><%= locals.t('doc_ts_2_reiniciar_sincronizacion') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_click_derecho_en_icono_de_onedrive"><%= locals.t('doc_ts_click_derecho_en_icono_de_onedrive') %></span></li>
                                <li><span data-i18n="doc_ts_seleccionar_configuracion"><%= locals.t('doc_ts_seleccionar_configuracion') %></span></li>
                                <li><span data-i18n="doc_ts_pestana_cuenta_desconectar"><%= locals.t('doc_ts_pestana_cuenta_desconectar') %></span></li>
                                <li><span data-i18n="doc_ts_volver_a_agregar_cuenta"><%= locals.t('doc_ts_volver_a_agregar_cuenta') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_3_espacio_en_disco"><%= locals.t('doc_ts_3_espacio_en_disco') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_verificar_que_haya_espacio"><%= locals.t('doc_ts_verificar_que_haya_espacio') %></span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hardware -->
            <div class="category-card" data-category="hardware">
                <div class="category-header cat-blue">
                    <i class="fas fa-laptop"></i> <span data-i18n="doc_ts_hardware"><%= locals.t('doc_ts_hardware') %></span>
                </div>
                <div class="category-content">
                    <div class="problem-item">
                        <div class="problem-header" onclick="toggleProblem(this)">
                            <h4><span data-i18n="doc_ts_laptop_no_enciende"><%= locals.t('doc_ts_laptop_no_enciende') %></span></h4>
                            <i class="fas fa-chevron-down chevron"></i>
                        </div>
                        <div class="problem-content">
                            <div class="step"><span data-i18n="doc_ts_1_verificar_cargador"><%= locals.t('doc_ts_1_verificar_cargador') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_confirmar_que_el_cargador_este"><%= locals.t('doc_ts_confirmar_que_el_cargador_este') %></span></li>
                                <li><span data-i18n="doc_ts_revisar_que_el_indicador_de_carga"><%= locals.t('doc_ts_revisar_que_el_indicador_de_carga') %></span></li>
                                <li><span data-i18n="doc_ts_probar_con_otro_cargador_si_es"><%= locals.t('doc_ts_probar_con_otro_cargador_si_es') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_2_forzar_reinicio"><%= locals.t('doc_ts_2_forzar_reinicio') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_mantener_presionado_el_boton_de"><%= locals.t('doc_ts_mantener_presionado_el_boton_de') %></span></li>
                                <li><span data-i18n="doc_ts_soltar_y_presionar_normalmente"><%= locals.t('doc_ts_soltar_y_presionar_normalmente') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_3_bateria_baja"><%= locals.t('doc_ts_3_bateria_baja') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_dejar_cargando_minimo_15_minutos"><%= locals.t('doc_ts_dejar_cargando_minimo_15_minutos') %></span></li>
                                <li><span data-i18n="doc_ts_intentar_encender_de_nuevo"><%= locals.t('doc_ts_intentar_encender_de_nuevo') %></span></li>
                            </ul>
                        </div>
                    </div>
                    <div class="problem-item">
                        <div class="problem-header" onclick="toggleProblem(this)">
                            <h4><span data-i18n="doc_ts_pantalla_negra"><%= locals.t('doc_ts_pantalla_negra') %></span></h4>
                            <i class="fas fa-chevron-down chevron"></i>
                        </div>
                        <div class="problem-content">
                            <div class="step"><span data-i18n="doc_ts_1_brillo_al_minimo"><%= locals.t('doc_ts_1_brillo_al_minimo') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_presionar_fn_tecla_de_brillo_varias"><%= locals.t('doc_ts_presionar_fn_tecla_de_brillo_varias') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_2_teclado_no_responde"><%= locals.t('doc_ts_2_teclado_no_responde') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_mantener_presionado_alt_ctrl_del"><%= locals.t('doc_ts_mantener_presionado_alt_ctrl_del') %></span></li>
                                <li><span data-i18n="doc_ts_si_abre_administrador_de_tareas"><%= locals.t('doc_ts_si_abre_administrador_de_tareas') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_3_apagar_y_encender"><%= locals.t('doc_ts_3_apagar_y_encender') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_mantener_boton_de_encendido_10"><%= locals.t('doc_ts_mantener_boton_de_encendido_10') %></span></li>
                            </ul>
                        </div>
                    </div>
                    <div class="problem-item">
                        <div class="problem-header" onclick="toggleProblem(this)">
                            <h4><span data-i18n="doc_ts_audifonos_no_funcionan"><%= locals.t('doc_ts_audifonos_no_funcionan') %></span></h4>
                            <i class="fas fa-chevron-down chevron"></i>
                        </div>
                        <div class="problem-content">
                            <div class="step"><span data-i18n="doc_ts_1_verificar_conexion"><%= locals.t('doc_ts_1_verificar_conexion') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_si_son_usb_probar_en_otro_puerto"><%= locals.t('doc_ts_si_son_usb_probar_en_otro_puerto') %></span></li>
                                <li><span data-i18n="doc_ts_si_son_bluetooth_verificar_que_esten"><%= locals.t('doc_ts_si_son_bluetooth_verificar_que_esten') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_2_dispositivo_de_audio"><%= locals.t('doc_ts_2_dispositivo_de_audio') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_click_derecho_en_icono_de_sonido"><%= locals.t('doc_ts_click_derecho_en_icono_de_sonido') %></span></li>
                                <li><span data-i18n="doc_ts_configuracion_de_sonido_salida_de"><%= locals.t('doc_ts_configuracion_de_sonido_salida_de') %></span></li>
                                <li><span data-i18n="doc_ts_seleccionar_los_audifonos"><%= locals.t('doc_ts_seleccionar_los_audifonos') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_3_reiniciar"><%= locals.t('doc_ts_3_reiniciar') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_apagar_y_encender_los_audifonos"><%= locals.t('doc_ts_apagar_y_encender_los_audifonos') %></span></li>
                                <li><span data-i18n="doc_ts_reconectar_bluetooth_si_es_necesario"><%= locals.t('doc_ts_reconectar_bluetooth_si_es_necesario') %></span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Software -->
            <div class="category-card" data-category="software">
                <div class="category-header cat-purple">
                    <i class="fas fa-code"></i> <span data-i18n="doc_ts_software_y_aplicaciones"><%= locals.t('doc_ts_software_y_aplicaciones') %></span>
                </div>
                <div class="category-content">
                    <div class="problem-item">
                        <div class="problem-header" onclick="toggleProblem(this)">
                            <h4><span data-i18n="doc_ts_app_no_responde"><%= locals.t('doc_ts_app_no_responde') %></span></h4>
                            <i class="fas fa-chevron-down chevron"></i>
                        </div>
                        <div class="problem-content">
                            <div class="step"><span data-i18n="doc_ts_1_forzar_cierre"><%= locals.t('doc_ts_1_forzar_cierre') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_presionar_ctrl_shift_esc"><%= locals.t('doc_ts_presionar_ctrl_shift_esc') %></span></li>
