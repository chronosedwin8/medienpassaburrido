                            </ul>
                            <div class="step"><span data-i18n="doc_ts_2_reiniciar_la_app"><%= locals.t('doc_ts_2_reiniciar_la_app') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_cerrar_completamente"><%= locals.t('doc_ts_cerrar_completamente') %></span></li>
                                <li><span data-i18n="doc_ts_esperar_30_segundos"><%= locals.t('doc_ts_esperar_30_segundos') %></span></li>
                                <li><span data-i18n="doc_ts_abrir_de_nuevo"><%= locals.t('doc_ts_abrir_de_nuevo') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_3_reiniciar_el_pc"><%= locals.t('doc_ts_3_reiniciar_el_pc') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_si_el_problema_persiste"><%= locals.t('doc_ts_si_el_problema_persiste') %></span></li>
                            </ul>
                        </div>
                    </div>
                    <div class="problem-item">
                        <div class="problem-header" onclick="toggleProblem(this)">
                            <h4><span data-i18n="doc_ts_error_de_login_office_365"><%= locals.t('doc_ts_error_de_login_office_365') %></span></h4>
                            <i class="fas fa-chevron-down chevron"></i>
                        </div>
                        <div class="problem-content">
                            <div class="step"><span data-i18n="doc_ts_1_verificar_credenciales"><%= locals.t('doc_ts_1_verificar_credenciales') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_usuario_debe_ser_nombre"><%= locals.t('doc_ts_usuario_debe_ser_nombre') %></span></li>
                                <li><span data-i18n="doc_ts_contrasena_es_la_del_correo"><%= locals.t('doc_ts_contrasena_es_la_del_correo') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_2_contrasena_expirada"><%= locals.t('doc_ts_2_contrasena_expirada') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_contactar_a_soporte_ti"><%= locals.t('doc_ts_contactar_a_soporte_ti') %></span></li>
                                <li><span data-i18n="doc_ts_no_intentar_multiples_veces"><%= locals.t('doc_ts_no_intentar_multiples_veces') %></span></li>
                            </ul>
                            <div class="step"><span data-i18n="doc_ts_3_cuenta_bloqueada"><%= locals.t('doc_ts_3_cuenta_bloqueada') %></span></div>
                            <ul>
                                <li><span data-i18n="doc_ts_esperar_30_minutos_e_intentar_de"><%= locals.t('doc_ts_esperar_30_minutos_e_intentar_de') %></span></li>
                                <li><span data-i18n="doc_ts_avisar_soporte_si_persiste"><%= locals.t('doc_ts_avisar_soporte_si_persiste') %></span></li>
                            </ul>
                        </div>
