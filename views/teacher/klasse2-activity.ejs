<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎨 Mi Primer Pasaporte Digital - Klasse 2</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Comic Sans MS', 'Chalkboard SE', 'Marker Felt', cursive;
            background: linear-gradient(135deg, #ffeaa7 0%, #fab1a9 25%, #a29bfe 50%, #74b9ff 75%, #81ecec 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container {
            max-width: 900px;
            width: 100%;
        }

        /* Header */
        .header {
            text-align: center;
            margin-bottom: 30px;
            animation: bounceIn 1s ease;
        }

        @keyframes bounceIn {
            0% { transform: scale(0.3); opacity: 0; }
            50% { transform: scale(1.05); }
            70% { transform: scale(0.9); }
            100% { transform: scale(1); opacity: 1; }
        }

        .header h1 {
            font-size: 2.5em;
            color: #6c5ce7;
            text-shadow: 3px 3px 0 #fdcb6;
            margin-bottom: 10px;
        }

        .header p {
            font-size: 1.2em;
            color: #636e72;
        }

        /* Progress Bar */
        .progress-container {
            background: white;
            border-radius: 30px;
            padding: 20px 30px;
            margin-bottom: 30px;
            box-shadow: 0 8px 20px rgba(108, 92, 231, 0.2);
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-weight: bold;
            color: #6c5ce7;
        }

        .progress-bar {
            height: 30px;
            background: #dfe6e9;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #a29bfe, #74b9ff, #81ecec);
            border-radius: 15px;
            transition: width 0.5s ease;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 15px;
            color: white;
            font-weight: bold;
            font-size: 0.9em;
        }

        .stars {
            text-align: center;
            font-size: 2em;
            margin-top: 10px;
        }

        .star { color: #dfe6e9; transition: 0.3s; }
        .star.active { color: #fdcb6; text-shadow: 0 0 10px #fdcb6; }

        /* Activity Cards */
        .activity-card {
            background: white;
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            display: none;
            animation: slideIn 0.5s ease;
        }

        .activity-card.active {
            display: block;
        }

        @keyframes slideIn {
            from { transform: translateY(50px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .activity-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 3px dashed #dfe6e9;
        }

        .activity-icon {
            font-size: 3em;
            animation: spin 3s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .activity-header h2 {
            color: #6c5ce7;
            font-size: 1.8em;
        }

        .activity-content {
            font-size: 1.1em;
            line-height: 1.8;
            color: #636e72;
            margin-bottom: 20px;
        }

        /* Interactive Elements */
        .quiz-option {
            background: linear-gradient(135deg, #ffeaa7, #fab1a9);
            border: 3px solid transparent;
            border-radius: 15px;
            padding: 15px 20px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1.05em;
            font-family: inherit;
            text-align: left;
            color: #2d3436;
        }

        .quiz-option:hover {
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(250, 177, 169, 0.5);
            border-color: #fab1a9;
        }

        .quiz-option.correct {
            background: linear-gradient(135deg, #81ecec, #55efc4);
            border-color: #00b894;
        }

        .quiz-option.wrong {
            background: linear-gradient(135deg, #fab1a9, #ff7675);
            border-color: #d63031;
        }

        /* Drag and Drop */
        .drag-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .drag-item {
            background: linear-gradient(135deg, #a29bfe, #74b9ff);
            color: white;
            padding: 15px;
            border-radius: 15px;
            text-align: center;
            cursor: grab;
            font-weight: bold;
            transition: transform 0.3s;
        }

        .drag-item:active { cursor: grabbing; transform: scale(1.1); }

        .drop-zone {
            background: #dfe6e9;
            border: 3px dashed #b2bec3;
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1em;
            color: #636e72;
            transition: all 0.3s;
        }

        .drop-zone.dragover {
            background: #ffeaa7;
            border-color: #fdcb6;
        }

        .drop-zone.correct {
            background: #81ecec;
            border-color: #00b894;
            color: #00b894;
        }

        /* Buttons */
        .btn {
            padding: 15px 30px;
            border: none;
            border-radius: 15px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            font-family: inherit;
        }

        .btn-primary {
            background: linear-gradient(135deg, #6c5ce7, #a29bfe);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(108, 92, 231, 0.4);
        }

        .btn-success {
            background: linear-gradient(135deg, #00b894, #55efc4);
            color: white;
        }

        .btn-next {
            display: none;
            margin: 20px auto 0;
        }

        .btn-next.show { display: block; }

        /* Feedback */
        .feedback {
            padding: 20px;
            border-radius: 15px;
            margin: 20px 0;
            display: none;
            animation: popIn 0.3s ease;
        }

        @keyframes popIn {
            0% { transform: scale(0); }
            80% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .feedback.show { display: block; }

        .feedback.correct {
            background: var(--mp-ok-soft);
            border: 3px solid var(--mp-ok);
            color: var(--mp-ok);
        }

        .feedback.wrong {
            background: var(--mp-danger-soft);
            border: 3px solid var(--mp-danger);
            color: var(--mp-danger);
        }

        .feedback h3 { margin: 0 0 10px; }

        /* Certificate */
        .certificate {
            background: linear-gradient(135deg, #ffeaa7, #fab1a9, #a29bfe, #74b9ff);
            border-radius: 25px;
            padding: 50px;
            text-align: center;
            display: none;
            animation: rotateIn 1s ease;
        }

        @keyframes rotateIn {
            from { transform: rotateY(90deg); opacity: 0; }
            to { transform: rotateY(0deg); opacity: 1; }
        }

        .certificate.show { display: block; }

        .certificate h2 {
            font-size: 3em;
            color: white;
            text-shadow: 3px 3px 0 rgba(0,0,0,0.2);
            margin-bottom: 20px;
        }

        .certificate .name {
            font-size: 2em;
            color: #2d3436;
            margin: 20px 0;
            padding: 20px;
            background: white;
            border-radius: 15px;
            display: inline-block;
            min-width: 300px;
        }

        .emoji-rain {
            font-size: 3em;
            margin: 20px 0;
        }

        /* Navigation */
        .nav-dots {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }

        .dot {
            width: 15px;
            height: 15px;
            border-radius: 50%;
            background: #dfe6e9;
            cursor: pointer;
            transition: all 0.3s;
        }

        .dot.active {
            background: #6c5ce7;
            transform: scale(1.3);
        }

        .dot.completed { background: #00b894; }

        /* Language Switcher */
        .lang-switch {
            position: fixed;
            top: 20px;
            right: 20px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }

        .lang-btn {
            padding: 10px 20px;
            border: none;
            border-radius: 20px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            font-family: inherit;
        }

        .lang-btn.active {
            background: #6c5ce7;
            color: white;
        }

        .lang-btn:not(.active) {
            background: white;
            color: #6c5ce7;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header h1 { font-size: 1.8em; }
            .activity-card { padding: 20px; }
            .certificate { padding: 30px; }
        }
    </style>
</head>
<body>
    <div class="lang-switch">
        <button class="lang-btn active" onclick="switchLang('es')">🇪🇸 ES</button>
        <button class="lang-btn" onclick="switchLang('de')">🇩🇪 DE</button>
        <button class="lang-btn" onclick="switchLang('en')">🇬🇺 EN</button>
    </div>

    <div class="container">
        <div class="header">
            <h1>🎨 Mi Primer Pasaporte Digital</h1>
            <p>🌟 Klasse 2 - ¡Aprendamos jugando! 🌟</p>
        </div>

        <div class="progress-container">
            <div class="progress-label">
                <span>🎯 Mi Progreso</span>
                <span id="progressText">0%</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill" style="width: 0%">0%</div>
            </div>
            <div class="stars" id="starsContainer">
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
            </div>
        </div>

        <!-- Activity 1: Safe Searching -->
        <div class="activity-card active" id="activity1">
            <div class="activity-header">
                <div class="activity-icon">🔍</div>
                <div>
                    <h2 data-lang="es:Aprendo a Buscar|Aprendo a Buscar|de:Lernen zu Suchen|en:Learning to Search">🔍 Aprendo a Buscar</h2>
                </div>
            </div>
            <div class="activity-content">
                <p data-lang="es:¿Ves algo que no conoces? ¡Usa el buscador!|de:Siehst du etwas, das du nicht kennst? Nutze die Suchmaschine!|en:See something you don't know? Use the search engine!">
                    🔍 ¿Ves algo que no conoces? ¡Usa el buscador!
                </p>
                <p data-lang="es:Selecciona la búsqueda más segura:|de:Wähle die sicherste Suche:|en:Select the safest search:">
                    👇 Selecciona la búsqueda más segura:
                </p>
            </div>

            <div class="quiz-option" onclick="checkAnswer(this, true)" data-lang="es:🌟 'Animales marinos' en Google Kids|de:🌟 'Meerestiere' bei Google Kids|en:🌟 'Sea animals' on Google Kids">
                🌟 'Animales marinos' en Google Kids
            </div>
            <div class="quiz-option" onclick="checkAnswer(this, false)" data-lang="es:⚠️ Cualquier cosa en internet|de:⚠️ Alles im Internet|en:⚠️ Anything on internet">
                ⚠️ Cualquier cosa en internet
            </div>
            <div class="quiz-option" onclick="checkAnswer(this, false)" data-lang="es:📱 'Juegos' sin preguntar|de:📱 'Spiele' ohne zu fragen|en:📱 'Games' without asking">
                📱 'Juegos' sin preguntar
            </div>

            <div class="feedback" id="feedback1">
                <h3>✅ ¡Correcto!</h3>
                <p data-lang="es:Google Kids es seguro para niños. ¡Siempre pregunta a un adulto antes de buscar!|de:Google Kids ist sicher für Kinder. Frag immer einen Erwachsenen, bevor du suchst!|en:Google Kids is safe for kids. Always ask an adult before searching!">
                    ✅ ¡Correcto! Google Kids es seguro para niños. ¡Siempre pregunta a un adulto antes de buscar!
                </p>
            </div>

            <button class="btn btn-next" id="next1" onclick="nextActivity(2)">➡️ Siguiente</button>
        </div>

        <!-- Activity 2: Kindness Online -->
        <div class="activity-card" id="activity2">
            <div class="activity-header">
                <div class="activity-icon">💌</div>
                <div>
                    <h2 data-lang="es:Soy Amable en Internet|Soy Amable en Internet|de:Nett freundlich sein|en:Being Kind Online">💌 Soy Amable en Internet</h2>
                </div>
            </div>
            <div class="activity-content">
                <p data-lang="es:¿Qué mensaje envías a tu amigo?|de:Welche Nachricht schickst du deinem Freund?|en:What message do you send to your friend?">
                    💌 ¿Qué mensaje envías a tu amigo?
                </p>
            </div>

            <div class="quiz-option" onclick="checkAnswer2(this, true)" data-lang="es:😊 '¡Qué bien tu dibujo! Me gusta mucho'|de:😊 'Toll dein Bild! Ich mag es sehr'|en:😊 'Great drawing! I like it a lot'">
                😊 '¡Qué bien tu dibujo! Me gusta mucho'
            </div>
            <div class="quiz-option" onclick="checkAnswer2(this, false)" data-lang="es:😠 'Ese dibujo es feo'|de:😠 'Dieses Bild ist hässlich'|en:😠 'That drawing is ugly'">
                😠 'Ese dibujo es feo'
            </div>
            <div class="quiz-option" onclick="checkAnswer2(this, false)" data-lang="es:🤐 No digo nada|de:🤐 Ich sage nichts|en:🤐 I say nothing">
                🤐 No digo nada
            </div>

            <div class="feedback" id="feedback2">
                <h3>✅ ¡Muy bien!</h3>
                <p data-lang="es:Ser amable en internet hace felices a todos. 🌈|de:Nett freundlich sein macht alle glücklich. 🌈|en:Being kind online makes everyone happy. 🌈">
                    ✅ ¡Muy bien! Ser amable en internet hace felices a todos. 🌈
                </p>
            </div>

            <button class="btn btn-next" id="next2" onclick="nextActivity(3)">➡️ Siguiente</button>
        </div>

        <!-- Activity 3: Protecting Info -->
        <div class="activity-card" id="activity3">
            <div class="activity-header">
                <div class="activity-icon">🔐</div>
                <div>
                    <h2 data-lang="es:Protejo mis Datos|Protejo mis Datos|de:Meine Daten schützen|en:Protect My Data">🔐 Protejo mis Datos</h2>
                </div>
            </div>
            <div class="activity-content">
                <p data-lang="es:Arrastra los datos a la caja correcta:|de:Ziehe die Daten in die richtige Box:|en:Drag the data to the correct box:">
                    🖐 Arrastra los datos a la caja correcta:
                </p>
            </div>

            <div class="drag-container">
                <div class="drag-item" draggable="true" ondragstart="drag(event)" id="drag1" data-lang="es:Mi nombre: Juan|de:Mein Name: Juan|en:My name: Juan">Mi nombre: Juan</div>
                <div class="drag-item" draggable="true" ondragstart="drag(event)" id="drag2" data-lang="es:Mi contraseña: 1234|de:Mein Passwort: 1234|en:My password: 1234">Mi contraseña: 1234</div>
                <div class="drag-item" draggable="true" ondragstart="drag(event)" id="drag3" data-lang="es:Mi color favorito: Azul|de:Meine Lieblingsfarbe: Blau|en:My favorite color: Blue">Mi color favorito: Azul</div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                <div>
                    <h4 data-lang="es:✅ Compartir|de:✅ Teilen|en:✅ Share">✅ Compartir</h4>
                    <div class="drop-zone" id="shareZone" ondrop="drop(event, 'share')" ondragover="allowDrop(event)"></div>
                </div>
                <div>
                    <h4 data-lang="es:🔒 Guardar Secreto|de:🔒 Geheim halten|en:🔒 Keep Secret">🔒 Guardar Secreto</h4>
                    <div class="drop-zone" id="secretZone" ondrop="drop(event, 'secret')" ondragover="allowDrop(event)"></div>
                </div>
            </div>

            <div class="feedback" id="feedback3">
                <h3>✅ ¡Excelente!</h3>
                <p data-lang="es:Las contraseñas son secretas. ¡No las compartas! 🔒|de:Passwörter sind geheim. Teile sie nicht! 🔒|en:Passwords are secret. Never share them! 🔒">
                    ✅ ¡Excelente! Las contraseñas son secretas. ¡No las compartas! 🔒
                </p>
            </div>

            <button class="btn btn-next" id="next3" onclick="nextActivity(4)">➡️ Siguiente</button>
        </div>

        <!-- Activity 4: Screen Time Balance -->
        <div class="activity-card" id="activity4">
            <div class="activity-header">
                <div class="activity-icon">⏰</div>
                <div>
                    <h2 data-lang="es:Uso mi Tiempo Bien|Uso mi Tiempo Bien|de:Meine Zeit gut nutzen|en:Using Time Wisely">⏰ Uso mi Tiempo Bien</h2>
                </div>
            </div>
            <div class="activity-content">
                <p data-lang="es:Marca lo que haces en un día:|de:Markiere, was du an einem Tag machst:|en:Mark what you do in a day:">
                    ⏰ Marca lo que haces en un día:
                </p>
            </div>

            <div class="quiz-option" onclick="checkAnswer3(this, true)" data-lang="es:📚 Leer un libro por 30 min|de:📚 Ein Buch lesen für 30 Min|en:📚 Read a book for 30 min">
                📚 Leer un libro por 30 min
            </div>
            <div class="quiz-option" onclick="checkAnswer3(this, true)" data-lang="es:🏃 Jugar afuera por 1 hora|de:🏃 Draussen spielen für 1 Stunde|en:🏃 Play outside for 1 hour">
                🏃 Jugar afuera por 1 hora
            </div>
            <div class="quiz-option" onclick="checkAnswer3(this, false)" data-lang="es:📱 Pantalla todo el día|de:📱 Den ganzen Tag Bildschirm|en:📱 Screen all day">
                📱 Pantalla todo el día
            </div>
            <div class="quiz-option" onclick="checkAnswer3(this, true)" data-lang="es:🎨 Dibujar y pintar|de:🎨 Malen und zeichnen|en:🎨 Draw and paint">
                🎨 Dibujar y pintar
            </div>

            <div class="feedback" id="feedback4">
                <h3>✅ ¡Perfecto!</h3>
                <p data-lang="es:Equilibra el tiempo de pantalla con otras actividades. 🌳|de:Balance Bildschirmzeit mit anderen Aktivitäten. 🌳|en:Balance screen time with other activities. 🌳">
                    ✅ ¡Perfecto! Equilibra el tiempo de pantalla con otras actividades. 🌳
                </p>
            </div>

            <button class="btn btn-next" id="next4" onclick="nextActivity(5)">➡️ Siguiente</button>
        </div>

        <!-- Activity 5: Ask Adults -->
        <div class="activity-card" id="activity5">
            <div class="activity-header">
                <div class="activity-icon">👨‍👩‍👦</div>
                <div>
                    <h2 data-lang="es:Pregunto a los Adultos|Pregunto a los Adultos|de:Erwachsene fragen|en:Ask Adults">👨‍👩‍👦 Pregunto a los Adultos</h2>
                </div>
            </div>
            <div class="activity-content">
                <p data-lang="es:¿Qué haces si ves algo raro en internet?|de:Was machst du, wenn du etwas Seltsames im Internet siehst?|en:What do you do if you see something weird online?">
                    🤔 ¿Qué haces si ves algo raro en internet?
                </p>
            </div>

            <div class="quiz-option" onclick="checkAnswer4(this, true)" data-lang="es:✅ Cerrar la pantalla y contárselo a mamá/papá|de:✅ Bildschirm schliessen und es Mama/Papa erzählen|en:✅ Close screen and tell mom/dad">
                ✅ Cerrar la pantalla y contárselo a mamá/papá
            </div>
            <div class="quiz-option" onclick="checkAnswer4(this, false)" data-lang="es:❌ Seguir mirando|de:❌ Weiterschauen|en:❌ Keep watching">
                ❌ Seguir mirando
            </div>
            <div class="quiz-option" onclick="checkAnswer4(this, false)" data-lang="es:🤐 No contarle a nadie|de:🤐 Niemandem erzählen|en:🤐 Tell no one">
                🤐 No contarle a nadie
            </div>

            <div class="feedback" id="feedback5">
                <h3>✅ ¡Exacto!</h3>
                <p data-lang="es:Siempres pide ayuda a un adulto. ¡Ellos te protegen! 🛡️|de:Immer Erwachsene um Hilfe bitten. Sie beschützen dich! 🛡️|en:Always ask an adult for help. They protect you! 🛡️">
                    ✅ ¡Exacto! Siempres pide ayuda a un adulto. ¡Ellos te protegen! 🛡️
                </p>
            </div>

            <button class="btn btn-success btn-next" id="next5" onclick="showCertificate()">🎓 ¡Obtener Certificado!</button>
        </div>

        <!-- Certificate -->
        <div class="certificate" id="certificate">
            <div class="emoji-rain">🎉🎊🏆🎊🎉</div>
            <h2 data-lang="es:¡CERTIFICADO!|de:URKUNDE!|en:CERTIFICATE!">¡CERTIFICADO!</h2>
            <p data-lang="es:Otorgado a:|de:Verliehen an:|en:Awarded to:">Otorgado a:</p>
            <div class="name" id="studentName">Estudiante de Klasse 2</div>
            <p data-lang="es:Por completar el Pasaporte Digital|de:Für den Abschluss des digitalen Passes|en:For completing the Digital Passport">Por completar el Pasaporte Digital</p>
            <div class="emoji-rain">⭐⭐⭐⭐⭐</div>
            <button class="btn btn-primary" onclick="restart()" data-lang="es:🔄 Volver a jugar|de:🔄 Nochmal spielen|en:🔄 Play Again">🔄 Volver a jugar</button>
        </div>

        <div class="nav-dots">
            <div class="dot active" onclick="goToActivity(1)"></div>
            <div class="dot" onclick="goToActivity(2)"></div>
            <div class="dot" onclick="goToActivity(3)"></div>
            <div class="dot" onclick="goToActivity(4)"></div>
            <div class="dot" onclick="goToActivity(5)"></div>
        </div>
    </div>

    <script>
        let currentActivity = 1;
        let completedActivities = new Set();
        let currentLang = 'es';

        const translations = {
            'es': {
                'Aprendo a Buscar': '🔍 Aprendo a Buscar',
                'Soy Amable en Internet': '💌 Soy Amable en Internet',
                'Protejo mis Datos': '🔐 Protejo mis Datos',
                'Uso mi Tiempo Bien': '⏰ Uso mi Tiempo Bien',
                'Pregunto a los Adultos': '👨‍👩‍👦 Pregunto a los Adultos'
            },
            'de': {
