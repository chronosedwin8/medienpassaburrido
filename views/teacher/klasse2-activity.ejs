        function allowDrop(ev) {
            ev.preventDefault();
            ev.currentTarget.classList.add('dragover');
        }

        function drag(ev) {
            ev.dataTransfer.setData("text", ev.target.id);
        }

        function drop(ev, zone) {
            ev.preventDefault();
            ev.currentTarget.classList.remove('dragover');
            
            const data = ev.dataTransfer.getData("text");
            const draggedElement = document.getElementById(data);
            
            if (zone === 'secret' && (data === 'drag2')) {
                ev.currentTarget.classList.add('correct');
                document.getElementById('feedback3').classList.add('show');
                document.getElementById('next3').classList.add('show');
                completeActivity(3);
            } else if (zone === 'share' && (data === 'drag1' || data === 'drag3')) {
                ev.currentTarget.appendChild(draggedElement);
            } else {
                ev.currentTarget.classList.add('wrong');
                setTimeout(() => ev.currentTarget.classList.remove('wrong'), 1000);
            }
        }

        function completeActivity(num) {
            completedActivities.add(num);
            updateProgress();
            document.querySelectorAll('.dot')[num - 1].classList.add('completed');
        }

        function updateProgress() {
            const total = 5;
            const completed = completedActivities.size;
            const percent = Math.round((completed / total) * 100);
            
            document.getElementById('progressFill').style.width = percent + '%';
            document.getElementById('progressFill').textContent = percent + '%';
            document.getElementById('progressText').textContent = percent + '%';
            
            const stars = document.querySelectorAll('.star');
            stars.forEach((star, index) => {
                if (index < completed) {
                    star.classList.add('active');
                } else {
                    star.classList.remove('active');
                }
            });
        }

        function nextActivity(num) {
            document.querySelectorAll('.activity-card').forEach(card => {
                card.classList.remove('active');
            });
            document.getElementById('activity' + num).classList.add('active');
            currentActivity = num;
            
            document.querySelectorAll('.dot').forEach((dot, index) => {
                dot.classList.toggle('active', index === num - 1);
            });
        }

        function goToActivity(num) {
            if (num <= Math.max(...completedActivities) + 1 || completedActivities.has(num)) {
                nextActivity(num);
            }
        }

        function showCertificate() {
            document.querySelectorAll('.activity-card').forEach(card => {
                card.classList.remove('active');
            });
            document.getElementById('certificate').classList.add('show');
            
            const name = prompt('¡Ingresa tu nombre para el certificado!', '');
            if (name) {
                document.getElementById('studentName').textContent = name;
            }
        }

        function restart() {
            completedActivities.clear();
            currentActivity = 1;
            updateProgress();
            
            document.querySelectorAll('.quiz-option').forEach(opt => {
                opt.classList.remove('correct', 'wrong');
            });
            
            document.querySelectorAll('.feedback').forEach(fb => {
                fb.classList.remove('show');
            });
            
            document.querySelectorAll('.btn-next').forEach(btn => {
                btn.classList.remove('show');
            });
            
            document.querySelectorAll('.dot').forEach(dot => {
                dot.classList.remove('completed', 'active');
            });
            document.querySelector('.dot').classList.add('active');
            
            document.getElementById('certificate').classList.remove('show');
            document.getElementById('activity1').classList.add('active');
        }
    </script>
</body>
