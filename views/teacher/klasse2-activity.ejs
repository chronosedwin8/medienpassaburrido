        function switchLang(lang) {
            currentLang = lang;
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.textContent.includes(lang.toUpperCase()));
            });
            
            document.querySelectorAll('[data-lang]').forEach(el => {
                const langData = el.getAttribute('data-lang');
                const parts = langData.split('|');
                const text = parts.find(p => p.startsWith(lang + ':'));
                if (text) {
                    el.textContent = text.substring(lang.length + 1);
                }
            });

            updateProgress();
        }

        function checkAnswer(element, isCorrect) {
            if (element.classList.contains('correct') || element.classList.contains('wrong')) return;

            if (isCorrect) {
                element.classList.add('correct');
                document.getElementById('feedback1').classList.add('show');
                document.getElementById('feedback1').querySelector('h3').textContent = '✅ ¡Correcto!';
                document.getElementById('next1').classList.add('show');
                completeActivity(1);
            } else {
                element.classList.add('wrong');
                document.getElementById('feedback1').classList.add('show');
                document.getElementById('feedback1').querySelector('h3').textContent = '❌ ¡Intenta de nuevo!';
                setTimeout(() => {
                    element.classList.remove('wrong');
                    document.getElementById('feedback1').classList.remove('show');
                }, 2000);
            }
        }

