<%- include('../partials/teacher-header', { activeItem: 'evaluation' }) %>
<%
const langAttr = obj => JSON.stringify(obj).replace(/&/g, '&amp;').replace(/'/g, '&#39;');
const langText = obj => (obj && (obj[locals.lang] || obj.es)) || '';
const selectedSubject = subjects.find(s => s.id === subject);
%>
<style>
.ttest { max-width: 860px; margin: 0 auto; padding: 20px; }
.ttest h1 { color: #1e1b4b; font-size: 1.6em; margin: 0 0 6px; }
.ttest-sub { color: #64748b; margin: 0 0 20px; }
.ttest-card { background: #fff; border-radius: 14px; padding: 22px; margin-bottom: 18px; box-shadow: 0 4px 15px rgba(0,0,0,.06); }
.ttest-part { font-size: 1.1em; font-weight: 800; color: #4338ca; margin: 26px 0 12px; }
.ttest-q { margin-bottom: 14px; padding: 16px 18px; background: #f8fafc; border-left: 4px solid #4f46e5; border-radius: 8px; border-top: 0; border-right: 0; border-bottom: 0; }
.ttest-q legend { float: left; width: 100%; padding: 0; margin-bottom: 10px; font-weight: 700; color: #1e293b; }
.ttest-q label { clear: both; display: flex; gap: 10px; align-items: flex-start; padding: 7px 0; font-weight: 400; color: #475569; cursor: pointer; }
.ttest-q input { width: auto; margin-top: 3px; }
.ttest-actions { position: sticky; bottom: 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 16px; background: #fff; border-radius: 12px; box-shadow: 0 -2px 12px rgba(0,0,0,.08); }
.ttest-btn { display: inline-block; padding: 12px 24px; font: inherit; font-weight: 700; color: #fff; background: #059669; border: 0; border-radius: 10px; cursor: pointer; text-decoration: none; }
.ttest-btn.secondary { background: #4f46e5; }
.ttest-btn:disabled { opacity: .5; cursor: default; }
.ttest-score { font-size: 3em; font-weight: 900; line-height: 1; }
.ttest-areas { width: 100%; border-collapse: collapse; margin-top: 12px; }
.ttest-areas th, .ttest-areas td { padding: 10px; text-align: left; border-bottom: 1px solid #e2e8f0; }
.ttest-banner { padding: 12px 16px; border-radius: 10px; background: #ecfdf5; color: #065f46; font-weight: 600; margin-bottom: 18px; }
.ttest-select { width: 100%; max-width: 420px; padding: 10px; border: 1.5px solid #cbd5e1; border-radius: 8px; font: inherit; }
</style>

<div class="ttest">
    <h1>📝 <span data-i18n="doc_test_titulo"><%= locals.t('doc_test_titulo') %></span></h1>
    <p class="ttest-sub" data-i18n="doc_test_intro"><%= locals.t('doc_test_intro') %></p>

    <% if (status && status.completed && !result) { %>
    <p class="ttest-banner">✅ <span data-i18n="doc_test_ya_aprobado"><%= locals.t('doc_test_ya_aprobado') %></span></p>
    <% } %>

    <% if (result) { %>
    <div class="ttest-card" style="border-top: 5px solid <%= result.passed ? '#10b981' : '#f59e0b' %>; text-align:center;">
        <div class="ttest-score" style="color: <%= result.passed ? '#059669' : '#d97706' %>;"><%= result.score %>%</div>
        <p><%= result.correct %> <span data-i18n="doc_test_de"><%= locals.t('doc_test_de') %></span> <%= result.total %></p>
        <h2 style="margin:8px 0;" data-i18n="<%= result.passed ? 'doc_test_aprobado' : 'doc_test_no_aprobado' %>"><%= locals.t(result.passed ? 'doc_test_aprobado' : 'doc_test_no_aprobado') %></h2>
        <% if (!result.passed && status && status.completed) { %>
        <p class="ttest-banner" data-i18n="doc_test_conserva"><%= locals.t('doc_test_conserva') %></p>
        <% } %>
    </div>
    <div class="ttest-card">
        <h2 style="font-size:1.1em; margin:0;" data-i18n="doc_test_por_competencia"><%= locals.t('doc_test_por_competencia') %></h2>
        <table class="ttest-areas">
            <tbody>
            <% result.byArea.forEach(row => { const area = kmkAreas[row.area - 1]; %>
                <tr>
                    <td><%= area.icon %> <span data-lang-content='<%- langAttr(area.name) %>'><%= langText(area.name) %></span></td>
                    <td style="white-space:nowrap;"><%= row.correct === row.total ? '✅' : '🔁' %> <%= row.correct %> / <%= row.total %></td>
                    <td><% if (row.correct < row.total) { %><a href="/teacher/training?subject=<%= encodeURIComponent(subject) %>#area<%= row.area %>" data-i18n="doc_test_repasar"><%= locals.t('doc_test_repasar') %></a><% } %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <p style="text-align:center;">
        <a class="ttest-btn secondary" href="/teacher/evaluation?subject=<%= encodeURIComponent(subject) %>" data-i18n="doc_test_repetir"><%= locals.t('doc_test_repetir') %></a>
        <a class="ttest-btn" href="/teacher/training?subject=<%= encodeURIComponent(subject) %>" data-i18n="doc_test_volver"><%= locals.t('doc_test_volver') %></a>
    </p>
    <% } else { %>
    <form method="get" action="/teacher/evaluation" class="ttest-card">
        <label for="testSubject" style="display:block; font-weight:700; margin-bottom:8px;" data-i18n="doc_test_tu_materia"><%= locals.t('doc_test_tu_materia') %></label>
        <select id="testSubject" name="subject" class="ttest-select" onchange="this.form.submit()">
            <option value="" data-i18n-option="doc_test_elige_materia"><%= locals.t('doc_test_elige_materia') %></option>
            <% subjects.forEach(s => { %>
            <option value="<%= s.id %>" <%= s.id === subject ? 'selected' : '' %> data-lang-option='<%- langAttr(s.name) %>'><%= s.icon %> <%= langText(s.name) %></option>
            <% }) %>
        </select>
    </form>

    <% if (questions) { %>
    <form method="post" action="/teacher/evaluation" id="teacherTestForm">
        <input type="hidden" name="subject" value="<%= subject %>">
        <% [['kmk', 'doc_test_parte_kmk'], ['subject', 'doc_test_parte_materia']].forEach(([part, key]) => { %>
        <h2 class="ttest-part"><span data-i18n="<%= key %>"><%= locals.t(key) %></span><% if (part === 'subject' && selectedSubject) { %> <span data-lang-content='<%- langAttr(selectedSubject.name) %>'><%= langText(selectedSubject.name) %></span><% } %></h2>
        <% questions.filter(q => q.part === part).forEach(q => { %>
        <fieldset class="ttest-q">
            <legend data-lang-content='<%- langAttr(q.label) %>'><%= langText(q.label) %></legend>
            <% q.options.forEach((option, idx) => { %>
            <label><input type="radio" name="q_<%= q.id %>" value="<%= idx %>" required> <span data-lang-content='<%- langAttr(option) %>'><%= langText(option) %></span></label>
            <% }) %>
        </fieldset>
        <% }) %>
        <% }) %>
        <div class="ttest-actions">
            <span><strong id="testAnswered">0</strong> / <%= questions.length %></span>
            <button type="submit" class="ttest-btn" data-i18n="doc_test_enviar"><%= locals.t('doc_test_enviar') %></button>
        </div>
    </form>
    <script>
        (function () {
            const form = document.getElementById('teacherTestForm');
            const counter = document.getElementById('testAnswered');
            form.addEventListener('change', () => {
                counter.textContent = new Set([...form.querySelectorAll('input[type=radio]:checked')].map(input => input.name)).size;
            });
        })();
    </script>
    <% } %>
    <% } %>
</div>

<%- include('../partials/footer') %>
