<%- include('../partials/header') %>

    <div class="admin-layout">
        <div class="admin-sidebar" style="background: #1e1b4b;">
            <div class="admin-brand">
                <i class="fas fa-chalkboard-teacher"></i>
                <h2 data-i18n="evalTitle">Evaluación KMK</h2>
            </div>
            <nav class="admin-nav">
                <a href="/teacher/training"><i class="fas fa-book-open"></i> <span data-i18n="navStudyModule">Módulo de Estudio</span></a>
                <a href="/teacher/worksheets"><i class="fas fa-print"></i> <span data-i18n="navWorksheets">Banco de Fichas</span></a>
                <a href="#" class="active"><i class="fas fa-tasks"></i> <span data-i18n="navEval">Evaluación</span></a>
                <a href="/teacher/troubleshooting"><i class="fas fa-wrench"></i> Guía Troubleshooting</a>
                <a href="/teacher/bitacora"><i class="fas fa-clipboard-list"></i> Bitácora de Novedades</a>
                <a href="/teacher/progress"><i class="fas fa-chart-line"></i> Monitoreo Retos (0-6)</a>
                <a href="/teacher/logout" style="margin-top: auto; color: #ef4444;"><i class="fas fa-sign-out-alt"></i>
                    <span data-i18n="logoutTitle">Cerrar Sesión</span></a>
            </nav>
        </div>

        <div class="admin-main" style="background: #f8fafc; overflow-y: auto;">
            <header class="admin-header">
                <div class="header-left">
                    <h1 data-i18n="certTitle">Certificación de Competencias Docentes</h1>
                    <p data-i18n="certSubtitle">Nivel Básico — Kultusministerkonferenz (KMK)</p>
                </div>
            </header>

            <div class="admin-content" style="max-width: 800px; margin: 0 auto;">
                <% if (typeof success !=='undefined' && success) { %>
                    <div class="admin-card" style="text-align: center; border-top: 5px solid <%= score >= 75 ? '#10b981' : '#f59e0b' %>;">
                        <% if (score >= 75) { %>
                            <i class="fas fa-award" style="font-size: 5em; color: #10b981; margin-bottom: 20px;"></i>
                            <h2>¡Felicitaciones!</h2>
                            <p style="font-size: 1.2em;">Has completado exitosamente la validación de competencias KMK.</p>
                        <% } else { %>
                            <i class="fas fa-exclamation-circle" style="font-size: 5em; color: #f59e0b; margin-bottom: 20px;"></i>
                            <h2>Puntuación insuficiente</h2>
                            <p style="font-size: 1.1em; color: #64748b;"><%= feedback %></p>
                        <% } %>
                        <p style="margin-top: 15px;">Tu puntuación fue del <strong><%= score %>%</strong>.</p>
                        <br>
                        <button class="btn btn-primary" onclick="window.location.href='/teacher/training'">
                            <%= score >= 75 ? 'Volver al Taller' : 'Repasar Módulo' %>
                        </button>
                    </div>
                    <% } else { %>
                        <form action="/teacher/evaluation" method="POST" class="admin-card" style="padding: 30px;">
                            <p>Por favor responde este breve cuestionario para validar los conocimientos del módulo.</p>
                            <hr style="margin: 20px 0; border: 0; border-top: 1px solid #e2e8f0;">

                            <div class="form-group" style="margin-bottom: 30px;">
                                <label style="font-size: 1.1em; color: #1e293b; margin-bottom: 10px; display: block;">1.
                                    ¿En qué área temática de la KMK se encuentra la competencia de "Evaluar y analizar
                                    fuentes mediáticas"?</label>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    <label><input type="radio" name="q1" value="A" required> A) Área 4: Protegerse y
                                        actuar con seguridad</label>
                                    <label><input type="radio" name="q1" value="B"> B) Área 1: Buscar, Procesar &
                                        Archivar Información</label>
                                    <label><input type="radio" name="q1" value="C"> C) Área 5: Solucionar
                                        problemas</label>
                                    <label><input type="radio" name="q1" value="D"> D) Área 2: Comunicar y
                                        Cooperar</label>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 30px;">
                                <label style="font-size: 1.1em; color: #1e293b; margin-bottom: 10px; display: block;">2.
                                    El cuidado del impacto ecológico (como el uso eficiente de dispositivos) pertenece
                                    a...</label>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    <label><input type="radio" name="q2" value="A" required> A) Proteger la salud
                                        física</label>
                                    <label><input type="radio" name="q2" value="B"> B) Identificar propias
                                        debilidades</label>
                                    <label><input type="radio" name="q2" value="C"> C) Conocer y respetar normas
                                        sociales</label>
                                    <label><input type="radio" name="q2" value="D"> D) Proteger el medio ambiente
                                        tecnológico (Área 4.4)</label>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 30px;">
                                <label style="font-size: 1.1em; color: #1e293b; margin-bottom: 10px; display: block;">3.
                                    'Interactuar, Compartir, Colaborar y Participar', hacen parte integral de:</label>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    <label><input type="radio" name="q3" value="A" required> A) Área 2: Comunicar y
                                        Cooperar</label>
                                    <label><input type="radio" name="q3" value="B"> B) Área 1: Archivar
                                        información</label>
                                    <label><input type="radio" name="q3" value="C"> C) Área 4: Actuar con
                                        seguridad</label>
                                    <label><input type="radio" name="q3" value="D"> D) Área 5: Solucionar algoritmos
                                        básicos</label>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 30px;">
                                <label style="font-size: 1.1em; color: #1e293b; margin-bottom: 10px; display: block;">4.
                                    Si un estudiante tiene un error con su cuenta escolar de Office 365, ayudarle a
                                    buscar de forma autónoma la raíz del problema mediante la lógica básica de
                                    "ensayo-error" corresponde a:</label>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    <label><input type="radio" name="q4" value="A" required> A) Área 1.1 Buscar y
                                        filtrar</label>
                                    <label><input type="radio" name="q4" value="B"> B) Área 2.4 Normas sociales</label>
                                    <label><input type="radio" name="q4" value="C"> C) Área 5.1 Resolver problemas
                                        técnicos</label>
                                    <label><input type="radio" name="q4" value="D"> D) Área 4.2 Proteger información
                                        personal</label>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 30px;">
                                <label style="font-size: 1.1em; color: #1e293b; margin-bottom: 10px; display: block;">5.
                                    ¿Cuál es el objetivo principal del MedienPass (Pasaporte de Medios) en el Colegio Alemán?</label>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    <label><input type="radio" name="q5" value="A" required> A) Generar una nota cuantitativa semestral en informática.</label>
                                    <label><input type="radio" name="q5" value="B"> B) Empoderar a los estudiantes para un uso seguro, creativo y crítico del mundo digital.</label>
                                    <label><input type="radio" name="q5" value="C"> C) Realizar un inventario de los dispositivos electrónicos de cada familia.</label>
                                    <label><input type="radio" name="q5" value="D"> D) Sustituir los libros de texto físicos por tablets permanentemente.</label>
                                </div>
                            </div>

                            <div style="text-align: center; margin-top: 40px;">
                                <button type="submit" class="btn btn-primary"
                                    style="font-size: 1.2em; padding: 12px 30px;">
                                    <i class="fas fa-paper-plane"></i> Enviar Evaluación
                                </button>
                            </div>
                        </form>
                        <% } %>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>