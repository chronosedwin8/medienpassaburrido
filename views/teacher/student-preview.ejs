<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Previsualización de Retos (Modo Estudiante) - Medienpass</title>
    <%- i18nScripts() %>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #f8fafc;
            background-image: 
                radial-gradient(at 0% 0%, rgba(241,245,249,1) 0, transparent 50%), 
                radial-gradient(at 50% 0%, rgba(224,231,255,0.4) 0, transparent 50%),
                radial-gradient(at 100% 0%, rgba(243,232,255,0.4) 0, transparent 50%);
            background-attachment: fixed;
        }

        .glass-header {
            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Legal Sheet Page Styling (8.5" x 14" aspect feel) */
        .legal-page-card {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
            border-radius: 1rem;
            padding: 2.5rem;
            min-height: 1050px;
            width: 100%;
            max-width: 820px;
            margin: 0 auto;
            position: relative;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .legal-page-card:hover {
            box-shadow: 0 25px 30px -5px rgba(0, 0, 0, 0.12), 0 10px 12px -5px rgba(0, 0, 0, 0.06);
            border-color: #94a3b8;
        }

        /* High Contrast Clear Scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }
        ::-webkit-scrollbar-track {
            background: #e2e8f0;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 9999px;
            border: 2px solid #e2e8f0;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #1e293b;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            animation: fadeIn 0.4s ease-out forwards;
        }

        /* Legal Print Styles */
        @media print {
            @page {
                size: legal portrait;
                margin: 12mm;
            }
            body {
                background: #ffffff !important;
                background-image: none !important;
            }
            .glass-header, #instrumentsSidebar, .no-print, header, nav {
                display: none !important;
            }
            main {
                max-width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .legal-page-card {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                min-height: auto !important;
                max-width: 100% !important;
                page-break-after: always !important;
                break-after: page !important;
            }
        }
    </style>
    <%- include('../partials/brand-head') %>
</head>
<body class="min-h-screen text-slate-800 antialiased pb-12">

    <!-- Encabezado del colegio: Configura tus Retos del 0 al 6 (antes Modo Estudiante),
         con acceso a Consulta los avances y al portal docente -->
    <%- include('../partials/brand-page-header', {
        pageTitle: 'doc_nav_configura_retos',
        pageSubtitle: 'doc_prev_previsualizacion_interactiva_de',
        pageLinks: [
            { href: '/teacher/progress', icon: 'fa-chart-line', key: 'doc_nav_consulta_avances' },
            { href: '/teacher/training', icon: 'fa-arrow-left', key: 'doc_ts_volver_al_portal' }
        ]
    }) %>

    <main class="max-w-7xl mx-auto px-4 md:px-6 mt-8 space-y-8">
        
        <!-- Main Layout with Sidebar and Preview Grid -->
        <div class="flex flex-col lg:flex-row gap-8 items-start">
            <!-- Menú Lateral Estilo Acordeón -->
            <%- include('../partials/instruments-sidebar') %>

            <!-- Preview Section -->
            <section class="flex-1 space-y-6 w-full">
                <!-- Legal Page Size Cards Container -->
                <div class="space-y-10" id="challengesContainer">
                    <!-- Filled dynamically by JS -->
                </div>
            </section>
        </div>

    </main>

    <!-- Instrument Editor Logic -->
    <script src="/js/instrument-editor.js"></script>

    <!-- JS Logic -->
    <script>
        const allActivities = <%- JSON.stringify(allActivities) %>;
        const sharedProfile = <%- JSON.stringify(sharedProfile) %>;
        const reto0BySubject = <%- JSON.stringify(typeof reto0BySubject !== 'undefined' ? reto0BySubject : {}) %>;
        const subjects = <%- JSON.stringify(subjects) %>;
        const challengeToolsConfig = <%- JSON.stringify(challengeToolsConfig || {}) %>;
        const defaultAgentTools = <%- JSON.stringify(defaultAgentTools || {}) %>;
        const editorAccess = <%- JSON.stringify(typeof editorAccess !== 'undefined' ? editorAccess : { subject: '', anySubject: false }) %>;
        // Materias activas (las inactivas se ocultan desde Administración › Materias)
        const activeSubjectList = subjects.filter(s => s.active !== false);

        // Current simulation state
        let currentGrade = 5;
        let currentLang = '<%= lang %>'; // idioma global elegido con los botones DE/EN/ES
        // Abre en la materia del docente (si está activa) o en la primera materia activa
        let currentSubject = activeSubjectList.some(s => s.id === editorAccess.subject)
            ? editorAccess.subject : ((activeSubjectList[0] || subjects[0] || {}).id || 'aleman');

        // Datos para el editor de retos (public/js/instrument-editor.js)
        window.editorConfig = {
            kmkAreas: <%- JSON.stringify(typeof kmkAreas !== 'undefined' ? kmkAreas : []) %>,
            access: editorAccess,
            subjects,
            // Preguntas del sistema de un reto para un grado y una materia.
            // Reto 0: su evaluación (las preguntas con quiz, desde la 10).
            getSystemQuestions: (reto, grade, subject) => {
                if (reto === 0) return (((reto0BySubject && reto0BySubject[subject]) || sharedProfile).evidence || []).filter(q => q.quiz);
                const acts = allActivities[String(reto)] || [];
                const act = acts.find(a => a.subject === subject) || acts[0] || {};
                return act[`evidence_k${grade}`] || act.evidence_k5 || act.evidence || [];
            }
        };

        // Default selected reto is Reto 0
        window.currentSelectedReto = 0;

        const gradeLevels = {
            2: { title: "Klasse 2", desc: "Básico" },
            3: { title: "Klasse 3", desc: "Básico + 1" },
            4: { title: "Klasse 4", desc: "Intermedio" },
            5: { title: "Klasse 5", desc: "Intermedio + 1" },
            6: { title: "Klasse 6", desc: "Avanzado" },
            7: { title: "Klasse 7", desc: "Avanzado + 1" },
            8: { title: "Klasse 8", desc: "Avanzado + 2" },
            9: { title: "Klasse 9", desc: "Avanzado + 3" },
            10: { title: "Klasse 10", desc: "Avanzado + 4" },
            11: { title: "Klasse 11", desc: "Avanzado + 5" },
            12: { title: "Klasse 12", desc: "Avanzado + 6" }
        };

        const inputPlaceholders = {
            es: "Respuesta simulada del estudiante...",
            de: "Simulierte Schülerantwort...",
            en: "Simulated student response..."
        };

        // Render selectors on startup
        window.addEventListener('DOMContentLoaded', () => {
            window.currentGrade = currentGrade;
            window.currentLang = currentLang;
            window.currentSubject = currentSubject;

            if (window.instrumentEditor && window.instrumentEditor.loadReviewSequence) {
                window.instrumentEditor.loadReviewSequence();
            }

            renderSubjectSelectors();
            window.instrumentEditor.switchInstrumentMode();
            window.instrumentEditor.renderEditorAccess();
            selectRetoFilter(0);
            updateBadges();
            updateUI();
        });

        function updateBadges() {
            // Grade badge
            const gradeLabel = document.getElementById('sidebarGradeActiveLabel');
            if (gradeLabel) {
                gradeLabel.innerText = currentGrade !== null ? `Klasse ${currentGrade}` : 'Sin Seleccionar';
            }

            // Lang badge
            const langLabel = document.getElementById('sidebarLangActiveLabel');
            if (langLabel) {
                langLabel.innerText = currentLang.toUpperCase();
            }

            // Subject badge
            const subLabel = document.getElementById('sidebarSubjectActiveLabel');
            if (subLabel) {
                const found = subjects.find(s => s.id === currentSubject);
                const subName = found ? (found.name[currentLang] || found.name.es) : window.t('doc_prev_js_sin_seleccionar');
                subLabel.innerText = subName;
            }

            // Reto badge
            const retoLabel = document.getElementById('sidebarRetoActiveLabel');
            if (retoLabel) {
                const r = window.currentSelectedReto;
                retoLabel.innerText = (r !== null && r !== undefined) ? (r === 0 ? window.t('doc_prev_js_reto0_intro') : `${window.t('doc_prev_js_reto')} ${r}`) : window.t('doc_prev_js_sin_seleccionar');
            }
        }

        function renderSubjectSelectors() {
            const sidebarContainer = document.getElementById('sidebarSubjectSelector');
            if (sidebarContainer) sidebarContainer.innerHTML = '';
            
            // Materias activas que tienen retos
            const activeSubjects = activeSubjectList.filter(sub => {
                const hasAct = Object.values(allActivities).some(acts =>
                    acts.some(a => a.subject === sub.id)
                ) || (sub.id === 'tecnologia');
                return hasAct;
            });

            activeSubjects.forEach(sub => {
                const isActive = sub.id === currentSubject;
                
                if (sidebarContainer) {
                    const sBtn = document.createElement('button');
                    sBtn.className = `w-full px-3 py-2 rounded-lg border transition-all flex items-center gap-2.5 text-xs ${
                        isActive 
                        ? 'bg-indigo-600/35 border-l-4 border-l-indigo-400 border-indigo-500/40 text-white font-bold shadow-sm' 
                        : 'border-transparent text-slate-300 hover:bg-white/10 hover:text-white font-medium'
                    }`;
                    sBtn.onclick = () => {
                        changeSubject(sub.id);
                        if (typeof collapseSidebarAccordion === 'function') collapseSidebarAccordion('acc-asignatura');
                    };
                    sBtn.innerHTML = `<span class="text-sm">${sub.icon}</span> <span>${sub.name[currentLang] || sub.name.es}</span>`;
                    sidebarContainer.appendChild(sBtn);
                }
            });
        }

        function changeGrade(g) {
            currentGrade = g;
            window.currentGrade = g;
            
            const sidebarGradeSelect = document.getElementById('sidebarGradeSelect');
            if (sidebarGradeSelect) {
                sidebarGradeSelect.value = g !== null ? String(g) : "";
            }
            if (window.instrumentEditor && window.instrumentEditor.loadReviewSequence) {
                window.instrumentEditor.loadReviewSequence();
            }
            updateBadges();
            updateUI();
        }

        function changeLang(l) {
            currentLang = l;
            window.currentLang = l;
            
            // Highlight active button in sidebar
            ['es', 'de', 'en'].forEach(langCode => {
                const sBtn = document.getElementById(`sidebar-btn-lang-${langCode}`);
                if (sBtn) {
                    sBtn.className = langCode === l 
                        ? 'py-1.5 px-2 rounded-xl border text-xs font-bold transition flex items-center justify-center gap-1 bg-indigo-600/35 border-l-4 border-l-indigo-400 border-indigo-500/40 text-white shadow-sm'
                        : 'py-1.5 px-2 rounded-xl border border-transparent text-xs font-medium transition flex items-center justify-center gap-1 text-slate-300 hover:bg-white/10 hover:text-white';
                }
            });

            // Re-render subject selector to update language of labels
            renderSubjectSelectors();
            if (window.instrumentEditor && window.instrumentEditor.renderReviewSequenceList) {
                window.instrumentEditor.renderReviewSequenceList();
                window.instrumentEditor.renderEditorAccess();
            }
            updateBadges();
            updateUI();
        }

        // Los botones de idioma cambian el idioma de toda la app (/js/lang.js); esta vista se
        // redibuja al recibir el aviso, salvo que ya esté en ese idioma.
        document.addEventListener('langchange', (e) => {
            const lang = e.detail && e.detail.lang;
            if (lang && lang !== currentLang) changeLang(lang);
        });

        function changeSubject(subId) {
            currentSubject = subId;
            window.currentSubject = subId;
            renderSubjectSelectors();
            if (window.instrumentEditor && window.instrumentEditor.loadReviewSequence) {
                window.instrumentEditor.loadReviewSequence();
                window.instrumentEditor.renderEditorAccess();
            }
            updateBadges();
            updateUI();
        }

        function selectRetoFilter(reto) {
            window.currentSelectedReto = reto;

            [0, 1, 2, 3, 4, 5, 6].forEach(r => {
                const btn = document.getElementById(`btn-reto-${r}`);
                if (!btn) return;

                const isActive = (r === reto);
                if (isActive) {
                    btn.className = "btn-reto-filter w-full px-3 py-2 rounded-lg border transition-all flex items-center justify-between bg-indigo-600/35 border-l-4 border-l-indigo-400 border-indigo-500/40 text-white font-bold text-xs shadow-md shadow-indigo-950/40";
                } else {
                    btn.className = "btn-reto-filter w-full px-3 py-2 rounded-lg border border-transparent text-xs font-medium transition-all flex items-center justify-between text-slate-300 hover:bg-white/10 hover:text-white";
                }
            });

            updateBadges();
            updateUI();
        }

        function printPDF() {
            const g = currentGrade !== null ? currentGrade : 5;
            window.open(`/teacher/download-challenges?level=${g}&lang=${currentLang}&subject=${encodeURIComponent(currentSubject)}`, '_blank');
        }

        function updateUI() {
            const selReto = window.currentSelectedReto;

            // Render challenges cards based on filter
            const container = document.getElementById('challengesContainer');
            container.innerHTML = '';

            if (selReto === null) {
                container.innerHTML = `
                    <div class="bg-white p-8 rounded-2xl border border-slate-200 text-center space-y-3 shadow-sm max-w-2xl mx-auto">
                        <span class="text-4xl">🎯</span>
                        <h4 class="font-extrabold text-slate-700 text-lg">${window.t('doc_prev_js_ningun_reto')}</h4>
                        <p class="text-xs text-slate-500 max-w-md mx-auto">${window.t('doc_prev_js_ningun_reto_ayuda')}</p>
                    </div>
                `;
                return;
            }

            // Prekínder a K2: estas preguntas se ven en el Medienpass visual
            if (currentGrade === 2) {
                const notice = document.createElement('div');
                notice.className = 'flex flex-wrap items-center justify-between gap-3 p-4 mb-4 rounded-2xl bg-amber-50 border border-amber-200 text-sm font-semibold text-amber-900 no-print';
                const noticeText = document.createElement('span');
                noticeText.textContent = window.t('doc_prev_visual_aviso');
                const noticeLink = document.createElement('a');
                noticeLink.id = 'visualPreviewLink';
                noticeLink.className = 'px-4 py-2 rounded-xl bg-amber-600 text-white font-bold no-underline';
                noticeLink.href = `/teacher/visual-preview?subject=${encodeURIComponent(currentSubject)}&reto=${selReto}`;
                noticeLink.textContent = window.t('doc_prev_visual_boton');
                notice.append(noticeText, noticeLink);
                container.appendChild(notice);
            }

            if (selReto === 0) {
                const profileCard = createProfileCard();
                container.appendChild(profileCard);
            } else if (selReto >= 1 && selReto <= 6) {
                const retoCard = createRetoCard(selReto);
                container.appendChild(retoCard);
            }
        }

        function getLangText(obj) {
            if (!obj) return '';
            if (typeof obj === 'string') return obj;
            if (typeof obj === 'object') {
                if (obj[currentLang]) return obj[currentLang];
                if (currentLang === 'es' && obj.es) return obj.es;
                if (currentLang === 'de' && obj.de) return obj.de;
                if (currentLang === 'en' && obj.en) return obj.en;
                return obj.es || obj.de || obj.en || '';
            }
            return String(obj);
        }

        function createProfileCard() {
            const card = document.createElement('div');
            card.className = 'legal-page-card animate-fade-in space-y-6';

            const currentLangState = (window.reviewSequenceState && window.reviewSequenceState[currentLang]) ? window.reviewSequenceState[currentLang] : {};
            const isReviewed = !!currentLangState[0];

            const reto0Title = currentLang === 'de' ? 'Herausforderung 0 - Das bin ich' : currentLang === 'en' ? 'Challenge 0 - This is me' : 'Reto 0 - Este soy yo';
            const reto0Sub = currentLang === 'de' ? 'Diagnose & Profil (Einführung)' : currentLang === 'en' ? 'Diagnosis & Profile (Intro)' : 'Diagnóstico y Perfil (Introducción)';
            const reto0Badge = currentLang === 'de' ? 'Einführung / Diagnose' : currentLang === 'en' ? 'Intro / Diagnosis' : 'Intro / Diagnóstico';

            // Top Official Legal Header Line
            const topMetaLine = document.createElement('div');
            topMetaLine.className = 'flex items-center justify-between text-[10px] text-slate-400 border-b border-slate-200 pb-2 font-mono tracking-wider';
            topMetaLine.innerHTML = `
                <span>${window.t('doc_prev_js_documento_oficial')}</span>
                <span>${window.t('doc_prev_js_reto').toUpperCase()} 0</span>
            `;
            card.appendChild(topMetaLine);

            // Card Header
            const activeProfile = (reto0BySubject && reto0BySubject[currentSubject]) || sharedProfile;
            const profileIcon = activeProfile.icon || '👤';
            const profileTitle = getLangText(activeProfile.title) || reto0Title;
            const profileSub = getLangText(activeProfile.subtitle) || reto0Sub;

            const header = document.createElement('div');
            header.className = 'flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-5';
            header.innerHTML = `
                <div class="flex items-center space-x-4">
                    <div class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-3xl shadow-inner">
                        ${profileIcon}
                    </div>
                    <div>
                        <h4 class="font-extrabold text-slate-800 text-xl leading-snug">
                            ${profileTitle}
                        </h4>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-0.5">
                            ${profileSub}
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-3 no-print">
                    <button onclick="window.instrumentEditor.toggleRetoReviewStatus(0)" 
                            class="px-3.5 py-1.5 rounded-xl text-xs font-extrabold transition border flex items-center gap-1.5 ${isReviewed ? 'bg-emerald-100 text-emerald-800 border-emerald-300 shadow-sm' : 'bg-amber-50 text-amber-800 border-amber-300 hover:bg-amber-100'}">
                        ${isReviewed ? window.t('doc_prev_js_revisado') : window.t('doc_prev_js_pendiente_revision')}
                    </button>
                    <span class="text-[10px] font-extrabold bg-blue-100 text-blue-800 border border-blue-200 px-2.5 py-1 rounded-lg uppercase tracking-wider">
                        ${reto0Badge}
                    </span>
                </div>
            `;
            card.appendChild(header);

            // Questions list
            const qList = document.createElement('div');
            qList.className = 'space-y-5';

            // Preguntas 1 a 9 (datos y preguntas abiertas): fijas. Desde la 10 (la evaluación) se
            // editan en K3-K12, como los retos 1 a 6; en el Medienpass visual se muestran sin editar.
            const editReto0 = currentGrade !== null && currentGrade >= 3;
            const profileEvidence = (activeProfile.evidence && activeProfile.evidence.length > 0) ? activeProfile.evidence : (sharedProfile.evidence || []);
            const fixedEvidence = editReto0 ? profileEvidence.filter(q => !q.quiz) : profileEvidence;
            fixedEvidence.forEach((q, idx) => {
                const label = getLangText(q.label);
                const questionDiv = document.createElement('div');
                
                if (q.type === 'label') {
                    questionDiv.className = 'border-b border-slate-200 pb-2 mt-6 mb-3';
                    questionDiv.innerHTML = `<h5 class="text-sm font-extrabold text-slate-800 uppercase tracking-wider">${label}</h5>`;
                } else {
                    questionDiv.className = 'space-y-2';
                    
                    let inputField = '';
                    if (q.type === 'textarea') {
                        inputField = `<textarea disabled placeholder="${inputPlaceholders[currentLang] || inputPlaceholders.es}" rows="2" class="w-full px-4 py-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-400 text-sm resize-none select-none"></textarea>`;
                    } else if (q.options && q.options.length > 0) {
                        let optionsHtml = '<div class="space-y-2 mt-2">';
                        q.options.forEach(opt => {
                            const optText = getLangText(opt);
                            optionsHtml += `
                                <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 bg-white cursor-not-allowed hover:bg-slate-50 transition text-sm text-slate-600 font-medium select-none">
                                    <input type="radio" disabled name="sim_${q.id}" class="w-4 h-4 text-blue-600 border-slate-300 focus:ring-blue-500">
                                    <span>${optText}</span>
                                </label>
                            `;
                        });
                        optionsHtml += '</div>';
                        inputField = optionsHtml;
                    } else {
                        inputField = `<input type="text" disabled placeholder="${inputPlaceholders[currentLang] || inputPlaceholders.es}" class="w-full px-4 py-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-400 text-sm select-none">`;
                    }

                    questionDiv.innerHTML = `
                        <div class="text-sm font-bold text-slate-700 flex items-start gap-2">
                            <span class="w-5 h-5 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0 text-xs mt-0.5 font-extrabold">${idx+1}</span>
                            <span>${label}</span>
                        </div>
                        ${inputField}
                    `;
                }
                qList.appendChild(questionDiv);
            });

            card.appendChild(qList);

            if (editReto0) card.appendChild(createReto0Editor());

            // Legal Footer
            const footer = document.createElement('div');
            footer.className = 'pt-6 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-400 font-medium font-mono';
            footer.innerHTML = `
                <span>Colegio Alemán Barranquilla — MedienPass</span>
                <span>${window.t('doc_prev_js_hoja_legal')}</span>
            `;
            card.appendChild(footer);

            return card;
        }

        // Evaluación del Reto 0 (desde la pregunta 10): tarjetas editables, como en los retos 1 a 6.
        // Las preguntas se piden al servidor (versión editada o del sistema) la primera vez.
        function createReto0Editor() {
            const editor = window.instrumentEditor;
            const state = editor.getEditorState(0);
            if (!state) editor.ensureInstrumentLoaded(0);
            const box = document.createElement('div');
            box.className = 'space-y-6 pt-4 border-t-4 border-amber-300';
            if (!state || state.status === 'loading') {
                box.innerHTML = `<p class="text-slate-500 text-sm text-center py-6"><i class="fa-solid fa-spinner animate-spin"></i> ${window.t('doc_inst_js_cargando')}</p>`;
                return box;
            }
            if (state.status === 'error') {
                box.innerHTML = `
                    <div class="text-center py-6 space-y-3">
                        <p class="text-rose-600 text-sm font-semibold">${window.t('doc_inst_js_error_carga')}</p>
                        <button onclick="window.instrumentEditor.ensureInstrumentLoaded(0)" class="px-4 py-2 bg-slate-800 text-white text-xs font-bold rounded-lg"><i class="fa-solid fa-rotate-right"></i> ${window.t('doc_inst_js_reintentar')}</button>
                    </div>`;
                return box;
            }
            box.insertAdjacentHTML('beforeend', editor.renderCompetenceHeader(0));
            state.questions.forEach((q, idx) => box.insertAdjacentHTML('beforeend', editor.renderEditableQuestionCard(q, 0, idx)));
            const canSave = editorAccess.anySubject || editorAccess.subject === currentSubject;
            box.insertAdjacentHTML('beforeend', `
                <div class="flex flex-wrap items-center justify-end gap-2 no-print">
                    <button onclick="addNewQuestionToEditor()" class="px-4 py-2 bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 rounded-lg text-xs font-bold flex items-center gap-2"><i class="fa-solid fa-plus"></i> ${window.t('doc_inst_anadir_pregunta')}</button>
                    <button onclick="saveCustomInstrumentToServer()" ${canSave ? '' : 'disabled title="' + window.t('doc_inst_js_err_forbidden').replace(/"/g, '&quot;') + '"'} class="editor-save-bottom px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-lg text-xs font-extrabold flex items-center gap-2 shadow ${canSave ? '' : 'opacity-50 cursor-not-allowed'}"><i class="fa-solid fa-floppy-disk"></i> ${window.t('doc_inst_guardar_cambios')}</button>
                </div>`);
            return box;
        }

        // Reto 1-6 (solo modo editable): la competencia KMK del reto arriba y una tarjeta editable por
        // pregunta. Las preguntas se piden al servidor (versión editada o del sistema) la primera vez
        // que se abre ese grado, materia y reto.
        function createRetoCard(retoNum) {
            const acts = allActivities[String(retoNum)] || [];
            const activeAct = acts.find(a => a.subject === currentSubject) || acts[0] || {};
            const editor = window.instrumentEditor;
            const state = editor.getEditorState(retoNum);
            if (!state) editor.ensureInstrumentLoaded(retoNum);

            const card = document.createElement('div');
            card.className = `legal-page-card animate-fade-in space-y-6 border-t-4`;
            card.style.borderTopColor = activeAct.color || '#3b82f6';

            const title = getLangText(activeAct.title);
            const subtitle = getLangText(activeAct.subtitle);

            const currentLangState = (window.reviewSequenceState && window.reviewSequenceState[currentLang]) ? window.reviewSequenceState[currentLang] : {};
            const isReviewed = !!currentLangState[retoNum];

            // Top Official Legal Header Line
            const topMetaLine = document.createElement('div');
            topMetaLine.className = 'flex items-center justify-between text-[10px] text-slate-400 border-b border-slate-200 pb-2 font-mono tracking-wider';
            topMetaLine.innerHTML = `
                <span>${window.t('doc_prev_js_documento_oficial')}</span>
                <span>${window.t('doc_prev_js_reto').toUpperCase()} ${retoNum}</span>
            `;
            card.appendChild(topMetaLine);

            // Card Header
            const header = document.createElement('div');
            header.className = 'flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-5';
            header.innerHTML = `
                <div class="flex items-center space-x-4">
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-inner bg-slate-100" style="color: ${activeAct.color}">
                        ${activeAct.icon || '🎯'}
                    </div>
                    <div>
                        <h4 class="font-extrabold text-slate-800 text-xl leading-snug">
                            ${title}
                        </h4>
                        <p class="text-xs text-slate-500 font-bold mt-0.5 leading-snug">
                            ${subtitle}
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-3 no-print">
                    <button onclick="window.instrumentEditor.toggleRetoReviewStatus(${retoNum})"
                            class="px-3.5 py-1.5 rounded-xl text-xs font-extrabold transition border flex items-center gap-1.5 ${isReviewed ? 'bg-emerald-100 text-emerald-800 border-emerald-300 shadow-sm' : 'bg-amber-50 text-amber-800 border-amber-300 hover:bg-amber-100'}">
                        ${isReviewed ? window.t('doc_prev_js_revisado') : window.t('doc_prev_js_pendiente_revision')}
                    </button>
                    <span class="text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300">
                        ✏️ ${window.t('doc_inst_editable')}
                    </span>
                    <div class="text-xs bg-slate-100 text-slate-700 font-extrabold px-3 py-1 rounded-lg border border-slate-200">
                        ${window.t('doc_prev_js_reto')} ${retoNum}
                    </div>
                </div>
            `;
            card.appendChild(header);

            // Questions list
            const qList = document.createElement('div');
            qList.className = 'space-y-6';

            if (!state || state.status === 'loading') {
                qList.innerHTML = `<p class="text-slate-500 text-sm text-center py-6"><i class="fa-solid fa-spinner animate-spin"></i> ${window.t('doc_inst_js_cargando')}</p>`;
            } else if (state.status === 'error') {
                qList.innerHTML = `
                    <div class="text-center py-6 space-y-3">
                        <p class="text-rose-600 text-sm font-semibold">${window.t('doc_inst_js_error_carga')}</p>
                        <button onclick="window.instrumentEditor.ensureInstrumentLoaded(${retoNum})" class="px-4 py-2 bg-slate-800 text-white text-xs font-bold rounded-lg"><i class="fa-solid fa-rotate-right"></i> ${window.t('doc_inst_js_reintentar')}</button>
                    </div>`;
            } else {
                qList.insertAdjacentHTML('beforeend', editor.renderCompetenceHeader(retoNum));
                if (state.questions.length === 0) {
                    qList.insertAdjacentHTML('beforeend', `<p class="text-slate-400 italic text-sm text-center py-4">${window.t('doc_prog_js_sin_config')}</p>`);
                }
                state.questions.forEach((q, idx) => {
                    qList.insertAdjacentHTML('beforeend', editor.renderEditableQuestionCard(q, retoNum, idx));
                });
                // Acciones también al final de la hoja (las mismas de la barra lateral)
                const canSave = editorAccess.anySubject || editorAccess.subject === currentSubject;
                qList.insertAdjacentHTML('beforeend', `
                    <div class="flex flex-wrap items-center justify-end gap-2 no-print">
                        <button onclick="addNewQuestionToEditor()" class="px-4 py-2 bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 rounded-lg text-xs font-bold flex items-center gap-2"><i class="fa-solid fa-plus"></i> ${window.t('doc_inst_anadir_pregunta')}</button>
                        <button onclick="saveCustomInstrumentToServer()" ${canSave ? '' : 'disabled title="' + window.t('doc_inst_js_err_forbidden').replace(/"/g, '&quot;') + '"'} class="editor-save-bottom px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-lg text-xs font-extrabold flex items-center gap-2 shadow ${canSave ? '' : 'opacity-50 cursor-not-allowed'}"><i class="fa-solid fa-floppy-disk"></i> ${window.t('doc_inst_guardar_cambios')}</button>
                    </div>`);
            }

            card.appendChild(qList);

            // Legal Footer
            const footer = document.createElement('div');
            footer.className = 'pt-6 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-400 font-medium font-mono';
            footer.innerHTML = `
                <span>Colegio Alemán Barranquilla — MedienPass</span>
                <span>${window.t('doc_prev_js_hoja_legal')}</span>
            `;
            card.appendChild(footer);

            return card;
        }

        async function saveAgentTools(retoNum) {
            const textarea = document.getElementById(`agent-desc-${retoNum}`);
            const btn = document.getElementById(`btn-save-agent-${retoNum}`);
            const desc = textarea.value.trim();

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> ...`;

            try {
                const response = await fetch('/api/teacher/challenge-tools', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        grade: currentGrade || 5,
                        subject: currentSubject,
                        challenge: retoNum,
                        description: desc
                    })
                });
                const result = await response.json();
                if (result.success) {
                    const key = `${currentGrade || 5}_${currentSubject}_${retoNum}`;
                    challengeToolsConfig[key] = desc;

                    btn.className = "px-4 py-1.5 bg-green-600 text-white font-bold rounded-lg text-xs transition flex items-center gap-1.5 shadow-sm";
                    btn.innerHTML = `<i class="fa-solid fa-circle-check"></i> OK`;
                    
                    setTimeout(() => {
                        btn.className = "px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg text-xs transition flex items-center gap-1.5 shadow-sm";
                        btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> Guardar`;
                        btn.disabled = false;
                    }, 2000);
                } else {
                    alert(window.t('doc_prev_error_al_guardar_la_configuracion') + (result.error || 'Intente de nuevo.'));
                    btn.disabled = false;
                    btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> Guardar`;
                }
            } catch (e) {
                console.error(e);
                alert(window.t('doc_prev_error_al_conectar_con_el_servidor'));
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> Guardar`;
            }
        }
    </script>
<%- include('../partials/help-button') %>
</body>
</html>
