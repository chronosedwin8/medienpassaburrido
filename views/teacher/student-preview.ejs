<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Previsualización de Retos (Modo Estudiante) - Medienpass</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #f8fafc;
            background-image: 
                radial-gradient(at 0% 0%, rgba(241,245,249,1) 0, transparent 50%), 
                radial-gradient(at 50% 0%, rgba(224,231,255,0.4) 0, transparent 50%),
                radial-gradient(at 100% 0%, rgba(243,232,255,0.4) 0, transparent 50%);
            background-attachment: fixed;
        }

        .glass-header {
            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Legal Sheet Page Styling (8.5" x 14" aspect feel) */
        .legal-page-card {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
            border-radius: 1rem;
            padding: 2.5rem;
            min-height: 1050px;
            width: 100%;
            max-width: 820px;
            margin: 0 auto;
            position: relative;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .legal-page-card:hover {
            box-shadow: 0 25px 30px -5px rgba(0, 0, 0, 0.12), 0 10px 12px -5px rgba(0, 0, 0, 0.06);
            border-color: #94a3b8;
        }

        /* High Contrast Clear Scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }
        ::-webkit-scrollbar-track {
            background: #e2e8f0;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 9999px;
            border: 2px solid #e2e8f0;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #1e293b;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            animation: fadeIn 0.4s ease-out forwards;
        }

        /* Legal Print Styles */
        @media print {
            @page {
                size: legal portrait;
                margin: 12mm;
            }
            body {
                background: #ffffff !important;
                background-image: none !important;
            }
            .glass-header, #instrumentsSidebar, .no-print, header, nav {
                display: none !important;
            }
            main {
                max-width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .legal-page-card {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                min-height: auto !important;
                max-width: 100% !important;
                page-break-after: always !important;
                break-after: page !important;
            }
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 antialiased pb-12">

    <!-- Top Glass Header -->
    <header class="glass-header sticky top-0 z-40 w-full px-6 py-4 shadow-xl no-print">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
                    <i class="fa-solid fa-graduation-cap text-lg"></i>
                </div>
                <div>
                    <h1 class="text-lg md:text-xl font-extrabold text-white tracking-tight flex items-center gap-2">
                        <span>Portal Docente</span>
                        <span class="text-xs bg-indigo-500/30 text-indigo-300 font-semibold px-2 py-0.5 rounded-full border border-indigo-400/20 uppercase tracking-wider">Modo Estudiante</span>
                    </h1>
                    <p class="text-xs text-slate-400 font-medium">Previsualización interactiva de Retos por grado y competencias KMK</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="/teacher/progress" class="px-4 py-2 text-sm font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700/80 rounded-xl transition border border-slate-700/60 flex items-center gap-2">
                    <i class="fa-solid fa-chevron-left text-xs"></i> Volver a Monitoreo
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 md:px-6 mt-8 space-y-8">
        
        <!-- Main Layout with Sidebar and Preview Grid -->
        <div class="flex flex-col lg:flex-row gap-8 items-start">
            <!-- Menú Lateral Estilo Acordeón -->
            <%- include('../partials/instruments-sidebar') %>

            <!-- Preview Section -->
            <section class="flex-1 space-y-6 w-full">
                <!-- Legal Page Size Cards Container -->
                <div class="space-y-10" id="challengesContainer">
                    <!-- Filled dynamically by JS -->
                </div>
            </section>
        </div>

    </main>

    <!-- Instrument Editor Logic -->
    <script src="/js/instrument-editor.js"></script>

    <!-- JS Logic -->
    <script>
        const allActivities = <%- JSON.stringify(allActivities) %>;
        const sharedProfile = <%- JSON.stringify(sharedProfile) %>;
        const subjects = <%- JSON.stringify(subjects) %>;
        const challengeToolsConfig = <%- JSON.stringify(challengeToolsConfig || {}) %>;
        const defaultAgentTools = <%- JSON.stringify(defaultAgentTools || {}) %>;
        const teacherData = <%- JSON.stringify(typeof teacher !== 'undefined' ? teacher : null) %>;
        
        // Current simulation state
        let currentGrade = 5;
        let currentLang = 'es';
        let rawSub = (teacherData && teacherData.subject) ? teacherData.subject.toLowerCase() : 'aleman';
        if (rawSub.includes('aleman') || rawSub.includes('deutsch')) rawSub = 'aleman';
        else if (rawSub.includes('ingles') || rawSub.includes('english')) rawSub = 'english';
        else if (rawSub.includes('tecno')) rawSub = 'tecnologia';
        let currentSubject = rawSub;

        // Default selected reto is Reto 0
        window.currentSelectedReto = 0;

        const gradeLevels = {
            2: { title: "Klasse 2", desc: "Básico" },
            3: { title: "Klasse 3", desc: "Básico + 1" },
            4: { title: "Klasse 4", desc: "Intermedio" },
            5: { title: "Klasse 5", desc: "Intermedio + 1" },
            6: { title: "Klasse 6", desc: "Avanzado" },
            7: { title: "Klasse 7", desc: "Avanzado + 1" },
            8: { title: "Klasse 8", desc: "Avanzado + 2" },
            9: { title: "Klasse 9", desc: "Avanzado + 3" },
            10: { title: "Klasse 10", desc: "Avanzado + 4" },
            11: { title: "Klasse 11", desc: "Avanzado + 5" },
            12: { title: "Klasse 12", desc: "Avanzado + 6" }
        };

        const kmkCompetencies = {
            es: [
                "1. Búsqueda y Procesamiento de Información",
                "2. Comunicación y Cooperación",
                "3. Producción y Presentación",
                "4. Protección y Seguridad",
                "5. Resolución de Problemas y Acción",
                "6. Análisis y Reflexión"
            ],
            de: [
                "1. Suchen, Verarbeiten und Aufbewahren",
                "2. Kommunizieren und Kooperieren",
                "3. Produzieren und Präsentieren",
                "4. Schützen und Sicher Agieren",
                "5. Problemlösen und Handeln",
                "6. Analysieren und Reflektieren"
            ],
            en: [
                "1. Search, Process, and Store",
                "2. Communicate and Cooperate",
                "3. Produce and Present",
                "4. Protect and Act Safely",
                "5. Problem Solving and Action",
                "6. Analyze and Reflect"
            ]
        };

        const inputPlaceholders = {
            es: "Respuesta simulada del estudiante...",
            de: "Simulierte Schülerantwort...",
            en: "Simulated student response..."
        };

        // Render selectors on startup
        window.addEventListener('DOMContentLoaded', () => {
            window.currentGrade = currentGrade;
            window.currentLang = currentLang;
            window.currentSubject = currentSubject;

            if (window.instrumentEditor && window.instrumentEditor.loadReviewSequence) {
                window.instrumentEditor.loadReviewSequence();
            }

            renderSubjectSelectors();
            selectRetoFilter(0);
            updateBadges();
            updateUI();
        });

        function updateBadges() {
            // Grade badge
            const gradeLabel = document.getElementById('sidebarGradeActiveLabel');
            if (gradeLabel) {
                gradeLabel.innerText = currentGrade !== null ? `Klasse ${currentGrade}` : 'Sin Seleccionar';
            }

            // Lang badge
            const langLabel = document.getElementById('sidebarLangActiveLabel');
            if (langLabel) {
                langLabel.innerText = currentLang.toUpperCase();
            }

            // Subject badge
            const subLabel = document.getElementById('sidebarSubjectActiveLabel');
            if (subLabel) {
                const found = subjects.find(s => s.id === currentSubject);
                const subName = found ? (found.name[currentLang] || found.name.es) : 'Sin Seleccionar';
                subLabel.innerText = subName;
            }

            // Mode badge
            const modeLabel = document.getElementById('sidebarModeActiveLabel');
            if (modeLabel) {
                const mode = window.currentInstrumentMode;
                modeLabel.innerText = mode === 'auto' ? 'AUTOMÁTICA' : mode === 'editable' ? 'EDITABLE' : mode === 'ai' ? 'IA' : 'SIN SELECCIONAR';
            }

            // Reto badge
            const retoLabel = document.getElementById('sidebarRetoActiveLabel');
            if (retoLabel) {
                const r = window.currentSelectedReto;
                retoLabel.innerText = (r !== null && r !== undefined) ? (r === 0 ? 'Reto 0 (Intro)' : `Reto ${r}`) : 'Sin Seleccionar';
            }
        }

        function renderSubjectSelectors() {
            const sidebarContainer = document.getElementById('sidebarSubjectSelector');
            if (sidebarContainer) sidebarContainer.innerHTML = '';
            
            // Filter subjects that have activities
            const activeSubjects = subjects.filter(sub => {
                const hasAct = Object.values(allActivities).some(acts => 
                    acts.some(a => a.subject === sub.id)
                ) || (sub.id === 'tecnologia');
                return hasAct;
            });

            activeSubjects.forEach(sub => {
                const isActive = sub.id === currentSubject;
                
                if (sidebarContainer) {
                    const sBtn = document.createElement('button');
                    sBtn.className = `w-full px-3 py-2 rounded-lg border transition-all flex items-center gap-2.5 text-xs ${
                        isActive 
                        ? 'bg-indigo-600/35 border-l-4 border-l-indigo-400 border-indigo-500/40 text-white font-bold shadow-sm' 
                        : 'border-transparent text-slate-300 hover:bg-white/10 hover:text-white font-medium'
                    }`;
                    sBtn.onclick = () => {
                        changeSubject(sub.id);
                        if (typeof collapseSidebarAccordion === 'function') collapseSidebarAccordion('acc-asignatura');
                    };
                    sBtn.innerHTML = `<span class="text-sm">${sub.icon}</span> <span>${sub.name[currentLang] || sub.name.es}</span>`;
                    sidebarContainer.appendChild(sBtn);
                }
            });
        }

        function changeGrade(g) {
            currentGrade = g;
            window.currentGrade = g;
            
            const sidebarGradeSelect = document.getElementById('sidebarGradeSelect');
            if (sidebarGradeSelect) {
                sidebarGradeSelect.value = g !== null ? String(g) : "";
            }
            if (window.instrumentEditor && window.instrumentEditor.loadReviewSequence) {
                window.instrumentEditor.loadReviewSequence();
            }
            updateBadges();
            updateUI();
        }

        function changeLang(l) {
            currentLang = l;
            window.currentLang = l;
            
            // Highlight active button in sidebar
            ['es', 'de', 'en'].forEach(langCode => {
                const sBtn = document.getElementById(`sidebar-btn-lang-${langCode}`);
                if (sBtn) {
                    sBtn.className = langCode === l 
                        ? 'py-1.5 px-2 rounded-xl border text-xs font-bold transition flex items-center justify-center gap-1 bg-indigo-600/35 border-l-4 border-l-indigo-400 border-indigo-500/40 text-white shadow-sm'
                        : 'py-1.5 px-2 rounded-xl border border-transparent text-xs font-medium transition flex items-center justify-center gap-1 text-slate-300 hover:bg-white/10 hover:text-white';
                }
            });

            // Re-render subject selector to update language of labels
            renderSubjectSelectors();
            if (window.instrumentEditor && window.instrumentEditor.renderReviewSequenceList) {
                window.instrumentEditor.renderReviewSequenceList();
            }
            updateBadges();
            updateUI();
        }

        function changeSubject(subId) {
            currentSubject = subId;
            window.currentSubject = subId;
            renderSubjectSelectors();
            if (window.instrumentEditor && window.instrumentEditor.loadReviewSequence) {
                window.instrumentEditor.loadReviewSequence();
            }
            updateBadges();
            updateUI();
        }

        function selectRetoFilter(reto) {
            window.currentSelectedReto = reto;

            [0, 1, 2, 3, 4, 5, 6].forEach(r => {
                const btn = document.getElementById(`btn-reto-${r}`);
                if (!btn) return;

                const isActive = (r === reto);
                if (isActive) {
                    btn.className = "btn-reto-filter w-full px-3 py-2 rounded-lg border transition-all flex items-center justify-between bg-indigo-600/35 border-l-4 border-l-indigo-400 border-indigo-500/40 text-white font-bold text-xs shadow-md shadow-indigo-950/40";
                } else {
                    btn.className = "btn-reto-filter w-full px-3 py-2 rounded-lg border border-transparent text-xs font-medium transition-all flex items-center justify-between text-slate-300 hover:bg-white/10 hover:text-white";
                }
            });

            updateBadges();
            updateUI();
        }

        function printPDF() {
            const g = currentGrade !== null ? currentGrade : 5;
            window.open(`/teacher/download-challenges?level=${g}&lang=${currentLang}`, '_blank');
        }

        function updateUI() {
            const selReto = window.currentSelectedReto;

            // Render challenges cards based on filter
            const container = document.getElementById('challengesContainer');
            container.innerHTML = '';

            if (selReto === null) {
                container.innerHTML = `
                    <div class="bg-white p-8 rounded-2xl border border-slate-200 text-center space-y-3 shadow-sm max-w-2xl mx-auto">
                        <span class="text-4xl">🎯</span>
                        <h4 class="font-extrabold text-slate-700 text-lg">Ningún reto seleccionado</h4>
                        <p class="text-xs text-slate-500 max-w-md mx-auto">Selecciona un reto del 0 al 6 en la sección 5 del menú lateral para visualizar la hoja tamaño Legal.</p>
                    </div>
                `;
                return;
            }

            if (selReto === 0) {
                const profileCard = createProfileCard();
                container.appendChild(profileCard);
            } else if (selReto >= 1 && selReto <= 6) {
                const retoCard = createRetoCard(selReto);
                container.appendChild(retoCard);
            }
        }

        function getLangText(obj) {
            if (!obj) return '';
            if (typeof obj === 'string') return obj;
            if (typeof obj === 'object') {
                if (obj[currentLang]) return obj[currentLang];
                if (currentLang === 'es' && obj.es) return obj.es;
                if (currentLang === 'de' && obj.de) return obj.de;
                if (currentLang === 'en' && obj.en) return obj.en;
                return obj.es || obj.de || obj.en || '';
            }
            return String(obj);
        }

        function createProfileCard() {
            const card = document.createElement('div');
            card.className = 'legal-page-card animate-fade-in space-y-6';

            const currentLangState = (window.reviewSequenceState && window.reviewSequenceState[currentLang]) ? window.reviewSequenceState[currentLang] : {};
            const isReviewed = !!currentLangState[0];

            const reto0Title = currentLang === 'de' ? 'Herausforderung 0 - Das bin ich' : currentLang === 'en' ? 'Challenge 0 - This is me' : 'Reto 0 - Este soy yo';
            const reto0Sub = currentLang === 'de' ? 'Diagnose & Profil (Einführung)' : currentLang === 'en' ? 'Diagnosis & Profile (Intro)' : 'Diagnóstico y Perfil (Introducción)';
            const reto0Badge = currentLang === 'de' ? 'Einführung / Diagnose' : currentLang === 'en' ? 'Intro / Diagnosis' : 'Intro / Diagnóstico';

            // Top Official Legal Header Line
            const topMetaLine = document.createElement('div');
            topMetaLine.className = 'flex items-center justify-between text-[10px] text-slate-400 border-b border-slate-200 pb-2 font-mono tracking-wider';
            topMetaLine.innerHTML = `
                <span>MEDIENPASS — DOCUMENTO OFICIAL DE REVISIÓN (FORMATO LEGAL 8.5" x 14")</span>
                <span>RETO 0</span>
            `;
            card.appendChild(topMetaLine);

            // Card Header
            const header = document.createElement('div');
            header.className = 'flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-5';
            header.innerHTML = `
                <div class="flex items-center space-x-4">
                    <div class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-3xl shadow-inner">
                        👤
                    </div>
                    <div>
                        <h4 class="font-extrabold text-slate-800 text-xl leading-snug">
                            ${reto0Title}
                        </h4>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-0.5">
                            ${reto0Sub}
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-3 no-print">
                    <button onclick="window.instrumentEditor.toggleRetoReviewStatus(0)" 
                            class="px-3.5 py-1.5 rounded-xl text-xs font-extrabold transition border flex items-center gap-1.5 ${isReviewed ? 'bg-emerald-100 text-emerald-800 border-emerald-300 shadow-sm' : 'bg-amber-50 text-amber-800 border-amber-300 hover:bg-amber-100'}">
                        ${isReviewed ? '✅ Revisado y Habilitado' : '⏳ Pendiente de Revisión'}
                    </button>
                    <span class="text-[10px] font-extrabold bg-blue-100 text-blue-800 border border-blue-200 px-2.5 py-1 rounded-lg uppercase tracking-wider">
                        ${reto0Badge}
                    </span>
                </div>
            `;
            card.appendChild(header);

            // Questions list
            const qList = document.createElement('div');
            qList.className = 'space-y-5';

            (sharedProfile.evidence || []).forEach((q, idx) => {
                const label = getLangText(q.label);
                const questionDiv = document.createElement('div');
                
                if (q.type === 'label') {
                    questionDiv.className = 'border-b border-slate-200 pb-2 mt-6 mb-3';
                    questionDiv.innerHTML = `<h5 class="text-sm font-extrabold text-slate-800 uppercase tracking-wider">${label}</h5>`;
                } else {
                    questionDiv.className = 'space-y-2';
                    
                    let inputField = '';
                    if (q.type === 'textarea') {
                        inputField = `<textarea disabled placeholder="${inputPlaceholders[currentLang] || inputPlaceholders.es}" rows="2" class="w-full px-4 py-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-400 text-sm resize-none select-none"></textarea>`;
                    } else if (q.options && q.options.length > 0) {
                        let optionsHtml = '<div class="space-y-2 mt-2">';
                        q.options.forEach(opt => {
                            const optText = getLangText(opt);
                            optionsHtml += `
                                <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 bg-white cursor-not-allowed hover:bg-slate-50 transition text-sm text-slate-600 font-medium select-none">
                                    <input type="radio" disabled name="sim_${q.id}" class="w-4 h-4 text-blue-600 border-slate-300 focus:ring-blue-500">
                                    <span>${optText}</span>
                                </label>
                            `;
                        });
                        optionsHtml += '</div>';
                        inputField = optionsHtml;
                    } else {
                        inputField = `<input type="text" disabled placeholder="${inputPlaceholders[currentLang] || inputPlaceholders.es}" class="w-full px-4 py-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-400 text-sm select-none">`;
                    }

                    questionDiv.innerHTML = `
                        <div class="text-sm font-bold text-slate-700 flex items-start gap-2">
                            <span class="w-5 h-5 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0 text-xs mt-0.5 font-extrabold">${idx+1}</span>
                            <span>${label}</span>
                        </div>
                        ${inputField}
                    `;
                }
                qList.appendChild(questionDiv);
            });

            card.appendChild(qList);

            // Legal Footer
            const footer = document.createElement('div');
            footer.className = 'pt-6 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-400 font-medium font-mono';
            footer.innerHTML = `
                <span>Colegio Alemán Barranquilla — MedienPass</span>
                <span>Hoja Tamaño Legal (216mm x 356mm)</span>
            `;
            card.appendChild(footer);

            return card;
        }

        function createRetoCard(retoNum) {
            const effectiveGrade = currentGrade !== null ? currentGrade : 5;

            // Find activity from allActivities list based on currentSubject
            const acts = allActivities[String(retoNum)] || [];
            const activeAct = acts.find(a => a.subject === currentSubject) || acts[0];

            const mode = window.currentInstrumentMode || 'auto';

            // Determine question list based on mode
            let questions = [];
            if (mode === 'editable' || mode === 'ai') {
                if (!window.customQuestionsCache[retoNum] || window.customQuestionsCache[retoNum].length === 0) {
                    const evidenceKey = `evidence_k${effectiveGrade}`;
                    const baseQ = activeAct[evidenceKey] || activeAct.evidence_k5 || activeAct.evidence || [];
                    window.customQuestionsCache[retoNum] = JSON.parse(JSON.stringify(baseQ));
                }
                questions = window.customQuestionsCache[retoNum];
            } else {
                const evidenceKey = `evidence_k${effectiveGrade}`;
                questions = activeAct[evidenceKey] || activeAct.evidence_k5 || activeAct.evidence || [];
            }

            const card = document.createElement('div');
            card.className = `legal-page-card animate-fade-in space-y-6 border-t-4`;
            card.style.borderTopColor = activeAct.color || '#3b82f6';

            // Title & Subtitle
            const title = getLangText(activeAct.title);
            const subtitle = getLangText(activeAct.subtitle);

            const currentLangState = (window.reviewSequenceState && window.reviewSequenceState[currentLang]) ? window.reviewSequenceState[currentLang] : {};
            const isReviewed = !!currentLangState[retoNum];

            // Top Official Legal Header Line
            const topMetaLine = document.createElement('div');
            topMetaLine.className = 'flex items-center justify-between text-[10px] text-slate-400 border-b border-slate-200 pb-2 font-mono tracking-wider';
            topMetaLine.innerHTML = `
                <span>MEDIENPASS — DOCUMENTO OFICIAL DE REVISIÓN (FORMATO LEGAL 8.5" x 14")</span>
                <span>RETO ${retoNum}</span>
            `;
            card.appendChild(topMetaLine);

            // Card Header
            const header = document.createElement('div');
            header.className = 'flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-5';
            header.innerHTML = `
                <div class="flex items-center space-x-4">
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-inner bg-slate-100" style="color: ${activeAct.color}">
                        ${activeAct.icon || '🎯'}
                    </div>
                    <div>
                        <h4 class="font-extrabold text-slate-800 text-xl leading-snug">
                            ${title}
                        </h4>
                        <p class="text-xs text-slate-500 font-bold mt-0.5 leading-snug">
                            ${subtitle}
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-3 no-print">
                    <button onclick="window.instrumentEditor.toggleRetoReviewStatus(${retoNum})" 
                            class="px-3.5 py-1.5 rounded-xl text-xs font-extrabold transition border flex items-center gap-1.5 ${isReviewed ? 'bg-emerald-100 text-emerald-800 border-emerald-300 shadow-sm' : 'bg-amber-50 text-amber-800 border-amber-300 hover:bg-amber-100'}">
                        ${isReviewed ? '✅ Revisado y Habilitado' : '⏳ Pendiente de Revisión'}
                    </button>
                    <span class="text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase tracking-wider ${mode === 'editable' ? 'bg-amber-100 text-amber-800 border border-amber-300' : mode === 'ai' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-indigo-100 text-indigo-800 border border-indigo-200'}">
                        ${mode === 'editable' ? '✏️ Editable' : mode === 'ai' ? '🤖 IA' : '⚡ Automática'}
                    </span>
                    <div class="text-xs bg-slate-100 text-slate-700 font-extrabold px-3 py-1 rounded-lg border border-slate-200">
                        Reto ${retoNum}
                    </div>
                </div>
            `;
            card.appendChild(header);

            // Agent panel removed as requested

            // Questions list
            const qList = document.createElement('div');
            qList.className = 'space-y-6';

            if (questions.length === 0) {
                const emptyMsg = currentLang === 'de' ? 'Keine Fragen für diese Herausforderung konfiguriert.' : currentLang === 'en' ? 'No questions configured for this challenge.' : 'No hay configuración de preguntas para este reto.';
                qList.innerHTML = `<p class="text-slate-400 italic text-sm text-center py-4">${emptyMsg}</p>`;
            } else {
                // If mode === 'ai', load base questions to show original vs modified preview
                const evidenceKey = `evidence_k${effectiveGrade}`;
                const baseQuestions = activeAct[evidenceKey] || activeAct.evidence_k5 || activeAct.evidence || [];

                if (mode === 'ai') {
                    const aiBanner = document.createElement('div');
                    aiBanner.className = 'bg-emerald-50 border-2 border-emerald-300 rounded-xl p-4 text-xs text-emerald-900 font-bold flex items-center justify-between no-print shadow-sm';
                    aiBanner.innerHTML = `
                        <div class="flex items-center gap-2.5">
                            <span class="text-xl">🤖</span>
                            <div>
                                <h5 class="text-sm font-extrabold text-emerald-950">VISTA PRELIMINAR DE ADAPTACIÓN CON IA (FORMATO LEGAL)</h5>
                                <p class="text-[11px] text-emerald-800 font-medium">Se muestran las ${questions.length} preguntas del reto comparando la versión original y la versión ajustada.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="saveCustomInstrumentToServer()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs transition shadow flex items-center gap-1">
                                <i class="fa-solid fa-floppy-disk"></i> Guardar ${questions.length} Preguntas
                            </button>
                            <button onclick="undoAICustomization()" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white font-bold rounded-lg text-xs transition shadow flex items-center gap-1">
                                <i class="fa-solid fa-rotate-left"></i> Deshacer
                            </button>
                        </div>
                    `;
                    qList.appendChild(aiBanner);
                }

                questions.forEach((q, idx) => {
                    if (mode === 'editable' && window.instrumentEditor) {
                        const formCardHtml = window.instrumentEditor.renderEditableQuestionCard(q, retoNum, idx);
                        const wrapper = document.createElement('div');
                        wrapper.innerHTML = formCardHtml;
                        qList.appendChild(wrapper);
                        return;
                    }

                    const label = getLangText(q.label);
                    const hintText = getLangText(q.hint);
                    const kmkTag = (kmkCompetencies[currentLang] && kmkCompetencies[currentLang][idx]) ? kmkCompetencies[currentLang][idx] : `KMK ${idx+1}`;

                    if (mode === 'ai') {
                        // AI Dual Preview Card showing Base Question + AI Modified Question
                        const originalQ = baseQuestions[idx] || q;
                        const origLabel = getLangText(originalQ.label);

                        const questionDiv = document.createElement('div');
                        questionDiv.className = 'space-y-3 bg-emerald-50/40 border-2 border-emerald-300/80 p-4 rounded-xl shadow-sm relative animate-fade-in';

                        let inputField = '';
                        if (q.type === 'textarea') {
                            inputField = `<textarea disabled placeholder="${inputPlaceholders[currentLang] || inputPlaceholders.es}" rows="2" class="w-full px-4 py-2 rounded-xl border border-emerald-200 bg-white text-slate-500 text-sm resize-none select-none"></textarea>`;
                        } else if (q.options && q.options.length > 0) {
                            let optionsHtml = '<div class="space-y-2 mt-2">';
                            q.options.forEach(opt => {
                                const optText = getLangText(opt);
                                optionsHtml += `
                                    <label class="flex items-center gap-3 p-2.5 rounded-xl border border-emerald-200 bg-white text-xs text-slate-700 font-medium select-none">
                                        <input type="radio" disabled name="sim_ai_${q.id}" class="w-4 h-4 text-emerald-600 border-slate-300">
                                        <span>${optText}</span>
                                    </label>
                                `;
                            });
                            optionsHtml += '</div>';
                            inputField = optionsHtml;
                        } else {
                            inputField = `<input type="text" disabled placeholder="${inputPlaceholders[currentLang] || inputPlaceholders.es}" class="w-full px-4 py-2 rounded-xl border border-emerald-200 bg-white text-slate-500 text-sm select-none">`;
                        }

                        let hintBox = '';
                        if (hintText) {
                            hintBox = `
                                <div class="flex items-start gap-2 bg-emerald-100/70 border border-emerald-300/80 rounded-xl p-2.5 text-xs text-emerald-900">
                                    <span class="text-emerald-600 font-bold flex-shrink-0 mt-0.5"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                                    <div class="font-medium leading-relaxed">
                                        <strong class="font-bold text-emerald-950">Pista / Enfoque IA:</strong> ${hintText}
                                    </div>
                                </div>
                            `;
                        }

                        questionDiv.innerHTML = `
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-emerald-200/80 pb-2">
                                <div class="flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-md bg-emerald-600 text-white font-extrabold flex items-center justify-center text-xs shadow-sm">${idx+1}</span>
                                    <span class="text-xs font-extrabold text-emerald-900 uppercase tracking-wider">Pregunta ${idx+1} de ${questions.length} (Vista Preliminar IA)</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button onclick="speakQuestionText(this)" data-label="${label.replace(/"/g, '&quot;')}" data-hint="${hintText.replace(/"/g, '&quot;')}" class="px-2.5 py-1 bg-emerald-100 hover:bg-emerald-200 text-emerald-900 font-bold rounded-lg text-[10px] transition border border-emerald-300 shadow-sm flex items-center gap-1.5 no-print" title="Escuchar pregunta en voz alta">
                                        <i class="fa-solid fa-volume-high text-emerald-700"></i> Lector Inmersivo
                                    </button>
                                    <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded border border-emerald-300 flex items-center gap-1">
                                        <i class="fa-solid fa-robot text-emerald-600"></i> ${kmkTag}
                                    </span>
                                </div>
                            </div>

                            <!-- 1. Pregunta Base (Original) -->
                            <div class="bg-slate-100/90 border border-slate-200/80 rounded-lg p-2.5 space-y-1">
                                <span class="text-[10px] font-black text-slate-500 uppercase tracking-wider flex items-center gap-1">
                                    <i class="fa-solid fa-bookmark text-blue-500"></i> Pregunta Base (Original del Sistema):
                                </span>
                                <p class="text-xs text-slate-700 font-semibold pl-2">${origLabel}</p>
                            </div>

                            <!-- 2. Pregunta Modificada por IA -->
                            <div class="bg-white border border-emerald-300 rounded-lg p-3 space-y-2 shadow-sm">
                                <span class="text-[10px] font-black text-emerald-700 uppercase tracking-wider flex items-center gap-1">
                                    <i class="fa-solid fa-wand-magic-sparkles text-emerald-600"></i> Pregunta Modificada por IA (Según Prompt):
                                </span>
                                <h5 class="text-sm font-bold text-slate-900 leading-snug pl-2">${label}</h5>
                                ${inputField}
                                ${hintBox}
                            </div>
                        `;
                        qList.appendChild(questionDiv);
                        return;
                    }

                    const questionDiv = document.createElement('div');
                    questionDiv.className = 'space-y-2 border-b border-slate-100 pb-4 last:border-b-0 last:pb-0';

                    let inputField = '';
                    if (q.type === 'textarea') {
                        inputField = `<textarea disabled placeholder="${inputPlaceholders[currentLang] || inputPlaceholders.es}" rows="2" class="w-full px-4 py-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-400 text-sm resize-none select-none"></textarea>`;
                    } else if (q.options && q.options.length > 0) {
                        let optionsHtml = '<div class="space-y-2 mt-2">';
                        q.options.forEach(opt => {
                            const optText = getLangText(opt);
                            optionsHtml += `
                                <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 bg-white cursor-not-allowed hover:bg-slate-50 transition text-sm text-slate-600 font-medium select-none">
                                    <input type="radio" disabled name="sim_${q.id}" class="w-4 h-4 text-blue-600 border-slate-300 focus:ring-blue-500">
                                    <span>${optText}</span>
                                </label>
                            `;
                        });
                        optionsHtml += '</div>';
                        inputField = optionsHtml;
                    } else {
                        inputField = `<input type="text" disabled placeholder="${inputPlaceholders[currentLang] || inputPlaceholders.es}" class="w-full px-4 py-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-400 text-sm select-none">`;
                    }

                    let hintBox = '';
                    if (hintText) {
                        hintBox = `
                            <div class="flex items-start gap-2 bg-amber-50/60 border border-amber-200/80 rounded-xl p-3 text-xs text-amber-900/80">
                                <span class="text-amber-500 font-medium text-sm flex-shrink-0 mt-0.5"><i class="fa-solid fa-lightbulb"></i></span>
                                <div class="font-medium leading-relaxed">
                                    <strong class="font-bold text-amber-900">${currentLang === 'de' ? 'Hinweis:' : currentLang === 'en' ? 'Hint:' : 'Pista:'}</strong> ${hintText}
                                </div>
                            </div>
                        `;
                    }

                    questionDiv.innerHTML = `
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                            <div class="text-sm font-extrabold text-slate-800 flex items-start gap-2 max-w-[70%]">
                                <span class="w-5 h-5 rounded-md flex items-center justify-center flex-shrink-0 text-xs mt-0.5 font-black text-white" style="background: ${activeAct.color || '#3b82f6'}">${idx+1}</span>
                                <span>${label}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <button onclick="speakQuestionText(this)" data-label="${label.replace(/"/g, '&quot;')}" data-hint="${hintText.replace(/"/g, '&quot;')}" class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-lg text-[10px] transition border border-indigo-200 shadow-sm flex items-center gap-1.5 no-print" title="Escuchar pregunta en voz alta">
                                    <i class="fa-solid fa-volume-high text-indigo-600"></i> Lector Inmersivo
                                </button>
                                <span class="text-[10px] bg-slate-100 text-slate-600 font-bold px-2 py-0.5 rounded border border-slate-200 shadow-sm flex items-center gap-1.5">
                                    <i class="fa-solid fa-tag text-[8px] text-blue-500"></i> ${kmkTag}
                                </span>
                            </div>
                        </div>
                        ${inputField}
                        ${hintBox}
                    `;
                    qList.appendChild(questionDiv);
                });
            }

            card.appendChild(qList);

            // Legal Footer
            const footer = document.createElement('div');
            footer.className = 'pt-6 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-400 font-medium font-mono';
            footer.innerHTML = `
                <span>Colegio Alemán Barranquilla — MedienPass</span>
                <span>Hoja Tamaño Legal (216mm x 356mm)</span>
            `;
            card.appendChild(footer);

            return card;
        }

        async function saveAgentTools(retoNum) {
            const textarea = document.getElementById(`agent-desc-${retoNum}`);
            const btn = document.getElementById(`btn-save-agent-${retoNum}`);
            const desc = textarea.value.trim();

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> ...`;

            try {
                const response = await fetch('/api/teacher/challenge-tools', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        grade: currentGrade || 5,
                        subject: currentSubject,
                        challenge: retoNum,
                        description: desc
                    })
                });
                const result = await response.json();
                if (result.success) {
                    const key = `${currentGrade || 5}_${currentSubject}_${retoNum}`;
                    challengeToolsConfig[key] = desc;

                    btn.className = "px-4 py-1.5 bg-green-600 text-white font-bold rounded-lg text-xs transition flex items-center gap-1.5 shadow-sm";
                    btn.innerHTML = `<i class="fa-solid fa-circle-check"></i> OK`;
                    
                    setTimeout(() => {
                        btn.className = "px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg text-xs transition flex items-center gap-1.5 shadow-sm";
                        btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> Guardar`;
                        btn.disabled = false;
                    }, 2000);
                } else {
                    alert('Error al guardar la configuración: ' + (result.error || 'Intente de nuevo.'));
                    btn.disabled = false;
                    btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> Guardar`;
                }
            } catch (e) {
                console.error(e);
                alert('Error al conectar con el servidor.');
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> Guardar`;
            }
        }

        // ─── Lector Inmersivo por Voz (Speech Synthesis API) ───
        function speakQuestionText(btn) {
            if (!('speechSynthesis' in window)) {
                alert('El Lector Inmersivo por voz no está soportado en este navegador.');
                return;
            }

            const label = btn.getAttribute('data-label') || '';
            const hint = btn.getAttribute('data-hint') || '';

            window.speechSynthesis.cancel(); // Detener cualquier locución activa

            const langMap = { es: 'es-ES', de: 'de-DE', en: 'en-US' };
            const langCode = langMap[window.currentLang || 'es'] || 'es-ES';

            let textToSpeak = label;
            if (hint) {
                const hintPrefix = (window.currentLang === 'de') ? 'Hinweis: ' : (window.currentLang === 'en') ? 'Hint: ' : 'Pista: ';
                textToSpeak += `. ${hintPrefix} ${hint}`;
            }

            const utterance = new SpeechSynthesisUtterance(textToSpeak);
            utterance.lang = langCode;
            utterance.rate = 0.92; // Ritmo pedagógico pausado y claro
            utterance.pitch = 1.0;

            const origHtml = btn.innerHTML;
            btn.innerHTML = `<i class="fa-solid fa-volume-high animate-bounce text-amber-600"></i> Leyendo...`;
            btn.classList.add('bg-amber-100', 'text-amber-900', 'border-amber-400');

            utterance.onend = () => {
                btn.innerHTML = origHtml;
                btn.classList.remove('bg-amber-100', 'text-amber-900', 'border-amber-400');
            };
            utterance.onerror = () => {
                btn.innerHTML = origHtml;
                btn.classList.remove('bg-amber-100', 'text-amber-900', 'border-amber-400');
            };

            window.speechSynthesis.speak(utterance);
        }

        function stopImmersiveReader() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
            }
        }
    </script>
</body>
</html>
