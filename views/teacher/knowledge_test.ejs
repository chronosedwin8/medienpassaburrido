const subj = (teacher.subject || '').toLowerCase();
const langCode = subj === 'aleman' ? 'de' : subj === 'ingles' ? 'en' : 'es';
const l = t[langCode] || t['es'];
%>

<style>
.kmk-test-container { max-width: 800px; margin: 40px auto; padding: 30px; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
.kmk-test-container h1 { color: #1e1b4b; text-align: center; }
.kmk-test-container p.subtitle { text-align: center; color: var(--mp-text-faint); margin-bottom: 30px; }
.question-block { margin-bottom: 25px; padding: 20px; background: var(--mp-bg); border-left: 4px solid var(--mp-accent); border-radius: 8px; }
.question-block h3 { margin-top: 0; font-size: 1.1em; color: var(--mp-text); }
.options label { display: block; margin-bottom: 10px; cursor: pointer; color: var(--mp-text-soft); }
.options input { margin-right: 10px; }
.submit-btn { display: block; width: 100%; padding: 15px; background: #10b981; color: white; border: none; border-radius: 8px; font-size: 1.1em; font-weight: 600; cursor: pointer; transition: background 0.3s; }
.submit-btn:hover { background: #059669; }
</style>

<div class="kmk-test-container">
    <h1>📝 <%= l.title %></h1>
    <p class="subtitle"><%= l.subtitle %></p>

    <% if (score === null) { %>
    <form action="/teacher/knowledge-test" method="POST">
        <div class="question-block">
            <h3><%= l.q1 %></h3>
            <div class="options">
                <label><input type="radio" name="q1" value="A"> <%= l.o1a %></label>
                <label><input type="radio" name="q1" value="B"> <%= l.o1b %></label>
                <label><input type="radio" name="q1" value="C" required> <%= l.o1c %></label>
            </div>
        </div>

        <div class="question-block">
            <h3><%= l.q2 %></h3>
            <div class="options">
                <label><input type="radio" name="q2" value="A"> <%= l.o2a %></label>
                <label><input type="radio" name="q2" value="B" required> <%= l.o2b %></label>
                <label><input type="radio" name="q2" value="C"> <%= l.o2c %></label>
            </div>
        </div>

        <div class="question-block">
            <h3><%= l.q3 %></h3>
            <div class="options">
                <label><input type="radio" name="q3" value="A"> <%= l.o3a %></label>
                <label><input type="radio" name="q3" value="B" required> <%= l.o3b %></label>
                <label><input type="radio" name="q3" value="C"> <%= l.o3c %></label>
            </div>
        </div>

        <div class="question-block">
            <h3><%= l.q4 %></h3>
            <div class="options">
                <label><input type="radio" name="q4" value="A"> <%= l.o4a %></label>
                <label><input type="radio" name="q4" value="B"> <%= l.o4b %></label>
                <label><input type="radio" name="q4" value="C" required> <%= l.o4c %></label>
            </div>
        </div>

        <div class="question-block">
            <h3><%= l.q5 %></h3>
            <div class="options">
                <label><input type="radio" name="q5" value="A"> <%= l.o5a %></label>
                <label><input type="radio" name="q5" value="B" required> <%= l.o5b %></label>
                <label><input type="radio" name="q5" value="C"> <%= l.o5c %></label>
            </div>
        </div>

        <div class="question-block">
            <h3><%= l.q6 %></h3>
            <div class="options">
                <label><input type="radio" name="q6" value="A"> <%= l.o6a %></label>
                <label><input type="radio" name="q6" value="B" required> <%= l.o6b %></label>
                <label><input type="radio" name="q6" value="C"> <%= l.o6c %></label>
            </div>
        </div>

        <button type="submit" class="submit-btn"><i class="fas fa-paper-plane"></i> <%= l.submit %></button>
    </form>
    <% } else { %>
        <div class="result-block" style="text-align: center; margin-top: 20px;">
            <h2>Puntaje / Score: <%= score %>%</h2>
            <% if (passed) { %>
                <p style="color: var(--mp-ok); font-weight: bold; font-size: 1.2em;">¡Felicitaciones! Has aprobado.</p>
            <% } else { %>
                <p style="color: var(--mp-danger); font-weight: bold; font-size: 1.2em;">No has alcanzado el 75%. Por favor, revisa los contenidos del taller KMK y vuelve a intentarlo.</p>
            <% } %>
            <a href="/teacher/training" class="submit-btn" style="display: inline-block; text-decoration: none; margin-top: 15px; width: auto; padding: 10px 20px;">Volver a Capacitación / Back to Training</a>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
