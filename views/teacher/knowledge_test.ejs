        o4b: "Passwort mit Freunden teilen",
        o4c: "Langes, sicheres Passwort verwenden", // Correct
        q5: "Bereich 5 (Problemlösen): Ein Projektor funktioniert nicht. Was tun?",
        o5a: "Direkt aufgeben",
        o5b: "Nach dem Trial-and-Error-Verfahren logisch prüfen (Kabel, Strom)", // Correct
