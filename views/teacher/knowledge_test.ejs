        o6b: "Aplicar la técnica SIFT (Detenerse, Investigar, Encontrar fuentes, Rastrear)", // Correct
        o6c: "Confiar ciegamente en comentarios de redes sociales",
        submit: "Enviar Respuestas"
    }
