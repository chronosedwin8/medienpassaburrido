%>

<style>
.kmk-module{max-width:1000px;margin:0 auto;padding:20px}.kmk-intro{background:linear-gradient(135deg,#1e1b4b,#312e81);color:#fff;border-radius:16px;padding:30px;text-align:center;margin-bottom:30px}.kmk-intro h1{font-size:1.8em;margin-bottom:8px}.kmk-intro p{opacity:.85;font-size:1.05em}.kmk-area{background:#fff;border-radius:14px;margin-bottom:24px;box-shadow:0 4px 15px rgba(0,0,0,.06);overflow:hidden}.kmk-area-header{padding:20px 24px;color:#fff;cursor:pointer;display:flex;align-items:center;gap:14px}.kmk-area-header h2{margin:0;font-size:1.25em;flex:1}.kmk-area-header .badge{background:rgba(255,255,255,.25);padding:4px 12px;border-radius:20px;font-size:.8em}.kmk-area-header .toggle-icon{font-size:1.2em;transition:transform .3s}.kmk-area.open .toggle-icon{transform:rotate(180deg)}.kmk-area-body{display:none;padding:24px}.kmk-area.open .kmk-area-body{display:block}.kmk-section{margin-bottom:20px}.kmk-section h3{font-size:1.05em;color:var(--mp-text);margin-bottom:10px;display:flex;align-items:center;gap:8px}.kmk-section h3 i{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.75em}.competency-list{list-style:none;padding:0;margin:0 0 16px}.competency-list li{padding:8px 12px;border-left:3px solid var(--mp-border);margin-bottom:6px;font-size:.92em;background:var(--mp-bg);border-radius:0 8px 8px 0}.example-box{background:var(--mp-accent-soft);border:1px solid #bfdbfe;border-radius:10px;padding:14px 16px;margin-bottom:12px}.example-box h4{margin:0 0 8px;color:#1e40af;font-size:.95em}.example-box p{font-size:.88em;color:var(--mp-text);margin:4px 0}.apply-box{background:var(--mp-ok-soft);border:1px solid #bbf7d0;border-radius:10px;padding:14px 16px;margin-bottom:12px}.apply-box h4{margin:0 0 8px;color:var(--mp-ok);font-size:.95em}.apply-box ul{padding-left:18px;margin:0}.apply-box li{font-size:.88em;color:var(--mp-text);margin:4px 0}.resources-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:8px;margin-top:10px}.resource-link{display:flex;align-items:center;gap:8px;padding:8px 12px;background:#fff;border:1px solid var(--mp-border);border-radius:8px;text-decoration:none;color:var(--mp-text);font-size:.82em;transition:all .2s}.resource-link:hover{border-color:#818cf8;background:#f5f3ff;transform:translateY(-1px)}.r-icon{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:.7em;color:#fff;flex-shrink:0}.r-icon.pdf{background:var(--mp-danger)}.r-icon.docx{background:var(--mp-accent)}.r-tag{font-size:.7em;padding:2px 6px;border-radius:4px;background:var(--mp-surface-alt);color:var(--mp-text-faint);flex-shrink:0;margin-left:auto}.nav-strip{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:20px}.nav-strip a{padding:8px 16px;border-radius:10px;text-decoration:none;color:#fff;font-size:.85em;font-weight:600;transition:transform .2s,box-shadow .2s}.nav-strip a:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.2)}.bottom-cta{text-align:center;margin:30px 0}.bottom-cta button{font-size:1.15em;padding:14px 28px;background:linear-gradient(135deg,var(--mp-ok),var(--mp-ok));color:#fff;border:none;border-radius:12px;cursor:pointer;font-weight:600;transition:all .3s}.bottom-cta button:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(16,185,129,.3)}.teacher-topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:10px}.teacher-topbar .welcome{font-size:.95em;color:var(--mp-text-faint)}.teacher-topbar .logout-btn{padding:6px 14px;background:var(--mp-danger-soft);color:var(--mp-danger);border:none;border-radius:8px;cursor:pointer;font-size:.85em;text-decoration:none}.lang-badge{display:inline-block;padding:4px 10px;border-radius:6px;font-size:.75em;font-weight:600;color:white;margin-left:8px}
html[lang="de"] .worksheet-note-box { display: none !important; }
</style>

<div class="kmk-module">
    <div class="teacher-topbar">
        <span class="welcome"><i class="fas fa-chalkboard-teacher"></i> <span data-lang-content="<%- encodeContent(ui_content.welcome) %>"><%= t.welcome %></span>, <%= teacher.last_name %>
            <span class="lang-badge" style="background:<%= lang==='de'?'var(--mp-danger)':lang==='en'?'#0ea5e9':'#ea580c' %>"><%= lang.toUpperCase() %></span>
        </span>
        <div>
            <a href="/teacher/worksheets" style="padding:6px 14px;background:#fef08a;color:#854d0e;border-radius:8px;text-decoration:none;font-size:.85em;margin-right:8px"><i class="fas fa-print"></i> <span data-i18n="navWorksheets"><%= t('navWorksheets') %></span></a>
            <a href="/teacher/evaluation" style="padding:6px 14px;background:var(--mp-accent-soft);color:var(--mp-accent);border-radius:8px;text-decoration:none;font-size:.85em;margin-right:8px"><i class="fas fa-tasks"></i> <span data-i18n="navEval"><%= t.evaluation %></span></a>
            <a href="/teacher/progress" style="padding:6px 14px;background:var(--mp-accent);color:white;border-radius:8px;text-decoration:none;font-size:.85em;margin-right:8px"><i class="fas fa-chart-line"></i> Monitoreo Retos (0-6)</a>
            <a href="/teacher/logout" class="logout-btn"><i class="fas fa-sign-out-alt"></i> <span data-i18n="logoutTitle"><%= t.logout %></span></a>
        </div>
    </div>

    <div class="kmk-intro">
        <h1>📘 <span data-lang-content="<%- encodeContent(ui_content.workshop) %>"><%= t.workshop %></span></h1>
        <p data-lang-content="<%- encodeContent(ui_content.subtitle) %>" style="font-weight:600; margin-bottom:15px"><%= t.subtitle %></p>
        <p data-lang-content="<%- encodeContent(ui_content.intro_kmk) %>" style="font-size:0.95em; line-height:1.5; margin-bottom:15px"><%= t.intro_kmk %></p>
        <p style="font-size:.85em;margin-top:10px;opacity:.7" data-lang-content="<%- encodeContent(ui_content.instructions) %>"><%= t.instructions %></p>
    </div>

    <div style="margin-bottom: 40px; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 25px rgba(0,0,0,.08); padding: 24px; border: 1px solid var(--mp-border);">
        <div style="background: linear-gradient(135deg, var(--mp-danger), var(--mp-danger)); color: #fff; padding: 18px; border-radius: 12px; font-weight: 800; font-size: 1.3em; margin-bottom: 24px; text-transform: uppercase; text-align: center; letter-spacing: 1px; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);">
            <i class="fas fa-exclamation-triangle" style="margin-right: 8px; font-size: 1.2em; vertical-align: middle;"></i> 
            <span style="vertical-align: middle;">Importante: Leer antes de iniciar el taller</span>
        </div>
        
        <div style="position: relative; width: 100%; aspect-ratio: 16 / 9; min-height: 400px; max-height: 85vh; background: var(--mp-text); border-radius: 12px; overflow: hidden; border: 4px solid var(--mp-border-strong); box-shadow: inset 0 0 20px rgba(0,0,0,0.5);">
            <iframe id="pdfViewer" src="/Digital_Citizenship_Blueprint.pdf#toolbar=0&navpanes=0&view=Fit" width="100%" height="100%" style="border: none; display: block;"></iframe>
        </div>
    </div>



    <h2 style="font-size: 1.5em; font-weight: 800; color: #1e1b4b; margin-top: 35px; margin-bottom: 20px; text-align: center; border-bottom: 2px solid var(--mp-border); padding-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px;" data-lang-content="<%- encodeContent({ de: 'KMK-Kompetenzen verstehen - Praktische Beispiele Teil I', en: 'Understanding KMK Competencies - Practical Examples Part I', es: 'Comprendiendo las competencias KMK - Ejemplos prácticos parte I' }) %>">
        Comprendiendo las competencias KMK - Ejemplos prácticos parte I
    </h2>

    <div class="nav-strip">
        <% areas.forEach((a,i) => { %>
            <a href="#area<%= a.num %>" style="background:<%= navColors[i] %>" onclick="openArea('area<%= a.num %>')">
                <span data-lang-content="<%- encodeContent({ de: 'Kompetenz ' + a.num, en: 'Competency ' + a.num, es: 'Competencia ' + a.num }) %>">
                <%= areaLabel %> <%= a.num %></span>
            </a>
        <% }) %>
    </div>

    <% areas.forEach((a, idx) => { %>
    <div class="kmk-area<%= idx===0?' open':'' %>" id="area<%= a.num %>">
        <div class="kmk-area-header" style="background:linear-gradient(135deg,<%= a.color %>,<%= a.grad %>)" onclick="toggleArea(this)">
            <span class="badge" data-lang-content="<%- encodeContent({ de: 'Kompetenz ' + a.num, en: 'Competency ' + a.num, es: 'Competencia ' + a.num }) %>"><%= areaLabel %> <%= a.num %></span>
            <h2><%= a.emoji %> <span data-lang-content="<%- encodeContent(a.title) %>"><%= a.title[lang] %></span></h2>
            <i class="fas fa-chevron-down toggle-icon"></i>
        </div>
        <div class="kmk-area-body">
            <div class="kmk-section">
                <h3><i style="background:<%= a.color %>" class="fas fa-list"></i> <span data-lang-content="<%- encodeContent(ui_content.competencies) %>"><%= t.competencies %></span></h3>
                <ul class="competency-list" data-lang-content="<%- encodeContent({ de: a.comps.de.map(c=>'<li>'+c+'</li>').join(''), en: a.comps.en.map(c=>'<li>'+c+'</li>').join(''), es: a.comps.es.map(c=>'<li>'+c+'</li>').join('') }) %>">
                    <% a.comps[lang].forEach(c => { %><li><%- c %></li><% }) %>
                </ul>
            </div>
            <div class="kmk-section">
                <% if(a.ex_primary) { %>
                <div class="example-box">
                    <h4>💡 <span data-lang-content="<%- encodeContent(ui_content.example_primary) %>"><%= t.example_primary %></span></h4>
                    <p data-lang-content="<%- encodeContent(a.ex_primary) %>"><%= a.ex_primary[lang] %></p>
                </div>
                <% } %>
                <% if(a.ex_secondary) { %>
                <div class="example-box">
                    <h4>💡 <span data-lang-content="<%- encodeContent(ui_content.example_secondary) %>"><%= t.example_secondary %></span></h4>
                    <p data-lang-content="<%- encodeContent(a.ex_secondary) %>"><%= a.ex_secondary[lang] %></p>
                </div>
                <% } %>
            </div>
            <div class="kmk-section">
                <div class="apply-box">
                    <h4>🎯 <span data-lang-content="<%- encodeContent(ui_content.apply) %>"><%= t.apply %></span></h4>
                    <ul data-lang-content="<%- encodeContent({ de: a.apply.de.map(t=>'<li>'+t+'</li>').join(''), en: a.apply.en.map(t=>'<li>'+t+'</li>').join(''), es: a.apply.es.map(t=>'<li>'+t+'</li>').join('') }) %>">
                        <% a.apply[lang].forEach(tip => { %><li><%- tip %></li><% }) %>
                    </ul>
                </div>
            </div>
            <div class="kmk-section">
                <h3><i style="background:<%= a.color %>" class="fas fa-file-download"></i> <span data-lang-content="<%- encodeContent(ui_content.worksheets) %>"><%= t.worksheets %></span></h3>
                <div class="worksheet-note-box" style="background:var(--mp-warn-soft);border:1px solid #fde047;border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:.85em;color:#854d0e">
                    <span data-lang-content="<%- encodeContent(ui_content.worksheets_note) %>"><%= t.worksheets_note %></span>
                </div>
                <div class="resources-grid">
                    <% a.resources.forEach(r => { %>
                    <a href="<%= r.url %>" target="_blank" class="resource-link" style="flex-direction:column;align-items:flex-start;gap:4px">
                        <div style="display:flex;align-items:center;gap:8px;width:100%">
                            <span class="r-icon <%= r.fmt==='PDF'?'pdf':'docx' %>"><i class="fas fa-file-<%= r.fmt==='PDF'?'pdf':'word' %>"></i></span>
                            <span style="flex:1" data-lang-content="<%- encodeContent(r.name) %>"><%= r.name[lang] || r.name.de %></span>
                            <span class="r-tag">
                                <span data-lang-content="<%- encodeContent(r.lvl==='primary' ? ui_content.primary : ui_content.sekI) %>"><%= r.lvl==='primary' ? t.primary : t.sekI %></span> · <%= r.fmt %>
                            </span>
                        </div>
                        <% if(r.desc) { %>
                        <div style="font-size:.78em;color:var(--mp-text-faint);padding-left:36px;line-height:1.3" data-lang-content="<%- encodeContent(r.desc) %>">📝 <%= r.desc[lang] || r.desc.de || '' %></div>
                        <% } %>
                    </a>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
    <% }) %>

    <h2 style="font-size: 1.5em; font-weight: 800; color: #1e1b4b; margin-top: 35px; margin-bottom: 20px; text-align: center; border-bottom: 2px solid var(--mp-border); padding-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px;" data-lang-content="<%- encodeContent({ de: 'Praktische Beispiele Teil II: Kompetenzen in Aktion 0 bis 6', en: 'Practical Examples Part II: Competencies in Action 0 to 6', es: 'Ejemplos prácticos parte II Competencias en acción 0 al 6:' }) %>">
        Ejemplos prácticos parte II Competencias en acción 0 al 6:
    </h2>

    <% part2Competencies.forEach((c, idx) => { %>
    <div class="kmk-area" id="competencia<%= c.num %>">
        <div class="kmk-area-header" style="background:linear-gradient(135deg,<%= c.color %>,<%= c.grad %>)" onclick="toggleArea(this)">
            <span class="badge" data-lang-content="<%- encodeContent(c.badge) %>"><%= c.badge[lang] %></span>
            <h2><%= c.emoji %> <span data-lang-content="<%- encodeContent(c.title) %>"><%= c.title[lang] %></span></h2>
            <i class="fas fa-chevron-down toggle-icon"></i>
        </div>
        <div class="kmk-area-body">
            <!-- Objetivo -->
            <div class="kmk-section">
                <h4 style="margin: 0 0 8px 0; color: <%= c.color %>; font-size: 1.1em; font-weight: 700;" data-lang-content="<%- encodeContent(c.objTitle) %>"><%= c.objTitle[lang] %></h4>
                <p style="margin: 0; color: var(--mp-text); font-size: 1em; line-height: 1.6; background: var(--mp-bg); padding: 14px; border-radius: 8px;" data-lang-content="<%- encodeContent(c.objText) %>"><%= c.objText[lang] %></p>
            </div>
            
            <!-- Desarrollo -->
            <div class="kmk-section">
                <h4 style="margin: 0 0 12px 0; color: var(--mp-ok); font-size: 1.15em; font-weight: 700; border-bottom: 2px solid var(--mp-ok); padding-bottom: 6px; display: inline-block;" data-lang-content="<%- encodeContent(c.devTitle) %>"><%= c.devTitle[lang] %></h4>
                <p style="margin: 0 0 16px 0; color: var(--mp-text-soft); font-size: 0.95em; line-height: 1.5;" data-lang-content="<%- encodeContent(c.devIntro) %>"><%= c.devIntro[lang] %></p>
                <% c.devList.forEach(d => { %>
                <div style="background: var(--mp-bg); border-left: 4px solid var(--mp-ok); padding: 16px; border-radius: 8px; margin-bottom: 16px;">
                    <h5 style="margin: 0 0 8px 0; color: var(--mp-ok); font-size: 1.05em; font-weight: 700;" data-lang-content="<%- encodeContent(d.title) %>"><%= d.title[lang] %></h5>
                    <p style="margin: 0; color: var(--mp-text); font-size: 0.95em; line-height: 1.6;" data-lang-content="<%- encodeContent(d.text) %>"><%= d.text[lang] %></p>
                </div>
                <% }) %>
            </div>

            <!-- Pistas -->
            <div class="kmk-section">
                <h4 style="margin: 0 0 12px 0; color: #1e1b4b; font-size: 1.15em; font-weight: 700; border-bottom: 2px solid <%= c.color %>; padding-bottom: 6px; display: inline-block;" data-lang-content="<%- encodeContent(c.hintTitle) %>"><%= c.hintTitle[lang] %></h4>
                <p style="margin: 0 0 16px 0; color: var(--mp-text-soft); font-size: 0.95em; line-height: 1.5;" data-lang-content="<%- encodeContent(c.hintIntro) %>"><%= c.hintIntro[lang] %></p>
                <% c.hintsList.forEach(h => { %>
                <div style="background: var(--mp-bg); border-left: 4px solid <%= c.color %>; padding: 16px; border-radius: 8px; margin-bottom: 16px;">
                    <h5 style="margin: 0 0 8px 0; color: var(--mp-text); font-size: 1.05em; font-weight: 700;" data-lang-content="<%- encodeContent(h.title) %>"><%= h.title[lang] %></h5>
                    <p style="margin: 0; color: var(--mp-text-soft); font-size: 0.95em; line-height: 1.6;" data-lang-content="<%- encodeContent(h.text) %>"><%= h.text[lang] %></p>
                </div>
                <% }) %>
            </div>

            <!-- Evaluación -->
            <div style="background: var(--mp-warn-soft); border: 1px solid #fde68a; padding: 20px; border-radius: 12px;">
                <h4 style="margin: 0 0 8px 0; color: var(--mp-warn); font-size: 1.1em; font-weight: 700;" data-lang-content="<%- encodeContent(c.evalTitle) %>"><%= c.evalTitle[lang] %></h4>
                <p style="margin: 0; color: var(--mp-warn); font-size: 0.95em; line-height: 1.6;" data-lang-content="<%- encodeContent(c.evalText) %>"><%= c.evalText[lang] %></p>
            </div>
        </div>
    </div>
    <% }) %>

    <div class="bottom-cta">
        <p style="color:var(--mp-text-faint);margin-bottom:14px" data-lang-content="<%- encodeContent(ui_content.cta_question) %>"><%= t.cta_question %></p>
        <button onclick="window.location.href='/teacher/evaluation'"><i class="fas fa-check-circle"></i> <span data-lang-content="<%- encodeContent(ui_content.cta_button) %>"><%= t.cta_button %></span></button>
    </div>
</div>

<script>
function toggleArea(h){h.parentElement.classList.toggle('open')}
function openArea(id) {
    document.querySelectorAll('.kmk-area').forEach(el => el.classList.remove('open'));
    const target = document.getElementById(id);
    if(target) target.classList.add('open');
}
</script>
<%- include('../partials/glossary') %>

<%- include('../partials/footer') %>